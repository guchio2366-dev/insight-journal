  "definitions": {
    "indigenousLanguageAge3Plus": {
      "label": "Speaks an Indigenous language (age 3+)",
      "universe": "Population aged 3 years and over (known age 3–130)",
      "countField": "P3YM_HLI",
      "denominatorField": "P_3YMAS",
      "table": "Etnicidad 2",
      "sheet": "02",
      "definition": "People aged 3 years and over reported as speaking an Indigenous language.",
      "percentageFormula": "100 * count / populationAge3Plus",
      "missingness": "The denominator includes people with unspecified Indigenous-language speaking status. That unspecified count is included separately, not recoded as No."
    },
    "afroMexicanSelfIdentificationAllAges": {
      "label": "Identifies as Afro-Mexican or Afrodescendant (all ages)",
      "universe": "Total usual resident population, all ages",
      "countField": "POB_AFRO",
      "denominatorField": "POBTOT",
      "table": "Etnicidad 14",
      "sheet": "14",
      "definition": "People reported as considering themselves Afro-Mexican or Afrodescendant.",
      "percentageFormula": "100 * count / totalPopulation",
      "missingness": "The denominator includes unspecified identity responses and estimated population in dwellings without occupant information and omitted minors. Unspecified identity is included separately, not recoded as No.",
      "tableFootnote": "1 Incluye una estimación de población de 6 337 751 personas que corresponden a 1 588 422 viviendas sin información de ocupantes y menores omitidos."
    }
  },
