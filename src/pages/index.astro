---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import ThemeCard from "../components/ThemeCard.astro";
import { topics } from "../data/taxonomy";
import BaseLayout from "../layouts/BaseLayout.astro";
import { compareDatedPublicIds } from "../lib/dates";
import { withBase } from "../lib/urls";

const articles = (await getCollection("articles"))
  .sort((left, right) => compareDatedPublicIds(left.data.publishedAt, left.data.publicId, right.data.publishedAt, right.data.publicId));
const allThemes = (await getCollection("publicThemes"))
  .sort((left, right) => compareDatedPublicIds(left.data.updatedAt, left.data.publicId, right.data.updatedAt, right.data.publicId));
const latest = articles.slice(0, 12);

const themeCounts = new Map<string, number>();
for (const article of articles) {
  for (const themeId of article.data.themeIds) {
    themeCounts.set(themeId, (themeCounts.get(themeId) ?? 0) + 1);
  }
}
const themes = allThemes.filter((theme) => (themeCounts.get(theme.data.publicId) ?? 0) > 0);

const primaryTopicOrder = ["conflict", "religion", "agriculture"];
const topicCounts = Object.entries(topics)
  .map(([slug, label]) => ({
    slug,
    label,
    count: articles.filter((article) => article.data.topics.includes(slug as keyof typeof topics)).length
  }))
  .filter((item) => item.count > 0 || primaryTopicOrder.includes(item.slug))
  .sort((left, right) => {
    const leftPrimary = primaryTopicOrder.indexOf(left.slug);
    const rightPrimary = primaryTopicOrder.indexOf(right.slug);
    if (leftPrimary >= 0 || rightPrimary >= 0) {
      if (leftPrimary < 0) return 1;
      if (rightPrimary < 0) return -1;
      return leftPrimary - rightPrimary;
    }
    return right.count - left.count || left.label.localeCompare(right.label, "ja");
  });
---

<BaseLayout>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent knowledge archive</p>
        <h1>ニュースの先にある、<br /><em>構造</em>を読む。</h1>
        <p class="hero-lede">
          政治、経済、社会、紛争、宗教、農業。日々の出来事を単発で終わらせず、背景と因果、場所と時間から理解を更新します。
        </p>
        <form class="hero-search" action={withBase("/search/")} method="get" role="search">
          <label class="visually-hidden" for="home-search">記事とテーマを検索</label>
          <input id="home-search" name="q" type="search" maxlength="200" placeholder="気になる言葉から探す" />
          <button type="submit">検索</button>
        </form>
        <div class="hero-actions">
          <a class="button button--primary" href={withBase("/search/")}>記事を探す</a>
          <a class="button button--quiet" href={withBase("/themes/")}>テーマから読む</a>
        </div>
      </div>
      <aside class="hero-index" aria-label="掲載情報">
        <div><strong>{String(articles.length).padStart(2, "0")}</strong><span>公開記事</span></div>
        <div><strong>{String(themes.length).padStart(2, "0")}</strong><span>継続テーマ</span></div>
        <p>事実・解釈・見解を分け、出典と更新日を明記します。</p>
      </aside>
    </div>
  </section>

  <section class="page-section shell" aria-labelledby="latest-title">
    <div class="section-heading section-heading--rule">
      <div>
        <p class="eyebrow">Latest</p>
        <h2 id="latest-title">新着インサイト</h2>
      </div>
      <a class="text-link" href={withBase("/search/")}>すべての記事 <span aria-hidden="true">→</span></a>
    </div>
    {latest.length > 0 ? (
      <div class="article-grid">
        {latest.map((article) => (
          <ArticleCard
            slug={article.data.slug}
            title={article.data.title}
            summary={article.data.summary}
            publishedAt={article.data.publishedAt}
            updatedAt={article.data.updatedAt}
            topics={article.data.topics}
            countries={article.data.countries}
            regions={article.data.regions}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p class="eyebrow">Preparing</p>
        <h3>最初の記事を準備しています</h3>
        <p>公開された記事は、ここに新しい順で並びます。</p>
      </div>
    )}
  </section>

  {themes.length > 0 && (
    <section class="page-section page-section--tinted">
      <div class="shell">
        <div class="section-heading section-heading--rule">
          <div>
            <p class="eyebrow">Living themes</p>
            <h2>継続して考えるテーマ</h2>
          </div>
          <a class="text-link" href={withBase("/themes/")}>テーマ一覧 <span aria-hidden="true">→</span></a>
        </div>
        <div class="theme-grid">
          {themes.slice(0, 4).map((theme) => (
            <ThemeCard
              slug={theme.data.slug}
              title={theme.data.title}
              summary={theme.data.summary}
              topics={theme.data.topics}
              articleCount={themeCounts.get(theme.data.publicId) ?? 0}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {topicCounts.length > 0 && (
    <section class="page-section shell" aria-labelledby="topics-title">
      <div class="section-heading section-heading--rule">
        <div>
          <p class="eyebrow">Browse by field</p>
          <h2 id="topics-title">分野から探す</h2>
        </div>
      </div>
      <div class="topic-directory">
        {topicCounts.map((topic, index) => (
          <a href={withBase(`/search/?topic=${topic.slug}`)}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{topic.label}</strong>
            <small>{topic.count}記事</small>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
