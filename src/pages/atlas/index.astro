---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasWorldNavigation from '../../components/atlas/AtlasWorldNavigation.astro';
import { withBase } from '../../lib/urls';

// Enable independently maintained destinations only when their pages exist.
const optionalPages = import.meta.glob('./{africa,oceania,russia}/index.astro');
const availableRegions = ['africa', 'oceania', 'russia'].filter(id => `./${id}/index.astro` in optionalPages);
---
<BaseLayout title="地図から見る" description="世界地図から地域を選んで、自然環境・農林業・産業・人口の地図へ。" compactAtlas>
  <div class="atlas-directory shell">
    <header>
      <div><p class="eyebrow">Atlas</p><h1>地図から見る</h1></div>
      <p>世界地図の地域や名前をタップして開く。</p>
    </header>
    <AtlasWorldNavigation availableRegions={availableRegions} />
    <a class="atlas-industry-feature-entry" data-industry-feature-entry href={withBase('/atlas/industry/')}><strong>産業を動かす地理</strong><span>自動車・太陽光・蓄電池・半導体を、北米・欧州・アジアで比べる</span><span aria-hidden="true">→</span></a>
  </div>
</BaseLayout>
<style>
  .atlas-directory { padding: 22px 0 32px; }
  header { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .eyebrow { margin: 0 0 5px; }
  h1 { font-family: var(--serif); font-size: clamp(28px, 3.5vw, 42px); letter-spacing: -.05em; margin: 0; }
  header > p { margin: 0 0 5px; color: var(--ink-soft); font-size: 13px; }
  .atlas-industry-feature-entry { display: flex; align-items: center; gap: 14px; margin-top: 16px; padding: 12px 16px; border: 1px solid var(--rule); border-radius: 8px; color: var(--ink); text-decoration: none; background: var(--paper); }
  .atlas-industry-feature-entry strong { white-space: nowrap; font-size: 15px; }
  .atlas-industry-feature-entry > span { font-size: 12px; color: var(--ink-soft); }
  .atlas-industry-feature-entry > span:last-child { margin-left: auto; }
  .atlas-industry-feature-entry:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  @media (max-width: 600px) {
    .atlas-directory { padding-top: 16px; }
    header { display: block; margin-bottom: 12px; }
    header > p { margin: 7px 0 0; font-size: 12px; }
    .eyebrow { font-size: 10px; }
    .atlas-industry-feature-entry { gap: 6px 12px; flex-wrap: wrap; padding: 10px 12px; }
    .atlas-industry-feature-entry > span:not(:last-child) { flex-basis: 100%; order: 1; }
  }
  @media (max-height: 600px) and (min-width: 601px) {
    .atlas-directory { padding-top: 10px; }
    header { align-items: center; margin-bottom: 10px; }
    .eyebrow { display: none; }
    h1 { font-size: 28px; }
    header > p { font-size: 11px; }
  }
</style>
