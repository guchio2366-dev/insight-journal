---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasWorldNavigation from '../../components/atlas/AtlasWorldNavigation.astro';

// Enable the two new destinations when their independently maintained pages exist.
const optionalPages = import.meta.glob('./{africa,oceania}/index.astro');
const availableRegions = ['africa', 'oceania'].filter(id => `./${id}/index.astro` in optionalPages);
---
<BaseLayout title="地図から見る" description="世界地図から地域を選んで、自然環境・農林業・産業・人口の地図へ。" compactAtlas>
  <div class="atlas-directory shell">
    <header>
      <div><p class="eyebrow">Atlas</p><h1>地図から見る</h1></div>
      <p>世界地図の地域や名前をタップして開く。</p>
    </header>
    <AtlasWorldNavigation availableRegions={availableRegions} />
  </div>
</BaseLayout>
<style>
  .atlas-directory { padding: 22px 0 32px; }
  header { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .eyebrow { margin: 0 0 5px; }
  h1 { font-family: var(--serif); font-size: clamp(28px, 3.5vw, 42px); letter-spacing: -.05em; margin: 0; }
  header > p { margin: 0 0 5px; color: var(--ink-soft); font-size: 13px; }
  @media (max-width: 600px) {
    .atlas-directory { padding-top: 16px; }
    header { display: block; margin-bottom: 12px; }
    header > p { margin: 7px 0 0; font-size: 12px; }
    .eyebrow { font-size: 10px; }
  }
</style>
