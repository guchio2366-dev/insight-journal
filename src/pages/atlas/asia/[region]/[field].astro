---
import AsiaAtlasPage from '../../../../components/atlas/AsiaAtlasPage.astro';
import { asiaMapIds } from '../../../../data/atlas/regional-atlas';
import {asiaFocusIds} from '../../../../data/atlas/asia-focus';
export function getStaticPaths() {
  return [...asiaMapIds,...asiaFocusIds].flatMap(id=>['nature','agriculture','industry','population'].map(field=>({params:{region:id,field},props:{regionId:asiaFocusIds.includes(id as any)?'south-central-asia':id,focusId:asiaFocusIds.includes(id as any)?id:undefined,initialField:field==='nature'?'natural':field}})));
}
const {regionId,initialField,focusId}=Astro.props;
---
<AsiaAtlasPage {regionId} {initialField} {focusId} />
