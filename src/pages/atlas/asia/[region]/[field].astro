---
import AsiaAtlasPage from '../../../../components/atlas/AsiaAtlasPage.astro';
import { asiaMapIds } from '../../../../data/atlas/regional-atlas';
export function getStaticPaths() {
  return asiaMapIds.flatMap(regionId=>['nature','agriculture','population'].map(field=>({params:{region:regionId,field},props:{regionId,initialField:field==='nature'?'natural':field}})));
}
const {regionId,initialField}=Astro.props;
---
<AsiaAtlasPage {regionId} {initialField} />
