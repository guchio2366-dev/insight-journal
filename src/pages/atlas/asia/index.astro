---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from '../../../components/atlas/AtlasRegionNavigation.astro';
import { asiaMapIds, regionalMaps, regionFeatures } from '../../../data/atlas/regional-atlas';
import { withBase } from '../../../lib/urls';
const routes = Object.fromEntries(asiaMapIds.map(id => [id, withBase(regionalMaps[id].href)]));
const countryRoutes = Object.fromEntries(asiaMapIds.flatMap(id => regionFeatures(id).map(feature => [feature.properties.code, id])));
---
<BaseLayout title="アジア地図" description="東アジア・東南アジア・南・中央アジアの地域別地図。" compactAtlas noindex>
  <section class="shell asia-legacy" data-asia-legacy data-routes={JSON.stringify(routes)} data-country-routes={JSON.stringify(countryRoutes)}>
    <p><a href={withBase('/atlas/')}>地図から見る</a> / アジア</p><h1>アジア地図</h1>
    <p>地域別の地図へ移動します。移動しない場合は、地域を選択してください。</p>
    <AtlasRegionNavigation group="asia" current="" />
  </section>
</BaseLayout>
<script>
  const root = document.querySelector<HTMLElement>('[data-asia-legacy]');
  if (root) {
    const routes: Record<string,string> = JSON.parse(root.dataset.routes!);
    const countryRoutes: Record<string,string> = JSON.parse(root.dataset.countryRoutes!);
    const oldRegions: Record<string,string> = {east:'east-asia', southeast:'southeast-asia', south:'south-central-asia', central:'south-central-asia'};
    const params = new URLSearchParams(location.search);
    const place = params.get('place') ?? '';
    const region = countryRoutes[place] ?? oldRegions[params.get('region') ?? ''] ?? 'east-asia';
    const destination = new URL(routes[region], location.origin);
    if (countryRoutes[place]) destination.searchParams.set('place', place);
    location.replace(destination.href);
  }
</script>
<style>.asia-legacy { padding: 30px 0 70px; }</style>

