---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {withBase} from '../../../lib/urls';
import geography from '../../../data/atlas/africa-geography.json';
import {africaPath,projectAfrica,africaWidth,africaHeight} from '../../../lib/atlas-africa-geometry';
import {countries,fields,metrics,regionNames} from '../../../data/atlas/africa-atlas';
import {reading} from '../../../data/atlas/africa-reading';
import {themes} from '../../../data/atlas/africa-themes';
import {africaClimateCities,africaClimateCityCoverage} from '../../../data/atlas/africa-climate-cities';
import AtlasNewsRail from '../../../components/atlas/AtlasNewsRail.astro';
import AtlasClimatePlot from '../../../components/atlas/AtlasClimatePlot.astro';
import '../../../styles/atlas-explorer.css';
import '../../../styles/atlas-desktop.css';
import '../../../styles/atlas-africa.css';
const climateSource=africaClimateCities[0].classification;
const formatClimateValue=(value:number|null,unit:string)=>value===null?'未収録':`${value.toFixed(1)} ${unit}`;
---
<BaseLayout title="アフリカ地図" description="アフリカの自然環境・農林業・主要産業・人口を、地図上の分布と地域・地点の説明から読む。" compactAtlas>
 <div class="africa-atlas shell" data-africa-atlas>
  <div class="africa-desktop-shell" data-atlas-shell>
   <AtlasNewsRail region="africa" mapActions={false} />
   <article class="africa-main">
    <header class="africa-heading">
     <div class="africa-compact-heading"><p class="africa-breadcrumb"><a href={withBase('/atlas/')}>地図から見る</a> / アフリカ</p><span>アフリカ地域</span></div>
     <h1>アフリカ地図</h1>
     <div class="africa-region-controls">
      <div class="africa-region-row"><nav class="africa-region-tabs" aria-label="地域の移動"><a href={withBase('/atlas/')}>世界の地域</a><a href={withBase('/atlas/africa/overview/')} aria-current="page">アフリカ</a></nav></div>
      <p class="africa-elevation-note" data-africa-elevation-note hidden>500mの等高線と段階色 · 元の表示格子は0.1度 · ETOPO 2022版</p>
     </div>
    </header>
    <nav class="africa-fields" aria-label="分野を選ぶ"><a data-africa-overview-link href={withBase('/atlas/africa/overview/')}>概要</a>{(['agriculture','nature','industry','population'] as const).map(id=><button type="button" data-field={id} aria-pressed={id==='nature'?'true':'false'}>{fields[id].label}</button>)}</nav>
    <nav class="africa-subfields" data-africa-subfields aria-label="分野内の項目"></nav>
    <div class="africa-workspace" id="africa-map-panel">
     <section class="africa-map-card" aria-labelledby="africa-map-title">
      <div class="africa-map-frame">
       <div class="africa-agri-map-controls" data-africa-agri-map-controls hidden><label>地域<select data-africa-agri-region aria-label="農畜産の表示地域">{Object.entries(regionNames).map(([id,name])=><option value={id}>{name}</option>)}</select></label></div>
       <div class="africa-map-heading"><h2 id="africa-map-title" data-metric-title>アフリカの気候</h2><span><span data-period>気候区分を読込中</span> · <span data-unit>国境は位置の目安</span></span></div>
       <svg class="africa-map" viewBox={`0 0 ${africaWidth} ${africaHeight}`} data-detail="false" role="img" aria-labelledby="africa-svg-title africa-svg-desc">
        <title id="africa-svg-title">アフリカの国境と位置</title>
        <desc id="africa-svg-desc">気候区分を読み込む前の国境図です。国境の中は同じ色で、国別統計は表していません。</desc>
        <rect width={africaWidth} height={africaHeight} fill="#e9f0f0"/>
        {[-20,0,20].map(lat=><line x1="0" x2={africaWidth} y1={projectAfrica([0,lat])[1]} y2={projectAfrica([0,lat])[1]} class="africa-graticule"/>)}
        {geography.features.map(feature=>{const country=countries.find(country=>country.code===feature.properties.code)!;return <path d={africaPath(feature.geometry)} data-country-path={country.code} fill="#f3f1e9" fill-rule="evenodd" pointer-events="none" class="africa-country"><title>{country.name}</title></path>})}
        <g data-africa-actual-layer></g>
        {[{name:'大西洋',point:[-18,-12]},{name:'インド洋',point:[56,-8]},{name:'地中海',point:[18,36]}].map(label=><text class="africa-ocean" data-africa-ocean={label.name==='インド洋'?'indian':undefined} x={projectAfrica(label.point)[0]} y={projectAfrica(label.point)[1]}>{label.name}</text>)}
        <g data-theme-marks></g>
       </svg>
       <div class="africa-map-tools" aria-label="地図の操作"><button data-reset type="button">リセット</button></div>
      </div>
      <div class="africa-commodities" data-africa-commodities role="group" hidden></div>
      <div class="africa-layer-options" data-africa-layer-options hidden></div>
      <section class="africa-essential-legend africa-actual-key" data-africa-actual-key hidden aria-label="表示分布の凡例"><p data-africa-layer-caption></p><div data-africa-layer-legend></div><div data-africa-agri-value-legend></div><p data-africa-layer-scope></p></section>
      <div class="africa-map-subfields" data-africa-map-subfields></div>
      <p class="africa-subfield-status" data-africa-subfield-status hidden role="status" aria-live="polite"></p>
      <div class="africa-themes" data-themes role="group" aria-label="分布テーマ" hidden></div>
      <details class="africa-map-notes"><summary>地図の表示方法と収録状況</summary><p class="africa-caption" data-map-caption>国境は位置を読むための目安です。気候・河川・作物などの分布は、それぞれの出典に基づいて表示します。</p><p class="africa-coverage" data-coverage></p></details>
     </section>
     <aside class="africa-detail" aria-label="地域と地点の読み方" tabindex="0">
      <section class="africa-theme-reading" aria-labelledby="africa-theme-title">
       <div class="africa-right-fixed">
        <button class="africa-agri-overview-return" data-africa-agri-overview type="button" hidden>← 農畜産の概要</button>
        <button class="africa-selection-return" data-africa-selection-return type="button" hidden>← 全域の概説へ戻る</button>
        <p class="africa-kicker">地図から持ち帰ること</p>
        <h2 id="africa-theme-title" data-theme-title>アフリカの気候</h2>
        <p class="africa-takeaway" data-theme-takeaway>湿潤な赤道付近、サハラの乾燥帯、高地や南北端の違いを気候区分で読みます。</p>
        <div class="africa-agri-actions" data-africa-agri-actions hidden><button type="button" data-africa-agri-only>この品目だけを表示</button><button type="button" data-africa-agri-all hidden>作物・家畜の全分布へ戻る</button></div>
       </div>
       <div class="africa-detail-scroll">
        <div class="africa-agri-context" data-africa-agri-context hidden></div>
        <div class="africa-city-readings" data-africa-city-readings hidden>
         {africaClimateCities.map(city=><article class="africa-city-reading" data-africa-city-reading={city.id} aria-label={`${city.name}の雨温図と気候`} hidden>
          <figure class="africa-city-climate-plot atlas-climate-diagram">
           <AtlasClimatePlot name={city.name} period={city.normalPeriod} temperatureC={city.temperatureC} precipitationMm={city.precipitationMm}/>
           <figcaption>{city.normalPeriod}の観測所平年値 · <span class="is-cold">棒：降水量 mm</span> · <span class="is-warm">線：平均気温 ℃</span></figcaption>
          </figure>
          <section class="africa-city-classification" aria-labelledby={`africa-city-class-${city.id}`}>
           <h4 id={`africa-city-class-${city.id}`}>{city.classification.name}（{city.classification.code}）</h4>
           <p>{city.classification.description}</p>
          </section>
          <section class="africa-city-geographic-reason" aria-labelledby={`africa-city-reason-${city.id}`}>
           <h4 id={`africa-city-reason-${city.id}`}>この気候になる地理的な理由</h4>
           <p data-africa-city-geographic-reason={city.id}>{city.geographicReason??city.geographicReasonStatus}</p>
           <p class="africa-city-mechanism-source"><a href={city.mechanismSourceUrl}>{city.mechanismSourceName}</a>を踏まえた地理的な読み方。</p>
          </section>
          <p class="africa-city-agriculture">農業・牧畜との関係：{city.agricultureLink}</p>
          <p class="africa-city-reading-summary">{city.reading}</p>
          <p class="africa-city-source">観測所の平年値：<a href={city.sourceUrl}>{city.sourceName} · {city.normalPeriod}</a></p>
          <p class="africa-city-source">地点の気候区分：<a data-africa-city-classification-source={city.id} href={city.classification.sourceUrl}>{city.classification.sourceName}</a> · {city.classification.period} · {city.classification.resolutionDegrees}度格子</p>
          <details class="africa-city-months" data-africa-city-months={city.id}>
           <summary>12か月の数値・観測地点・出典</summary>
           <p>{city.stationName} · 観測所番号 {city.stationId} · 標高 {city.elevationM.toLocaleString('ja-JP')} m · {Math.abs(city.coordinates[1]).toFixed(2)}°{city.coordinates[1]<0?'S':'N'} / {Math.abs(city.coordinates[0]).toFixed(2)}°{city.coordinates[0]<0?'W':'E'}</p>
           <p>平年期間：{city.normalPeriod}。気温と降水量は別の軸で読みます。未収録と降水量0 mmを区別します。</p>
           <table><caption>{city.name}の月別平年値（{city.normalPeriod}）</caption><thead><tr><th scope="col">月</th><th scope="col">平均気温</th><th scope="col">降水量</th></tr></thead><tbody>{city.temperatureC.map((value,index)=><tr><th scope="row">{index+1}月</th><td>{formatClimateValue(value,'℃')}</td><td>{formatClimateValue(city.precipitationMm[index],'mm')}</td></tr>)}</tbody></table>
           {city.notes.map(note=><p>{note}</p>)}
           <p>平年値の保存日：{city.sourceRetrievedAt}。<a href="https://ds.data.jma.go.jp/tcc/tcc/products/climate/climatview/outline.html">気象庁の平年期間と算出方法</a> · <a href={city.sourceTermsUrl}>利用条件</a>。</p>
           <p>気候区分は観測所の座標にある格子の分類です。<a href={city.classification.licenseUrl}>{city.classification.license}</a>。</p>
          </details>
         </article>)}
         <p class="africa-city-coverage" data-africa-city-coverage>{africaClimateCityCoverage}</p>
        </div>
        <div class="africa-alternatives" data-africa-alternatives hidden></div>
        <div class="africa-layer-selection" data-africa-layer-selection hidden><label>表示・読解する分類<select data-africa-layer-category></select></label><p data-africa-point-reading aria-live="polite"></p><button type="button" data-africa-layer-retry hidden>分布データを再読込</button></div>
        <p class="africa-theme-explanation" data-theme-takeaway-detail>作物や暮らしには、気候に加え、水の管理・技術・交通・市場も関わります。</p>
        <p class="africa-theme-caveat" data-theme-caveat>気候区分の格子と、観測所の月別平年値は別の資料です。</p>
        <a class="africa-theme-source" data-theme-source href={climateSource.sourceUrl}>{climateSource.sourceName}</a>
        <details class="africa-theme-full"><summary>分布の詳しい読み方・出典</summary><div data-theme-details><p>気候区分：{climateSource.period} · {climateSource.resolutionDegrees}度格子 · <a href={climateSource.licenseUrl}>{climateSource.license}</a>。</p><p>{africaClimateCityCoverage}</p></div></details>
       </div>
      </section>
     </aside>
    </div>
    <div class="africa-secondary">
     <div class="africa-agri-notes" data-africa-agri-notes hidden></div>
     <details class="africa-disclosure"><summary>場所から、自然・産業・暮らしのつながりを読む</summary>
      <section class="africa-reading"><div class="africa-section-heading"><p class="eyebrow">Read the geography</p><h2>場所から、つながりを読む</h2><p>収録済みの地域別説明と、その根拠資料です。</p></div>
       {Object.entries(reading).map(([field,cards])=><section class="africa-reading-field"><h3>{fields[field as keyof typeof fields].label}</h3><div class="africa-reading-grid">{cards.map(card=><article><h4>{card.title}</h4><p>{card.text}</p><div class="africa-place-links">{card.places.map(code=><span>{countries.find(country=>country.code===code)?.name}</span>)}</div><a href={card.source} class="africa-reading-source">{card.sourceLabel}</a></article>)}</div></section>)}
      </section>
     </details>
     <details class="africa-disclosure"><summary>地域の事例・詳しい説明と出典</summary>
      <section class="africa-reading" aria-label="収録済みの分布テーマの説明">{themes.map(theme=><article class="africa-theme-archive"><h3>{theme.title}</h3><p>{theme.takeaway}</p><p>{theme.caveat}</p><a href={theme.source}>{theme.sourceLabel}</a>{theme.marks.map(mark=><p><strong>{mark.label}</strong> — {mark.note}</p>)}<p>{theme.compareText}</p>{theme.evidenceSources?.map(source=><p><a href={source.url}>{source.label}</a></p>)}</article>)}</section>
     </details>
     <details class="africa-disclosure"><summary>保存した国別統計の読み方・分野の説明</summary>
      <p>以下は保存した国別指標を読むための説明です。現在の分布図の色や記号が、その国別数値を表すものではありません。</p>
      {Object.entries(fields).map(([id,field])=><section class="africa-intro" data-africa-field-reference={id}><h3>{field.label}：{field.title}</h3><p>{field.summary}</p></section>)}
     </details>
     <details class="africa-disclosure"><summary>地図・統計の全出典と範囲・CSV</summary>
      <footer class="africa-sources"><h2>地図・統計の出典と範囲</h2>
       <p>境界：<a href="https://www.naturalearthdata.com/downloads/50m-cultural-vectors/50m-admin-0-countries-2/">Natural Earth Admin 0 Countries 1:50m</a>（public domain）。西経27度〜東経64度、南緯36度〜北緯39度を等距円筒図法で表示しています。面積を比較する地図ではありません。54か国と西サハラの境界を収録し、海外領土はこの地域区分に含みません。</p>
       <p>境界は出典の概略表現で、現在の実効支配や主権を判定するものではありません。西サハラは別の地物として表示し、モロッコの統計を転用しません。ソマリアは保存統計の対象に合わせ、出典のソマリランド地物も同じ区分に含めています。</p>
       <p>統計：世界銀行 World Development Indicators（FAO、国民経済計算、人口推計等に由来）。<a href="https://datacatalog.worldbank.org/public-licenses">CC BY 4.0・データの利用条件</a>。国境地物と統計の集計範囲は完全には一致しません。数値は改訂される場合があります。</p>
       <p>統計取得：2026年9月25日。収録年は2000〜2024年。CSVは保存したデータを使用します。欠測を補間しません。長期平均の降水量は年ごとの雨量ではありません。</p>
       <p><a href={withBase('/assets/atlas/africa/indicators.csv')} download>15指標の国別・年別データをCSVで保存</a></p>
       <details><summary>15指標の定義・出典をすべて見る</summary>{metrics.map(metric=><div class="africa-source-entry"><h3>{metric.label}（{metric.unit}）</h3><p>{metric.note}</p><a href={`https://data.worldbank.org/indicator/${metric.id}`}>{metric.id} · 世界銀行</a></div>)}</details>
      </footer>
     </details>
    </div>
    <noscript><p class="africa-noscript">JavaScriptが無効のため、同じ色の国境図を表示しています。下部の折り畳みを開くと、地域の説明・出典・15指標の定義を読めます。保存済みの国別数値はCSVから確認できます。分布の描画や、地図上の河川・都市・品目などの選択にはJavaScriptが必要です。</p></noscript>
   </article>
  </div>
 </div>
</BaseLayout>
<script>import {initializeAfricaAtlas} from '../../../scripts/atlas-africa'; initializeAfricaAtlas();</script>
