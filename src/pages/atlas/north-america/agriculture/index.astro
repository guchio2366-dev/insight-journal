---
import AtlasMap from "../../../../components/atlas/AtlasMap.astro";
import AtlasFieldNavigation from "../../../../components/atlas/AtlasFieldNavigation.astro";
import AtlasNavigation from "../../../../components/atlas/AtlasNavigation.astro";
import { agricultureField } from "../../../../data/atlas/north-america-agriculture";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { withBase } from "../../../../lib/urls";
import "../../../../styles/atlas.css";

const mapHref = "/atlas/north-america/agriculture/";
const reportHref = "/atlas/north-america/agriculture/report/";
---

<BaseLayout title={agricultureField.title} description={`${agricultureField.title}を地図から読む。${agricultureField.dataNote}`}>
  <article class="atlas-page" data-pagefind-body>
    <div class="shell atlas-page-top">
      <nav class="breadcrumb" aria-label="パンくずリスト" data-pagefind-ignore>
        <a href={withBase("/")}>ホーム</a><span aria-hidden="true">/</span>
        <a href={withBase("/atlas/")}>地図から見る</a><span aria-hidden="true">/</span>
        <a href={withBase("/atlas/north-america/")}>北米地図</a><span aria-hidden="true">/</span>
        <span aria-current="page">北米の農業</span>
      </nav>
      <AtlasFieldNavigation active="agriculture" />
      <AtlasNavigation active="map" {mapHref} {reportHref} label="北米農業" />
    </div>
    <div class="shell">
      <AtlasMap {mapHref} {reportHref} />
    </div>
  </article>
</BaseLayout>
