---
import { withBase } from '../../lib/urls';
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>地図の画面検証</title></head><body>
<header><label>画面サイズ <select id="viewport"><option value="390,844">iPhone 縦 390×844</option><option value="844,390">iPhone 横 844×390</option><option value="820,1180">iPad 縦 820×1180</option><option value="1180,820">iPad 横 1180×820</option><option value="1280,800">PC 1280×800</option></select></label><button id="measure">収まりを確認</button><output id="result"></output><p>CSSビューポート検証用。実機・Safari・タッチ端末の完全なエミュレーションではありません。</p></header>
<iframe id="atlas-device" title="端末相当サイズの地図" src={withBase('/atlas/north-america/review/')} width="390" height="844"></iframe>
<style>body{font:13px system-ui;background:#e2e6e4;margin:0;padding:12px;color:#223d45}header{padding:0 0 12px}header p{margin:5px 0}select,button{font:inherit;padding:6px}output{margin-left:12px}iframe{border:0;display:block;margin:0 auto;background:#fff;box-shadow:0 0 0 1px #81918c}body{width:max-content;min-width:100%;box-sizing:border-box}</style>
<script>
 const frame=document.querySelector<HTMLIFrameElement>('#atlas-device')!;
 const selector=document.querySelector<HTMLSelectElement>('#viewport')!;
 selector.addEventListener('change',()=>{const [w,h]=selector.value.split(',');frame.width=w;frame.height=h;frame.src=frame.src.split('?')[0];document.querySelector('#result')!.textContent='';});
 document.querySelector('#measure')!.addEventListener('click',()=>{const d=frame.contentDocument!;const w=frame.contentWindow!;const rect=d.querySelector('.atlas-workspace')!.getBoundingClientRect();const map=d.querySelector('[data-map-frame]')!.getBoundingClientRect();const nav=d.querySelector('.atlas-tabs')!.getBoundingClientRect();document.querySelector('#result')!.textContent=JSON.stringify({viewport:[w.innerWidth,w.innerHeight],horizontalOverflow:d.documentElement.scrollWidth>w.innerWidth,mapFullyVisible:map.top>=0&&map.bottom<=w.innerHeight,tabsVisible:nav.top>=0&&nav.bottom<=w.innerHeight,workspaceBottom:Math.round(rect.bottom),state:d.querySelector('[data-atlas-explorer]')?.getAttribute('data-render-state')});});
</script></body></html>
