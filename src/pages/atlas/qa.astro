---
import { withBase } from '../../lib/urls';
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>地図の画面検証</title></head><body>
<header><label>画面サイズ <select id="viewport"><option value="390,844">iPhone 縦 390×844</option><option value="844,390">iPhone 横 844×390</option><option value="820,1180">iPad 縦 820×1180</option><option value="1180,820">iPad 横 1180×820</option><option value="1280,800">PC 1280×800</option></select></label><button id="measure">収まりを確認</button><button id="reload">初期表示に戻す</button><button id="asset-error">読込失敗を試す</button><button id="context-loss">描画停止を試す</button><output id="result"></output><p>CSSビューポート検証用。実機・Safari・タッチ端末の完全なエミュレーションではありません。</p></header>
<iframe id="atlas-device" title="端末相当サイズの地図" src={withBase('/atlas/north-america/review/')} width="390" height="844"></iframe>
<style>body{font:13px system-ui;background:#e2e6e4;margin:0;padding:12px;color:#223d45}header{padding:0 0 12px}header p{margin:5px 0}select,button{font:inherit;padding:6px}output{display:block;max-width:1200px;overflow-wrap:anywhere;min-height:32px;margin-top:8px}iframe{border:0;display:block;margin:0 auto;background:#fff;box-shadow:0 0 0 1px #81918c}body{width:max-content;min-width:100%;box-sizing:border-box}</style>
<script>
 const frame=document.querySelector<HTMLIFrameElement>('#atlas-device')!;
 const selector=document.querySelector<HTMLSelectElement>('#viewport')!;
 const reviewUrl=frame.src.split('?')[0];
 const result=document.querySelector('#result')!;
 selector.addEventListener('change',()=>{const [w,h]=selector.value.split(',');frame.width=w;frame.height=h;frame.src=reviewUrl;result.textContent='';});
 document.querySelector('#reload')!.addEventListener('click',()=>{frame.src=reviewUrl;result.textContent='';});
 document.querySelector('#asset-error')!.addEventListener('click',()=>{frame.src=reviewUrl+'?qa=asset-error';result.textContent='必須データの404応答から代替図へ移ることを確認します。';});
 document.querySelector('#context-loss')!.addEventListener('click',()=>{
   const state=frame.contentDocument?.querySelector('[data-atlas-explorer]')?.getAttribute('data-render-state');
   if(state!=='ready'){result.textContent='WebGL地図が動作していないため、描画中断テストは実行できません。';return;}
   frame.contentWindow?.postMessage('atlas-qa-lose-context',location.origin);
   result.textContent='WEBGL_lose_context拡張による描画中断を要求しました。状態を再確認してください。';
 });
 document.querySelector('#measure')!.addEventListener('click',()=>{
   const d=frame.contentDocument!,w=frame.contentWindow!;
   const rect=d.querySelector('.atlas-workspace')!.getBoundingClientRect(),map=d.querySelector('[data-map-frame]')!.getBoundingClientRect(),nav=d.querySelector('.atlas-tabs')!.getBoundingClientRect();
   const labels=[...d.querySelectorAll<HTMLElement>('.atlas-geolabel')].filter(n=>!n.hidden).map(n=>({name:n.textContent,rect:n.getBoundingClientRect()}));
   const collisions=labels.flatMap((a,i)=>labels.slice(i+1).filter(b=>a.rect.left<b.rect.right&&a.rect.right>b.rect.left&&a.rect.top<b.rect.bottom&&a.rect.bottom>b.rect.top).map(b=>[a.name,b.name]));
   result.textContent=JSON.stringify({viewport:[w.innerWidth,w.innerHeight],horizontalOverflow:d.documentElement.scrollWidth>d.documentElement.clientWidth,mapFullyVisible:map.top>=0&&map.bottom<=w.innerHeight,tabsVisible:nav.top>=0&&nav.bottom<=w.innerHeight,workspaceBottom:Math.round(rect.bottom),state:d.querySelector('[data-atlas-explorer]')?.getAttribute('data-render-state'),canvasCount:d.querySelectorAll('canvas').length,labelCollisions:collisions,url:w.location.href});
 });
</script></body></html>
