---
import LatinNaturePage from '../../../components/atlas/LatinNaturePage.astro';
import LatinAmericaAgriculturePage from '../../../components/atlas/LatinAmericaAgriculturePage.astro';
import LatinIndustryPage from '../../../components/atlas/LatinIndustryPage.astro';
import LatinAmericaPopulationPage from '../../../components/atlas/LatinAmericaPopulationPage.astro';
export function getStaticPaths(){return ['agriculture','nature','industry','population'].map(field=>({params:{field},props:{field}}));}
const {field}=Astro.props;
---
{field==='nature'?<LatinNaturePage />:field==='agriculture'?<LatinAmericaAgriculturePage />:field==='industry'?<LatinIndustryPage />:<LatinAmericaPopulationPage />}
