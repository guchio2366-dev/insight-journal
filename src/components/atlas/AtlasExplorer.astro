---
import { withBase } from '../../lib/urls';
import { cropExplanations, geographicLabels, type ExplorerField } from '../../data/atlas/explorer';
import { sources, reportSections, timelineEvents } from '../../data/atlas/north-america-agriculture';
import { northAmericaFields } from '../../data/atlas/regions';
import { regionalInsights } from '../../data/atlas/regional-insights';
import { statisticCropIds } from '../../data/atlas/statistics';
import { livestockKinds, livestockRegions } from '../../data/atlas/livestock';
import AgricultureRelations from './AgricultureRelations.astro';
import AgricultureRelationFallback from './AgricultureRelationFallback.astro';
import { agricultureRelations } from '../../data/atlas/agriculture-relations';
import NationalAgricultureSummary from './NationalAgricultureSummary.astro';
import LivestockReading from './LivestockReading.astro';
import CropStatistics from './CropStatistics.astro';
import ConditionText from './ConditionText.astro';
import NatureViewNavigation from './NatureViewNavigation.astro';
import ClimateOverview from './ClimateOverview.astro';
import ClimateStaticCodes from './ClimateStaticCodes.astro';
import NaturalEnvironmentSummary from './NaturalEnvironmentSummary.astro';
import PopulationNavigation from './PopulationNavigation.astro';
import PopulationMapReading from './PopulationMapReading.astro';
import PopulationNationalSummary from './PopulationNationalSummary.astro';
import PopulationReading from './PopulationReading.astro';
import IndustryNavigation from './IndustryNavigation.astro';
import IndustryNationalSummary from './IndustryNationalSummary.astro';
import IndustrySelectedExplanation from './IndustrySelectedExplanation.astro';
import IndustryReading from './IndustryReading.astro';
import IndustryInsights from './IndustryInsights.astro';
import IndustryNoScript from './IndustryNoScript.astro';
import {industryRegions,industrySources} from '../../data/atlas/industry-regions';
import {industrySectors,subsectorLabel} from '../../data/atlas/industry-catalog';
import { climateCities, climateFamilies, natureFeatureCopy, natureLabels, natureModes, natureSources, type NatureMode } from '../../data/atlas/natural-environment';
import climateCodeLabels from '../../data/atlas/climate-code-labels.json';

interface Props { initialField?: ExplorerField }
const { initialField='overview' } = Astro.props;
const assetBase = withBase('/assets/atlas/v3/');
const livestockAssetBase=withBase('/assets/atlas/livestock/v2/');
const populationAssetBase=withBase('/assets/atlas/population/v1/');
const natureAssetBase = withBase('/assets/atlas/nature-v1/');
const reviewMode = Astro.url.pathname.includes('/review/');
const requestedMode=Astro.url.pathname.includes('/land/')?'landform':'climate';
const initialMode=(natureModes.some(mode=>mode.id===requestedMode)?requestedMode:'climate') as NatureMode;
const fallbackName=initialField==='population'?'density.webp':initialField==='agriculture'?'agriculture-fallback.webp':initialField==='natural'?`${initialMode}-fallback.webp`:'land-fallback.webp';
const payload = JSON.stringify({ initialField, initialMode, populationAssetBase, agricultureRelations, assetBase, natureAssetBase, livestockAssetBase, livestockKinds, livestockRegions, industryRegions, industrySources, reviewMode, base: withBase('/atlas/north-america/'), crops:cropExplanations, regionalInsights, statisticCropIds, geographicLabels, climateCities, climateCodeLabels, natureModes, natureLabels, natureFeatureCopy }).replace(/</g,'\\u003c');
---
<article class="atlas-explorer" data-atlas-explorer data-field={initialField} data-nature-mode={initialMode} data-pagefind-body={reviewMode?undefined:true} data-pagefind-ignore={reviewMode?'all':undefined}>
  <section class="atlas-workspace" aria-label="北米の分野別地図">
    <div class="atlas-compact-heading">
      <nav aria-label="パンくずリスト"><a href={withBase('/atlas/')}>地図から見る</a><span aria-hidden="true"> / </span><a href={withBase('/atlas/north-america/')}>北米地図</a></nav>
      <span>米国本土</span>
    </div>
    <h1 class="visually-hidden">北米地図から読む、農業・自然環境・主要産業・人口</h1>
    <nav class="atlas-tabs" aria-label="地図の分野">
      {northAmericaFields.map(field => field.status==='ready' ?
        <a href={withBase(field.href)} data-field={field.id} aria-current={initialField===field.id?'page':undefined}>{field.label}</a> :
        <span class="atlas-tab-planned" aria-label={`${field.label}、準備中`}>{field.label}<small>準備中</small></span>
      )}
    </nav>
    <NatureViewNavigation {initialMode} active={initialField==='natural'} />
    {initialField==='industry'&&<noscript><style is:global>.atlas-explorer [data-industry-detail][hidden]{display:block!important}.atlas-explorer [data-industry-detail]{margin-bottom:30px}.industry-controls,.industry-key>details{display:none!important}#industry-description[hidden],[data-industry-description-panel][hidden]{display:block!important}#industry-description{position:static!important;height:auto!important}</style></noscript>}
    <IndustryNavigation active={initialField==='industry'} />
    <PopulationNavigation active={initialField==='population'} />

    <div class="atlas-primary-grid" id="nature-map-panel" data-map-panel role={initialField==='natural'?'tabpanel':'group'} aria-labelledby={initialField==='natural'?`nature-tab-${initialMode}`:undefined}>
      <div class="atlas-map-column">
        <div class="atlas-map-frame" data-map-frame>
          <div class="atlas-map-surface" data-map-surface tabindex="0" aria-describedby="atlas-map-description" aria-label="拡大縮小できる米国本土地図"></div>
          <div class="atlas-fallback" data-fallback>
            <div class="atlas-fallback-map"><img src={initialField==='population'?`${populationAssetBase}${fallbackName}`:initialField==='natural'?`${natureAssetBase}${fallbackName}`:`${assetBase}${fallbackName}`} width="1800" height="1084" alt={initialField==='population'?'米国本土の人口密度（ACS 2020–2024）。下の説明で表示方法を確認できます。':initialField==='agriculture'?'米国本土の地形・河川と、州境をまたぐ主要作物の栽培分布。下の作物別解説でも内容を読めます。':initialField==='natural'?'米国本土の自然環境。気候区分、水資源、地形、標高を切り替えて読めます。':'米国本土の地形と水系。西部に山地、中央に平原、東部にアパラチア山脈が続きます。'} data-fallback-image /><img class="atlas-fallback-livestock" src={`${livestockAssetBase}agriculture-livestock-fallback.svg`} width="1800" height="1084" alt="主要な畜産集積地域の代表点。" data-fallback-livestock hidden={initialField!=='agriculture'} />{initialField==='industry'&&<IndustryNoScript map />}<AgricultureRelationFallback />{initialField==='natural'&&initialMode==='climate'&&<ClimateStaticCodes />}</div>
            <p><span data-fallback-status>代替図を表示しています。</span> <a href={`${initialField==='population'?populationAssetBase:initialField==='natural'?natureAssetBase:assetBase}${fallbackName}`} data-fallback-full target="_blank" rel="noopener">図を拡大</a> <button type="button" data-retry-nature hidden>再試行</button></p>
          </div>
          <div class="atlas-map-labels" data-map-labels aria-hidden="true"></div>
          <div class="atlas-nature-labels" data-nature-labels hidden></div>
          <div class="atlas-nature-labels" data-water-labels hidden></div>
          <div class="atlas-livestock-markers" data-livestock-markers></div>
          <div class="industry-markers" data-industry-markers hidden={initialField!=='industry'}></div>
          <div class="atlas-nature-labels population-city-markers" data-pop-city-markers hidden={initialField!=='population'}></div>
          <div class="atlas-nature-labels population-religion-markers" data-pop-religion-markers hidden></div>
          <fieldset class="atlas-agri-layers" data-agri-layers hidden={initialField!=='agriculture'}><legend class="visually-hidden">農業地図の表示</legend><label><input type="checkbox" value="crops" data-agri-layer checked />作物</label><label><input type="checkbox" value="livestock" data-agri-layer checked />畜産</label></fieldset>
          <div class="atlas-map-tools" aria-label="地図操作" hidden>
            <button type="button" data-map-action="fit" aria-label="米国本土の全体を表示">全体</button>
            <button type="button" data-map-action="in" aria-label="地図を拡大">＋</button>
            <button type="button" data-map-action="out" aria-label="地図を縮小">−</button>
          </div>
          <p class="atlas-layer-caption" data-layer-caption>{initialField==='agriculture'?'主要栽培域 · 2023年の衛星分類から概略化':initialField==='natural'?natureModes.find(mode=>mode.id===initialMode)?.caption:'地形・水系'}</p>
          <div class="atlas-selection" data-selection id="atlas-selection" hidden role="region" aria-labelledby="atlas-selection-title">
            <button type="button" class="atlas-selection-close" data-close-selection aria-label="選択した地域の説明を閉じる">×</button>
            <span class="atlas-selection-kicker" data-selection-kicker>選択地域</span><strong id="atlas-selection-title" data-selection-title></strong><p data-selection-text></p>
            <div class="atlas-relation-warning" data-relation-warning hidden><p data-relation-warning-text></p><button type="button" data-enable-relation-layers>必要な層を表示して比較</button></div>
            <div class="atlas-selection-candidates" data-selection-candidates hidden></div>
            <button class="atlas-focus-selection" type="button" data-focus-selection hidden>選択地点へ</button><a href="#crop-details" data-selection-link>↓ 作物の詳説へ</a>
          </div>
        </div>
        <div class="atlas-key" data-crop-key hidden={initialField!=='agriculture'} aria-label="栽培域の凡例">
          <span class="agri-picker-group" id="agri-crop-picker"><strong>作物</strong>{cropExplanations.map(c=><a href={`#crop-${c.id}`} style={`--crop-color:${c.color}`} data-crop-select={c.id}><i aria-hidden="true"></i>{c.name}</a>)}</span>
          <span class="atlas-overlap-key"><i aria-hidden="true"></i>重なり</span>
          <span class="atlas-livestock-key agri-picker-group" data-livestock-key id="agri-livestock-picker"><strong>畜産</strong>{livestockKinds.map(k=><a href={`#livestock-${k.id}`} style={`--livestock-color:${k.color}`}><i aria-hidden="true">{k.symbol}</i>{k.label}</a>)}</span>
        </div>
        <p class="atlas-context-key" data-land-key hidden={initialField!=='overview'}>地形陰影・河川・湖・州境。自然環境では気候・水・地形・標高を切り替えられます。</p>
        <div class="atlas-water-key" data-water-key hidden></div>
        <div class="atlas-nature-key" data-nature-key hidden={initialField!=='natural'}>
          <div data-nature-key-panel="climate" hidden={initialMode!=='climate'}>{climateFamilies.map(item=><span>{item.id} {item.label}</span>)}<span><b class="atlas-city-dot"></b>雨温図の都市</span></div>
          <div data-nature-key-panel="water" hidden={initialMode!=='water'}><span><i class="atlas-aquifer-key"></i>主要帯水層</span><span><b class="atlas-river-line"></b>河川・湖</span><span><b class="atlas-reservoir-dot"></b>貯水池</span></div>
          <div data-nature-key-panel="landform" hidden={initialMode!=='landform'}><span><i class="atlas-relief-key"></i>地形陰影</span><span>名称は地形の概略域</span></div>
          <div data-nature-key-panel="contour" hidden={initialMode!=='contour'}><span><b class="atlas-contour-line"></b><span data-contour-index>主要線 1,000 m</span></span><span><b class="atlas-contour-line is-light"></b><span data-contour-secondary>補助線 500 m</span></span></div>
          <p><span class="is-cold">↓ カリフォルニア海流（寒流）</span><span class="is-warm">メキシコ湾流（暖流） ↗</span></p>
        </div>
        <p class="atlas-nature-guide" data-nature-guide hidden></p>
        <a class="atlas-nature-jump" data-nature-jump href="#nature-feature-heading" hidden>選んだ対象の解説へ</a>
        <PopulationMapReading active={initialField==='population'} />
        <div class="atlas-selection-slot" data-selection-slot></div>
        <a class="atlas-city-jump" data-city-jump href="#city-climate-heading" hidden>都市の雨温図へ</a>
        <p class="visually-hidden" id="atlas-map-description">地図の内容は下の解説でも読めます。タッチ操作は２本指で地図を動かします。</p><p class="visually-hidden" data-atlas-live aria-live="polite" aria-atomic="true"></p>
        <div data-agriculture-relations-host hidden={initialField!=='agriculture'}><AgricultureRelations /></div>
        <div class="industry-key" data-industry-key hidden={initialField!=='industry'}>
          <p>{industrySectors.filter(s=>s.id!=='all').map(s=><span><i style={`--industry-color:${s.color}`}>{s.symbol}</i>{s.label}</span>)}</p>
          <p data-industry-size-note>記号は代表地域。同じ条件で数値を比べられる分野のみ、円の面積で経済規模を示します。この表示では同サイズです。</p>
          <p>サービスの記号：金＝金融、情＝情報、専＝専門、商＝商業・物流、観＝宿泊・飲食等、医＝医療・教育、他＝その他。複＝複数分野。</p>
          <div class="industry-economic-legend" data-industry-economic-legend hidden></div>
          <p data-industry-empty hidden>この分野の地域例は未登録です。右欄の説明と下の全国推移を確認できます。</p>
          <details><summary>地域一覧から選ぶ</summary><div class="industry-region-list">{industryRegions.map(r=><button type="button" data-industry-region-option={r.id}>{r.name}<small>{subsectorLabel(r.sector,r.subsector)}</small></button>)}</div></details>
          <noscript><p>業態の切替と地図の地域表示にはJavaScriptが必要です。全産業の統計とインサイトはこのまま読めます。</p></noscript>
        </div>
        <IndustryInsights active={initialField==='industry'} />
      </div>

      <div data-field-national="agriculture" hidden={initialField!=='agriculture'}><div data-agri-overview><NationalAgricultureSummary /></div>
        <section class="agri-reading-panel" data-agri-reading-panel hidden aria-labelledby="agri-reading-heading">
          <header><button type="button" data-agri-overview-button>← 米国の農業</button><h2 id="agri-reading-heading" tabindex="-1"></h2></header>
          <div class="agri-reading-body" data-agri-reading-body>
            <div data-agri-reading-content></div>
            <details data-agri-region hidden><summary></summary><p></p></details>
            <div data-agri-candidates hidden></div>
            <div class="atlas-relation-warning" data-agri-layer-warning hidden><p></p><button type="button" data-agri-enable-layers>必要な層を表示して比較</button></div>
          </div>
        </section>
      </div>
      <div data-field-national="natural" hidden={initialField!=='natural'}><NaturalEnvironmentSummary {initialMode} /></div>
      <div data-field-national="population" hidden={initialField!=='population'}><PopulationNationalSummary /></div>
      <div class="industry-map-reading" data-field-national="industry" hidden={initialField!=='industry'}><IndustrySelectedExplanation /><IndustryNationalSummary /></div>
      <aside class="atlas-national atlas-land-summary" data-field-national="overview" hidden={initialField!=='overview'}>
        <header><p class="atlas-eyebrow">GEOGRAPHIC BASE</p><h2>米国本土の地形</h2><p>西部の山地、中央の大平原と低地、東部のアパラチア山脈を共通の土台にします。農業へ切り替えると、同じ位置・倍率のまま栽培域を重ねて比較できます。</p></header>
        <p>河川と湖は水利用や輸送を考える手掛かりです。現在の土地レイヤーは地形・水系の概略であり、土壌や地質の分類ではありません。</p>
      </aside>
      <ClimateOverview visible={initialField==='natural'&&initialMode==='climate'} />
    </div>
    <section data-field-content="agriculture" hidden={initialField!=='agriculture'}>
      <div class="agri-statistics" data-agri-statistics hidden><h2 data-agri-statistics-heading></h2><div data-agri-statistics-panels></div></div>
    </section>
  </section>

  <div class="atlas-reading" id="atlas-details">
    <p class="atlas-evidence-note">米国本土が主対象です。地図の色・線・点は表示ごとに意味が異なり、面積や水量を直接表すものではありません。<a href="#atlas-method">出典・加工方法</a></p>
    <section data-field-content="overview" hidden={initialField!=='overview'}>
      <h2 id="land-conditions">土地を読む</h2>
      <p>西部の山地と盆地、中央の大平原・低地、東部の山地を共通の土台にします。「農業」へ切り替えると、同じ場所に栽培域が重なります。地形と水の条件に、気候、灌漑、加工・輸送、市場が加わって農業地域が形成されます。</p>
      <p>地形の陰影はNatural Earthの地理座標付きラスタから作成しました。山地・平原の地域区分もNatural Earthの地誌的な概略で、地質境界・土壌の分類ではありません。</p>
    </section>
    <section data-field-content="natural" hidden={initialField!=='natural'}>
      <h2 id="natural-conditions">自然環境を読み比べる</h2>
      <p>米国本土では、太平洋から来る空気が西部の高い山地を越える過程で水分を失い、内陸西部に乾燥域が広がります。ロッキー山脈の東には広い平原が続き、東へ進むにつれてメキシコ湾・大西洋からの水分の影響が強まります。東部のアパラチア山脈はロッキーより低いものの、局地的な降水と河川の流れをつくる地形です。</p>
      <p>長期平均の気候区分だけでは、年ごとの災害や季節差は分かりません。春の大平原では強い雷雨や竜巻、夏から秋の湾岸・東海岸ではハリケーン、南西部では夏のモンスーンに伴う雨が起こります。西部では冬の雨や山地の積雪が、その後の河川・貯水池・灌漑用水につながります。</p>
      <p>土壌の保水性・排水性や塩類の蓄積も、水の利用しやすさに関わります。土壌中の水と、井戸でくみ上げる帯水層の地下水は同じものとして扱いません。カリフォルニア海流は西岸沖を南へ、暖かいメキシコ湾流は南東岸から北東へ流れます。西岸では風が表層の海水を沖へ運ぶと、冷たく栄養分に富む深い水が上がる沿岸湧昇が起こります。湧昇の強さには季節差があります。</p>
      <div class="atlas-nature-reading-grid">
        <section><h3>気候区分と雨温図</h3><p>ケッペン＝ガイガー区分は月ごとの気温・降水の長期的な組合せを分類します。都市の雨温図は一点の観測所の平年値であり、色面全体の代表値ではありません。</p></section>
        <section><h3>水資源</h3><p>河川・湖・貯水池と地下水を分け、地元の雨、山地の融雪、貯水、取水がどのようにつながるかを読みます。</p></section>
        <section><h3>地形と標高</h3><p>地形では山脈・高原・平原の広がりを、等高線では共通のメートル基準による高さを確かめます。同じ「山脈」でもロッキーとアパラチアの高さは大きく異なります。</p></section>
      </div>
    </section>
    <section data-field-content="agriculture" hidden={initialField!=='agriculture'}>
      <p class="industry-return" data-industry-return hidden><a href={withBase('/atlas/north-america/industry/')} data-industry-return-link>主要産業の選択へ戻る</a></p>
      <CropStatistics />
      <LivestockReading />
      {cropExplanations.filter(c=>c.id==='specialty').map(c=><article id="crop-specialty" data-agri-extra-copy="specialty" class="atlas-crop-copy"><h3>{c.name}</h3>{c.paragraphs.map(paragraph=><ConditionText {paragraph} />)}<p><strong>主な用途</strong> {c.uses}</p><p>{c.sources.map(id=><a href={`#${id}`}>{sources.find(source=>source.id===id)?.publisher} </a>)}</p><p>複数品目のため、この区分の共通統計は未収録</p></article>)}
      <article data-agri-extra-copy="corn-soybean" class="atlas-crop-copy"><h3>とうもろこし・大豆の重なり</h3><p>近い地域で両方の作物がまとまります。この図だけでは、同じ畑の輪作や同時栽培は判定できません。</p><p><a href="#crop-corn">とうもろこし</a> ／ <a href="#crop-soybean">大豆</a></p></article>
      <details class="atlas-context-reading"><summary>北米農業の背景をさらに読む</summary>
        {reportSections.filter(s=>s.id!=='crop-conditions').map(s=><section id={s.id}><h3>{s.title}</h3>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}
      </details>
      <section id="atlas-news"><h3>ニュースと年表</h3>{timelineEvents.length===0?<p>関連する公開記事はまだありません。記事が追加されたら、発生地・影響範囲・報道日を分けて結びつけます。</p>:<ol>{timelineEvents.map(e=><li>{e.dateLabel} {e.title}</li>)}</ol>}</section>
    </section>
    <section data-field-content="population" hidden={initialField!=='population'}><PopulationReading /></section>
    <section data-field-content="industry" hidden={initialField!=='industry'}><IndustryReading />{initialField==='industry'&&<IndustryNoScript />}</section>
    <section class="atlas-method" id="atlas-method">
      <h2>出典と表示方法</h2>
      <p>分布間の関係はUSDAの生産構造資料に基づく事前執筆の解説です。強調は既存の地理図形・代表点を使い、地図上の近接を数量的な因果や飼料の調達率へ換算していません。代替図の輪郭も同じ緯度経度をWebメルカトルへ変換しています。</p>
      <p>供給元と行き先はUSDA WASDE-675（2026年9月11日公表）の2024/25販売年度。国内生産・輸入・期首在庫と、排他的な国内用途・輸出・期末在庫を同じ単位で検算しました。米は原表の籾米換算を維持し、精米換算の輸出先図と混ぜていません。</p>
      <p>農業：USDA NASS「Cropland Data Layer 2023」。約2km間隔で衛星分類を抽出し、周辺の分布を平滑化して主要なまとまりを表示しています。分類誤差・間引き誤差があり、小さな産地や薄い分布は省略しています。生産量や面積の計算には使えません。</p>
      <p>地形・河川・湖・国境：Natural Earth 5.1.2、縮尺1:5,000万。州境は既存の1:1億1,000万データを再利用。陰影はNatural Earth I 3.2.0。全レイヤーを緯度経度にそろえ、画面上はWebメルカトルで表示しています。面積の見た目を数量比較に使わないでください。</p>
      <p>地域説明は、タップ位置と作物に対応する査読済み原稿を選ぶための概略範囲を使います。その範囲自体は地図に描かず、栽培面積や気候境界として扱いません。<a href={`${assetBase}manifest.json`}>地図データの対象年・加工条件</a></p>
      <p>畜産：USDA NASS「2022 Census of Agriculture」の郡別分布と公的資料から主要集積地域を確認し、説明用の代表点として表示しています。記号は農場の所在地、地域境界、頭・羽数の大小を示しません。</p>
      <ul>{sources.map(s=><li id={s.id}><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a><span> — {s.publisher}</span></li>)}</ul>
      <p>自然環境：気候区分はBeck et al. (2023) を示すkoppen.earth配信の1991–2020年スナップショットです（V3と同定していません）。分類格子を最近傍で投影し、米国陸域を抽出しました。色・地図内コード・都市分類は同じ格子を参照します。雨温図は同期間のNOAA観測所平年値で、分類格子とはデータ源が異なります。帯水層はUSGS Ground Water Atlas由来、等高線はUSGS 3DEPを500m格子で抽出した全国比較用の500m間隔です。拡大しても同じ線を表示します。鉛直基準はNAVD88、線の間隔は標高精度を意味しません。海流線は模式表示で、流速や日々の位置を示しません。<a href={`${natureAssetBase}manifest.json`}>自然環境データの取得・加工記録</a></p>
      <p>代表的な最高峰：ロッキーのエルバートは約4,400m（<a href="https://www.fs.usda.gov/r02/psicc/recreation/trails/north-mount-elbert-trail-1484">米国森林局の14,433フィート表記</a>から概数）、アパラチアのミッチェルは約2,037m（<a href="https://www.ncparks.gov/state-parks/mount-mitchell-state-park">州立公園の6,684フィート</a>から換算）。山脈の平均標高や間引いたDEMの最高値ではありません。</p>
      <ul>{natureSources.map(s=><li id={s.id}><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a><span> — {s.publisher}</span></li>)}</ul>
