---
import LatinAmericaWorkspace from './LatinAmericaWorkspace.astro';
import population from '../../data/atlas/latin-america/population.json';
import {latinPopulationOriginalTopics} from '../../data/atlas/latin-america/population-reading';
import {latinPopulationValue} from '../../lib/atlas-latin-america-population';
import {renderLatinUrbanMap} from '../../lib/atlas-latin-reading-population';
import {renderLatinCultureMap} from '../../lib/atlas-latin-reading-culture';
import {latinUrbanSource,latinUrbanPopulations} from '../../data/atlas/latin-america/urban-population-2018';
import {latinCultureCoverage,latinCultureNational,latinCultureGroups,latinCultureRegions,chileIdentitySource,chileReligionSource,chileCultureLicense} from '../../data/atlas/latin-america/culture-reading';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-latin-america-population.css';
const assets=withBase('/assets/atlas/latin-america-population-v2');
const spatialAssets=withBase('/assets/atlas/latin-america-population-v1');
---
<LatinAmericaWorkspace field="population" title="人口の分布から読む中南米" lead="都市集積域の人数と、仕事・交通による人口集中を読む。">
 <Fragment slot="map">
  <div class="latin-reading-controls"><label>地図の範囲<select data-lp-scope-select><option value="all">中南米全体</option><option value="central">中米・カリブ</option><option value="south">南米</option></select></label><label data-lp-layer-label>人口の表示<select data-lp-layer-select><option value="urban">都市集積域の人数・2018</option><option value="spatial">居住人口密度・2020</option></select></label></div>
  <h2 class="latin-map-reading-heading" data-lp-map-heading>都市集積域の人数・2018年</h2>
  <div data-latin-section-panel="population"><div data-lp-target-map set:html={renderLatinUrbanMap()} /></div>
  <div data-latin-section-panel="ethnicity" hidden><div data-lc-map="ethnicity" set:html={renderLatinCultureMap('ethnicity')} /></div>
  <div data-latin-section-panel="religion" hidden><div data-lc-map="religion" set:html={renderLatinCultureMap('religion')} /></div>
  <div class="lp-legend" data-lp-target-legend><p>円の面積＝都市集積域の人口・2018年。7都市を収録。国の人数や密度格子の人数ではありません。</p></div>
  <p class="latin-caption" data-lp-status aria-live="polite">国連WUP2018。都市域の定義は国ごとに異なります。2026年の現在人口ではありません。</p>
 </Fragment>
 <Fragment slot="reading">
  <h2 data-lp-reading-title>沿岸・河川・高地の都市への人口集中</h2>
  <p class="latin-takeaway" data-lp-overview>サンパウロ、リオデジャネイロ、ブエノスアイレスなどの都市集積域に1,000万人を超える人口が集まります。リマは乾燥した海岸、ボゴタは高原にあり、気候だけで人口の集まり方は決まりません。</p>
  <div data-lp-reading-body><h3>解説：仕事と交通が集積を支える</h3><p>港と道路、行政・工業・サービスの仕事が都市の集積を支えます。大陸内陸や高地にも都市があり、「沿岸だけに住む」とは読めません。</p><p>{latinUrbanSource.definition}</p></div>
 </Fragment>
 <Fragment slot="statistics">
  <h2>都市集積域の採用人数・2018年</h2><p>{latinUrbanSource.definition}</p><div class="latin-table-scroll"><table><thead><tr><th>都市集積域</th><th>2018年・人</th></tr></thead><tbody>{latinUrbanPopulations.map(city=><tr><th>{city.name}</th><td>{city.population.toLocaleString('ja-JP')}</td></tr>)}</tbody></table></div><p><a href={latinUrbanSource.url}>{latinUrbanSource.title}</a>（PDF pp.98–99、{latinUrbanSource.license}）。千人から人への変換・日本語名はInsight Journal。都市集積域の境界図形は未収録。</p>
  <h2>民族関連・宗教の採用値と収録範囲</h2><p>{latinCultureCoverage}</p>{(['ethnicity','religion'] as const).map(section=><details><summary>{section==='ethnicity'?'民族関連の別設問':'宗教・信条'}の原表抜粋</summary>{latinCultureNational[section].map(row=><article><h3>{row.name}・{row.year}年全国</h3><p>{row.denominator}</p><ul>{row.values.map((value,i)=><li>{latinCultureGroups[section][i].name}：{value.toLocaleString('ja-JP')}人（原表 {row.percentages[i]}%）</li>)}</ul><p><a href={row.source}>国勢調査原典</a> · <a href={row.licenseUrl}>{row.license}</a>。Insight Journalによる抜粋・日本語表示。値の合計・残差から新しい分類を作りません。</p></article>)}<table><caption>チリ2024・代表6州の公表人数。民族関連は全年齢・各設問回答者、宗教は15歳以上・信条設問回答者。</caption><thead><tr><th>州</th>{latinCultureGroups[section].map(group=><th>{group.name}・人</th>)}</tr></thead><tbody>{latinCultureRegions.map(region=><tr><th>{region.name}</th>{(section==='ethnicity'?region.identity:region.religion).map(value=><td>{value.toLocaleString('ja-JP')}</td>)}</tr>)}</tbody></table><p><a href={section==='ethnicity'?chileIdentitySource:chileReligionSource}>チリINE Censo2024原典</a>、民族pp.9・11、宗教pp.14・16・17。<a href={chileCultureLicense.url}>CC BY-SA4.0</a>、当サイトの抽出・日本語加工も同ライセンスで配信。</p></details>)}
 </Fragment>
 <Fragment slot="sources">
  <h2>国・地域の値と、国内の居住分布を確かめる</h2>
  <details class="lp-country-table" data-lp-country-table open><summary>全34国・地域の人口・密度・都市化率</summary><div class="latin-table-scroll"><table><caption>2023年の世界銀行公表値。人数は人、密度は人/陸地km²、都市化率は%。欠測・対象統計なしは0に置換しません。</caption><thead><tr><th scope="col">国・地域</th><th scope="col">人口（人）</th><th scope="col">密度</th><th scope="col">都市化率</th></tr></thead><tbody>{population.countries.map(row=><tr data-lp-row={row.countryCode}><th scope="row">{row.nameJa}<span lang="en">{row.name}・{row.countryCode}</span></th><td>{latinPopulationValue(row.population,row.populationStatus)}</td><td>{latinPopulationValue(row.density,row.densityStatus,1)}</td><td>{latinPopulationValue(row.urbanShare,row.urbanShareStatus,1)}</td></tr>)}</tbody></table></div></details>
  <details class="lp-spatial-detail"><summary>補助密度図の2020年推計・粒度・欠測を確かめる（GHSL）</summary><p>国平均の2023年密度と、国内の居住密度分布を読む2020年推計は別の年・尺度です。欧州委員会JRC・GHS-POP R2023Aの1km人口推計を10km等積格子に集計。表示は約14kmで小さな集落が平滑化され、小島や海岸は省略されることがあります。街区ごとの実測人数ではありません。</p><p>単位：人/km²。分母は有効な元人口セルの面積で、国別統計の陸地面積とは異なります。0は有効な0、透明部分は欠測・対象外。メルカトル画像のセル数から人口を足し上げません。表示格子は既存の配信原値をそのまま照会します。</p><p><a href={`${spatialAssets}/latin-america.grid.json`}>2020年の配信格子値</a> ／ <a href={`${spatialAssets}/manifest.json`}>加工・配信値・利用条件台帳</a> ／ <a href={`${spatialAssets}/source-inputs.json`}>42元タイルの原典とSHA256</a></p></details>
  <details class="lp-original-readings"><summary>都市・河川・中米・カリブの地域解説</summary>{latinPopulationOriginalTopics.map(topic=><details><summary>{topic.title}</summary><p>{topic.summary}</p>{topic.sections.map(section=><div><h3>{section.title}</h3><p>{section.body}</p></div>)}<ul>{topic.sources.map(source=><li><a href={source.url}>{source.label}</a>{source.period?`（${source.period}）`:''}</li>)}</ul></details>)}</details>


  <details><summary>原典・加工・配信値・利用条件</summary><ul>{population.sources.map(source=><li><a href={source.apiUrl}>世界銀行API：{source.indicator}（2023年を採用）</a> ／ <a href={source.metadataUrl}>個別指標の定義と利用条件</a>。API更新：{source.apiLastUpdated}。</li>)}<li>3指標それぞれの公式メタデータにCC BY4.0を指定。世界銀行・元指標提供機関を出典とし、対象・年の抽出、日本語名、表示丸め、地図表示はInsight Journalが加工。</li><li>国境：Natural Earth。人口密度は国境面積から再計算していません。</li><li><a href={`${assets}/countries-2023.csv`}>採用値CSV</a> ／ <a href={`${assets}/countries-2023.json`}>採用JSON</a> ／ <a href={`${assets}/manifest.json`}>原典レスポンス・個別メタデータ・加工・SHA256台帳</a></li></ul></details>
  <details class="lp-ghsl-citation"><summary>GHSL補助密度図の元データ・参考論文</summary><p>2020年の補助密度図の元データ：欧州委員会JRC、<a href="https://human-settlement.emergency.copernicus.eu/ghs_pop2023.php">GHS-POP R2023A</a>。1km人口格子を10kmの等積格子に集約した図です。2023年国別統計と年・目的が異なります。</p><p>GHSLの方法と検証の参考論文：<a href="https://doi.org/10.1080/17538947.2024.2390454">Pesaresi et al. (2024)、DOI: 10.1080/17538947.2024.2390454</a>。元データの採用年・加工・配信値は補助密度図の台帳で確認できます。</p></details>
 </Fragment>
 <script>import {initLatinReadingPopulation} from '../../scripts/atlas-latin-reading-population';const init=()=>document.querySelectorAll<HTMLElement>('[data-latin-field="population"]').forEach(initLatinReadingPopulation);init();document.addEventListener('astro:page-load',init);</script>
</LatinAmericaWorkspace>
