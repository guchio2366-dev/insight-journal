---
import LatinAmericaWorkspace from './LatinAmericaWorkspace.astro';
import population from '../../data/atlas/latin-america/population.json';
import {latinPopulationOriginalTopics} from '../../data/atlas/latin-america/population-reading';
import {latinPopulationValue} from '../../lib/atlas-latin-america-population';
import {renderLatinUrbanMap,renderLatinPopulationDotLegend} from '../../lib/atlas-latin-reading-population';
import {renderLatinCulturePatterns as renderLatinCultureMap} from '../../lib/atlas-latin-culture-patterns';
import {religionSurvey,pewReligionSource,pewTranslationNotice} from '../../data/atlas/latin-america/culture-distributions';
import {geographicRegions,geographicSources,geographicLedger} from '../../data/atlas/latin-america/culture-geographic-distributions';
import {majorAreas,majorSources} from '../../data/atlas/latin-america/culture-major-compositions';
import {latinCountryName} from '../../lib/atlas-latin-america-geometry';
import {latinCultureSupplementReading} from '../../lib/atlas-latin-culture-supplement';
import {latinUrbanSource,latinUrbanPopulations} from '../../data/atlas/latin-america/urban-population-2018';
import {latinCultureCoverage,latinCultureNational,latinCultureGroups,latinCultureRegions,chileIdentitySource,chileReligionSource,chileCultureLicense} from '../../data/atlas/latin-america/culture-reading';
import {latinCultureSupplements} from '../../data/atlas/latin-america/culture-supplement-2018';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-latin-america-population.css';
const assets=withBase('/assets/atlas/latin-america-population-v2');
const spatialAssets=withBase('/assets/atlas/latin-america-population-v1');
---
<LatinAmericaWorkspace field="population" title="人口の分布から読む中南米" lead="都市集積域の人数と、仕事・交通による人口集中を読む。">
 <Fragment slot="map">
  <div class="latin-reading-controls"><label>地図の範囲<select data-lp-scope-select><option value="all">中南米全体</option><option value="central">中米・カリブ</option><option value="south">南米</option></select></label><label data-lp-layer-label>人口の表示<select data-lp-layer-select><option value="urban">人口集中の点表示・2020</option><option value="spatial">居住人口密度・2020</option></select></label></div>
  <h2 class="latin-map-reading-heading" data-lp-map-heading>人口集中の点表示・2020年</h2>
  <div data-latin-section-panel="population"><div data-lp-target-map set:html={renderLatinUrbanMap()} /></div>
  <div data-latin-section-panel="ethnicity" hidden><div data-lc-map="ethnicity" set:html={renderLatinCultureMap('ethnicity')} /></div>
  <div data-latin-section-panel="religion" hidden><div data-lc-map="religion" set:html={renderLatinCultureMap('religion')} /></div>
  <div class="lp-legend" data-lp-target-legend set:html={renderLatinPopulationDotLegend()}/>
  <p class="latin-caption" data-lp-status aria-live="polite">地図はGHSL2020の推計密度。都市選択の人数は国連WUP2018の別資料で、2026年の現在人口ではありません。</p>
 </Fragment>
 <Fragment slot="reading">
  <h2 data-lp-reading-title>沿岸・河川・高地の都市への人口集中</h2>
  <p class="latin-takeaway" data-lp-overview>サンパウロ、リオデジャネイロ、ブエノスアイレスなどの都市集積域に1,000万人を超える人口が集まります。リマは乾燥した海岸、ボゴタは高原にあり、気候だけで人口の集まり方は決まりません。</p>
  <div data-lp-reading-body><h3>解説：仕事と交通が集積を支える</h3><p>港と道路、行政・工業・サービスの仕事が都市の集積を支えます。大陸内陸や高地にも都市があり、「沿岸だけに住む」とは読めません。</p><p>{latinUrbanSource.definition}</p></div>
 </Fragment>
 <Fragment slot="statistics">
  <h2>都市集積域の採用人数・2018年</h2><p>{latinUrbanSource.definition}</p><div class="latin-table-scroll"><table><thead><tr><th>都市集積域</th><th>2018年・人</th></tr></thead><tbody>{latinUrbanPopulations.map(city=><tr><th>{city.name}</th><td>{city.population.toLocaleString('ja-JP')}</td></tr>)}</tbody></table></div><p><a href={latinUrbanSource.url}>{latinUrbanSource.title}</a>（PDF pp.98–99、{latinUrbanSource.license}）。千人から人への変換・日本語名はInsight Journal。都市集積域の境界図形は未収録。</p>
  <h2 id="latin-culture-statistics">民族・宗教の地図と、詳しい統計・資料</h2>
  <details data-lc-geographic-method><summary>地図に採用した実地域・値・原分類</summary>{(['ethnicity','religion'] as const).map(section=><details><summary>{section==='ethnicity'?'民族・人種':'宗教'}の地域別資料</summary>{geographicRegions[section].map(r=><article><h3>{latinCountryName(r.country)}・{r.name}・{r.year}年</h3><p>{r.denominator}</p><p>{r.note}</p><ul>{r.values.map(v=><li>{v.native}：{v.percent===null?'地理記述の概略':`${v.percent}%`}</li>)}</ul><details><summary>原回答の内訳</summary><ul>{Object.entries(r.rawCounts??r.rawPercent??{}).map(([n,v])=><li>{n}：{v}{r.rawCounts?'人':'%'}</li>)}</ul></details><p><a href={geographicSources.find(s=>s.id===r.source)?.url}>原典</a></p></article>)}</details>)}</details>
  <details data-lc-major-method><summary>一枚の地図の読み方・元分類・年代</summary><p>行政区の実際の形に、民族関連10%以上・宗教5%以上の区分を重ねています。色面と斜線・点は同地域の別分類。点線枠は地理記述に基づく概略です。全国割合から帯や居住境界を作っていません。行政区内の一人一人の位置や、特定集団だけの領域は示しません。</p><p>民族・人種の自己認識は設問や社会で異なります。Mestizo・pardo・Ladino・Mixed等を一つに合算せず、宗教と民族も別設問のまま保ちます。未収録・不明・未回答は、誰もいない・宗教なし・0人に置換しません。表示閾値未満の元回答も以下に残します。</p>{(['ethnicity','religion'] as const).map(section=><details data-lc-major-native={section}><summary>{section==='ethnicity'?'民族・人種':'宗教'}：採用した全国回答の元分類</summary>{majorAreas[section].map(area=><article><h3>{latinCountryName(area.code)}・{area.year}年</h3><p>{area.denominator}</p><p>{area.note}</p><ul>{area.values.map(v=><li>{v.native}：{Number.isInteger(v.percent)?v.percent:v.percent.toFixed(1)}%{'count' in v?`（${v.count?.toLocaleString('ja-JP')}人）`:''}</li>)}</ul>{area.rawCounts&&<ul>{Object.entries(area.rawCounts).map(([key,count])=><li>{area.rawLabels?.[key]??key}：{count.toLocaleString('ja-JP')}人</li>)}</ul>}<p><a href={majorSources.find(s=>s.id===area.source)?.url}>原典</a></p></article>)}</details>)}</details>
  <details data-lc-religion-survey><summary>宗教の全国回答割合・2013–14年（18国・地域）</summary><p>{pewReligionSource.evidence}。単位は%。その他の回答もあり、原表の割合を100%に正規化しません。全国の参考資料です。これらの全国割合から、地図内の行政区や帯の境界を作っていません。丸めにより原表の合計が100にならないことがあります。</p><table><caption>Pew Research Center, Religion in Latin America, p.14 / QCURREL。2013–14年調査、現在値ではありません。</caption><thead><tr><th>国・地域</th><th>カトリック</th><th>プロテスタント</th><th>宗教に所属しない</th><th>その他</th></tr></thead><tbody>{religionSurvey.map(row=><tr><th>{latinCountryName(row.code)}</th>{row.values.map(value=><td>{value}%</td>)}</tr>)}</tbody></table><p>Copyright © 2014 Pew Research Center. Washington, D.C. <a href={pewReligionSource.url}>Religion in Latin America</a>, November 13, 2014. Insight Journalによる抜粋・独自図表・日本語表示。</p><p lang="en">{pewTranslationNotice}</p><p><a href="https://www.pewresearch.org/religion/2014/11/13/appendix-a-methodology-13/">調査方法と対象外地域</a> · <a href={pewReligionSource.termsUrl}>利用条件</a></p></details>
  <details data-lc-method-ledger><summary>採用資料・利用条件の台帳</summary>{geographicSources.map(s=><article><h3><a href={s.url}>{s.title}</a></h3><p>{s.year}年。{s.denominator}</p><p>{s.rights}</p></article>)}<p><a href={geographicLedger.url}>行政区境界：Natural Earth10m</a>（<a href={geographicLedger.terms}>public domain</a>）。経緯度を既存Web Mercatorへ投影し、結合・簡略化・国境でのクリップを実施。原典の地図をトレースしていません。</p>{majorSources.map(s=><article><h3><a href={s.url}>{s.title}</a></h3><p>{s.period}。公表された集計値を独自に図表化。元の画像・図形は転載しません。</p><p>{typeof s.rights==='string'?s.rights:JSON.stringify(s.rights)}</p><p><a href={s.termsUrl}>利用条件・原典確認</a></p></article>)}<p>広域の背景は<a href="https://saylordotorg.github.io/text_world-regional-geography-people-places-and-globalization/s09-01-introducing-the-realm.html">Berglee, World Regional Geography (2012), South America</a>と<a href="https://saylordotorg.github.io/text_world-regional-geography-people-places-and-globalization/s08-01-introducing-the-realm.html">Middle America</a>、<a href="https://www.cepal.org/es/publicaciones/45664-pueblos-indigenas-america-latina-abya-yala-la-agenda-2030-desarrollo-sostenible">CEPAL (2020)</a>を参考に独自に記述。資料の図や文章を転載していません。国境図形は既存Natural Earth（public domain）。</p><p>ガイアナ：Adapted from Bureau of Statistics Guyana Census 2012 data; no endorsement implied. スリナム：Source: Algemeen Bureau voor de Statistiek, Census 8 (2012)。</p></details>
  <h2>既存の国勢調査：採用値と収録範囲</h2><p>{latinCultureCoverage}</p>{(['ethnicity','religion'] as const).map(section=><details><summary>{section==='ethnicity'?'民族関連の別設問':'宗教・信条'}の原表抜粋</summary>{latinCultureNational[section].map(row=><article><h3>{row.name}・{row.year}年全国</h3><p>{row.denominator}</p><ul>{row.values.map((value,i)=><li>{latinCultureGroups[section][i].name}：{value.toLocaleString('ja-JP')}人（原表 {row.percentages[i]}%）</li>)}</ul><p><a href={row.source}>国勢調査原典</a> · <a href={row.licenseUrl}>{row.license}</a>。Insight Journalによる抜粋・日本語表示。値の合計・残差から新しい分類を作りません。</p></article>)}<table><caption>チリ2024・代表6州の公表人数。民族関連は全年齢・各設問回答者、宗教は15歳以上・信条設問回答者。</caption><thead><tr><th>州</th>{latinCultureGroups[section].map(group=><th>{group.name}・人</th>)}</tr></thead><tbody>{latinCultureRegions.map(region=><tr><th>{region.name}</th>{(section==='ethnicity'?region.identity:region.religion).map(value=><td>{value.toLocaleString('ja-JP')}</td>)}</tr>)}</tbody></table><p><a href={section==='ethnicity'?chileIdentitySource:chileReligionSource}>チリINE Censo2024原典</a>、民族pp.9・11、宗教pp.14・16・17。<a href={chileCultureLicense.url}>CC BY-SA4.0</a>、当サイトの抽出・日本語加工も同ライセンスで配信。</p></details>)}
  {latinCultureSupplements.map(data=><details data-lc-supplement-source={data.country}><summary>{data.name}・{data.year}年・{data.grain}の原表抜粋</summary><div data-lc-supplement-detail set:html={latinCultureSupplementReading(data.country+':national')!.body}/></details>)}
 </Fragment>
 <Fragment slot="sources">
  <h2>国・地域の値と、国内の居住分布を確かめる</h2>
  <details class="lp-country-table" data-lp-country-table open><summary>全34国・地域の人口・密度・都市化率</summary><div class="latin-table-scroll"><table><caption>2023年の世界銀行公表値。人数は人、密度は人/陸地km²、都市化率は%。欠測・対象統計なしは0に置換しません。</caption><thead><tr><th scope="col">国・地域</th><th scope="col">人口（人）</th><th scope="col">密度</th><th scope="col">都市化率</th></tr></thead><tbody>{population.countries.map(row=><tr data-lp-row={row.countryCode}><th scope="row">{row.nameJa}<span lang="en">{row.name}・{row.countryCode}</span></th><td>{latinPopulationValue(row.population,row.populationStatus)}</td><td>{latinPopulationValue(row.density,row.densityStatus,1)}</td><td>{latinPopulationValue(row.urbanShare,row.urbanShareStatus,1)}</td></tr>)}</tbody></table></div></details>
  <details class="lp-spatial-detail"><summary>補助密度図の2020年推計・粒度・欠測を確かめる（GHSL）</summary><p>国平均の2023年密度と、国内の居住密度分布を読む2020年推計は別の年・尺度です。欧州委員会JRC・GHS-POP R2023Aの1km人口推計を10km等積格子に集計。表示は約14kmで小さな集落が平滑化され、小島や海岸は省略されることがあります。街区ごとの実測人数ではありません。</p><p>単位：人/km²。分母は有効な元人口セルの面積で、国別統計の陸地面積とは異なります。0は有効な0、透明部分は欠測・対象外。メルカトル画像のセル数から人口を足し上げません。表示格子は既存の配信原値をそのまま照会します。</p><p><a href={`${spatialAssets}/latin-america.grid.json`}>2020年の配信格子値</a> ／ <a href={`${spatialAssets}/manifest.json`}>加工・配信値・利用条件台帳</a> ／ <a href={`${spatialAssets}/source-inputs.json`}>42元タイルの原典とSHA256</a></p></details>
  <details class="lp-original-readings"><summary>都市・河川・中米・カリブの地域解説</summary>{latinPopulationOriginalTopics.map(topic=><details><summary>{topic.title}</summary><p>{topic.summary}</p>{topic.sections.map(section=><div><h3>{section.title}</h3><p>{section.body}</p></div>)}<ul>{topic.sources.map(source=><li><a href={source.url}>{source.label}</a>{source.period?`（${source.period}）`:''}</li>)}</ul></details>)}</details>


  <details><summary>原典・加工・配信値・利用条件</summary><ul>{population.sources.map(source=><li><a href={source.apiUrl}>世界銀行API：{source.indicator}（2023年を採用）</a> ／ <a href={source.metadataUrl}>個別指標の定義と利用条件</a>。API更新：{source.apiLastUpdated}。</li>)}<li>3指標それぞれの公式メタデータにCC BY4.0を指定。世界銀行・元指標提供機関を出典とし、対象・年の抽出、日本語名、表示丸め、地図表示はInsight Journalが加工。</li><li>国境：Natural Earth。人口密度は国境面積から再計算していません。</li><li><a href={`${assets}/countries-2023.csv`}>採用値CSV</a> ／ <a href={`${assets}/countries-2023.json`}>採用JSON</a> ／ <a href={`${assets}/manifest.json`}>原典レスポンス・個別メタデータ・加工・SHA256台帳</a></li></ul></details>
  <details class="lp-ghsl-citation"><summary>GHSL補助密度図の元データ・参考論文</summary><p>2020年の補助密度図の元データ：欧州委員会JRC、<a href="https://human-settlement.emergency.copernicus.eu/ghs_pop2023.php">GHS-POP R2023A</a>。1km人口格子を10kmの等積格子に集約した図です。2023年国別統計と年・目的が異なります。</p><p>GHSLの方法と検証の参考論文：<a href="https://doi.org/10.1080/17538947.2024.2390454">Pesaresi et al. (2024)、DOI: 10.1080/17538947.2024.2390454</a>。元データの採用年・加工・配信値は補助密度図の台帳で確認できます。</p></details>
 </Fragment>
 <script>import {initLatinReadingPopulation} from '../../scripts/atlas-latin-reading-population';const init=()=>document.querySelectorAll<HTMLElement>('[data-latin-field="population"]').forEach(initLatinReadingPopulation);init();document.addEventListener('astro:page-load',init);</script>
</LatinAmericaWorkspace>
