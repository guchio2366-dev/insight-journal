---
import MexicoWorkspace from './MexicoWorkspace.astro';
import MexicoIndustryAdopted from './MexicoIndustryAdopted.astro';
import MexicoFoodProcessingReading from './MexicoFoodProcessingReading.astro';
import {mexicoFoodProcessingReading} from '../../data/atlas/mexico/food-processing-reading';
import originalData from '../../data/atlas/mexico/industry.json';
import catalog from '../../data/atlas/mexico/industry-catalog.json';
import population from '../../data/atlas/mexico/population.json';
import {mexicoIndustryReading as originalReading} from '../../data/atlas/mexico/industry-reading';
import {geometryPath,stateFeatures,stateLabelPoint,stateViewBox,mapViewBox,geometryMetadata,projectLonLat} from '../../lib/atlas-mexico-geometry';
import {industryExportColor,industryValueText,mexicoIndustryBins,mexicoIndustrySectors,mexicoIndustryPrimarySectors,mexicoIndustrySubsectorsFor,type MexicoIndustryValue} from '../../lib/atlas-mexico-industry';
import {mexicoDensityBins,mexicoDensityColor,mexicoPopulationLegendValues,mexicoPopulationRadius} from '../../lib/atlas-mexico-population';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-industry.css';
import '../../styles/atlas-mexico-industry.css';

const industryHref=withBase('/atlas/north-america/mexico/industry/');
const populationHref=withBase('/atlas/north-america/mexico/population/');
const assets=withBase('/assets/atlas/mexico-industry-v1');
const catalogRows=new Map(catalog.rows.map(r=>[r.id,r.values]));
const data={...originalData,metrics:[...originalData.metrics.map(m=>({...m,sector:'manufacturing',topStates:m.id==='transport'?['05','11']:['08','14']})),...catalog.metrics],rows:originalData.rows.map(r=>({...r,values:{...r.values,...catalogRows.get(r.id)}}))};
const reading={...originalReading,...Object.fromEntries(catalog.metrics.map(m=>[m.id,m.reading]))};
const sectorReadings=catalog.sectorReadings;
const readingPlaces=[...originalData.metrics.flatMap(m=>(m.id==='transport'?['05','11']:['08','14']).map(state=>({state,name:data.states.find(s=>s.id===state)!.name,sector:'manufacturing',metric:m.id,label:m.name,overview:true}))),...catalog.metrics.flatMap(m=>m.topStates.map(state=>({state,name:data.states.find(s=>s.id===state)!.name,sector:m.sector,metric:m.id,label:m.name,overview:false}))),...Object.entries(sectorReadings).flatMap(([sector,copy])=>copy.places.map(place=>({...place,sector,metric:'',label:sector==='resources'?(place.state==='26'?'銅':'銀'):sector==='services'?(place.state==='09'?'金融・専門サービス':'宿泊・飲食'):'建設・不動産／需要の背景',overview:true})))];
// Keep the complete reading/metric list above, while the first view uses a
// small, source-backed set of state production regions instead of all 26 points.
const factoryCities=[
 {state:'01',name:'アグアスカリエンテス市',sector:'manufacturing',metric:'transport',label:'自動車組立',overview:true,point:[442.87222,351.54215] as [number,number],source:'Nissan'},
 {state:'21',name:'プエブラ市',sector:'manufacturing',metric:'transport',label:'自動車組立',overview:true,point:[553.76287,430.88847] as [number,number],source:'Volkswagen'},
];
// Coordinates are 2020 INEGI locality centres, not facility footprints. The
// named operations and city economies are independently documented below.
const sourcedCities=[
 {state:'26',name:'カナネア市',sector:'resources',metric:'mining',label:'銅鉱山',point:projectLonLat([-110.3016714,30.9826528]),source:'Grupo México',siteKind:'mine'},
 {state:'11',name:'サラマンカ市',sector:'resources',metric:'refining',label:'石油精製',point:projectLonLat([-101.1999153,20.5686806]),source:'Pemex',siteKind:'refinery'},
 {state:'20',name:'サリナ・クルス市',sector:'resources',metric:'refining',label:'石油精製',point:projectLonLat([-95.1921586,16.175885]),source:'Pemex',siteKind:'refinery'},
 {state:'14',name:'グアダラハラ市',sector:'manufacturing',metric:'electronics',label:'電子機器集積',point:projectLonLat([-103.3422222,20.6763889]),source:'INEGI',siteKind:'city-cluster'},
 {state:'19',name:'モンテレイ市',sector:'manufacturing',metric:'machinery',label:'製造集積',point:projectLonLat([-100.3108917,25.6646972]),source:'INEGI',siteKind:'city-cluster'},
 {state:'19',name:'モンテレイ市',sector:'services',metric:'finance',label:'金融・専門サービス',point:projectLonLat([-100.3108917,25.6646972]),source:'INEGI',siteKind:'city-cluster'},
 {state:'23',name:'カンクン市',sector:'services',metric:'tourism',label:'宿泊・飲食',point:projectLonLat([-86.8248111,21.1614161]),source:'INEGI',siteKind:'city-cluster'},
];
const mapPlaces=[...readingPlaces.filter(place=>place.sector==='manufacturing'&&place.overview&&!(place.metric==='electronics'&&place.state==='14')),...readingPlaces.filter(place=>place.metric==='food'&&place.state==='19'),...readingPlaces.filter(place=>place.metric==='chemicals'&&place.state==='28'),...readingPlaces.filter(place=>place.metric==='metals'&&place.state==='02'),...factoryCities,...readingPlaces.filter(place=>place.metric==='oil-gas'&&['04','27'].includes(place.state)),...readingPlaces.filter(place=>place.metric==='mining'&&place.state==='32'),...readingPlaces.filter(place=>place.sector==='services'&&place.state==='09').map(place=>({...place,metric:'finance'})),...sourcedCities];
const selected={id:'',name:'州未選択'};
const rows=new Map(data.rows.map(r=>[r.id,r]));
const populationRows=new Map(population.states.map(r=>[r.stateCode,r]));
const geometry=stateFeatures.map(f=>({id:f.properties.code,path:geometryPath(f.geometry),point:stateLabelPoint(f.properties.code)}));
const labels=Object.fromEntries(geometry.map(g=>[g.id,g.point]));
const views=Object.fromEntries(data.states.map(s=>[s.id,stateViewBox(s.id)]));
const usaLabel=projectLonLat([-105,32]);
const config={data,population,reading,labels,views,industryHref,populationHref,mapViewBox,catalog,readingPlaces};
const value=(v:unknown)=>industryValueText(v as MexicoIndustryValue);
---
<MexicoWorkspace field="industry" title="メキシコの主要産業｜地域・輸送・市場をつなぐ" lead="資源・エネルギー、製造業、サービス業の主要地域から、資源・人・交通・市場のつながりを読む。">
  <div slot="controls" class="industry-controls country-industry-navigation" data-industry-controls data-ma-legacy>
   <p><a href={industryHref}>産業・品目の集積図へ戻る</a></p>
   <div class="industry-tab-row" role="tablist" aria-label="主要産業の3分野">{mexicoIndustryPrimarySectors.map(sector=><button type="button" role="tab" id={`mi-sector-${sector.id}`} data-industry-sector={sector.id} aria-selected={sector.id==='resources'?'true':'false'} tabindex={sector.id==='resources'?0:-1} aria-controls="mi-primary-map-panel">{sector.label}</button>)}</div>
   {mexicoIndustryPrimarySectors.map(sector=><div class="industry-tab-row industry-subtabs" role="tablist" aria-label={`${sector.label}の分野`} data-industry-subtabs={sector.id} data-mi-metric-tabs hidden>{(sector.id==='services'?[{id:'all',label:'全分野'},{id:'finance',label:'金融・専門サービス'},{id:'tourism',label:'宿泊・飲食'}]:mexicoIndustrySubsectorsFor(sector.id)).map(sub=><button type="button" role="tab" id={`mi-category-${sector.id}-${sub.id}`} data-industry-subsector={sub.id} data-owner-sector={sector.id} data-mi-metric-button={sub.id==='all'||sector.id==='services'?undefined:sub.id} aria-selected={sub.id==='all'?'true':'false'} tabindex={sub.id==='all'?0:-1} aria-controls="mi-description mi-statistics">{sub.label}</button>)}</div>)}
   <p class="industry-guide"><span data-industry-breadcrumb>資源・エネルギー</span><a href="#mi-statistics">この分野の統計へ</a></p>
   <select data-mi-metric hidden aria-label="輸出業種" tabindex="-1">{data.metrics.map(m=><option value={m.id} selected={m.id==='transport'}>{m.name}</option>)}</select>
  </div>
 <Fragment slot="map"><MexicoIndustryAdopted /><div class="mi-map-panel" data-ma-legacy>
  <div data-mi-comparison-heading hidden><h2 data-mi-comparison-title>{reading.comparison.title}</h2><p class="mexico-caption" data-mi-comparison-lead>{reading.comparison.lead}</p></div>
  <div class="mi-map-grid" data-mi-map-grid>
   {['primary','secondary'].map((slot,i)=><figure class="mi-map-figure" data-mi-figure={slot} hidden={i===1}>
    <div class="atlas-map-frame mexico-map-frame" id={i===0?'mi-primary-map-panel':undefined}>
    <svg class="mexico-map mi-map" data-mexico-map data-mi-map={slot} viewBox={mapViewBox} role="group" aria-labelledby={`mi-${slot}-title mi-${slot}-desc`}>
     <title id={`mi-${slot}-title`}>{i===0?'資源・エネルギーの主要地域':'電子機器の州別輸出額、2025年速報'}</title>
     <desc id={`mi-${slot}-desc`}>{i===0?'点は公式統計に基づく州の位置案内。施設の所在地や数量ではありません。':'色は州の生産地に配分したFOB輸出額。秘匿は斜線、未把握は点模様です。'}</desc>
     <defs>
      <pattern id={`mi-${slot}-confidential`} width="9" height="9" patternUnits="userSpaceOnUse"><rect width="9" height="9" fill="#e3e5e0"/><path d="M-2,2L2,-2M0,9L9,0M7,11L11,7" stroke="#7c8982" stroke-width="1.5"/></pattern>
      <pattern id={`mi-${slot}-unknown`} width="10" height="10" patternUnits="userSpaceOnUse"><rect width="10" height="10" fill="#fbfaf4"/><circle cx="3" cy="3" r="1.4" fill="#8b9890"/></pattern>
      <pattern id={`mi-${slot}-unretrieved`} width="9" height="9" patternUnits="userSpaceOnUse"><rect width="9" height="9" fill="#f8ece3"/><path d="M1,1L8,8M8,1L1,8" stroke="#a17758" stroke-width="1"/></pattern>
      <pattern id={`mi-${slot}-notSignificant`} width="10" height="10" patternUnits="userSpaceOnUse"><rect width="10" height="10" fill="#fff"/><path d="M0,5H10" stroke="#92a394" stroke-width="1"/></pattern>
      <pattern id={`mi-${slot}-notApplicable`} width="9" height="9" patternUnits="userSpaceOnUse"><rect width="9" height="9" fill="#e6e6e6"/></pattern>
     </defs>
     {i===0&&<image href={withBase('/assets/atlas/mexico-nature-v1/relief.svg')} width="900" height="580" opacity=".35" aria-hidden="true"/>}
     <g class="mi-country-context" data-mi-country-context aria-hidden="true">{geometry.map(g=><path data-mi-context-state={g.id} d={g.path} fill-rule="evenodd" />)}</g>
     <g>{geometry.map(g=>{const state=data.states.find(s=>s.id===g.id)!,v=rows.get(g.id)!.values[i===0?'transport':'electronics'],label=i===0?`${state.name}の位置を選ぶ`:`${state.name} ${value(v)}`;return <path class:list={['mi-state',{'is-selected':g.id===selected.id}]} data-mi-shape={g.id} d={g.path} fill={i===0?'#edf1df':industryExportColor(v.value,v.status as MexicoIndustryValue['status'],`mi-${slot}`)} fill-rule="evenodd" role="button" tabindex="0" aria-pressed={g.id===selected.id?'true':'false'} aria-label={label}><title>{label}</title></path>;})}</g>
     {i===1&&<g data-mi-population-circles hidden>{geometry.map(g=>{const r=populationRows.get(g.id)!;return <circle data-mi-population-circle={g.id} cx={g.point[0]} cy={g.point[1]} r={mexicoPopulationRadius(r.population)} class="mi-population-circle" role="button" tabindex="0" aria-label={`${r.nameJa} 人口 ${r.population.toLocaleString('ja-JP')}人`}><title>{r.nameJa} 人口 {r.population.toLocaleString('ja-JP')}人、2020年</title></circle>;})}</g>}
     <g class="mi-labels" aria-hidden="true">{geometry.map(g=>{const s=data.states.find(s=>s.id===g.id)!;return <text data-mi-label={g.id} x={g.point[0]} y={g.point[1]-7} text-anchor="middle" hidden={!['05','11','08','14'].includes(g.id)}>{s.short}</text>;})}</g>
     {i===0&&<g data-mi-reading-markers>{mapPlaces.map(place=>{const center=labels[place.state],point='point' in place?place.point:center,kind=mexicoIndustrySectors.find(s=>s.id===place.sector)!,city='source' in place,siteKind='siteKind' in place?place.siteKind:city?'factory-city':'state-guide';return <g data-mi-region-option={place.state} data-mi-region-metric={place.metric} data-mi-region-sector={place.sector} data-mi-region-x={point[0]} data-mi-region-y={point[1]} data-mi-overview-place="true" data-mi-site-kind={siteKind} data-mi-facility-city={siteKind==='factory-city'?'true':undefined} style={`--mi-region-color:${kind.color}`} role="button" tabindex="0" hidden={place.sector!=='resources'} aria-label={`${place.label}：${place.name}の資料を読む`} transform={`translate(${point[0]},${point[1]})`}><path data-mi-region-leader d="M0,0L12,-12" aria-hidden="true"/><circle r={city?'7':'8'} fill={kind.color}/><text data-mi-region-label x="12" text-anchor="start" y="-28"><tspan data-mi-region-name x="12">{place.label}</tspan><tspan data-mi-region-topic x="12" dy="1.3em">{place.name}</tspan></text><title>{place.label}・{place.name}（{city?'原典で確認した活動のある都市。点はINEGI市街地の位置で、施設敷地や業種別数量ではありません。':'州別統計の案内点。個別施設の位置や数量ではありません。'}）</title></g>;})}<g data-mi-selected-state-pin hidden role="button" tabindex="-1" aria-pressed="false"><circle r="8"/><title>選択した州の案内位置</title></g></g>}
     <text class="mi-context-label" data-mi-context-label x={usaLabel[0]} y={usaLabel[1]} text-anchor="middle" aria-hidden="true">米国</text>
    </svg>
    {i===0&&<div class="mi-map-navigation" role="group" aria-label="産業地図の拡大と縮小"><button type="button" data-mi-map-action="fit">全体</button><button type="button" data-mi-map-action="in" aria-label="地図を拡大">＋</button><button type="button" data-mi-map-action="out" aria-label="地図を縮小">−</button></div>}
    </div>
    <h3 class="mi-map-heading" data-mi-map-heading={slot}>{i===0?'資源・エネルギーを読む地域':'電子機器の輸出額'} <span>{i===0?'州と市街の位置案内':'2025年速報・10億米ドル'}</span></h3>
    <figcaption data-mi-map-caption={slot}>2025年速報。太枠は読む州。略号は州の位置案内。</figcaption>
   </figure>)}
  </div>
  <p class="mexico-caption" data-mi-map-status aria-live="polite">2025年速報・輸送機器の輸出額。32州の公開状態を表示。</p>
 </div></Fragment>
 <div slot="items" class="industry-key" data-ma-legacy><div data-mi-sector-legend>{mexicoIndustryPrimarySectors.map(s=><span><i style={`--industry-color:${s.color}`} aria-hidden="true">{s.symbol}</i>{s.label}</span>)}</div><p data-mi-geography-scope>●は州単位の案内位置、○は原典で活動を確認した都市の市街位置です。採掘・精製・工場・都市集積の実際の敷地や点の数量を表しません。表示のない州を産業の不在とは判断しません。背景：INEGI自然地理地域（2001年の区分図）。</p><div class="mi-reading-keys">
  <label class="mi-export-overlay-control" data-mi-export-overlay-wrap hidden><input type="checkbox" data-mi-export-overlay/>州別FOB輸出額を面で表示（補助統計）</label>
  {['primary','secondary'].map((slot,i)=><div data-mi-legend-slot={slot}>
   <div data-mi-export-legend={slot}>
    <p class="mi-legend-unit">FOB輸出額・10億米ドル（2025年速報・8業種共通階級）</p>
    <ul class="mexico-legend mi-legend" aria-label={`${i===0?'主図':'比較図'}の輸出額の色階級`}>{mexicoIndustryBins.map(bin=><li><i style={`background:${bin.color}`} aria-hidden="true"/>{bin.label}</li>)}<li><i class="mi-zero" aria-hidden="true"/>0</li><li><i class="mi-confidential" aria-hidden="true"/>秘匿</li><li><i class="mi-unknown" aria-hidden="true"/>未把握</li></ul>
   </div>
   {i===1&&<div data-mi-population-legend hidden>
    <div data-mi-density-legend><p class="mi-legend-unit">人口密度・人/km²（2020年）</p><ul class="mexico-legend mi-legend" aria-label="元の人口密度の色階級">{mexicoDensityBins.map(bin=><li><i style={`background:${bin.color}`} aria-hidden="true"/>{bin.label}</li>)}</ul></div>
    <div data-mi-population-size-legend hidden><p class="mi-legend-unit">人口・円の面積が人数に比例（2020年）</p><svg class="mi-circle-legend" viewBox="0 0 330 75" role="img" aria-label="人口の円の大きさ、100万人・500万人・1000万人">{mexicoPopulationLegendValues.map((n,j)=><g><circle data-mi-size-reference={n} cx={55+j*110} cy="28" r={mexicoPopulationRadius(n)} class="mi-population-circle"/><text x={55+j*110} y="69" text-anchor="middle">{(n/10000).toLocaleString('ja-JP')}万人</text></g>)}</svg></div>
   </div>}
  </div>)}
 </div></div>
 <div slot="reading" data-ma-legacy class="mi-reading industry-map-reading" id="mi-description">
  <section data-mi-reading-comparison hidden><h2 data-mi-reading-comparison-title>{reading.comparison.title}</h2><p class="mexico-takeaway" data-mi-reading-comparison-text>{reading.comparison.text}</p><p class="mexico-caption" data-mi-period-note hidden>{reading.populationComparison.periodNote}</p><a class="mexico-return" data-mi-return href={`${industryHref}?state=05&metric=transport`}>コアウイラの輸送機器地図へ戻る</a></section>
  <p class="mexico-caption mi-fallback-note" data-mi-fallback-note hidden>簡易表示。州は上の選択欄で選べます。</p>
  <div class="industry-selected-reading" data-mi-reading-normal>
   <p class="mexico-caption" data-mi-legacy-sector-note hidden></p>
   {mexicoIndustrySectors.map(sector=>{const copy=sectorReadings[sector.id];return <article data-mi-industry-panel={`${sector.id}:all`} hidden={sector.id!=='resources'}><header><h2>{sector.label}</h2></header><div class="industry-selected-reading-body"><p class="industry-key-sentence"><strong>{sector.id==='all'?'製造業・資源・サービス・建設・不動産を、地域の交通・市場・需要につなげて読む。':copy?.lead??'米国への近さ・部品集積を、国境・港への交通と輸出向けの生産網につなげて読む。'}</strong></p><section><h3>{sector.id==='all'?'州の位置から、産業を支える条件を比べる':copy?.heading??'北部とバヒオから、製造業の分布へ'}</h3><p>{sector.id==='all'?'北部とバヒオの製造業、ソノラの銅とサカテカスの銀、メキシコシティの都市サービスとキンタナ・ローの観光サービスを比べます。メキシコシティ・メヒコ州の人口は、建設・不動産の需要を考える背景です。点は州を読む位置案内で、工場の位置や生産・建設額ではありません。':copy?.text??reading.causal[0]}</p><div class="industry-reading-places">{copy?copy.places.map(place=><button type="button" data-mi-region-option={place.state} data-mi-region-sector={sector.id}>{place.name}を地図で見る</button>):<><button type="button" data-mi-jump-metric="transport">輸送機器の分布を見る</button><button type="button" data-mi-jump-metric="electronics">半導体・電子機器の分布を見る</button></>}</div></section>{sector.id==='resources'&&<section><h3>採掘から精製へ</h3><p>ソノラ州カナネアの銅鉱山と、グアナフアト州サラマンカ・オアハカ州サリナ・クルスのPemex製油所を実在例として示します。採掘と精製は別の産業分類です。地図の市街点や採掘のFOB輸出額から、製油所の処理量や原油の移動先を推定しません。</p><p><a href="https://desarrollosustentable.gmexico.com/en/provee/">Grupo México・Buenavista del Cobre</a>／<a href="https://www.pemex.com/en/press_room/press_releases/Paginas/2018-093-national.aspx">Pemex・製油所一覧</a></p></section>}{sector.id==='manufacturing'&&<section><h3>製造業の都市集積</h3><p>モンテレイ市とグアダラハラ市は、INEGIの経済センサスで市全体の就業・事業所の集積を確認した都市です。同じ資料では、ヌエボ・レオン州の製造業、ハリスコ州の電子機器も示されます。市全体の数値を特定の業種や工場へ配分しません。</p><p><a href="https://www.inegi.org.mx/contenidos/programas/ce/2024/doc/mnl_ce24.pdf">INEGI・ヌエボ・レオン</a>／<a href="https://www.inegi.org.mx/contenidos/programas/ce/2024/doc/mjal_ce24.pdf">INEGI・ハリスコ</a></p></section>}{sector.id==='services'&&<section><h3>都市サービスの別の例</h3><p>ヌエボ・レオン州では、金融・保険の就業者6万6,686人、専門・科学・技術サービス5万9,565人（2023年）。モンテレイ市の点は都市を読む位置で、州全体の値を市へ配分しません。</p><a href="https://www.inegi.org.mx/contenidos/programas/ce/2024/doc/mnl_ce24.pdf">INEGI・ヌエボ・レオン経済センサス</a></section>}<details class="industry-reading-definitions"><summary>対象範囲・統計の読み方・出典</summary><p>{copy?copy.sourceYear:'配信中の数値は2025年速報のFOB輸出額です。全産業のGDP・雇用人数ではありません。'}</p>{copy&&copy.places.map(place=>place.sourceURL&&<a href={place.sourceURL}>{place.name}の根拠資料</a>)}<a href={copy?.sourceURL??reading.sources[0].url}>{copy?'地域事例の公式資料':reading.sources[0].label}</a></details></div></article>;})}
   {data.metrics.map(m=><article data-mi-industry-panel={`${m.sector}:${m.id}`} hidden>
    <header><h2>{m.id==='electronics'?'電子機器（通信・計測など）':m.name}</h2><button type="button" data-industry-overview>全分野へ</button></header>
    <div class="industry-selected-reading-body">
     {m.id==='food'?<MexicoFoodProcessingReading />:<>
      <p class="industry-key-sentence"><strong>{reading[m.id].heading}</strong></p>
