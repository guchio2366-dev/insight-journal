---
import MexicoWorkspace from './MexicoWorkspace.astro';
import MexicoFoodProcessingReading from './MexicoFoodProcessingReading.astro';
import {mexicoFoodProcessingReading} from '../../data/atlas/mexico/food-processing-reading';
import originalData from '../../data/atlas/mexico/industry.json';
import catalog from '../../data/atlas/mexico/industry-catalog.json';
import population from '../../data/atlas/mexico/population.json';
import {mexicoIndustryReading as originalReading} from '../../data/atlas/mexico/industry-reading';
import {geometryPath,stateFeatures,stateLabelPoint,stateViewBox,mapViewBox,geometryMetadata,projectLonLat} from '../../lib/atlas-mexico-geometry';
import {industryExportColor,industryValueText,mexicoIndustryBins,mexicoIndustrySectors,mexicoIndustrySubsectorsFor,type MexicoIndustryValue} from '../../lib/atlas-mexico-industry';
import {mexicoDensityBins,mexicoDensityColor,mexicoPopulationLegendValues,mexicoPopulationRadius} from '../../lib/atlas-mexico-population';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-industry.css';
import '../../styles/atlas-mexico-industry.css';

const industryHref=withBase('/atlas/north-america/mexico/industry/');
const populationHref=withBase('/atlas/north-america/mexico/population/');
const assets=withBase('/assets/atlas/mexico-industry-v1');
const catalogRows=new Map(catalog.rows.map(r=>[r.id,r.values]));
const data={...originalData,metrics:[...originalData.metrics.map(m=>({...m,sector:'manufacturing',topStates:m.id==='transport'?['05','11']:['08','14']})),...catalog.metrics],rows:originalData.rows.map(r=>({...r,values:{...r.values,...catalogRows.get(r.id)}}))};
const reading={...originalReading,...Object.fromEntries(catalog.metrics.map(m=>[m.id,m.reading]))};
const sectorReadings=catalog.sectorReadings;
const readingPlaces=[...originalData.metrics.flatMap(m=>(m.id==='transport'?['05','11']:['08','14']).map(state=>({state,name:data.states.find(s=>s.id===state)!.name,sector:'manufacturing',metric:m.id,label:m.name,overview:true}))),...catalog.metrics.flatMap(m=>m.topStates.map(state=>({state,name:data.states.find(s=>s.id===state)!.name,sector:m.sector,metric:m.id,label:m.name,overview:false}))),...Object.entries(sectorReadings).flatMap(([sector,copy])=>copy.places.map(place=>({...place,sector,metric:'',label:sector==='resources'?(place.state==='26'?'銅':'銀'):sector==='services'?(place.state==='09'?'金融・専門サービス':'宿泊・飲食'):'建設・不動産／需要の背景',overview:true})))];
const selected={id:'',name:'州未選択'};
const rows=new Map(data.rows.map(r=>[r.id,r]));
const populationRows=new Map(population.states.map(r=>[r.stateCode,r]));
const geometry=stateFeatures.map(f=>({id:f.properties.code,path:geometryPath(f.geometry),point:stateLabelPoint(f.properties.code)}));
const labels=Object.fromEntries(geometry.map(g=>[g.id,g.point]));
const views=Object.fromEntries(data.states.map(s=>[s.id,stateViewBox(s.id)]));
const usaLabel=projectLonLat([-105,32]);
const config={data,population,reading,labels,views,industryHref,populationHref,mapViewBox,catalog,readingPlaces};
const value=(v:unknown)=>industryValueText(v as MexicoIndustryValue);
---
<MexicoWorkspace field="industry" title="メキシコの主要産業｜地域・輸送・市場をつなぐ" lead="製造業・資源・サービス・建設の地域例から、産業を支える位置・交通・市場のつながりを読む。">
  <div slot="controls" class="industry-controls country-industry-navigation" data-industry-controls>
   <div class="industry-tab-row" role="tablist" aria-label="産業の業態">{mexicoIndustrySectors.map(sector=><button type="button" role="tab" id={`mi-sector-${sector.id}`} data-industry-sector={sector.id} aria-selected={sector.id==='all'?'true':'false'} tabindex={sector.id==='all'?0:-1} aria-controls="mi-primary-map-panel">{sector.label}</button>)}</div>
   {mexicoIndustrySectors.filter(s=>s.id!=='all').map(sector=><div class="industry-tab-row industry-subtabs" role="tablist" aria-label={`${sector.label}の分野`} data-industry-subtabs={sector.id} data-mi-metric-tabs hidden>{mexicoIndustrySubsectorsFor(sector.id).map(sub=><button type="button" role="tab" id={`mi-category-${sector.id}-${sub.id}`} data-industry-subsector={sub.id} data-owner-sector={sector.id} data-mi-metric-button={sub.id==='all'?undefined:sub.id} aria-selected={sub.id==='all'?'true':'false'} tabindex={sub.id==='all'?0:-1} aria-controls="mi-description mi-statistics">{sub.label}</button>)}</div>)}
   <p class="industry-guide"><span data-industry-breadcrumb>全産業</span><a href="#mi-statistics">この分野の統計へ</a></p>
   <select data-mi-metric hidden aria-label="輸出業種" tabindex="-1">{data.metrics.map(m=><option value={m.id} selected={m.id==='transport'}>{m.name}</option>)}</select>
  </div>
 <div slot="map" class="mi-map-panel">
  <div data-mi-comparison-heading hidden><h2 data-mi-comparison-title>{reading.comparison.title}</h2><p class="mexico-caption" data-mi-comparison-lead>{reading.comparison.lead}</p></div>
  <div class="mi-map-grid" data-mi-map-grid>
   {['primary','secondary'].map((slot,i)=><figure class="mi-map-figure" data-mi-figure={slot} hidden={i===1}>
    <div class="atlas-map-frame mexico-map-frame" id={i===0?'mi-primary-map-panel':undefined}>
    <svg class="mexico-map mi-map" data-mexico-map data-mi-map={slot} viewBox={mapViewBox} role="group" aria-labelledby={`mi-${slot}-title mi-${slot}-desc`}>
     <title id={`mi-${slot}-title`}>{i===0?'輸送機器':'電子機器'}の州別輸出額、2025年速報</title>
     <desc id={`mi-${slot}-desc`}>色は州の生産地に配分したFOB輸出額。州を選ぶと数値と説明を読めます。秘匿は斜線、未把握は点模様です。</desc>
     <defs>
      <pattern id={`mi-${slot}-confidential`} width="9" height="9" patternUnits="userSpaceOnUse"><rect width="9" height="9" fill="#e3e5e0"/><path d="M-2,2L2,-2M0,9L9,0M7,11L11,7" stroke="#7c8982" stroke-width="1.5"/></pattern>
      <pattern id={`mi-${slot}-unknown`} width="10" height="10" patternUnits="userSpaceOnUse"><rect width="10" height="10" fill="#fbfaf4"/><circle cx="3" cy="3" r="1.4" fill="#8b9890"/></pattern>
      <pattern id={`mi-${slot}-unretrieved`} width="9" height="9" patternUnits="userSpaceOnUse"><rect width="9" height="9" fill="#f8ece3"/><path d="M1,1L8,8M8,1L1,8" stroke="#a17758" stroke-width="1"/></pattern>
      <pattern id={`mi-${slot}-notSignificant`} width="10" height="10" patternUnits="userSpaceOnUse"><rect width="10" height="10" fill="#fff"/><path d="M0,5H10" stroke="#92a394" stroke-width="1"/></pattern>
      <pattern id={`mi-${slot}-notApplicable`} width="9" height="9" patternUnits="userSpaceOnUse"><rect width="9" height="9" fill="#e6e6e6"/></pattern>
     </defs>
     {i===0&&<image href={withBase('/assets/atlas/mexico-nature-v1/relief.svg')} width="900" height="580" opacity=".35" aria-hidden="true"/>}
     <g class="mi-country-context" data-mi-country-context aria-hidden="true">{geometry.map(g=><path data-mi-context-state={g.id} d={g.path} fill-rule="evenodd" />)}</g>
     <g>{geometry.map(g=>{const state=data.states.find(s=>s.id===g.id)!,v=rows.get(g.id)!.values[i===0?'transport':'electronics'];return <path class:list={['mi-state',{'is-selected':g.id===selected.id}]} data-mi-shape={g.id} d={g.path} fill={industryExportColor(v.value,v.status as MexicoIndustryValue['status'],`mi-${slot}`)} fill-rule="evenodd" role="button" tabindex="0" aria-pressed={g.id===selected.id?'true':'false'} aria-label={`${state.name} ${value(v)}`}><title>{state.name} {value(v)}</title></path>;})}</g>
     {i===1&&<g data-mi-population-circles hidden>{geometry.map(g=>{const r=populationRows.get(g.id)!;return <circle data-mi-population-circle={g.id} cx={g.point[0]} cy={g.point[1]} r={mexicoPopulationRadius(r.population)} class="mi-population-circle" role="button" tabindex="0" aria-label={`${r.nameJa} 人口 ${r.population.toLocaleString('ja-JP')}人`}><title>{r.nameJa} 人口 {r.population.toLocaleString('ja-JP')}人、2020年</title></circle>;})}</g>}
     <g class="mi-labels" aria-hidden="true">{geometry.map(g=>{const s=data.states.find(s=>s.id===g.id)!;return <text data-mi-label={g.id} x={g.point[0]} y={g.point[1]-7} text-anchor="middle" hidden={!['05','11','08','14'].includes(g.id)}>{s.short}</text>;})}</g>
     {i===0&&<g data-mi-reading-markers>{readingPlaces.map(place=>{const point=labels[place.state],kind=mexicoIndustrySectors.find(s=>s.id===place.sector)!;return <g data-mi-region-option={place.state} data-mi-region-metric={place.metric} data-mi-region-sector={place.sector} data-mi-overview-place={String(place.overview)} style={`--mi-region-color:${kind.color}`} role="button" tabindex="0" aria-label={`${place.name}の${place.label}を読む`} transform={`translate(${point[0]},${point[1]})`}><path data-mi-region-leader d="M0,0L12,-12" aria-hidden="true"/><circle r="8" fill={kind.color}/><text data-mi-region-label x="12" text-anchor="start" y="-28"><tspan data-mi-region-name x="12">{place.name}</tspan><tspan data-mi-region-topic x="12" dy="1.3em">{place.label}</tspan></text><title>{place.name}（州の位置案内。工場の位置・数量ではありません）</title></g>;})}</g>}
     <text class="mi-context-label" data-mi-context-label x={usaLabel[0]} y={usaLabel[1]} text-anchor="middle" aria-hidden="true">米国</text>
    </svg>
    {i===0&&<div class="mi-map-navigation" role="group" aria-label="産業地図の拡大と縮小"><button type="button" data-mi-map-action="fit">全体</button><button type="button" data-mi-map-action="in" aria-label="地図を拡大">＋</button><button type="button" data-mi-map-action="out" aria-label="地図を縮小">−</button></div>}
    </div>
    <h3 class="mi-map-heading" data-mi-map-heading={slot}>{i===0?'輸送機器の輸出額':'電子機器の輸出額'} <span>2025年速報・10億米ドル</span></h3>
    <figcaption data-mi-map-caption={slot}>2025年速報。太枠は読む州。略号は州の位置案内。</figcaption>
   </figure>)}
  </div>
  <p class="mexico-caption" data-mi-map-status aria-live="polite">2025年速報・輸送機器の輸出額。32州の公開状態を表示。</p>
 </div>
 <div slot="items" class="industry-key"><div data-mi-sector-legend>{mexicoIndustrySectors.filter(s=>s.id!=='all').map(s=><span><i style={`--industry-color:${s.color}`} aria-hidden="true">{s.symbol}</i>{s.label}</span>)}</div><p data-mi-geography-scope>点は本文の州の案内位置です。同じ大きさで、施設の所在地・数量を表しません。背景：INEGI自然地理地域（2001年の区分図）。</p><div class="mi-reading-keys">
  {['primary','secondary'].map((slot,i)=><div data-mi-legend-slot={slot}>
   <div data-mi-export-legend={slot}>
    <p class="mi-legend-unit">FOB輸出額・10億米ドル（2025年速報・両業種共通）</p>
    <ul class="mexico-legend mi-legend" aria-label={`${i===0?'主図':'比較図'}の輸出額の色階級`}>{mexicoIndustryBins.map(bin=><li><i style={`background:${bin.color}`} aria-hidden="true"/>{bin.label}</li>)}<li><i class="mi-zero" aria-hidden="true"/>0</li><li><i class="mi-confidential" aria-hidden="true"/>秘匿</li><li><i class="mi-unknown" aria-hidden="true"/>未把握</li></ul>
   </div>
   {i===1&&<div data-mi-population-legend hidden>
    <div data-mi-density-legend><p class="mi-legend-unit">人口密度・人/km²（2020年）</p><ul class="mexico-legend mi-legend" aria-label="元の人口密度の色階級">{mexicoDensityBins.map(bin=><li><i style={`background:${bin.color}`} aria-hidden="true"/>{bin.label}</li>)}</ul></div>
    <div data-mi-population-size-legend hidden><p class="mi-legend-unit">人口・円の面積が人数に比例（2020年）</p><svg class="mi-circle-legend" viewBox="0 0 330 75" role="img" aria-label="人口の円の大きさ、100万人・500万人・1000万人">{mexicoPopulationLegendValues.map((n,j)=><g><circle data-mi-size-reference={n} cx={55+j*110} cy="28" r={mexicoPopulationRadius(n)} class="mi-population-circle"/><text x={55+j*110} y="69" text-anchor="middle">{(n/10000).toLocaleString('ja-JP')}万人</text></g>)}</svg></div>
   </div>}
  </div>)}
 </div></div>
 <div slot="reading" class="mi-reading industry-map-reading" id="mi-description">
  <section data-mi-reading-comparison hidden><h2 data-mi-reading-comparison-title>{reading.comparison.title}</h2><p class="mexico-takeaway" data-mi-reading-comparison-text>{reading.comparison.text}</p><p class="mexico-caption" data-mi-period-note hidden>{reading.populationComparison.periodNote}</p><a class="mexico-return" data-mi-return href={`${industryHref}?state=05&metric=transport`}>コアウイラの輸送機器地図へ戻る</a></section>
  <p class="mexico-caption mi-fallback-note" data-mi-fallback-note hidden>簡易表示。州は上の選択欄で選べます。</p>
  <div class="industry-selected-reading" data-mi-reading-normal>
   {mexicoIndustrySectors.map(sector=>{const copy=sectorReadings[sector.id];return <article data-mi-industry-panel={`${sector.id}:all`} hidden={sector.id!=='all'}><header><h2>{sector.label}</h2></header><div class="industry-selected-reading-body"><p class="industry-key-sentence"><strong>{sector.id==='all'?'製造業・資源・サービス・建設・不動産を、地域の交通・市場・需要につなげて読む。':copy?.lead??'米国への近さ・部品集積を、国境・港への交通と輸出向けの生産網につなげて読む。'}</strong></p><section><h3>{sector.id==='all'?'州の位置から、産業を支える条件を比べる':copy?.heading??'北部とバヒオから、製造業の分布へ'}</h3><p>{sector.id==='all'?'北部とバヒオの製造業、ソノラの銅とサカテカスの銀、メキシコ市の都市サービスとキンタナ・ローの観光サービスを比べます。メキシコ市・メヒコ州の人口は、建設・不動産の需要を考える背景です。点は州を読む位置案内で、工場の位置や生産・建設額ではありません。':copy?.text??reading.causal[0]}</p><div class="industry-reading-places">{copy?copy.places.map(place=><button type="button" data-mi-region-option={place.state} data-mi-region-sector={sector.id}>{place.name}を地図で見る</button>):<><button type="button" data-mi-jump-metric="transport">輸送機器の分布を見る</button><button type="button" data-mi-jump-metric="electronics">半導体・電子機器の分布を見る</button></>}</div></section><details class="industry-reading-definitions"><summary>対象範囲・統計の読み方・出典</summary><p>{copy?copy.sourceYear:'配信中の数値は2025年速報のFOB輸出額です。全産業のGDP・雇用人数ではありません。'}</p>{copy&&copy.places.map(place=>place.sourceURL&&<a href={place.sourceURL}>{place.name}の根拠資料</a>)}<a href={copy?.sourceURL??reading.sources[0].url}>{copy?'地域事例の公式資料':reading.sources[0].label}</a></details></div></article>;})}
   {data.metrics.map(m=><article data-mi-industry-panel={`${m.sector}:${m.id}`} hidden>
    <header><h2>{m.id==='electronics'?'電子機器（通信・計測など）':m.name}</h2><button type="button" data-industry-overview>全分野へ</button></header>
    <div class="industry-selected-reading-body">
     {m.id==='food'?<MexicoFoodProcessingReading />:<>
      <p class="industry-key-sentence"><strong>{reading[m.id].heading}</strong></p>
      <section><h3>立地・交通・市場をつなげて読む</h3><p>{reading[m.id].text}</p><p>{reading[m.id].note}{m.id==='electronics'?' 半導体だけの輸出額ではありません。':m.id==='transport'?' 自動車・航空宇宙それぞれの単独値ではありません。':''}</p><div class="industry-reading-places">{m.topStates.map(code=><button type="button" data-mi-region-option={code} data-mi-region-metric={m.id} data-mi-region-sector={m.sector}>{data.states.find(s=>s.id===code)!.name}を地図で見る</button>)}</div></section>
     </>}
     <details class="industry-reading-definitions"><summary>対象範囲・統計の読み方・出典</summary>
      {m.id==='food'&&<>
       <h3>{reading[m.id].heading}</h3><p>{reading[m.id].text}</p><p>{reading[m.id].note}</p>
       <p>2025年に輸出額が公開されている州の上位例</p>
       <div class="industry-reading-places">{m.topStates.map(code=><button type="button" data-mi-region-option={code} data-mi-region-metric={m.id} data-mi-region-sector={m.sector}>{data.states.find(s=>s.id===code)!.name}を地図で見る</button>)}</div>
       <ul>{mexicoFoodProcessingReading.sources.map(source=><li><a href={source.url}>{source.label}</a></li>)}</ul>
      </>}
      <p>州の生産地に配分したFOB輸出額。2025年速報、10億米ドル。秘匿・未把握は0と区別します。</p><p>{m.scope??(m.id==='electronics'?reading.electronics.note:reading.transport.note)}</p><a href={reading.sources[0].url}>{reading.sources[0].label}</a>
     </details>
    </div>
   </article>)}
  </div>
  <section data-mi-selected-place-reading hidden><h3 data-mi-selected-place-name></h3><p data-mi-selected-place-text></p></section>
  <div class="mi-items">
   <a class="mexico-comparison-link" data-mi-electronics-link href={`${industryHref}?compare=electronics&state=05&metric=transport`}>輸送機器 × 電子機器：集中する州を比べる</a>
   <a class="mexico-comparison-link" data-mi-population-link href={`${industryHref}?compare=population&state=05&metric=transport&sourceView=density&from=industry`}>人口・密度 × 輸出額：人と生産拠点の位置を比べる</a>
  </div>
  <details class="mi-selected" aria-labelledby="mi-selected-state"><summary>選んだ州の統計</summary><h3 id="mi-selected-state" data-mi-selected-name>{selected.name}</h3><div class="mi-value-cards">
   <div data-mi-population-card hidden><span data-mi-population-card-label>人口密度・2020年</span><strong data-mi-population-card-value>—</strong></div>
   {data.metrics.map(m=><div data-mi-value-card={m.id}><span>{m.name}・2025年速報</span><strong data-mi-value={m.id}>—</strong></div>)}
  </div></details>
  <details class="mi-topic-reading" hidden><summary>選んだ業種の立地・交通・市場を読む</summary><h3 data-mi-topic-heading>{reading.transport.heading}</h3><p data-mi-topic-text>{reading.transport.text}</p></details>
  <details><summary>業種と公開状態の意味</summary><p>{reading.transport.note}</p><p>{reading.electronics.note}</p><p>FOB型の輸出額は、輸出国の国境まで届ける費用を含む価額。国境から先の運賃・保険料は含みません。<a href={reading.sources[9].url}>国連の貿易統計の定義</a></p><p>秘匿：個別業種の値を公表しない。未把握：輸出の有無を特定する情報がない。数値0：輸出なし。500米ドル未満、対象外、未取得もゼロと分けます。</p><p>{data.notes.scope}</p><p>{data.notes.confidential}</p><p>表示は千米ドルを1,000,000で割った10億米ドル。州別GDPや工場数への換算はしていません。</p></details>
 </div>
 <details slot="statistics" class="mi-statistics" id="mi-statistics"><summary>この分野の統計：選択州・全32州の輸出額と人口値</summary>
  <div class="mexico-controls mi-controls" data-mi-supplementary-controls><label>州 <select data-mi-state-select><option value="" selected>全国・州未選択</option>{data.states.map(s=><option value={s.id} selected={s.id===selected.id}>{s.name}</option>)}</select></label><label data-mi-source-view-control hidden>元の分布 <select data-mi-source-view><option value="density">人口密度</option><option value="population">人口</option></select></label></div>
  <div class="mexico-actions mi-actions"><label><input type="checkbox" data-mi-only/> 読む州だけ</label><button type="button" data-mi-zoom aria-pressed="false">読む州を拡大</button><button type="button" data-mi-all>全32州へ</button></div>
  <h2><span data-mi-stats-state>{selected.name}</span>の値を確認</h2>
  <div class="mexico-table-scroll"><table class="mi-selected-table"><caption>選択州・輸出額2025年速報／人口・密度2020年</caption><thead><tr><th scope="col">指標</th><th scope="col">値</th><th scope="col">原典の公開状態</th></tr></thead><tbody>{data.metrics.map(m=><tr><th scope="row">{m.name}輸出額・10億米ドル</th><td data-mi-stats-value={m.id}>—</td><td data-mi-stats-status={m.id}>州を選択</td></tr>)}<tr data-mi-population-stats hidden><th scope="row" data-mi-population-stats-label>人口密度・人/km²</th><td data-mi-population-stats-value>—</td><td>INEGI 公表値</td></tr></tbody></table></div>
  <details class="mi-all-data"><summary>全32州の輸出額・公開状態を原典と照合する</summary><div class="mexico-table-scroll"><table><caption>INEGI ETEF・2025年年次速報。原典はFOB千米ドル、表示は10億米ドル。</caption><thead><tr><th scope="col">州</th>{data.metrics.map(m=><Fragment><th scope="col">{m.name}<br/>10億米ドル</th><th scope="col">原典・千米ドル<br/>公開状態</th></Fragment>)}</tr></thead><tbody>{data.states.map(s=>{const r=rows.get(s.id)!;return <tr data-mi-data-row={s.id}><th scope="row">{s.name}<small>{s.sourceName}</small></th>{data.metrics.map(m=>{const v=r.values[m.id as 'transport'|'electronics'];return <Fragment><td>{value(v)}</td><td>{v.sourceValue===null?'—':v.sourceValue.toLocaleString('ja-JP')}<small>{v.sourceStatus}</small></td></Fragment>;})}</tr>;})}</tbody></table></div></details>
 </details>
