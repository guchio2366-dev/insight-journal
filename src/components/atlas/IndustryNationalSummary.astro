---
import {industrySectors} from '../../data/atlas/industry-catalog';
import {industryYear,chartRows,sectorTotal,nationalSectorShare,industryStatRows} from '../../data/atlas/industry-statistics';
const serviceIds=new Set(industryStatRows.services.map(r=>r.id));
const serviceColor=industrySectors.find(s=>s.id==='services')!.color;
---
<aside class="atlas-national industry-national" data-industry-national-summary aria-label="選択した業態の全米統計">
{industrySectors.map(sector=>{
 const gdp=chartRows(sector.id,'gdp').sort((a,b)=>Number(a.id.startsWith('other-'))-Number(b.id.startsWith('other-'))||a.value-b.value),employment=chartRows(sector.id,'employment');
 const largestGDP=gdp.reduce((a,b)=>a.share>b.share?a:b),largestEmployment=employment.reduce((a,b)=>a.share>b.share?a:b);
 const rows=gdp.map(row=>({...row,employment:employment.find(e=>e.id===row.id)!}));
 return <section data-industry-national-panel={sector.id} hidden={sector.id!=='all'}>
  <header><h3>{sector.id==='all'?'全産業':sector.label}の全国構成</h3>
   <p>{industryYear}年 · {sector.id==='all'?'農林水産・政府を含む12区分':`全米GDPの${nationalSectorShare(sector.id,'gdp').toFixed(1)}%・雇用の${nationalSectorShare(sector.id,'employment').toFixed(1)}%`}</p>
  </header>
  <p class="industry-composition-takeaway">{largestGDP.id===largestEmployment.id?`${largestGDP.label}が付加価値・雇用とも最大。`:`付加価値は${largestGDP.label}、雇用は${largestEmployment.label}の割合が最大。`}</p>
  <figure class="industry-chart industry-paired-chart">
   <figcaption><h3>付加価値・雇用の構成比</h3><span>{sector.id==='all'?'全米':sector.label}を100%</span></figcaption>
   <div class="industry-paired-heading" aria-hidden="true"><span>付加価値の昇順</span><span>付加価値</span><span>雇用</span></div>
   <ol class="industry-bars industry-paired-bars" aria-label="名目付加価値と年平均雇用の割合">
    {rows.map(r=>{
     const serviceDetail=sector.id==='all'&&serviceIds.has(r.id);
     const color=sector.id==='all'?(serviceDetail?serviceColor:industrySectors.find(s=>s.id===r.id)?.color??'#64815d'):sector.color;
     return <li data-industry-stat-row={r.id} class:list={{'industry-service-detail':serviceDetail}}>

      <div class="industry-paired-row"><span class="industry-paired-name">{r.label}</span>
       {([['gdp',r.share],['employment',r.employment.share]] as const).map(([metric,share])=><span class="industry-paired-cell" data-industry-metric={metric} aria-label={`${metric==='gdp'?'付加価値':'雇用'} ${share.toFixed(1)}%`}><strong>{share.toFixed(1)}<small>%</small></strong><i class="industry-paired-track" aria-hidden="true"><b style={`width:${share}%;--industry-color:${color}`}/></i></span>)}
      </div>
     </li>;
    })}
   </ol>
   <details class="industry-number-table"><summary>金額・雇用数と定義</summary><table><caption>{industryYear}年 · 名目付加価値：10億米ドル／年平均雇用：千雇用</caption><thead><tr><th scope="col">区分</th><th scope="col">付加価値</th><th scope="col">雇用</th></tr></thead><tbody>{rows.map(r=><tr><th scope="row">{r.label}</th><td>{r.value.toLocaleString('en-US',{maximumFractionDigits:1})}</td><td>{r.employment.value.toLocaleString('en-US',{maximumFractionDigits:1})}</td></tr>)}<tr><th scope="row">合計</th><td>{sectorTotal(sector.id,'gdp').toLocaleString('en-US',{maximumFractionDigits:1})}</td><td>{sectorTotal(sector.id,'employment').toLocaleString('en-US',{maximumFractionDigits:1})}</td></tr></tbody></table><p>「娯楽・宿泊・飲食」は住民の利用も含み、観光だけの値ではありません。統計：全米／地図：米国本土。雇用はフルタイム・パートタイムの年平均（自営業を除く）。</p></details>
  </figure>
 </section>;
})}
<p class="industry-stat-source"><a href="#industry-method">BEA原表・分類</a></p>
</aside>
