---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import { getOverviewRegion, overviewTopics, type OverviewRegionId } from '../../data/atlas/country-overview';
import { withBase } from '../../lib/urls';
import { getOverviewMap } from '../../data/atlas/overview-map';
import { getRegionOverview } from '../../data/atlas/region-overview';
import {countryOverview,europeCountryOverviews,europeCountryOverviewSources,europeOverviewTopics,overviewFactIds,formatOverviewFact} from '../../data/atlas/europe/country-overviews';
import statistics from '../../data/atlas/europe/country-statistics.json';
import '../../styles/atlas-regional-overview-layout.css';
import '../../styles/atlas-europe-country-overview.css';
import '../../styles/atlas-country-overview.css';

interface Props { regionId: OverviewRegionId }
const region = getOverviewRegion('europe');
const initialCountry = region.countries.find(country => country.code === region.defaultCountry) ?? region.countries[0];
const map = getOverviewMap(region.id);
const reading = getRegionOverview(region.id, region.label);
const initialOverview=countryOverview(initialCountry.code);
const config = {
  basePath: withBase('/').replace(/\/$/,''),
  overviews: europeCountryOverviews.map(country=>({...country,facts:country.facts.map(fact=>({...fact,valueText:formatOverviewFact(fact)}))})),
  sources: europeCountryOverviewSources, factIds:overviewFactIds,
  countries: region.countries.map(country => ({ ...country, bounds: map.countries.find(item => item.code === country.code)?.bounds })),
  topics: overviewTopics.map(topic => ({ id: topic.id, label: topic.label })),
  fields: region.fields.filter(field => field.href).map(field => ({
    id: field.id,
    href: withBase(field.href!),
    ...(field.countryHrefs ? { countryHrefs: Object.fromEntries(Object.entries(field.countryHrefs).map(([code, href]) => [code, withBase(href)])) } : {}),
  })),
  regionLabel: region.label, width: map.width, height: map.height, cities: map.cities,
};
---

<BaseLayout title={`${region.label}の概要と白地図`} description={`${region.label}の国・地域と主要都市の位置を白地図で確かめ、地域の分布と国ごとの短い要点を読み、4分野の地図と制度の一次資料へ進むページです。`} compactAtlas>
  <div class="overview-workspace">
  <AtlasWorkspaceFrame region={region.newsRegion} mapActions={false}>
    <article class="atlas-explorer country-overview" data-country-overview data-europe-country-overview data-field="country-overview" data-regional-overview-layout data-overview-region={region.id}>
      <nav class="country-overview-breadcrumb" aria-label="パンくずリスト"><a href={withBase('/atlas/')}>地図から見る</a><span aria-hidden="true"> / </span><a href={withBase(region.mapPath)}>{region.label}</a><span aria-hidden="true"> / </span><span>概要</span></nav>

      <div class="atlas-region-controls country-overview-controls">
        <nav class="country-overview-regions" aria-label="地域を選ぶ">
          <a href={withBase('/atlas/')}>世界の地域</a>
          {region.peers.map(id => { const peer = getOverviewRegion(id); return <a href={withBase(peer.path)} aria-current={id === region.id ? 'page' : undefined}>{peer.label}</a>; })}
        </nav>
        <label class="country-overview-picker" for="overview-country">国・地域
          <select id="overview-country" data-overview-country><option value="">{region.label}全体</option>{region.countries.map(country => <option value={country.code}>{country.name}</option>)}</select>
        </label>
      </div>

      <nav class="atlas-tabs country-overview-fields" aria-label="概要と分野別地図">
        <a href={withBase(region.path)} aria-current="page" data-overview-current-link>概要</a>
        {region.fields.map(field => field.href ? <a href={withBase(field.href)} data-overview-field={field.id}>{field.label}</a> : <span class="atlas-tab-planned" aria-disabled="true">{field.label}<small>準備中</small></span>)}
      </nav>

      <h1 class="visually-hidden">{region.label}の概要と白地図</h1>
      <p class="visually-hidden" data-overview-announcement aria-live="polite" aria-atomic="true"></p>
      <div class="overview-map-reading">
        <section class="overview-map-column" aria-label={`${region.label}の白地図`}>
          <div class="overview-map-stage" data-overview-map-stage>
            <svg class="overview-base-map" data-overview-map viewBox={`0 0 ${map.width} ${map.height}`} role="group" aria-label={`${region.label}の国境と主要都市`}>
              {map.context.map(path => <path class="overview-context-land" d={path} fill-rule="evenodd" />)}
              {map.countries.map(country => <path class="overview-country-shape" d={country.path} fill-rule="evenodd" data-overview-map-country={country.code} role="button" tabindex="-1" aria-label={country.name} aria-pressed="false"><title>{country.name}</title></path>)}
              {map.lakes?.map(path => <path class="overview-map-water" d={path} />)}
              {map.waters.map(water => <text class="overview-water-name" x={water.point[0]} y={water.point[1]}>{water.name}</text>)}
              {map.cities.map(city => <circle class="overview-city-dot" cx={city.point[0]} cy={city.point[1]} r="3" data-overview-city-dot={city.id} />)}
            </svg>
            <div class="overview-map-labels" data-overview-labels>
              {map.countries.map(country => <button type="button" class="overview-country-label" hidden={country.area<2500} data-overview-label-country={country.code} data-x={country.label[0]} data-y={country.label[1]} data-priority={country.area} style={`left:${country.label[0]/map.width*100}%;top:${country.label[1]/map.height*100}%`} aria-pressed="false">{country.name}</button>)}
              {map.cities.map((city,index) => <button type="button" class="overview-city-label" hidden={index>11} data-overview-map-city={city.id} data-country={city.country} data-x={city.point[0]} data-y={city.point[1]} data-priority={city.rank} style={`left:${city.point[0]/map.width*100}%;top:${city.point[1]/map.height*100}%`} aria-label={`${city.name}（${region.countries.find(country=>country.code===city.country)?.name ?? city.country}）`} aria-pressed="false">{city.name}</button>)}
            </div>
            <div class="overview-map-controls" aria-label="地図の表示範囲">
              <button type="button" data-overview-zoom="in" aria-label="地図を拡大">＋</button><button type="button" data-overview-zoom="out" aria-label="地図を縮小">−</button><button type="button" data-overview-reset>全体へ</button>
            </div>
            <span class="overview-map-badge">{region.label} · 国と主要都市</span>
          </div>
          <div class="overview-map-key"><span><i class="overview-key-border"></i> 国・地域の境界</span><span><i class="overview-key-city"></i> 主要都市</span><span><i class="overview-key-selected"></i> 選択中の国</span></div>
          <div class="overview-place-summary" data-overview-place-summary aria-live="polite">
            <strong data-overview-place-title>国や都市を選んで、位置を確かめる</strong>
            <p data-overview-place-description>地図の国名・都市名、または上の一覧から国・地域を選べます。</p>
            <a href="#overview-country-detail" data-overview-detail-link hidden><span data-overview-country-name>{initialCountry.name}</span><span data-overview-detail-label>の詳しい解説へ ↓</span></a>
          </div>
          <details class="overview-map-source"><summary>地図の範囲・出典</summary><p>境界と都市はNatural Earthの概略データを用いています。小さな国や重なる地名は、上の国・地域の一覧から選択できます。都市は主要な地点を抜粋しており、すべての都市を示すものではありません。</p><p>境界・名称は出典の表示上の区分に基づきます。詳細な行政境界や領土の実効支配を示す地図ではありません。</p>{map.notes.map(note=><p>{note}</p>)}<p>{map.projection}</p>{map.sources.map(source=><p><a href={source.url}>{source.label}</a></p>)}</details>
          <noscript><p class="country-overview-noscript">白地図と地域の概要を表示しています。国の選択・拡大にはJavaScriptが必要です。</p></noscript>
        </section>
        <aside class="overview-region-reading" data-overview-region-reading aria-labelledby="overview-region-title">
          <p class="overview-reading-eyebrow">地域の概要</p><h2 id="overview-region-title">{reading.title}</h2><p class="overview-region-intro">{reading.introduction}</p>
          {reading.sections.map(section => <section class="overview-region-section"><h3>{section.heading}</h3><p>{section.body}</p>{section.sourceIds.length > 0 && <p class="overview-inline-sources">{section.sourceIds.map(id => {const source=reading.sources.find(source=>source.id===id);return source && <a href={source.url}>{source.label}</a>;})}</p>}</section>)}
          {reading.checkedAt && <p class="overview-reading-date">説明の確認日：{reading.checkedAt}</p>}
        </aside>
        <div class="overview-europe-country-slot" data-overview-europe-country-slot hidden />
      </div>
      <section id="overview-country-detail" data-overview-country-detail hidden aria-labelledby="overview-country-title">
        <header class="eu-country-heading"><p class="overview-reading-eyebrow">国・地域の概要<span data-eu-country-selected-city hidden></span></p><h2 id="overview-country-title" data-overview-country-name>{initialCountry.name}</h2></header>
        <div class="country-overview-topic-tabs" role="tablist" aria-label="国・地域の解説テーマ">
          {europeOverviewTopics.map((topic,index)=><button type="button" id={`overview-tab-${topic.id}`} role="tab" aria-controls={`overview-panel-${topic.id}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-overview-topic={topic.id}>{topic.label}</button>)}
        </div>
        {europeOverviewTopics.map((topic,index)=><section id={`overview-panel-${topic.id}`} class="eu-country-topic" role="tabpanel" aria-labelledby={`overview-tab-${topic.id}`} tabindex="0" hidden={index!==0}>
          <p class="eu-country-takeaway" data-eu-country-takeaway>{initialOverview?.topics[topic.id]?.takeaway}</p>
          <p class="eu-country-copy" data-eu-country-body>{initialOverview?.topics[topic.id]?.body}</p>
          <nav class="eu-country-topic-links" data-eu-country-links aria-label={`${topic.label}の根拠を地図・資料で確認する`}></nav>
          <section class="eu-country-facts" data-eu-country-facts hidden><h3>2023年・国全体の統計</h3><dl data-eu-country-fact-list></dl></section>
          <details class="eu-country-details"><summary>対象範囲・出典・確認日</summary><p data-eu-country-evidence-note hidden></p><ul data-eu-country-sources></ul><p>数値と地図は異なる年・粒度の資料です。地図の格子から国全体の生産量や都市人口を推定していません。</p><p>出典と本文の確認日：2026-10-02</p></details>
        </section>)}
        <details class="eu-country-all-statistics"><summary>この国の全10指標・欠測と単位</summary><p>{statistics.scope}</p><dl data-eu-country-all-facts></dl></details>
      </section>
      <script type="application/json" data-overview-config set:html={JSON.stringify(config).replace(/</g, '\u003c')} />
    </article>
  </AtlasWorkspaceFrame>
  </div>
</BaseLayout>

<script>
  import { initEuropeCountryOverview } from '../../scripts/atlas-europe-country-overview';
  document.querySelectorAll<HTMLElement>('[data-country-overview]').forEach(initEuropeCountryOverview);
</script>
