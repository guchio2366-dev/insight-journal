---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-mexico.css';
import '../../styles/atlas-mexico-parity.css';
interface Props {field:'overview'|'nature'|'agriculture'|'industry'|'population';title:string;lead:string;description?:string}
const {field,title,lead,description=lead}=Astro.props;
const atlasField=field==='nature'?'natural':field;
const requestedReading=Astro.url.searchParams.get('reading');
const initialReadingSelected=requestedReading==='item'||(requestedReading!=='overview'&&(!!Astro.url.searchParams.get('state')||Astro.url.searchParams.has('compare')||Astro.url.searchParams.has('item')||Astro.url.searchParams.has('feature')||(field!=='population'&&Astro.url.searchParams.has('category'))||(field==='population'&&Astro.url.searchParams.has('compositionMetric')&&Astro.url.searchParams.get('compositionView')!=='overview')||((field==='agriculture'||field==='industry')&&Astro.url.searchParams.has('metric'))));
---
<BaseLayout title={`${title}｜メキシコ地理`} {description} compactAtlas>
 <AtlasWorkspaceFrame region="north-america" mapActions={false}>
  <article class={`atlas-explorer mexico-workspace mexico-${field}`} data-field={atlasField} data-mexico-workspace data-mexico-field={field} data-mexico-reading-selected={String(initialReadingSelected)}>
   <script is:inline>
    {const root=document.currentScript?.parentElement;if(root){const url=new URL(location.href),query=url.searchParams;const selected=query.get('reading')==='item'||(query.get('reading')!=='overview'&&(!!query.get('state')||query.has('compare')||query.has('item')||query.has('feature')||(root.dataset.mexicoField!=='population'&&query.has('category'))||(root.dataset.mexicoField==='population'&&query.has('compositionMetric')&&query.get('compositionView')!=='overview')||(['agriculture','industry'].includes(root.dataset.mexicoField)&&query.has('metric'))));root.dataset.mexicoInitialReadingSelected=String(selected);if(query.get('reading')!=='overview'&&query.get('reading')!=='item'){query.set('reading',selected?'item':'overview');history.replaceState(history.state,'',url);}}}
   </script>
   <section class="atlas-workspace mexico-learning-workspace" aria-label="メキシコの分野別地図">
    <div class="atlas-compact-heading"><nav aria-label="パンくずリスト"><a href={withBase('/atlas/')}>地図から見る</a><span aria-hidden="true"> / </span><a href={withBase('/atlas/north-america/')}>北米地理</a></nav><span>メキシコ</span></div>
    <div class="atlas-region-controls mexico-navigation"><AtlasRegionNavigation group="americas" current="north-america" country="mexico" /></div>
    <nav class="atlas-tabs atlas-tabs-with-overview mexico-fields" aria-label="地図の分野">
     {([['overview','概要'],['agriculture','農林業'],['nature','自然環境'],['industry','主要産業'],['population','人口']] as const).map(([id,label])=><a href={withBase(`/atlas/north-america/mexico/${id}/${id==='overview'?'?country=MEX':''}`)} aria-current={field===id?'page':undefined}>{label}</a>)}
    </nav>
    <slot name="controls" />
    <div class="atlas-primary-grid mexico-primary-grid">
     <section class="atlas-map-column mexico-map-column" aria-label="地図と項目"><slot name="map" /><div class="atlas-key mexico-items"><slot name="items" /></div></section>
     <aside class="atlas-national mexico-reading" aria-label="分布の理由と比較">
      <div class="mexico-reading-legend"><slot name="legend" /></div>
      <header class="mexico-header" data-mexico-country-overview hidden={initialReadingSelected}><h1>{title}</h1><p class="mexico-lead">{lead}</p></header>
      <div class="mexico-country-summary" data-mexico-country-summary hidden={initialReadingSelected}><slot name="overview" /></div>
      <button type="button" class="mexico-overview-button" data-mexico-overview-button hidden={!initialReadingSelected}>← メキシコの概要</button>
      <div class="mexico-reading-content" hidden={field==='agriculture'&&!initialReadingSelected}><slot name="reading" /></div>
     </aside>
    </div>
   </section>
   <section class="mexico-statistics" aria-label="地図の値を確かめる"><slot name="statistics" /></section>
   <footer class="mexico-sources"><slot name="sources" /></footer>
   <slot />
  </article>
 </AtlasWorkspaceFrame>
</BaseLayout>
<script>
 const initializeMexicoReading = () => {
  for (const root of document.querySelectorAll<HTMLElement>('[data-mexico-workspace]')) {
   if (root.dataset.mexicoReadingReady) continue;
   const overview=root.querySelector<HTMLElement>('[data-mexico-country-overview]');
   const back=root.querySelector<HTMLButtonElement>('[data-mexico-overview-button]');
   const countrySummary=root.querySelector<HTMLElement>('[data-mexico-country-summary]');
   const reading=root.querySelector<HTMLElement>('.mexico-reading-content');
   const agriculture=root.dataset.mexicoField==='agriculture';
   const selectionFromURL=(query:URLSearchParams)=>query.get('reading')==='item'||(query.get('reading')!=='overview'&&(!!query.get('state')||query.has('compare')||query.has('item')||query.has('feature')||(root.dataset.mexicoField!=='population'&&query.has('category'))||(root.dataset.mexicoField==='population'&&query.has('compositionMetric')&&query.get('compositionView')!=='overview')||((agriculture||root.dataset.mexicoField==='industry')&&query.has('metric'))));
   const mainFields=new Map(Array.from(root.querySelectorAll<HTMLAnchorElement>('.mexico-fields>a')).map(link=>[link,link.href]));
   // Mexico owns these links so the generic overview adapter cannot replace their state context.
   for(const link of mainFields.keys())link.removeAttribute('data-atlas-overview-link');
   const syncMainFields=()=>{
    const query=new URL(location.href).searchParams,code=query.get('state')??'';
    const mode=query.get('reading')==='item'?'item':query.get('reading')==='overview'?'overview':root.dataset.mexicoReadingSelected==='true'?'item':'overview';
    for(const [link,target] of mainFields){
     const url=new URL(target,location.href);
     for(const key of [...url.searchParams.keys()])if(key!=='country')url.searchParams.delete(key);
     if(/^(0[1-9]|[12][0-9]|3[0-2])$/.test(code))url.searchParams.set('state',code);
     url.searchParams.set('reading',mode);
     if(link.href!==url.href)link.href=url.href;
    }
   };
   const commitReadingMode=(selected:boolean,mode:'push'|'replace'|'none')=>{
    if(mode==='none')return;
    const url=new URL(location.href),readingMode=selected?'item':'overview';
    if(url.searchParams.get('reading')===readingMode)return;
    url.searchParams.set('reading',readingMode);
    if(mode==='push')history.pushState(history.state,'',url);else history.replaceState(history.state,'',url);
   };
   const clearAgricultureSelection=()=>{
    if(!agriculture||root.dataset.mexicoReadingSelected==='true')return;
    const select=root.querySelector<HTMLSelectElement>('[data-agriculture-state]');
    if(select?.value)root.dataset.mexicoReadingState=select.value;
    if(select)select.value='';
    const only=root.querySelector<HTMLInputElement>('[data-agriculture-only]');
    if(only){only.disabled=true;const control=only.closest<HTMLElement>('label');if(control)control.hidden=true;}
    const map=root.querySelector('[data-agriculture-map]');
    if(map?.classList.contains('is-only'))map.classList.remove('is-only');
    for(const element of root.querySelectorAll<HTMLElement|SVGElement>('[data-agriculture-state-code], [data-agriculture-stat-row], [data-agriculture-fallback-row], [data-agriculture-pick]')){
     if(element.classList.contains('is-selected'))element.classList.remove('is-selected');
     if(element.hasAttribute('aria-pressed')&&element.getAttribute('aria-pressed')!=='false')element.setAttribute('aria-pressed','false');
    }
    const description=root.querySelector('#mexico-agriculture-svg-desc');
    if(description)description.textContent='全国32州の農林業指標の分布です。指標と単位は地図下の見出し・凡例に記載しています。州を選ぶと、その州の値と説明を読めます。';
   };
   const choose='path[data-mexico-nature-feature],[data-mexico-nature-item-select],button[data-mexico-nature-category],button[data-population-category],[data-mexico-overview-state],[data-mexico-overview-shape],[data-agriculture-state],[data-agriculture-pick],[data-agriculture-state-code],[data-agriculture-metric],[data-agriculture-nature-comparison],select[data-mexico-nature-state-select],path[data-mexico-nature-state],path[data-mexico-nature-compare-state],circle[data-mexico-nature-compare-symbol],button[data-mexico-nature-view],input[data-mexico-nature-only],button[data-mexico-nature-focus],a[data-mexico-nature-compare-link],a[data-mexico-nature-plain-return],a[data-mexico-nature-source-return],[data-mi-state-select],[data-mi-metric],[data-mi-metric-button],[data-mi-source-view],[data-mi-only],[data-mi-zoom],[data-mi-shape],[data-mi-population-circle],[data-mi-electronics-link],[data-mi-population-link],[data-mi-return],[data-population-state],[data-population-state-shape],[data-population-state-symbol],[data-population-view],[data-population-only],[data-population-scale-link],[data-population-industry-link],[data-population-nature-link],[data-population-return]';
   const readingLinks='[data-agriculture-nature-comparison],[data-mexico-nature-compare-link],[data-mexico-nature-plain-return],[data-mexico-nature-source-return],[data-mi-electronics-link],[data-mi-population-link],[data-mi-return],[data-population-scale-link],[data-population-return],[data-population-industry-link],[data-population-nature-link]';
   const returnsToOverview=(link:HTMLAnchorElement,url:URL)=>url.searchParams.get('reading')==='overview'&&link.matches('[data-mi-return],[data-mexico-nature-source-return],[data-mexico-nature-plain-return],[data-population-return]');
   const prepareReadingLinks=()=>{
    for(const link of root.querySelectorAll<HTMLAnchorElement>(readingLinks)){
     const href=link.getAttribute('href');if(!href)continue;
     const url=new URL(href,location.href);
     if(url.origin===location.origin&&!returnsToOverview(link,url)&&url.searchParams.get('reading')!=='item'){url.searchParams.set('reading','item');link.href=url.href;}
    }
   };
   const showSelection=(selected:boolean,mode:'push'|'replace'|'none'='replace')=>{
    commitReadingMode(selected,mode);
    root.dataset.mexicoReadingSelected=String(selected);
    if(overview){overview.hidden=selected;overview.style.display=selected?'':'block';}
    if(countrySummary)countrySummary.hidden=selected;
    if(back)back.hidden=!selected;
    if(agriculture){
     if(reading)reading.hidden=!selected;
     if(!selected)clearAgricultureSelection();
     else{
      const select=root.querySelector<HTMLSelectElement>('[data-agriculture-state]');
      const code=select?.value||root.dataset.mexicoReadingState||'25';
      if(select)select.value=code;
      const only=root.querySelector<HTMLInputElement>('[data-agriculture-only]');
      if(only){only.disabled=false;const control=only.closest<HTMLElement>('label');if(control)control.hidden=false;root.querySelector('[data-agriculture-map]')?.classList.toggle('is-only',only.checked);}
      for(const element of root.querySelectorAll<HTMLElement|SVGElement>('[data-agriculture-state-code], [data-agriculture-stat-row], [data-agriculture-fallback-row], [data-agriculture-pick]')){
       const current=(element.getAttribute('data-agriculture-state-code')??element.getAttribute('data-agriculture-stat-row')??element.getAttribute('data-agriculture-fallback-row')??element.getAttribute('data-agriculture-pick'))===code;
       element.classList.toggle('is-selected',current);
       if(element.hasAttribute('aria-pressed'))element.setAttribute('aria-pressed',String(current));
      }
     }
    }
    prepareReadingLinks();syncMainFields();
   };
   const beforeNative=new WeakMap<Event,{href:string;length:number}>();
   const captureChoice=(event:Event)=>{
    if(!(event.target instanceof Element)||!event.target.closest(choose))return;
    beforeNative.set(event,{href:location.href,length:history.length});
    const link=event.target.closest<HTMLAnchorElement>('a');
    if(link){const url=new URL(link.href,location.href);if(url.origin===location.origin&&!returnsToOverview(link,url)){url.searchParams.set('reading','item');link.href=url.href;}}
   };
   const chooseReading=(event:Event)=>{
    if(!(event.target instanceof Element)||!event.target.closest(choose))return;
    if(event.type!=='change'&&event.target.closest('select,input'))return;
    if(event.type==='click'){const click=event as MouseEvent;if(click.button!==0||click.ctrlKey||click.metaKey||click.altKey||click.shiftKey)return;}
    const before=beforeNative.get(event);
    setTimeout(()=>{
     const nativePushed=before&&(before.href!==location.href||before.length!==history.length);
     // Population owns the distinction between its national overview and an
     // individual indicator. A category change must not invent a state choice.
     const selected=root.dataset.mexicoField==='population'?selectionFromURL(new URL(location.href).searchParams):root.dataset.mexicoField!=='overview'||!!root.querySelector<HTMLSelectElement>('[data-mexico-overview-state]')?.value;
     showSelection(selected,nativePushed?'replace':'push');
    },0);
   };
   for(const type of ['change','click','keydown'])root.addEventListener(type,captureChoice,{capture:true});
   root.addEventListener('change',chooseReading);
   root.addEventListener('click',chooseReading);
   for(const type of ['click','auxclick','focusin'])root.addEventListener(type,event=>{if(event.target instanceof Element&&event.target.closest('.mexico-fields>a'))syncMainFields();},{capture:true});
   const keyboardChoices='path[data-mexico-nature-feature],[data-mexico-overview-shape],path[data-agriculture-state-code],path[data-mexico-nature-state],path[data-mexico-nature-compare-state],circle[data-mexico-nature-compare-symbol],[data-mi-shape],[data-mi-population-circle],[data-population-state-shape],[data-population-state-symbol]';
   root.addEventListener('keydown',event=>{if(['Enter',' '].includes(event.key)&&event.target instanceof Element&&event.target.closest(keyboardChoices))chooseReading(event);});
   back?.addEventListener('click',()=>showSelection(false,'push'));
   root.addEventListener('mexico-reading-mode',event=>showSelection((event as CustomEvent<{selected:boolean}>).detail.selected,'replace'));
   root.addEventListener('keydown',event=>{if(agriculture&&event.key==='Escape')showSelection(false,'push');});
   window.addEventListener('popstate',()=>showSelection(selectionFromURL(new URL(location.href).searchParams),'none'));
   root.dataset.mexicoReadingReady='true';
   const fitReading=()=>{const panel=root.querySelector<HTMLElement>('.mexico-reading');if(!panel)return;panel.style.maxHeight=window.innerWidth>=960?`${Math.max(200,window.innerHeight-panel.getBoundingClientRect().top-12)}px`:'';};
   requestAnimationFrame(fitReading);
   window.addEventListener('resize',fitReading);
   new ResizeObserver(fitReading).observe(root.querySelector('.mexico-learning-workspace')!);
   const query=new URL(location.href).searchParams;
   showSelection((root.dataset.mexicoInitialReadingSelected??String(selectionFromURL(query)))==='true');
   new MutationObserver(prepareReadingLinks).observe(root,{subtree:true,attributes:true,attributeFilter:['href']});
   new MutationObserver(syncMainFields).observe(root,{attributes:true});
   if(agriculture){
    const updateTopics=()=>{const forestry=!!root.querySelector('[data-agriculture-reading="pine"]:not([hidden])');for(const link of root.querySelectorAll<HTMLElement>('[data-mexico-agriculture-topic]')){if((link.dataset.mexicoAgricultureTopic==='forestry')===forestry)link.setAttribute('aria-current','page');else link.removeAttribute('aria-current');}};
    new MutationObserver(updateTopics).observe(root,{subtree:true,attributes:true,attributeFilter:['hidden']});
    new MutationObserver(clearAgricultureSelection).observe(root,{subtree:true,attributes:true,attributeFilter:['class','aria-pressed']});
    updateTopics();
   }
  }
 };
 initializeMexicoReading();
 document.addEventListener('astro:page-load',initializeMexicoReading);
</script>
