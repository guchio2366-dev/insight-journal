---
import {climateAxes} from '../../lib/atlas-climate-axes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import {regionFeatures,japaneseNames,features,type CountryFeature} from '../../data/atlas/regional-atlas';
import {latinEconomyTopics} from '../../data/atlas/latin-america-economy';
import {latinSocietyTopics} from '../../data/atlas/latin-america-society';
import {latinClimateCities,climateClasses} from '../../data/atlas/latin-america-climate';
import products from '../../data/atlas/latin-america-products.json';
import overviewManifest from '../../../public/assets/atlas/latin-america-overview-v1/manifest.json';
import {withBase} from '../../lib/urls';
import 'maplibre-gl/dist/maplibre-gl.css';
import '../../styles/atlas-latin-america.css';
const {initialField='overview',legacyBasePath='/atlas/latin-america/'}=Astro.props as {initialField?:string;legacyBasePath?:string};
const basePath=withBase(legacyBasePath);
const topics=[...latinSocietyTopics,...latinEconomyTopics];
const fields=[{id:'nature',name:'自然環境',subtitle:'雨・地形・水が地域差をつくる',summary:'赤道付近のアマゾンからアンデス、乾燥する太平洋岸、温帯のパンパへ。緯度だけでなく、標高・海流・風の向きが雨と気温を変え、その違いが産地や暮らしに結び付きます。'}, {id:'agriculture',name:'農林業',subtitle:'同じ熱帯でも、作物と生産条件は違う',summary:'ブラジル内陸の大豆、パンパの穀物、中米とアンデスのコーヒー。作物ごとの収穫面積と地域の解説を重ね、土地・雨・技術・輸送が産地を支える仕組みを読みます。'},{id:'industry',name:'主要産業',subtitle:'資源の場所と、加工・市場の場所を結ぶ',summary:'アンデスの鉱物、ブラジルの鉱山と工業地帯、パナマの物流。原料の産地から加工・輸出の拠点までを、国内の地域差と結び付けて読みます。'},{id:'population',name:'人口',subtitle:'海岸・高地・河川沿いに、人と都市が集まる',summary:'ブラジル南東部の都市群、アンデス高地の都市、ラプラタ河口の集積。自然条件に加え、植民地期以来の交通・経済・移動の歴史が、現在の人口分布につながっています。'}];
const overviewField={id:'overview',name:'地理の概況',subtitle:'中南米の地理を読む',summary:'アンデス山脈、アマゾン流域、ブラジル高原、パンパ。国境と主な河川を共通の土台に、農林業・自然環境・主要産業・人口を同じ地図で読み比べます。'};
const initial=fields.find(f=>f.id===initialField)??overviewField;
const fieldTabs=['agriculture','nature','industry','population'].map(id=>fields.find(f=>f.id===id)!);
const cropChoices=[['soyb','大豆','作物'],['maiz','とうもろこし','作物'],['whea','小麦','作物'],['rice','米','作物'],['sugc','さとうきび','作物'],['coff','コーヒー（アラビカ）','作物'],['rcof','コーヒー（ロブスタ）','作物'],['bana','バナナ','作物'],['coco','カカオ','作物'],['cott','綿花','作物'],['pota','じゃがいも','作物'],['temf','温帯果樹','作物'],['cattle','牛','畜産'],['pig','豚','畜産'],['chicken','鶏','畜産'],['none','森林資源と木材生産','林業']];
const rings=(f:CountryFeature)=>f.geometry.type==='Polygon'?f.geometry.coordinates as number[][][]:(f.geometry.coordinates as number[][][][]).flat();
const merc=(lat:number)=>Math.log(Math.tan(Math.PI/4+lat*Math.PI/360))*180/Math.PI;
const project=([lon,lat]:number[])=>[lon,-merc(lat)];
const countries=regionFeatures('latin-america').map(f=>{const p=rings(f).flat();return {code:f.properties.code,name:japaneseNames[f.properties.code]??f.properties.name,bounds:[Math.min(...p.map(p=>p[0])),Math.min(...p.map(p=>p[1])),Math.max(...p.map(p=>p[0])),Math.max(...p.map(p=>p[1]))]};}).sort((a,b)=>a.name.localeCompare(b.name,'ja'));
const path=(f:CountryFeature)=>rings(f).map(r=>r.map((p,i)=>{const [x,y]=project(p);return `${i?'L':'M'}${x.toFixed(4)},${y.toFixed(4)}`;}).join('')+'Z').join('');
const frame=[-93,-merc(28),60,merc(28)-merc(-56)];
const geography=features.filter(f=>countries.some(c=>c.code===f.properties.code)||['MEX','USA'].includes(f.properties.code));
const config={products,overviewManifest,initialField,basePath,topics,fields:[overviewField,...fields],countries,cities:latinClimateCities,classes:climateClasses,assetBase:withBase('/assets/atlas/'),bounds:[-93,-56,-33,28]};
const chartX=(i:number)=>38+i*24;
---

<BaseLayout title="中南米地図｜自然環境・農林業・産業・人口" description="中南米の気候、作物分布、産業拠点、人口を同じ地図で読み比べる。" compactAtlas>
 <div data-latin-atlas>
  <AtlasWorkspaceFrame region="latin-america">
   <article class="atlas-explorer latin-atlas" data-latin-explorer data-field={initialField==='nature'?'natural':initialField==='overview'?'regional-overview':initialField} data-nature-mode="climate">
    <section class="atlas-workspace" aria-label="中南米の分野別地図">
     <div class="atlas-compact-heading"><nav aria-label="パンくずリスト"><a href={withBase('/atlas/')}>地図から見る</a><span aria-hidden="true"> / </span><a href={basePath}>中南米地図</a></nav><span data-current-place>中米・カリブ・南米</span></div>
     <h1 class="visually-hidden">中南米地図から読む、農林業・自然環境・主要産業・人口</h1>
     <div class="atlas-region-controls latin-region-shell">
      <AtlasRegionNavigation group="americas" current="latin-america" />
      <div class="latin-country-navigation" aria-label="中南米の国・地域">
       <label class="visually-hidden" for="latin-country">国・地域</label>
       <select id="latin-country" data-place aria-label="国・地域"><option value="">中南米全体</option>{countries.map(c=><option value={c.code}>{c.name}</option>)}</select>
       <button type="button" data-reset>全体に戻す</button>
      </div>
     </div>
     <nav class="atlas-tabs atlas-tabs-with-overview" aria-label="地図の分野"><a data-atlas-overview-link href={`${basePath}overview/`}>概要</a>{fieldTabs.map(f=><a href={`${basePath}${f.id}/`} data-field={f.id} aria-current={initialField===f.id?'page':undefined}>{f.name}</a>)}</nav>
     <div class="atlas-nature-controls latin-nature-controls" data-nature-controls hidden={initialField!=='nature'}>
      <div class="atlas-nature-tabs" role="tablist" aria-label="自然環境の表示切替"><button type="button" role="tab" data-view-option="climate" aria-selected="true">気候区分</button><button type="button" role="tab" data-view-option="rivers" aria-selected="false">河川・地形の解説</button></div>
      <select data-view aria-label="自然環境の表示" hidden><option value="climate">気候区分</option><option value="rivers">河川と地域</option></select>
     </div>
     <div class="atlas-primary-grid">
      <div class="atlas-map-column">
       <h2 class="visually-hidden" data-map-title>中南米の地理</h2><span class="visually-hidden" data-map-kicker>Geographic base</span>
       <div class="atlas-map-frame latin-map-frame">
        <div data-map-surface class="atlas-map-surface" role="region" tabindex="0" aria-label="拡大縮小できる中南米地図"></div>
        <svg data-map-fallback class="latin-map-fallback" viewBox={frame.join(' ')} data-default-frame={frame.join(' ')} role="img" aria-labelledby="latin-svg-title"><title id="latin-svg-title">中南米の国と地域、テーマの位置</title><g>{geography.map(f=><path d={path(f)} fill-rule="evenodd" data-map-country={countries.some(c=>c.code===f.properties.code)?f.properties.code:undefined} class={countries.some(c=>c.code===f.properties.code)?'target':'context'}><title>{japaneseNames[f.properties.code]}</title></path>)}</g><image data-fallback-raster x={frame[0]} y={frame[1]} width={frame[2]} height={frame[3]} preserveAspectRatio="none" /><g data-fallback-extra></g><g data-fallback-rivers></g><g data-fallback-markers></g></svg>
        <div class="latin-layer-switches" data-layer-switches hidden={initialField!=='agriculture'} aria-label="農畜産の表示"><button type="button" data-toggle-crops aria-pressed="true">作物の分布 ON</button><button type="button" data-toggle-livestock aria-pressed="true">畜産の分布 ON</button></div>
        <div class="atlas-map-tools" aria-label="地図操作"><button type="button" data-fit aria-label="中南米の全体を表示">全体</button><button type="button" data-zoom="1" aria-label="地図を拡大">＋</button><button type="button" data-zoom="-1" aria-label="地図を縮小">−</button></div>
        <p class="atlas-layer-caption" data-layer-caption>国境・主な河川</p>
       </div>
       <div class="atlas-key latin-product-key" data-agriculture-controls hidden={initialField!=='agriculture'}>
        {['作物','畜産','林業'].map(group=><span class="agri-picker-group"><strong>{group}</strong>{cropChoices.filter(c=>c[2]===group).map(([id,label])=><button type="button" data-crop-option={id} aria-pressed="false" style={`--product-color:${products.find(p=>p.id===id)?.color??'#708966'}`}>{label}</button>)}</span>)}
        <select data-crop aria-label="分布を見る作物・家畜" hidden>{cropChoices.map(([id,label])=><option value={id}>{label}</option>)}</select>
       </div>
       <div class="atlas-nature-key latin-legend" data-legend></div>
       <p class="latin-small" data-layer-notice role="status" hidden></p><p class="latin-map-status" data-map-status role="status">地図を準備しています</p>
       <p class="atlas-context-key latin-grid-reading" data-grid-reading aria-live="polite">地図の地域名から、解説を選べます。</p>
       <details class="latin-location-list"><summary>地域一覧から選ぶ</summary><label for="latin-topic">読む地域・テーマ</label><select id="latin-topic" data-topic aria-label="読む地域・テーマ"><option value="">分野の全体像</option>{topics.map(t=><option value={t.id}>{t.title}</option>)}</select></details>
       <details class="latin-country-list"><summary>国・地域の一覧</summary><div>{countries.map(c=><button type="button" data-country-button={c.code} aria-pressed="false">{c.name}</button>)}</div></details>
       <p class="latin-map-note">地域名は解説の代表位置です。地図操作と一覧から選べます。<a href="#latin-reading-panel">選んだ対象の解説へ</a></p>
      </div>
      <aside class="latin-reading-column" data-field-national={initialField==='nature'?'natural':initialField} aria-label="選択した地域の解説">
       <div class="atlas-national latin-reading" id="latin-reading-panel">
        <div class="latin-comparison-return" data-comparison-return hidden><button type="button" data-return>← 比較前の解説・地図に戻る</button></div>
        <div class="latin-reading-topbar" data-reading-topbar hidden><button type="button" data-reading-overview>← 分野の全体像</button></div>
        <div class="latin-city-picker" data-city-picker hidden={initialField!=='nature'}><label for="latin-city">雨温図の都市</label><select id="latin-city" data-city aria-label="都市の雨温図"><option value="">都市を選ぶ</option>{latinClimateCities.map(c=><option value={c.id}>{c.name}</option>)}</select></div>
        <div class="latin-selection-summary" data-selection-summary hidden><p class="atlas-eyebrow" data-selection-kind></p><h2 data-selection-title></h2><p class="latin-takeaway" data-selection-takeaway></p><div data-selection-actions></div></div>
        <div class="latin-product-actions" data-product-actions hidden><button type="button" data-show-selected hidden>選択した種類を表示する</button><button type="button" data-only-selected></button><button type="button" data-all-products hidden>← 作物・畜産の一枚図へ戻る</button><a href="#latin-selected-statistics">この品目の統計へ ↓</a></div>
        <div class="latin-reading-scroll" data-reading-scroll tabindex="0" role="region" aria-label="選択した項目の解説本文">
         <section data-product-panel hidden><h3>分布の読み方</h3><p data-product-definition></p><p data-product-limit></p><h3>地域の事例を読む</h3><div class="latin-topic-list" data-product-topics></div><p class="latin-small" data-product-empty hidden>この品目に対応する地域別解説は未収録です。分布と下の概算統計は確認できます。</p><p><a data-product-source href="https://cgiar-climate-data-hub.github.io/catalog/spam2020/">分布の原資料・定義</a></p></section>
         <p data-capital-missing class="latin-small" hidden></p>
         <section class="latin-overview" data-overview><header><p class="atlas-eyebrow" data-reading-field>{initial.name}</p><h2 data-overview-title>{initial.subtitle}</h2><p data-overview-summary>{initial.summary}</p></header><details><summary>地域の事例を選ぶ</summary><div class="latin-topic-list">{topics.map(t=><button type="button" data-select-topic={t.id} hidden={t.field!==initialField}><b>{t.title}</b><small>{t.placeLabel}</small></button>)}</div></details><div class="latin-overview-fields" data-overview-fields hidden={initialField!=='overview'}>{fieldTabs.map(f=><a href={`${basePath}${f.id}/`} data-open-field={f.id}><strong>{f.name}</strong><span>{f.subtitle} →</span></a>)}</div></section>
         {topics.map(t=><article class="latin-topic-reading" data-topic-panel={t.id} id={`read-${t.id}`} hidden><p class="eyebrow">{fields.find(f=>f.id===t.field)?.name} · {t.placeLabel}</p><h2>{t.title}</h2><p class="latin-takeaway">{t.summary}</p>{t.stats?.length?<dl class="latin-facts">{t.stats.map(s=><div><dt>{s.label}</dt><dd>{s.value.toLocaleString('ja-JP',{maximumFractionDigits:2})}<span>{s.unit}</span></dd><small>{s.year} · {s.scope}</small><a href={s.sourceUrl}>出典</a></div>)}</dl>:null}{t.sections.map(s=><section><h3>{s.title}</h3><p>{s.body}</p></section>)}<div class="latin-related"><h3>地図をつなげて読む</h3>{t.relatedIds.map(id=>{const target=topics.find(x=>x.id===id);return target?<button type="button" data-compare-topic={id}>{target.title}<span>→</span></button>:null})}<button type="button" data-compare-field={t.field==='nature'?'agriculture':'nature'}>{t.field==='nature'?'同じ場所で作物の分布を見る':'同じ場所で気候を見る'}<span>→</span></button></div><details class="latin-topic-sources"><summary>この解説の出典</summary><ul>{t.sources.map(s=><li><a href={s.url}>{s.label}</a>{s.period&&<span>（{s.period}）</span>}</li>)}</ul></details></article>)}
         {latinClimateCities.map(c=>{
 const axes=climateAxes(c.temperatureC,c.precipitationMm),py=(v:number)=>157-v/axes.rainMax*125,ty=(v:number)=>157-(v-axes.temperatureMin)/(axes.temperatureMax-axes.temperatureMin)*125;
 const segments:string[]=[];let segment:string[]=[];c.temperatureC.forEach((v,i)=>{if(v===null){if(segment.length)segments.push(segment.join(' '));segment=[];}else segment.push(`${chartX(i)},${ty(v)}`);});if(segment.length)segments.push(segment.join(' '));
 return <article data-city-panel={c.id} class="latin-city-reading" hidden><header><h2>気候と観測地点</h2></header><h3 class="latin-city-name">{c.name} ― {japaneseNames[c.countryCode]}</h3><p class="latin-small">この観測所の平年値を示します。国全体や地図の同色地域全体を代表する値ではありません。下の統計で雨温図と月別値を確認できます。</p><a href="#latin-selected-statistics">雨温図・月別表へ ↓</a><svg class="latin-climate-chart" viewBox={`0 0 350 ${axes.peakLabel?238:217}`} role="img" data-climate-plot data-temperature-min={axes.temperatureMin} data-temperature-max={axes.temperatureMax} data-rain-max={axes.rainMax} data-plot-top="32" data-plot-bottom="157" aria-label={`${c.name}の月別平均気温と降水量。下の表で数値を読めます。`}>
 <text x="4" y="13">mm</text><text x="320" y="13">℃</text>
 {axes.rainTicks.map(v=><g><line data-rain-tick={v} x1="32" x2="316" y1={py(v)} y2={py(v)} stroke="#b6cedb" stroke-dasharray="2 3"/><text x="28" y={v===axes.rainMax?28:py(v)+4} text-anchor="end">{v}</text></g>)}
 {!axes.rainTicks.includes(axes.rainMax)&&<text x="28" y="28" text-anchor="end" data-rain-upper>{axes.rainMax}</text>}
 {axes.temperatureTicks.map(v=><line data-temperature-tick={v} x1="32" x2="316" y1={ty(v)} y2={ty(v)} stroke="#dcc8be"/>)}
 {[...axes.temperatureTicks,...(axes.temperatureMin===-3?[-3]:[])].map(v=><text x="322" y={v===-3?169:ty(v)+4}>{v}</text>)}
 {c.precipitationMm.map((v,i)=>v!==null&&<rect x={chartX(i)-6} y={py(v)} width="12" height={157-py(v)} fill="#78b4d1"/>)}
 {segments.map(points=><polyline {points} fill="none" stroke="#c95042" stroke-width="2.5"/>)}
 {c.temperatureC.map((v,i)=>v!==null&&<circle cx={chartX(i)} cy={ty(v)} r="2.7" fill="#ab493b"/>)}
 {Array.from({length:12},(_,i)=><text data-climate-plot-month={i+1} x={chartX(i)} y="175" text-anchor="middle">{i+1}</text>)}
 <text x="42" y="203" fill="#78b4d1">■ 降水量</text><text x="165" y="203" fill="#ab493b">● 平均気温</text>
 {axes.peakLabel&&<text x="175" y="231" text-anchor="middle">{axes.peakLabel}</text>}
 </svg><section><h3>{c.name}の気候</h3><p class="latin-takeaway">{c.summary}</p><p class="latin-small">{c.period} · 観測所：{c.stationName}{c.elevationM!=null?` · 標高${c.elevationM.toLocaleString()}m`:""}</p></section><details><summary>月別の数値を見る</summary><table class="latin-months"><thead><tr><th>月</th><th>気温 ℃</th><th>降水量 mm</th></tr></thead><tbody>{c.temperatureC.map((v,i)=><tr><th>{i+1}</th><td>{v??'欠測'}</td><td>{c.precipitationMm[i]??'欠測'}</td></tr>)}</tbody></table></details><a class="latin-source-link" href={c.sourceUrl}>{c.sourceName} · 観測所 {c.stationId}</a><button class="latin-compare" type="button" data-compare-field="agriculture">この都市の周辺で作物分布を見る →</button></article>;})}
        </div>
       </div>
      </aside>
     </div>
    </section>
   </article>
    <div class="atlas-reading latin-statistics-area">
       <section id="latin-selected-statistics" class="latin-selected-statistics" data-selected-statistics hidden aria-label="選択した対象の統計">
        <div data-product-statistics hidden><h2 data-product-stat-title></h2><p class="latin-small" data-product-stat-note></p><p data-product-stat-status role="status"></p><details open><summary>収録済みの概算値を国・地域別に見る</summary><div class="latin-stat-table" data-product-stat-table></div></details><p class="latin-small"><a data-product-stat-source>集計に用いた原資料</a></p><p class="latin-small">販売総額（米ドル）は未収録です。需給・用途、輸出先、世界生産とシェアも共通定義の資料がそろっていません。以下の概算値は販売額や公式生産量の代わりにはなりません。</p></div>
        <div data-topic-statistics></div><div data-city-statistics></div>
       </section>
       <section class="latin-statistics" aria-labelledby="latin-stat-title"><div class="latin-section-heading"><div><p class="eyebrow">Country comparison · 2023</p><h2 id="latin-stat-title">国の規模と構造を比べる</h2></div><label>比較する指標<select data-statistic aria-label="比較する指標"><option value="SP.POP.TOTL">人口</option><option value="SP.URB.TOTL.IN.ZS">都市人口比率</option><option value="NV.IND.MANF.ZS">製造業のGDP比率</option><option value="NV.AGR.TOTL.ZS">農林水産業のGDP比率</option><option value="AG.LND.FRST.ZS">森林面積比率</option></select></label></div><p class="latin-small">同じ年の国全体の統計を比較します。国内の分布を示す地図とは地理単位が異なります。都市の定義は各国で異なります。</p><div data-statistics-status role="status">統計を読み込んでいます</div><div class="latin-stat-table" data-statistics-table></div><p class="latin-small"><a data-statistics-source href="https://data.worldbank.org/indicator/SP.POP.TOTL">世界銀行 World Development Indicators</a> · 欠測は「データなし」と表示。森林面積は商業林面積ではありません。</p></section>
  <footer class="latin-sources" id="latin-sources"><h2>地図の範囲と出典</h2><div><section><h3>自然環境</h3><p>気候区分は<a href="https://www.nature.com/articles/s41597-023-02549-6">Beckほか（2023）</a>の1991–2020年ケッペン＝ガイガー区分。雨温図は<a href="https://www.data.jma.go.jp/cpd/monitor/climatview/frame.php">気象庁 ClimatView</a>の観測所別平年値です。分類格子と観測所は位置・解像度が異なります。</p></section><section><h3>農業分布</h3><p><a href="https://cgiar-climate-data-hub.github.io/catalog/spam2020/">IFPRI MapSPAM 2020 v2r2 / CGIAR</a>。5分格子（赤道付近で約9km）の年間収穫面積、単位ha。統計を空間配分した推計で、畑の境界ではありません。二期作等の収穫回数を含みます。単品図は1ha以上を色で表示。一枚図は重なる格子の表示用スコア上位2品目を配色し、選択輪郭にはその品目の1ha以上の全格子を含めます。概況の色は品目間の面積比ではありません。加工済み農業データは<a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>。</p></section><section><h3>地域・拠点・統計</h3><p>解説の点は地域を読むための代表位置。鉱山や都市の実位置とは本文で区別します。出典・対象年・統計範囲は各解説に記載しています。国別統計は世界銀行の2023年値です。</p></section><section><h3>範囲と境界</h3><p>メキシコを除く中米・カリブ・南米が対象。メキシコは北米に掲載。国境と河川は<a href="https://www.naturalearthdata.com/">Natural Earth</a>。小島や細い河川は省略があります。名称と境界は出典の表現で、主権に関する見解を示しません。メルカトル図法で面積比較には適しません。</p></section></div></footer>
  <section class="latin-data-attribution"><h3>人口・畜産データと加工</h3><p>人口密度：<a href="https://doi.org/10.2905/2FF68A52-5B5B-4A22-8F40-C41DA8332CFE">European Commission JRC, GHS-POP R2023A（2020年）</a>。国勢調査等と建物情報から推計した1km格子を10km格子へ集計し、投影・地域抽出しています。居住者密度であり、昼間人口や現在の実測値ではありません。GHSLとBeckの気候データは<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>に基づき加工しました。</p><p>牛・豚・鶏：<a href="https://cgiar-climate-data-hub.github.io/catalog/glw4-2020/">FAO, GLW4 2020 / CGIAR Climate Action Data Hub</a>。5分格子の頭数密度推計（牛・豚：頭/km²、鶏：羽/km²）、CC BY 4.0。各農場の位置・面積を示すものではありません。いずれも小島や海岸の一部は格子・境界の解像度により省略されます。</p><p>人口の10km格子が海岸にかかる場合、出典で値のある1km格子の面積を分母とします。地図の色から国の総人口を計算しないでください。</p></section>
