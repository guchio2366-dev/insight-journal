---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import {regionFeatures,japaneseNames,features,type CountryFeature} from '../../data/atlas/regional-atlas';
import {latinEconomyTopics} from '../../data/atlas/latin-america-economy';
import {latinSocietyTopics} from '../../data/atlas/latin-america-society';
import {latinClimateCities,climateClasses} from '../../data/atlas/latin-america-climate';
import {withBase} from '../../lib/urls';
import 'maplibre-gl/dist/maplibre-gl.css';
import '../../styles/atlas-latin-america.css';
const topics=[...latinSocietyTopics,...latinEconomyTopics];
const fields=[{id:'nature',name:'自然環境',subtitle:'雨・地形・水が地域差をつくる',summary:'赤道付近のアマゾンからアンデス、乾燥する太平洋岸、温帯のパンパへ。緯度だけでなく、標高・海流・風の向きが雨と気温を変え、その違いが産地や暮らしに結び付きます。'}, {id:'agriculture',name:'農林業',subtitle:'同じ熱帯でも、作物と生産条件は違う',summary:'ブラジル内陸の大豆、パンパの穀物、中米とアンデスのコーヒー。作物ごとの収穫面積と地域の解説を重ね、土地・雨・技術・輸送が産地を支える仕組みを読みます。'},{id:'industry',name:'主要産業',subtitle:'資源の場所と、加工・市場の場所を結ぶ',summary:'アンデスの鉱物、ブラジルの鉱山と工業地帯、パナマの物流。原料の産地から加工・輸出の拠点までを、国内の地域差と結び付けて読みます。'},{id:'population',name:'人口',subtitle:'海岸・高地・河川沿いに、人と都市が集まる',summary:'ブラジル南東部の都市群、アンデス高地の都市、ラプラタ河口の集積。自然条件に加え、植民地期以来の交通・経済・移動の歴史が、現在の人口分布につながっています。'}];
const rings=(f:CountryFeature)=>f.geometry.type==='Polygon'?f.geometry.coordinates as number[][][]:(f.geometry.coordinates as number[][][][]).flat();
const merc=(lat:number)=>Math.log(Math.tan(Math.PI/4+lat*Math.PI/360))*180/Math.PI;
const project=([lon,lat]:number[])=>[lon,-merc(lat)];
const countries=regionFeatures('latin-america').map(f=>{const p=rings(f).flat();return {code:f.properties.code,name:japaneseNames[f.properties.code]??f.properties.name,bounds:[Math.min(...p.map(p=>p[0])),Math.min(...p.map(p=>p[1])),Math.max(...p.map(p=>p[0])),Math.max(...p.map(p=>p[1]))]};}).sort((a,b)=>a.name.localeCompare(b.name,'ja'));
const path=(f:CountryFeature)=>rings(f).map(r=>r.map((p,i)=>{const [x,y]=project(p);return `${i?'L':'M'}${x.toFixed(4)},${y.toFixed(4)}`;}).join('')+'Z').join('');
const frame=[-93,-merc(28),60,merc(28)-merc(-56)];
const geography=features.filter(f=>countries.some(c=>c.code===f.properties.code)||['MEX','USA'].includes(f.properties.code));
const config={topics,fields,countries,cities:latinClimateCities,classes:climateClasses,assetBase:withBase('/assets/atlas/'),bounds:[-93,-56,-33,28]};
const chartX=(i:number)=>38+i*24,chartT=(t:number)=>145-(t+10)/50*125;
---
<BaseLayout title="中南米地図｜自然環境・農林業・産業・人口" description="中南米の気候、作物分布、産業拠点、人口を地図と解説・統計で読み比べる。" compactAtlas>
 <div class="latin-atlas shell" data-latin-atlas>
  <p class="latin-breadcrumb"><a href={withBase('/atlas/')}>地図から見る</a> / 南北アメリカ / 中南米</p>
  <header class="latin-heading"><div><p class="eyebrow">Atlas · Latin America</p><h1>中南米</h1></div><p>自然から産業、暮らしまで。地図をつないで読む。</p></header>
  <AtlasRegionNavigation group="americas" current="latin-america" />
  <nav class="latin-fields" aria-label="中南米の分野">{fields.map((f,i)=><button type="button" data-field={f.id} aria-pressed={i===0?'true':'false'}><span>0{i+1}</span>{f.name}</button>)}</nav>
  <div class="latin-toolbar"><label>国・地域<select data-place aria-label="国・地域"><option value="">中南米全体</option>{countries.map(c=><option value={c.code}>{c.name}</option>)}</select></label><label class="latin-topic-select">読む地域・テーマ<select data-topic aria-label="読む地域・テーマ"><option value="">分野の全体像</option>{topics.map(t=><option value={t.id} data-option-field={t.field}>{t.title}</option>)}</select></label><button type="button" data-reset>全体に戻す</button></div>
  <div class="latin-layout">
   <section class="latin-map-panel" aria-labelledby="latin-map-title">
    <div class="latin-map-heading"><div><p class="eyebrow" data-map-kicker>Nature · 1991–2020</p><h2 id="latin-map-title" data-map-title>気候と地域の違い</h2></div><a href="#latin-sources">出典</a></div>
    <div class="latin-layer-controls" data-nature-controls><label>地図表示<select data-view aria-label="自然環境の表示"><option value="climate">気候区分</option><option value="rivers">河川と地域</option></select></label><label>雨温図<select data-city aria-label="都市の雨温図"><option value="">都市を選ぶ</option>{latinClimateCities.map(c=><option value={c.id}>{c.name}</option>)}</select></label></div>
    <div class="latin-layer-controls" data-agriculture-controls hidden><label>作物・家畜の分布<select data-crop aria-label="分布を見る作物・家畜"><option value="soyb">大豆</option><option value="maiz">とうもろこし</option><option value="whea">小麦</option><option value="rice">米</option><option value="sugc">さとうきび</option><option value="coff">コーヒー（アラビカ）</option><option value="rcof">コーヒー（ロブスタ）</option><option value="bana">バナナ</option><option value="coco">カカオ</option><option value="cott">綿花</option><option value="pota">じゃがいも</option><option value="temf">温帯果樹</option><option value="cattle">牛の密度</option><option value="pig">豚の密度</option><option value="chicken">鶏の密度</option><option value="none">地域の位置のみ</option></select></label><span>2020年 · 5分格子の推計</span></div>
    <div class="latin-map-frame">
     <div data-map-surface class="latin-map-surface" role="region" aria-label="中南米の操作できる地図"></div>
     <svg data-map-fallback class="latin-map-fallback" viewBox={frame.join(' ')} data-default-frame={frame.join(' ')} role="img" aria-labelledby="latin-svg-title"><title id="latin-svg-title">中南米の国と地域、テーマの位置</title><g>{geography.map(f=><path d={path(f)} fill-rule="evenodd" data-map-country={countries.some(c=>c.code===f.properties.code)?f.properties.code:undefined} class={countries.some(c=>c.code===f.properties.code)?'target':'context'}><title>{japaneseNames[f.properties.code]}</title></path>)}</g><image data-fallback-raster x={frame[0]} y={frame[1]} width={frame[2]} height={frame[3]} preserveAspectRatio="none" /><g data-fallback-rivers></g><g data-fallback-markers></g></svg>
     <div class="latin-map-state" data-map-status role="status">地図を準備しています</div>
     <div class="latin-map-tools"><button type="button" data-zoom="1" aria-label="地図を拡大">＋</button><button type="button" data-zoom="-1" aria-label="地図を縮小">−</button><button type="button" data-fit>全景</button></div>
    </div>
    <p class="latin-grid-reading" data-grid-reading aria-live="polite">地図の番号かテーマ一覧から、地域の解説を選べます。</p>
    <div class="latin-legend" data-legend></div>
    <p class="latin-map-note">番号は解説する地域の代表位置です。範囲や数量を表しません。地図は2本指で移動・拡大できます。</p>
    <details class="latin-country-list"><summary>国・地域の一覧</summary><div>{countries.map(c=><button type="button" data-country-button={c.code} aria-pressed="false">{c.name}</button>)}</div></details>
   </section>
   <aside class="latin-reading" aria-label="選択した地域の解説">
    <div class="latin-comparison-return" data-comparison-return hidden><button type="button" data-return>← 比較前の解説・地図に戻る</button></div>
    <section class="latin-overview" data-overview><p class="eyebrow" data-reading-field>自然環境</p><h2 data-overview-title>{fields[0].subtitle}</h2><p class="latin-takeaway" data-overview-summary>{fields[0].summary}</p><h3>地域から読む</h3><div class="latin-topic-list">{topics.map((t,i)=><button type="button" data-select-topic={t.id} data-list-field={t.field} hidden={t.field!=='nature'}><span>{i+1}</span><div><b>{t.title}</b><small>{t.placeLabel}</small></div></button>)}</div></section>
    {topics.map(t=><article class="latin-topic-reading" data-topic-panel={t.id} id={`read-${t.id}`} hidden><p class="eyebrow">{fields.find(f=>f.id===t.field)?.name} · {t.placeLabel}</p><h2>{t.title}</h2><p class="latin-takeaway">{t.summary}</p>{t.stats?.length?<dl class="latin-facts">{t.stats.map(s=><div><dt>{s.label}</dt><dd>{s.value.toLocaleString('ja-JP',{maximumFractionDigits:2})}<span>{s.unit}</span></dd><small>{s.year} · {s.scope}</small><a href={s.sourceUrl}>出典</a></div>)}</dl>:null}{t.sections.map(s=><section><h3>{s.title}</h3><p>{s.body}</p></section>)}<div class="latin-related"><h3>地図をつなげて読む</h3>{t.relatedIds.map(id=>{const target=topics.find(x=>x.id===id);return target?<button type="button" data-compare-topic={id}>{target.title}<span>→</span></button>:null})}<button type="button" data-compare-field={t.field==='nature'?'agriculture':'nature'}>{t.field==='nature'?'同じ場所で作物の分布を見る':'同じ場所で気候を見る'}<span>→</span></button></div><details class="latin-topic-sources"><summary>この解説の出典</summary><ul>{t.sources.map(s=><li><a href={s.url}>{s.label}</a>{s.period&&<span>（{s.period}）</span>}</li>)}</ul></details></article>)}
    {latinClimateCities.map(c=><article data-city-panel={c.id} class="latin-city-reading" hidden><p class="eyebrow">都市の雨温図 · {c.period}</p><h2>{c.name}</h2><p class="latin-takeaway">{c.summary}</p><p class="latin-small">観測所：{c.stationName}{c.elevationM!=null?` · 標高${c.elevationM.toLocaleString()}m`:''}</p><svg class="latin-climate-chart" viewBox="0 0 350 205" role="img" aria-label={`${c.name}の月別平均気温と降水量。下の表で数値を読めます。`}><text x="4" y="13">mm</text><text x="320" y="13">℃</text>{[0,200,400,600,800].map(v=><g><line x1="32" x2="316" y1={145-v/800*125} y2={145-v/800*125} stroke="#dce2e5"/><text x="28" y={149-v/800*125} text-anchor="end">{v}</text></g>)}{[-10,0,10,20,30,40].map(v=><text x="322" y={chartT(v)+4}>{v}</text>)}{c.precipitationMm.map((v,i)=>v!==null&&<rect x={chartX(i)-6} y={145-Math.min(v,800)/800*125} width="12" height={Math.min(v,800)/800*125} fill="#4b829d"/>)}<polyline points={c.temperatureC.map((v,i)=>v===null?'':`${chartX(i)},${chartT(v)}`).join(' ')} fill="none" stroke="#ab493b" stroke-width="2.5"/>{c.temperatureC.map((v,i)=>v!==null&&<circle cx={chartX(i)} cy={chartT(v)} r="2.7" fill="#ab493b"/>)}{c.temperatureC.map((_,i)=><text x={chartX(i)} y="163" text-anchor="middle">{i+1}</text>)}<text x="42" y="191" fill="#4b829d">■ 降水量</text><text x="165" y="191" fill="#ab493b">● 平均気温</text></svg><details><summary>月別の数値を見る</summary><table class="latin-months"><thead><tr><th>月</th><th>気温 ℃</th><th>降水量 mm</th></tr></thead><tbody>{c.temperatureC.map((v,i)=><tr><th>{i+1}</th><td>{v??'欠測'}</td><td>{c.precipitationMm[i]??'欠測'}</td></tr>)}</tbody></table></details><a class="latin-source-link" href={c.sourceUrl}>{c.sourceName} · 観測所 {c.stationId}</a><button class="latin-compare" type="button" data-compare-field="agriculture">この都市の周辺で作物分布を見る →</button></article>)}
   </aside>
  </div>
  <section class="latin-statistics" aria-labelledby="latin-stat-title"><div class="latin-section-heading"><div><p class="eyebrow">Country comparison · 2023</p><h2 id="latin-stat-title">国の規模と構造を比べる</h2></div><label>比較する指標<select data-statistic aria-label="比較する指標"><option value="SP.POP.TOTL">人口</option><option value="SP.URB.TOTL.IN.ZS">都市人口比率</option><option value="NV.IND.MANF.ZS">製造業のGDP比率</option><option value="NV.AGR.TOTL.ZS">農林水産業のGDP比率</option><option value="AG.LND.FRST.ZS">森林面積比率</option></select></label></div><p class="latin-small">同じ年の国全体の統計を比較します。国内の分布を示す地図とは地理単位が異なります。都市の定義は各国で異なります。</p><div data-statistics-status role="status">統計を読み込んでいます</div><div class="latin-stat-table" data-statistics-table></div><p class="latin-small"><a data-statistics-source href="https://data.worldbank.org/indicator/SP.POP.TOTL">世界銀行 World Development Indicators</a> · 欠測は「データなし」と表示。森林面積は商業林面積ではありません。</p></section>
  <footer class="latin-sources" id="latin-sources"><h2>地図の範囲と出典</h2><div><section><h3>自然環境</h3><p>気候区分は<a href="https://www.nature.com/articles/s41597-023-02549-6">Beckほか（2023）</a>の1991–2020年ケッペン＝ガイガー区分。雨温図は<a href="https://www.data.jma.go.jp/cpd/monitor/climatview/frame.php">気象庁 ClimatView</a>の観測所別平年値です。分類格子と観測所は位置・解像度が異なります。</p></section><section><h3>農業分布</h3><p><a href="https://cgiar-climate-data-hub.github.io/catalog/spam2020/">IFPRI MapSPAM 2020 v2r2 / CGIAR</a>。5分格子（赤道付近で約9km）の年間収穫面積、単位ha。統計を空間配分した推計で、畑の境界ではありません。二期作等の収穫回数を含みます。1ha以上を色で表示。加工済み農業データは<a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>。</p></section><section><h3>地域・拠点・統計</h3><p>解説の点は地域を読むための代表位置。鉱山や都市の実位置とは本文で区別します。出典・対象年・統計範囲は各解説に記載しています。国別統計は世界銀行の2023年値です。</p></section><section><h3>範囲と境界</h3><p>メキシコを除く中米・カリブ・南米が対象。メキシコは北米に掲載。国境と河川は<a href="https://www.naturalearthdata.com/">Natural Earth</a>。小島や細い河川は省略があります。名称と境界は出典の表現で、主権に関する見解を示しません。メルカトル図法で面積比較には適しません。</p></section></div></footer>
  <section class="latin-data-attribution"><h3>人口・畜産データと加工</h3><p>人口密度：<a href="https://doi.org/10.2905/2FF68A52-5B5B-4A22-8F40-C41DA8332CFE">European Commission JRC, GHS-POP R2023A（2020年）</a>。国勢調査等と建物情報から推計した1km格子を10km格子へ集計し、投影・地域抽出しています。居住者密度であり、昼間人口や現在の実測値ではありません。GHSLとBeckの気候データは<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>に基づき加工しました。</p><p>牛・豚・鶏：<a href="https://cgiar-climate-data-hub.github.io/catalog/glw4-2020/">FAO, GLW4 2020 / CGIAR Climate Action Data Hub</a>。5分格子の頭数密度推計（牛・豚：頭/km²、鶏：羽/km²）、CC BY 4.0。各農場の位置・面積を示すものではありません。いずれも小島や海岸の一部は格子・境界の解像度により省略されます。</p><p>人口の10km格子が海岸にかかる場合、出典で値のある1km格子の面積を分母とします。地図の色から国の総人口を計算しないでください。</p></section>
  <noscript><p>地図操作と表示の切り替えにはJavaScriptが必要です。上の基礎地図と出典を参照できます。</p><details open><summary>地域別解説</summary>{topics.map(t=><article><h2>{t.title}</h2><p>{t.summary}</p>{t.sections.map(s=><section><h3>{s.title}</h3><p>{s.body}</p></section>)}</article>)}</details></noscript>
  <script type="application/json" data-latin-config set:html={JSON.stringify(config).replace(/</g,'\u003c')} />
 </div>
</BaseLayout>
<script>import '../../scripts/atlas-latin-america';</script>
