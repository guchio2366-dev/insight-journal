---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import LatinAgricultureNavigation from './LatinAgricultureNavigation.astro';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-latin-learning.css';
import '../../styles/atlas-latin-review.css';
import type {LatinLearningField} from '../../lib/atlas-latin-learning-state';
import {latinIndustryLayers} from '../../lib/atlas-latin-industry';
import {latinIndustrySectors} from '../../lib/atlas-latin-industry-sectors';
interface Props {field:LatinLearningField;title:string;lead:string;description?:string;agricultureSection?:'agriculture'|'forestry'}
const {field,title,lead,description=lead,agricultureSection='agriculture'}=Astro.props;
const isForestry=field==='agriculture'&&agricultureSection==='forestry';
const fields=[['agriculture','農林業'],['nature','自然環境'],['industry','主要産業'],['population','人口']];
const sections=field==='agriculture'?[['agriculture','農畜産'],['forestry','林業']]:field==='nature'?[['climate','気候区分'],['water','水資源'],['terrain','地形'],['elevation','標高']]:field==='industry'?latinIndustrySectors.sectors.map(sector=>[sector.id,sector.label]):[['population','人口分布'],['ethnicity','民族・人種'],['religion','宗教']];
const defaultSection=sections[0][0];
---
<BaseLayout title={`${title}｜中南米地図`} {description} compactAtlas>
 <article class={`latin-workspace latin-${field}`} data-latin-workspace data-latin-reading-population={field==='population'?'true':undefined} data-latin-field={field} data-latin-agriculture-section={field==='agriculture'?agricultureSection:undefined} data-regional-forestry={isForestry?'':undefined} data-region={isForestry?'latin-america':undefined} data-latin-industry={field==='industry'?'':undefined} data-base-path={field==='industry'?withBase('/atlas/latin-america/'):undefined}>
 <AtlasWorkspaceFrame region="latin-america" mapActions={false}>
  <div class="latin-workspace-content">
   <div class="latin-compact-heading"><nav aria-label="パンくずリスト"><a href={withBase('/atlas/')}>地図から見る</a> / <a href={withBase('/atlas/latin-america/')}>中南米地図</a></nav><span>中米・カリブ・南米</span></div>
   <div class="latin-navigation"><AtlasRegionNavigation group="americas" current="latin-america" /><div class="latin-navigation-selection" data-latin-navigation-selection aria-label="地図の地域と国を選ぶ"></div></div>
   <header class="latin-header"><h1>{title}</h1><p class="latin-lead">{lead}</p></header>
   <nav class="latin-fields" aria-label="中南米の分野"><a href={withBase('/atlas/latin-america/overview/')}>概要</a>{fields.map(([id,label])=><a href={withBase(`/atlas/latin-america/${id}/`)} aria-current={field===id?'page':undefined}>{label}</a>)}</nav>
   {field!=='agriculture'?<div class="latin-subfield-band"><nav class="latin-subfields" data-industry-sector-nav={field==='industry'?'':undefined} aria-label="分野の項目">{sections.map(([id,label])=><button type="button" data-latin-section={field==='industry'?undefined:id} data-latin-industry-sector={field==='industry'?id:undefined} aria-pressed={id===defaultSection}>{label}</button>)}</nav>{field==='industry'?<><nav class="latin-subfields" data-industry-legacy-nav hidden aria-label="既存資料の項目">{latinIndustryLayers.map(layer=><button type="button" data-industry-layer-option={layer.id} aria-pressed={layer.id==='locations'}>{layer.name}</button>)}</nav><p class="latin-field-status" data-industry-layer-status>資料に基づく主要な立地例。産業名を選ぶと、ほかの分布を残して強調します。</p></>:field==='population'?<p class="latin-field-status">人口：2020年の推計密度／選択都市の人数は2018年。民族・宗教：原集計の実行政区と、範囲不明の参照記号。年代・設問は資料ごとに異なります。</p>:null}</div>:null}
   {field==='nature'?<nav class="latin-water-items" data-latin-water-items aria-label="水資源の項目" hidden><button type="button" data-latin-section="rivers">河川・地下水</button><button type="button" data-latin-section="rainfall">降水量</button><button type="button" data-latin-section="basins">河川の流域</button></nav>:null}
   <p class="latin-unavailable" data-latin-unavailable role="status" hidden></p>
   {Astro.slots.has('map')?<div class="latin-primary-grid"><section class="latin-map-column" data-map-surface tabindex="0" aria-label="地図と項目"><slot name="map" /><div class="latin-items">{field==='agriculture'?<LatinAgricultureNavigation current={agricultureSection}/>:null}<slot name="items" /></div></section><aside class="latin-reading" aria-label="全体像から選択対象の解説へ"><div class="latin-reading-fixed" data-latin-reading-fixed>{Astro.slots.has('reading-heading')?<slot name="reading-heading"/>:<p class="latin-reading-kicker">中南米の全体像・選択した場所</p>}</div><div class="latin-reading-scroll"><slot name="reading" /></div></aside></div>:null}
   <slot />
   <details class="latin-base-map-entry"><summary>基礎地図・既存の詳しい資料</summary><a href={withBase('/atlas/latin-america/base-map/')}>国境・河川・既存の解説を読む</a></details>
  </div>
 </AtlasWorkspaceFrame>
 <div class="latin-below-workspace" data-latin-below-workspace>   {Astro.slots.has('statistics')?<section class="latin-statistics" aria-label="地図の値を確かめる"><slot name="statistics" /></section>:null}
   {Astro.slots.has('sources')?<footer class="latin-sources"><slot name="sources" /></footer>:null}
</div>
 </article>
</BaseLayout>
<script>import {initLatinWorkspaceLayout} from '../../scripts/atlas-latin-workspace-layout';initLatinWorkspaceLayout();document.addEventListener('astro:page-load',initLatinWorkspaceLayout);</script>
