---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasExplorer from './AtlasExplorer.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import type { ExplorerField } from '../../data/atlas/explorer';
import '../../styles/atlas-explorer.css';
import '../../styles/atlas-industry.css';
import '../../styles/atlas-population.css';
import '../../styles/atlas-desktop.css';
import '../../styles/atlas-population-insights.css';
import '../../styles/atlas-us-responsive.css';
const { initialField='overview' } = Astro.props as {initialField?:ExplorerField};
---
<BaseLayout title="北米地図" description="自然環境・農林業・主要産業・人口を同じ地図で読み比べる。" compactAtlas noindex={Astro.url.pathname.includes('/review/')}>
  <AtlasWorkspaceFrame>
    <AtlasExplorer {initialField}>
      <div class="atlas-region-controls" slot="region-navigation"><AtlasRegionNavigation group="americas" current="north-america" country="usa" /></div>
    </AtlasExplorer>
  </AtlasWorkspaceFrame>
</BaseLayout>
