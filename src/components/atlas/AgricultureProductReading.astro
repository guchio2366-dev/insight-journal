
---
import {cornReading,cornStories} from '../../data/atlas/corn-reading';
import {withBase} from '../../lib/urls';
import {productParagraphs,productSources,productInsightOrder,insightFor,targetLabel} from '../../data/atlas/agriculture-insights';
import {agricultureInsightUrl} from '../../lib/atlas-agriculture-insight-state';
import type {ProductId} from '../../lib/atlas-agriculture-detail-state';
interface Props {product:ProductId}
const {product}=Astro.props;
const base=withBase('/atlas/north-america/');
const origin=new URL(base+'agriculture/','https://atlas.invalid');
origin.searchParams.set('agriReading','product:'+product);
origin.searchParams.set('agriProduct',product);
const emphasis:Record<ProductId,readonly string[]>={
corn:['中央低地','センターピボット','ミシシッピ川'],soybean:['輪作','大豆ミール','ミシシッピ川水系'],
wheat:['春小麦','冬小麦','ステップ気候'],cotton:['ハイプレーンズ帯水層','フロリダン帯水層系'],
rice:['沖積帯水層','サクラメント川','シャスタ湖'],specialty:['セントラルヴァレー','地下水','流域'],
beef:['放牧','肥育','飼料作物の灌漑'],dairy:['集荷・冷却・加工','乳製品加工','飼料生産'],
hogs:['エネルギー源','たんぱく源','生産の仕組み'],broilers:['とうもろこし','大豆ミール','契約農場'],layers:['集荷','包装','輸送']
};
const terms=new Set(emphasis[product]),pattern=new RegExp('('+emphasis[product].join('|')+')','g');
const links=productInsightOrder[product].map(id=>insightFor(id)!);
---
{product==='corn'?<div class="agri-editorial-reading" data-editorial-product="corn">
  <nav class="corn-story-index" aria-label="とうもろこしを読む4つの視点">
    {cornStories.map((story,index)=>{const u=agricultureInsightUrl(origin,base,product,story.id);return <a href={u.pathname+u.search} data-agri-insight-link={story.id} data-agri-link-product={product} data-corn-story-link={story.id}><small>{String(index+1).padStart(2,'0')}　{story.label}</small><strong>{story.key}</strong><span aria-hidden="true">→</span></a>;})}
  </nav>
  <details class="corn-full-reading"><summary>全体の解説を読む</summary>
  <p class="agri-editorial-takeaway"><strong data-reading-emphasis>{cornReading.takeaway}</strong></p>
  {cornReading.sections.map(section=><section class="agri-editorial-section">
    <h3>{section.heading}</h3>
    {section.subtitle&&<p class="agri-editorial-subtitle">{section.subtitle}</p>}
    <p><strong data-reading-emphasis>{section.key}</strong> {section.body}</p>
    {section.paragraphs?.map(part=><p class="agri-editorial-use"><strong data-reading-emphasis>{part.label}</strong>{part.text}</p>)}
    <nav class="agri-inline-actions" aria-label={`${section.heading}を確かめる`}>
      {section.actions.map(action=>{const u=action.insight?agricultureInsightUrl(origin,base,product,action.insight):null;return <a href={u?u.pathname+u.search:action.href} data-agri-insight-link={action.insight} data-agri-link-product={action.insight?product:undefined}>{action.label}<span aria-hidden="true"> →</span></a>;})}
    </nav>
  </section>)}
  </details>
</div>:productParagraphs[product].map(text=><p>{text.split(pattern).map(part=>terms.has(part)?<strong data-reading-emphasis>{part}</strong>:part)}</p>)}
{product!=='corn'&&links.length>0&&<nav class="agri-insight-links" aria-label="地図で確かめる">
  <strong>地図で確かめる</strong>
  <div>{links.map(item=>{const u=agricultureInsightUrl(origin,base,product,item.id);return <a href={u.pathname+u.search} data-agri-insight-link={item.id} data-agri-link-product={product}><span>{item.label}</span><small>{targetLabel(item.target)}</small></a>;})}</div>
</nav>}
<details class="agri-reading-sources"><summary>解説の出典</summary><ul>{productSources[product].map(([label,url])=><li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>)}</ul></details>
