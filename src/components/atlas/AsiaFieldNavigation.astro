---
import {industrySectors,industrySubsectors,naturalGroups,populationGroups,populationGroup} from '../../data/atlas/asia-navigation';
import {type SocialRegion} from '../../data/atlas/asia-social';
import {socialEntry} from '../../data/atlas/asia-social-overview';
import {asiaPopulationTopics} from '../../data/atlas/asia-population';
import type {AsiaField} from '../../lib/atlas-asia-state';
const {initialField,social}=Astro.props as {initialField:AsiaField;social:SocialRegion};
const populationTopics=[...asiaPopulationTopics,...social.groups.map(g=>({id:socialEntry(g.id),label:g.label}))];
---
<div class="asia-natural-controls" data-natural-topics hidden={initialField!=='natural'}>
 <nav class="asia-primary-topics" aria-label="自然環境の主題">{naturalGroups.map(t=><button type="button" data-natural-group={t.id} aria-pressed={t.id==='climate'}>{t.label}</button>)}</nav>
 <nav class="asia-secondary-topics" data-water-topics hidden aria-label="水資源の種類">{[{id:'water',label:'河川・地下水'},{id:'precipitation',label:'降水量'},{id:'basins',label:'河川の流域'}].map(t=><button type="button" data-water-view={t.id} data-natural-topic={t.id} aria-pressed="false">{t.label}</button>)}</nav>
</div>
<div class="asia-population-navigation" data-population-topics hidden={initialField!=='population'}>
 <nav class="asia-population-tabs" aria-label="人口の主題">{populationGroups.map(g=><button type="button" data-population-group={g.id} data-topic={{distribution:'density',identity:'ethnicity',religion:'religion'}[g.id]} aria-pressed={g.id==='distribution'}>{g.label}</button>)}</nav>
</div>
<div class="asia-industry-navigation" data-industry-navigation hidden={initialField!=='industry'}>
 <nav class="asia-industry-sectors" aria-label="産業の業種">{industrySectors.map(s=><button type="button" data-industry-sector={s.id} aria-pressed={s.id==='manufacturing'}>{s.label}</button>)}</nav>
 {industrySectors.filter(s=>s.id!=='all').map(s=><nav class="asia-industry-subsectors" data-industry-subsectors={s.id} aria-label={`${s.label}の分野`} hidden={s.id!=='manufacturing'}>{[{id:'all',label:'全分野'},...industrySubsectors[s.id]].map(sub=><button type="button" data-industry-subsector={sub.id} data-sector={s.id} aria-pressed={sub.id==='all'}>{sub.label}</button>)}</nav>)}
 <div class="asia-industry-guide"><strong data-industry-navigation-label>製造業 ／ 全分野</strong><span>地図に表示中：<span data-industry-current-map></span></span></div>
 <p class="asia-navigation-note" data-industry-navigation-note hidden role="status"></p>
</div>
