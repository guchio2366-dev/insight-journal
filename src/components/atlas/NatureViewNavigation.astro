---
import { natureModes, type NatureMode } from '../../data/atlas/natural-environment';
interface Props { initialMode?:NatureMode; active?:boolean }
const { initialMode='climate', active=false } = Astro.props;
---
<div class="atlas-nature-controls" data-nature-controls hidden={!active}>
  <div class="atlas-nature-tabs" role="tablist" aria-label="自然環境の表示切替">
    {natureModes.map(mode=><button type="button" role="tab" id={`nature-tab-${mode.id}`} aria-controls="nature-map-panel" data-nature-mode={mode.id} aria-selected={String(mode.id===initialMode)} tabindex={mode.id===initialMode?0:-1}>{mode.label}</button>)}
  </div>
</div>
