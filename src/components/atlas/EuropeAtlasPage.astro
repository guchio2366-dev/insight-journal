---
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import EuropeRegionNavigation from './EuropeRegionNavigation.astro';
import EuropeLayoutControls from './EuropeLayoutControls.astro';
import '../../styles/atlas-europe-workspace.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EuropeClimateReading from './EuropeClimateReading.astro';
import EuropeStatistics from './EuropeStatistics.astro';
import farmingAreas from '../../data/atlas/europe/farming-full-display.json';
import farmingDominantAreas from '../../data/atlas/europe/farming-dominant-overview.json';
import farmingSecondaryAreas from '../../data/atlas/europe/farming-secondary-overview.json';
import { farmingVisualWeight } from '../../lib/atlas-europe-farming';
import { europeFarmingGenres, europeFarmingGenreIds } from '../../data/atlas/europe/farming-genres';
import EuropeSubjectReader from './EuropeSubjectReader.astro';
import EuropePopulationCases from './EuropePopulationCases.astro';
import '../../styles/atlas-europe-comparison.css';
import { europeLayers, fields, europeFieldHeadings, type EuropeField } from '../../data/atlas/europe/layers';
import { europeForestryPlaces } from '../../data/atlas/europe/forestry-places';
import { europeReadings } from '../../data/atlas/europe/readings';
import populationCities from '../../data/atlas/europe/population-cities.json';
import statistics from '../../data/atlas/europe/country-statistics.json';
import { withBase } from '../../lib/urls';
import { frame, viewPath, project } from '../../lib/atlas-europe-view';
import geography from '../../data/atlas/europe-countries.json';
import fallbackGeography from '../../../data-source/atlas/europe/legacy-country-mask-110m-v1.json';
import countries from '../../data/atlas/europe/countries.json';
import cities from '../../data/atlas/europe/climate-cities.json';
import legend from '../../data/atlas/europe/climate-legend.json';
import wheatLegend from '../../data/atlas/europe/wheat-legend.json';
import mapLabels from '../../data/atlas/europe/map-labels.json';
import climateWater from '../../data/atlas/europe/climate-water.json';
import rivers from '../../../public/assets/atlas/europe/context-v1/rivers.json';
import waterLakes from '../../../public/assets/atlas/europe/context-v1/lakes.json';
import languageObservations from '../../data/atlas/europe/language-observations.json';
import mainLanguage from '../../data/atlas/europe/main-language-ts024-2021.json';
import riverNames from '../../data/atlas/europe/river-names.json';
import { europeTerrainGuides } from '../../data/atlas/europe/terrain-geography';
import { pew2020EuropeGroups } from '../../data/atlas/europe/pew-religion-2020';
import {smreMapGroups} from '../../lib/atlas-europe-smre-surface';
import { pewSurfaceGroups, pewSurfaceColors } from '../../lib/atlas-europe-pew-surface';

import { majorClimateCities } from '../../lib/atlas-europe-annotations';
import { europeFarmingMapName } from '../../lib/atlas-europe-farming';
import { europeMainRivers } from '../../lib/atlas-europe-drainage';
import { europeIndustryCountries, europeIndustryGroups, europeIndustryColors, europeIndustryInSector, europeIndustrySectorCopy } from '../../lib/atlas-europe-industry';
import { countryOverview, countryOverviewSource } from '../../data/atlas/europe/country-overviews';
import { europeReaderCopy } from '../../lib/atlas-europe-reader';
import '../../styles/atlas-europe.css';
import languageRegionalSources from '../../data/atlas/europe/language-regional-observations.json';
const czechRegionalLanguage=languageRegionalSources['cze-mother-tongue-regional-source-statements-2021'];
const irishDailyUse=languageRegionalSources['ireland-daily-irish-towns-2022'];
interface Props { field?: EuropeField }
const { field = 'nature' } = Astro.props;
const agriculture = field === 'agriculture';
const currentField = fields.find(f => f.id === field)!;
const regions = [{ id: 'all', name: '欧州全体' }, { id: 'north', name: '北欧' }, { id: 'west', name: '西欧' }, { id: 'south', name: '南欧' }, { id: 'east', name: '東欧' }];
const countryName = (code: string) => countries.find(c => c.code === code)?.name ?? code;
const climate = withBase('/assets/atlas/europe/climate-v1/climate.png');
const wheat = withBase('/assets/atlas/europe/wheat-v1/wheat.png');
const layers = europeLayers.map(l=>({...l,image:l.image?withBase(l.image):undefined,grid:l.grid?withBase(l.grid):undefined,manifest:l.manifest?withBase(l.manifest):undefined}));
const initialLayer = layers.find(l=>l.id===currentField.initial)!;
const initialClimateReader = field==='nature';
const climateOverview = europeReaderCopy(layers.find(l=>l.id==='climate')!);
const initialFeatures = field==='population'?populationCities:field==='industry'?europeReadings.filter(r=>r.field==='industry'&&europeIndustryInSector(r.id,'resources')):[];
const initialPointVisible = (p:{id:string;rank?:number}) => initialFeatures.some(f=>f.id===p.id)&&(p.rank??0)<=1;
const renderPriority=(feature:(typeof farmingAreas.features)[number])=>{const index=europeFarmingGenres.crops.ids.indexOf(feature.properties.id as typeof europeFarmingGenres.crops.ids[number]);return index<0?europeFarmingGenres.crops.ids.length:index;};
const displayFarmingAreas={...farmingAreas,features:[...farmingAreas.features].sort((a,b)=>renderPriority(a)-renderPriority(b))};
const riverIds:Record<string,string>={Danube:'danube',Donau:'danube',Rhine:'rhine',Rhein:'rhine',Rhin:'rhine',Seine:'seine',Thames:'thames',...Object.fromEntries(riverNames.flatMap(river=>river.sourceNames.map(name=>[name,river.id])))};
const majorRivers={type:'FeatureCollection' as const,features:rivers.features.filter(feature=>riverIds[feature.properties.sourceName]).map(feature=>({type:'Feature' as const,properties:{id:riverIds[feature.properties.sourceName],name:riverNames.find(river=>river.id===riverIds[feature.properties.sourceName])?.name??feature.properties.name},geometry:feature.geometry}))};
const riverPath=(geometry:{type:string;coordinates:unknown})=>{
  const lines=geometry.type==='MultiLineString'?geometry.coordinates as number[][][]:[geometry.coordinates as number[][]];
  return lines.map(line=>line.map((coordinate,index)=>`${index?'L':'M'}${project(coordinate).join(' ')}`).join(' ')).join(' ');
};
const industryOverviews = Object.fromEntries(europeIndustryCountries.map(code=>{const copy=countryOverview(code)!.topics.industry!;return [code,{...copy,sources:copy.sourceIds.map(id=>{const source=countryOverviewSource(id)!;const indicator=id==='society-wdi-manufacturing'?'NV.IND.MANF.ZS':id==='society-wdi-services'?'NV.SRV.TOTL.ZS':undefined;return indicator?{...source,definitionUrl:`https://databank.worldbank.org/metadataglossary/world-development-indicators/series/${indicator}`} :source;})}];}));
const config = { industryOverviews, farmingAreas:displayFarmingAreas, farmingDominantAreas, farmingSecondaryAreas, majorRivers, waterLakes, geography:fallbackGeography, geographyURL:withBase('/assets/atlas/europe/geography-v2/countries-10m.geojson.gz'), climateWater, countries, cities: cities.map(({ id, name, country, coordinates }) => ({ id, name, country, coordinates })), climate, wheat, wheatValues: withBase('/assets/atlas/europe/wheat-v1/values.bin.gz'), initialLayer: currentField.initial, layers, populationCities, readings:[...europeReadings,...europeForestryPlaces], statistics };
---
<BaseLayout title={`欧州の${currentField.label}`} description="欧州の自然環境・農林業・産業・人口を、国境をまたぐ分布と国別の数値で読み比べる地図。" compactAtlas>
  <div class="eu-atlas eu-workspace-root" data-europe-detail>
    <AtlasWorkspaceFrame region="europe">
    <div class="eu-workspace atlas-explorer" data-field={field==='nature'?'natural':field}>
    <p class="eu-breadcrumb"><a href={withBase('/atlas/')}>地図から見る</a> / <a data-base-map href={withBase('/atlas/europe/')}>欧州</a> / <span data-eu-field-label>{currentField.label}</span></p>
    <header class="eu-heading visually-hidden"><div><p class="eu-kicker" data-eu-field-kicker>EUROPE · {field.toUpperCase()}</p><h1 data-eu-field-heading>{europeFieldHeadings[field]}</h1></div><p>西欧から東欧・ロシア西部まで。<br />地図上の名前を選び、分布と説明を読み比べます。</p></header>
    <EuropeRegionNavigation industry={field==='industry'} />
    <div class="eu-country-navigation"><label>国の詳細へ <select data-eu-country-navigation><option value="">国を選ぶ</option>{countries.map(country=><option value={country.code}>{country.name}</option>)}</select></label><a data-eu-country-overview href={withBase('/atlas/europe/overview/')} hidden>選んだ国の概要を開く</a></div>
    <nav class="eu-field-nav" aria-label="欧州地図の表示"><a data-atlas-overview-link href={withBase('/atlas/europe/overview/')}>概要</a>{[fields[1],fields[0],...fields.slice(2)].map(f=><a data-eu-field={f.initial} href={withBase(`/atlas/europe/${f.id}/`)} aria-current={field===f.id?'page':undefined}>{f.id==='industry'?'主要産業':f.label}</a>)}</nav>
    <EuropeLayoutControls position="above" {field} />
    <div class="eu-water-options" data-eu-water-options hidden role="tablist" aria-label="水資源の表示">
      <button type="button" role="tab" aria-selected="true" aria-pressed="true" data-eu-topic="water">河川・湖</button><button type="button" role="tab" aria-selected="false" aria-pressed="false" tabindex="-1" data-eu-topic="precipitation">降水量 <small>1991–2020年平均</small></button><button type="button" role="tab" aria-selected="false" aria-pressed="false" tabindex="-1" data-eu-topic="drainage">河川の流域 <small>モデルの区画</small></button>
    </div>
    <div class="eu-layout">
      <section class="eu-map-panel" aria-labelledby="eu-map-title">
        <div class="eu-map-stage" data-map-surface tabindex="0" role="region" aria-label="欧州の地図">
          <EuropeLayoutControls position="map" {field} />
          <div class="eu-map-heading"><div><h2 id="eu-map-title" data-eu-map-title>{field==='industry'?'資源・エネルギーの集積':initialLayer.title}</h2><p data-eu-map-status>{initialClimateReader?'観測所の平年値・1991–2020年。':agriculture?'穀物・畑作の品目を同時表示しています。品目名を選ぶと輪郭を強調します。':'地図の分布と右側の説明を読み比べます。'}</p></div><p data-eu-focus aria-live="polite">欧州全体</p></div>
          <svg class="eu-static-map" data-eu-static viewBox={`0 0 ${frame.width} ${frame.height}`} role="img" aria-labelledby="eu-map-label">
            <title id="eu-map-label">欧州の{initialLayer.title}。{initialLayer.unit}。地図の名前から地点や品目を選べます。</title>
            <rect width={frame.width} height={frame.height} fill="#e7eff1" />
            <defs>{geography.features.map(f=><path id={`eu-country-${f.properties.code}`} d={viewPath(f.geometry)} vector-effect="non-scaling-stroke" />)}</defs>
            {geography.features.map(f => <use href={`#eu-country-${f.properties.code}`} fill="#edece5" fill-rule="evenodd" />)}
            <image data-eu-climate-image href={field === 'nature' ? climate : undefined} x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" />
            <image data-eu-wheat-image x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" />
            <image data-eu-subject-image href={field==='population'?initialLayer.image:undefined} x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" />
            <g data-eu-terrain-guides style="display:none">{europeTerrainGuides.map(guide=><polyline points={guide.line.map(point=>project(point).join(',')).join(' ')} fill="none" stroke="#574b3c" stroke-width="2" stroke-dasharray="6 4" vector-effect="non-scaling-stroke" />)}</g>
            <g data-eu-water-lakes style="display:none">{waterLakes.features.map(lake=><path d={viewPath(lake.geometry as any)} fill="#91bdd0" fill-opacity=".85" stroke="#749daa" stroke-width=".6" vector-effect="non-scaling-stroke"><title>{lake.properties.name}・Natural Earth 1:50m</title></path>)}</g>
            <g data-eu-major-rivers style="display:none">{majorRivers.features.map(river=><g><path d={riverPath(river.geometry)} data-eu-major-river-hit={river.properties.id} style={['rhine','danube','seine','thames','don','volga','ural'].includes(river.properties.id)?undefined:'display:none'} fill="none" stroke="#176783" stroke-opacity="0" stroke-width="12" pointer-events="stroke" vector-effect="non-scaling-stroke" /><path d={riverPath(river.geometry)} data-eu-major-river={river.properties.id} style={['rhine','danube','seine','thames','don','volga','ural'].includes(river.properties.id)?undefined:'display:none'} fill="none" stroke="#176783" stroke-width="2.5" vector-effect="non-scaling-stroke"><title>{river.properties.name}・Natural Earthに収録された河道の一部</title></path></g>)}</g>
            <image data-eu-drainage-selection x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" style="display:none" />
            <image data-eu-origin-image x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" style="display:none" />
            <defs>{displayFarmingAreas.features.map(f=><path id={`eu-farm-geometry-${f.properties.id}`} d={viewPath(f.geometry as any)} />)}{farmingDominantAreas.features.map(f=><path id={`eu-farm-dominant-${f.properties.id}`} d={viewPath(f.geometry as any)} />)}{farmingSecondaryAreas.features.map(f=><path id={`eu-farm-secondary-${f.properties.id}`} d={viewPath(f.geometry as any)} />)}</defs>
            <g class="eu-farming-areas" style={agriculture?'':'display:none'} data-eu-farming-shapes>
              {displayFarmingAreas.features.map(f=><use href={`#eu-farm-dominant-${f.properties.id}`} data-eu-farm-area={f.properties.id} style={europeFarmingGenres.crops.ids.some(id=>id===f.properties.id)?undefined:'display:none'} fill-rule="evenodd" fill={f.properties.color} fill-opacity=".82" stroke={f.properties.color} stroke-opacity=".22" stroke-width={farmingVisualWeight(f.properties,undefined,false).width}  vector-effect="non-scaling-stroke"><title>{f.properties.name}の主な分布</title></use>)}
            </g>
            <g class="eu-farming-secondary" style={agriculture?'':'display:none'} data-eu-farming-secondary>
              {farmingSecondaryAreas.features.map(f=><use href={`#eu-farm-secondary-${f.properties.id}`} data-eu-farm-secondary={f.properties.id} style={europeFarmingGenres.crops.ids.some(id=>id===f.properties.id)?undefined:'display:none'} fill="none" stroke={f.properties.color} stroke-width=".9" stroke-opacity=".46" stroke-dasharray="3 2" vector-effect="non-scaling-stroke" />)}
            </g>
            <g class="eu-farming-selection">
              {farmingAreas.features.map(f=><g><use href={`#eu-farm-geometry-${f.properties.id}`} data-eu-farm-outline={f.properties.id} fill="none" stroke="#fffdf2" stroke-width="5" vector-effect="non-scaling-stroke" style="display:none"/><use href={`#eu-farm-geometry-${f.properties.id}`} data-eu-farm-outline={f.properties.id} fill="none" stroke="#173c48" stroke-width="2.5" vector-effect="non-scaling-stroke" style="display:none"/></g>)}
            </g>
            {geography.features.map(f => <use href={`#eu-country-${f.properties.code}`} fill-rule="evenodd" class:list={['eu-outline', { 'eu-context': f.properties.kind === 'context' }]} data-eu-shape={f.properties.kind === 'europe' ? f.properties.code : undefined} />)}
            <g data-eu-climate-water style={initialClimateReader?'':'display:none'}>
              {climateWater.features.map(f=><path d={viewPath(f.geometry)} data-eu-water-mask={f.properties.id} fill="#e7eff1" fill-rule="evenodd" stroke="#8ca6aa" stroke-width="0.7" vector-effect="non-scaling-stroke"><title>{f.properties.name}の水面</title></path>)}
            </g>
            {cities.map(city => <g data-eu-point={city.id} class="eu-city-point" hidden={!initialClimateReader||!majorClimateCities.includes(city.id)}><circle cx={project(city.coordinates)[0]} cy={project(city.coordinates)[1]} r="6" /><text x={project(city.coordinates)[0] + 10} y={project(city.coordinates)[1] - 8}>{city.name}</text></g>)}
            {[...populationCities,...europeReadings].map(p=><g data-eu-feature-point={p.id} class="eu-city-point" hidden={!initialPointVisible(p)}><circle cx={project(p.coordinates)[0]} cy={project(p.coordinates)[1]} r="5"/><text x={project(p.coordinates)[0]+10} y={project(p.coordinates)[1]-8}>{p.name}</text></g>)}
            <g data-eu-static-codes hidden={!initialClimateReader}>{mapLabels.labels.filter(l=>!l.detail).map(l=><text x={project(l.coordinate)[0]} y={project(l.coordinate)[1]} class="eu-static-code">{l.code}</text>)}</g>
            <g data-eu-static-crops hidden></g>
            <g data-eu-comparison-overlay></g>
            <g data-eu-culture-layer></g>
            <g data-eu-language-layer></g>
          </svg>
          <div class="eu-live-map" data-eu-live aria-label="操作できる欧州地図"></div>
          <div class="eu-map-inline-key" data-eu-inline-farm-key hidden={!agriculture} aria-label="農畜産分布の品目色"><strong data-eu-farm-key-title>穀物・畑作</strong>{farmingAreas.features.map(f=><span data-eu-farm-key-item={f.properties.id} hidden={!europeFarmingGenres.crops.ids.some(id=>id===f.properties.id)}><i style={`background:${f.properties.color}`}></i>{europeFarmingMapName(f.properties.id,f.properties.name)}</span>)}<small data-eu-farm-key-note>点線＝同じ品目の色面外に続く集中域</small></div>
          <div class="eu-map-inline-key eu-map-industry-key" data-eu-inline-industry-key hidden={field!=='industry'} aria-label="産業拠点の色と分野">{europeIndustryGroups.map(group=><span data-eu-industry-key-item={group} hidden={!europeIndustrySectorCopy.resources.groups.includes(group)}><i style={`background:${europeIndustryColors[group]}`}></i>{group}</span>)}</div>
          <div class="eu-map-annotations" data-eu-annotations aria-label="地図の都市と地点"><svg aria-hidden="true"></svg></div>
          <div class="eu-farming-focus-marker" data-eu-farming-focus-marker hidden><span aria-hidden="true"></span><strong data-eu-farming-focus-point-label></strong></div>
          <span class="eu-selected-point" data-eu-selected-point role="img" aria-label="選択地点" hidden></span>
        </div>
        <div class="eu-map-legend" data-eu-map-legend><p class="eu-water-note">河川・湖の位置、年降水量、流域区画を切り替えます。地下水の歴史的な水理地質図は利用条件を確認済みですが、原画像を取得・位置合わせできていないため未収録です。</p><p data-eu-farming-regional-note hidden>農畜産の概略面は元資料の測定対象に沿って表示します。牛は乳用・肉用の合計、果樹・園芸は資料の集合品目です。酪農専用とブドウ・オリーブの個別生産域は原資料未収録です。</p><div class="eu-pew-surface-key" data-eu-pew-surface-key hidden><strong>補足：別資料の全国推計・構成詳細</strong><div role="group" aria-label="色面で見る宗教的帰属"><button type="button" data-eu-smre-overview aria-pressed="true">宗派・宗教の広域図</button>{pewSurfaceGroups.map(group=><button type="button" data-eu-pew-surface-group={group} aria-pressed="false">{pew2020EuropeGroups.find(item=>item.id===group)!.label}</button>)}</div><label>国の構成を読む <select data-eu-religion-country><option value="">欧州全体</option>{countries.map(country=><option value={country.code}>{country.name}</option>)}</select></label><p data-eu-pew-surface-note>濃い色ほど選んだ分類の全国割合が高い。灰色はPewの対象外です。国の中は均一に塗り、国内差やキリスト教の宗派は示しません。</p><div class="eu-pew-surface-scale" data-eu-pew-surface-scale>{pewSurfaceColors.unaffiliated.map((color,index)=><span><i style={`background:${color}`}></i>{['10%未満','10–25%','25–50%','50–75%','75%以上'][index]}</span>)}</div></div><div class="eu-pew-surface-key" data-eu-smre-key hidden><strong>45か国の宗教構成 · 全国集計</strong><div class="eu-pew-surface-scale">{smreMapGroups.map(group=><span><i style={`background:${group.color}`}></i>{group.label}</span>)}</div><p>色面＝各国の最大分類（過半数とは限りません）。全国割合は右の説明に記載。カ：カトリック、プ：プロテスタント、正：正教会、イ：イスラム教、無：宗教的帰属なし、他：その他のキリスト教。全国統計は国内の居住境界・人口規模を表しません。国内の宗派・無所属の実分布は未収録です。</p><small>SMRE 2010期（原観測2006–2015年）・01/2018版。国勢調査などを統合した推計で、現在の分布ではありません。<a href="https://www.smre-data.ch/en/content/download/159">Liedhegener・Odermatt（2018）, Appendix A</a> · <a href="https://www.smre-data.ch/en/content/privacy-policy-impressum">SMRE / ODbL・DBCL</a>（45か国抜粋・表示分類を付加）</small></div><div class="eu-pew-map-key" data-eu-pew-map-key hidden><strong>Pew 2020年 · 国別の宗教構成</strong><small>各小帯の幅はその国の全人口に対する7分類の割合です。国内の細地域・宗派分布ではありません。未掲載国は数値なしです。</small></div></div>
        <div class="eu-item-list" data-eu-farming-list hidden={!agriculture} aria-label="現在のジャンルの品目を選ぶ">
          <p class="eu-item-ranking-note" data-eu-farming-ranking-note>選んだジャンルの品目を同時表示します。色は品目を表し、面積や濃さで生産量を比較しません。</p>
          {europeFarmingGenreIds.map(genre=><section data-eu-farming-children={genre} hidden={genre!=='crops'}><h3>{europeFarmingGenres[genre].title}</h3><div>{europeFarmingGenres[genre].ids.map(id=>{const f=farmingAreas.features.find(feature=>feature.properties.id===id);return f?<button type="button" data-eu-layer={id} aria-pressed="false"><span class:list={['eu-item-swatch',{'is-livestock':f.properties.kind==='livestock'}]} style={{'--item-color':f.properties.color}}></span>{europeFarmingMapName(f.properties.id,f.properties.name)}</button>:null;})}{genre==='livestock'&&<button type="button" data-eu-layer="dairy" aria-pressed="false">酪農・生乳（分布未収録）</button>}</div><p class="eu-farm-missing">{europeFarmingGenres[genre].missing}</p></section>)}
          <section data-eu-farming-children="forest" hidden><h3>林業</h3><button type="button" data-eu-layer="treecover" aria-pressed="false">樹木被覆の分布 · 2021</button><button type="button" data-eu-layer="forest" aria-pressed="false">国別の森林面積比率 · 2023</button></section>
        </div>
        <div class="eu-map-candidates" data-eu-farm-candidates hidden aria-live="polite"></div>
        <div class="eu-city-choice" data-eu-city-list hidden={!initialClimateReader}><label>雨温図の都市<select data-eu-city-choice><option value="">都市を選ぶ</option>{cities.map(city=><option value={city.id}>{city.name}（{countryName(city.country)}）</option>)}</select></label></div>
