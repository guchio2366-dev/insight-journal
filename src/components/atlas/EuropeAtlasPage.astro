---
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import EuropeRegionNavigation from './EuropeRegionNavigation.astro';
import EuropeLayoutControls from './EuropeLayoutControls.astro';
import '../../styles/atlas-europe-workspace.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EuropeClimateReading from './EuropeClimateReading.astro';
import EuropeStatistics from './EuropeStatistics.astro';
import farmingAreas from '../../data/atlas/europe/farming-areas.json';
import { overviewColorCrops, farmingVisualWeight } from '../../lib/atlas-europe-farming';
import EuropeSubjectReader from './EuropeSubjectReader.astro';
import EuropePopulationCases from './EuropePopulationCases.astro';
import '../../styles/atlas-europe-comparison.css';
import { europeLayers, fields, europeFieldHeadings, type EuropeField } from '../../data/atlas/europe/layers';
import { europeReadings } from '../../data/atlas/europe/readings';
import populationCities from '../../data/atlas/europe/population-cities.json';
import statistics from '../../data/atlas/europe/country-statistics.json';
import { withBase } from '../../lib/urls';
import { frame, viewPath, project } from '../../lib/atlas-europe-view';
import geography from '../../data/atlas/europe-countries.json';
import countries from '../../data/atlas/europe/countries.json';
import cities from '../../data/atlas/europe/climate-cities.json';
import legend from '../../data/atlas/europe/climate-legend.json';
import wheatLegend from '../../data/atlas/europe/wheat-legend.json';
import mapLabels from '../../data/atlas/europe/map-labels.json';
import climateWater from '../../data/atlas/europe/climate-water.json';
import { europeTerrainGuides } from '../../data/atlas/europe/terrain-geography';

import { majorClimateCities } from '../../lib/atlas-europe-annotations';
import { europeIndustryCountries, europeIndustryGroups, europeIndustryColors } from '../../lib/atlas-europe-industry';
import { countryOverview, countryOverviewSource } from '../../data/atlas/europe/country-overviews';
import { europeReaderCopy } from '../../lib/atlas-europe-reader';
import '../../styles/atlas-europe.css';
interface Props { field?: EuropeField }
const { field = 'nature' } = Astro.props;
const agriculture = field === 'agriculture';
const currentField = fields.find(f => f.id === field)!;
const regions = [{ id: 'all', name: '欧州全体' }, { id: 'north', name: '北欧' }, { id: 'west', name: '西欧' }, { id: 'south', name: '南欧' }, { id: 'east', name: '東欧' }];
const countryName = (code: string) => countries.find(c => c.code === code)?.name ?? code;
const climate = withBase('/assets/atlas/europe/climate-v1/climate.png');
const wheat = withBase('/assets/atlas/europe/wheat-v1/wheat.png');
const layers = europeLayers.map(l=>({...l,image:l.image?withBase(l.image):undefined,grid:l.grid?withBase(l.grid):undefined,manifest:l.manifest?withBase(l.manifest):undefined}));
const initialLayer = layers.find(l=>l.id===currentField.initial)!;
const initialClimateReader = field==='nature';
const climateOverview = europeReaderCopy(layers.find(l=>l.id==='climate')!);
const initialFeatures = field==='population'?populationCities:field==='industry'?europeReadings.filter(r=>r.field==='industry'):[];
const initialPointVisible = (p:{id:string;rank?:number}) => initialFeatures.some(f=>f.id===p.id)&&(p.rank??0)<=1;
const renderPriority=(feature:(typeof farmingAreas.features)[number])=>feature.properties.kind==='livestock'?10:Math.max(0,overviewColorCrops.indexOf(feature.properties.id as typeof overviewColorCrops[number])+1);
const displayFarmingAreas={...farmingAreas,features:[...farmingAreas.features].sort((a,b)=>renderPriority(a)-renderPriority(b))};
const industryOverviews = Object.fromEntries(europeIndustryCountries.map(code=>{const copy=countryOverview(code)!.topics.industry!;return [code,{...copy,sources:copy.sourceIds.map(id=>countryOverviewSource(id))}];}));
const config = { industryOverviews, farmingAreas:displayFarmingAreas, geography, climateWater, countries, cities: cities.map(({ id, name, country, coordinates }) => ({ id, name, country, coordinates })), climate, wheat, wheatValues: withBase('/assets/atlas/europe/wheat-v1/values.bin.gz'), initialLayer: currentField.initial, layers, populationCities, readings:europeReadings, statistics };
---
<BaseLayout title={`欧州の${currentField.label}`} description="欧州の自然環境・農林業・産業・人口を、国境をまたぐ分布と国別の数値で読み比べる地図。" compactAtlas>
  <div class="eu-atlas eu-workspace-root" data-europe-detail>
    <AtlasWorkspaceFrame region="europe">
    <div class="eu-workspace atlas-explorer" data-field={field==='nature'?'natural':field}>
    <p class="eu-breadcrumb"><a href={withBase('/atlas/')}>地図から見る</a> / <a data-base-map href={withBase('/atlas/europe/')}>欧州</a> / <span data-eu-field-label>{currentField.label}</span></p>
    <header class="eu-heading visually-hidden"><div><p class="eu-kicker" data-eu-field-kicker>EUROPE · {field.toUpperCase()}</p><h1 data-eu-field-heading>{europeFieldHeadings[field]}</h1></div><p>西欧から東欧・ロシア西部まで。<br />地図上の名前を選び、分布と説明を読み比べます。</p></header>
    <EuropeRegionNavigation industry={field==='industry'} />
    <nav class="eu-field-nav" aria-label="欧州地図の表示"><a data-atlas-overview-link href={withBase('/atlas/europe/overview/')}>概要</a>{[fields[1],fields[0],...fields.slice(2)].map(f=><a data-eu-field={f.initial} href={withBase(`/atlas/europe/${f.id}/`)} aria-current={field===f.id?'page':undefined}>{f.id==='industry'?'主要産業':f.label}</a>)}</nav>
    <div class="eu-country-navigation"><label>国の詳細へ <select data-eu-country-navigation><option value="">国を選ぶ</option>{countries.map(country=><option value={country.code}>{country.name}</option>)}</select></label><a data-eu-country-overview href={withBase('/atlas/europe/overview/')} hidden>選んだ国の概要を開く</a></div>
    <EuropeLayoutControls position="above" {field} />
    <div class="eu-water-options" data-eu-water-options hidden role="tablist" aria-label="水資源の表示">
      <button type="button" role="tab" aria-selected="true" aria-pressed="true" data-eu-topic="water">河川・湖</button><button type="button" role="tab" aria-selected="false" aria-pressed="false" tabindex="-1" data-eu-topic="precipitation">降水量 <small>1991–2020年平均</small></button><button type="button" role="tab" aria-selected="false" aria-pressed="false" tabindex="-1" data-eu-topic="drainage">河川の流域 <small>モデルの区画</small></button>
    </div>
    <div class="eu-layout">
      <section class="eu-map-panel" aria-labelledby="eu-map-title">
        <div class="eu-map-stage" data-map-surface tabindex="0" role="region" aria-label="欧州の地図">
          <EuropeLayoutControls position="map" {field} />
          <div class="eu-map-buttons" role="group" aria-label="地図の縮尺と表示"><button type="button" data-eu-reset>全体へ</button><button type="button" data-eu-zoom="in" aria-label="地図を拡大">＋</button><button type="button" data-eu-zoom="out" aria-label="地図を縮小">−</button><button type="button" data-eu-render>簡易表示</button></div>
          <div class="eu-map-heading"><div><h2 id="eu-map-title" data-eu-map-title>{initialLayer.title}</h2><p data-eu-map-status>{initialClimateReader?'都市を選ぶと、その観測所の気候を表示します。':agriculture?'作物・家畜の分布を同時表示しています。品目名を選ぶと輪郭を強調します。':'地図の分布と右側の説明を読み比べます。'}</p></div><p data-eu-focus aria-live="polite">欧州全体</p></div>
          <svg class="eu-static-map" data-eu-static viewBox={`0 0 ${frame.width} ${frame.height}`} role="img" aria-labelledby="eu-map-label">
            <title id="eu-map-label">欧州の{initialLayer.title}。{initialLayer.unit}。地図の名前から地点や品目を選べます。</title>
            <rect width={frame.width} height={frame.height} fill="#e7eff1" />
            {geography.features.map(f => <path d={viewPath(f.geometry)} fill="#edece5" />)}
            <image data-eu-climate-image href={field === 'nature' ? climate : undefined} x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" />
            <image data-eu-wheat-image x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" />
            <image data-eu-subject-image href={field==='population'?initialLayer.image:undefined} x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" />
            <g data-eu-terrain-guides style="display:none">{europeTerrainGuides.map(guide=><polyline points={guide.line.map(point=>project(point).join(',')).join(' ')} fill="none" stroke="#574b3c" stroke-width="2" stroke-dasharray="6 4" vector-effect="non-scaling-stroke" />)}</g>
            <image data-eu-drainage-selection x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" style="display:none" />
            <image data-eu-origin-image x="0" y="0" width={frame.width} height={frame.height} preserveAspectRatio="none" style="display:none" />
            <defs>{displayFarmingAreas.features.map(f=><path id={`eu-farm-geometry-${f.properties.id}`} d={viewPath(f.geometry as any)} />)}</defs>
            <g class="eu-farming-areas" style={agriculture?'':'display:none'} data-eu-farming-shapes>
              {displayFarmingAreas.features.map(f=><use href={`#eu-farm-geometry-${f.properties.id}`} data-eu-farm-area={f.properties.id} fill-rule="evenodd" fill={f.properties.color} fill-opacity={farmingVisualWeight(f.properties,undefined,false).fill} stroke={f.properties.color} stroke-opacity={farmingVisualWeight(f.properties,undefined,false).line} stroke-width={farmingVisualWeight(f.properties,undefined,false).width} stroke-dasharray={f.properties.kind==='livestock'?'5 3':undefined} vector-effect="non-scaling-stroke"><title>{f.properties.name}の主な分布</title></use>)}
            </g>
            <g class="eu-farming-selection">
              {farmingAreas.features.map(f=><g><use href={`#eu-farm-geometry-${f.properties.id}`} data-eu-farm-outline={f.properties.id} fill="none" stroke="#fffdf2" stroke-width="5" vector-effect="non-scaling-stroke" style="display:none"/><use href={`#eu-farm-geometry-${f.properties.id}`} data-eu-farm-outline={f.properties.id} fill="none" stroke="#173c48" stroke-width="2.5" vector-effect="non-scaling-stroke" style="display:none"/></g>)}
            </g>
            {geography.features.map(f => <path d={viewPath(f.geometry)} class:list={['eu-outline', { 'eu-context': f.properties.kind === 'context' }]} data-eu-shape={f.properties.kind === 'europe' ? f.properties.code : undefined} />)}
            <g data-eu-climate-water style={initialClimateReader?'':'display:none'}>
              {climateWater.features.map(f=><path d={viewPath(f.geometry)} data-eu-water-mask={f.properties.id} fill="#e7eff1" fill-rule="evenodd" stroke="#8ca6aa" stroke-width="0.7" vector-effect="non-scaling-stroke"><title>{f.properties.name}の水面</title></path>)}
            </g>
            {cities.map(city => <g data-eu-point={city.id} class="eu-city-point" hidden={!initialClimateReader||!majorClimateCities.includes(city.id)}><circle cx={project(city.coordinates)[0]} cy={project(city.coordinates)[1]} r="6" /><text x={project(city.coordinates)[0] + 10} y={project(city.coordinates)[1] - 8}>{city.name}</text></g>)}
            {[...populationCities,...europeReadings].map(p=><g data-eu-feature-point={p.id} class="eu-city-point" hidden={!initialPointVisible(p)}><circle cx={project(p.coordinates)[0]} cy={project(p.coordinates)[1]} r="5"/><text x={project(p.coordinates)[0]+10} y={project(p.coordinates)[1]-8}>{p.name}</text></g>)}
            <g data-eu-static-codes hidden={!initialClimateReader}>{mapLabels.labels.filter(l=>!l.detail).map(l=><text x={project(l.coordinate)[0]} y={project(l.coordinate)[1]} class="eu-static-code">{l.code}</text>)}</g>
            <g data-eu-static-crops hidden></g>
            <g data-eu-comparison-overlay></g>
            <g data-eu-culture-layer></g>
          </svg>
          <div class="eu-live-map" data-eu-live aria-label="操作できる欧州地図"></div>
          <div class="eu-map-inline-key" data-eu-inline-farm-key hidden={!agriculture} aria-label="農畜産分布の主な色"><strong>主な色面</strong>{overviewColorCrops.map(id=>{const item=farmingAreas.features.find(f=>f.properties.id===id)!.properties;return <span><i style={`background:${item.color}`}></i>{item.name}</span>})}<small>他品目は細い輪郭。選択で強調</small></div>
          <div class="eu-map-inline-key eu-map-industry-key" data-eu-inline-industry-key hidden={field!=='industry'} aria-label="産業拠点の色と分野">{europeIndustryGroups.map(group=><span><i style={`background:${europeIndustryColors[group]}`}></i>{group}</span>)}</div>
          <div class="eu-map-annotations" data-eu-annotations aria-label="地図の都市と地点"><svg aria-hidden="true"></svg></div>
          <div class="eu-farming-focus-marker" data-eu-farming-focus-marker hidden><span aria-hidden="true"></span><strong data-eu-farming-focus-point-label></strong></div>
          <span class="eu-selected-point" data-eu-selected-point role="img" aria-label="選択地点" hidden></span>
        </div>
        <div class="eu-terrain-name-options" data-eu-terrain-name-options hidden role="group" aria-label="地形名の種類"><button type="button" data-eu-terrain-names="landforms" aria-pressed="true">山地・平原</button><button type="button" data-eu-terrain-names="coasts" aria-pressed="false">半島・島・海域</button></div>
        <div class="eu-map-legend" data-eu-map-legend><p class="eu-water-note">河川・湖の位置、年降水量、流域区画を切り替えます。地下水の歴史的な水理地質図は利用条件を確認済みですが、原画像を取得・位置合わせできていないため未収録です。</p></div>
        <div class="eu-item-list" data-eu-farming-list hidden={!agriculture} aria-label="農畜産物と林業を選ぶ">
          <p class="eu-item-ranking-note" data-eu-farming-ranking-note>作物12区分・家畜4種の分布と、酪農の生乳統計です。生産額順位ではありません。野菜・果樹の集合区分と個別作物、生体数と肉・乳・卵を同列に順位付けしません。</p>
          {(['crop','livestock'] as const).map(kind=><section data-eu-farming-children={kind}><h3>{kind==='crop'?'作物':'畜産'}</h3><div>{farmingAreas.features.filter(f=>f.properties.kind===kind).map(f=><button type="button" data-eu-layer={f.properties.id} aria-pressed="false"><span class:list={['eu-item-swatch',{'is-livestock':kind==='livestock'}]} style={{'--item-color':f.properties.color}}></span>{f.properties.name}</button>)}</div></section>)}
          <section data-eu-farming-children="dairy"><h3>酪農</h3><button type="button" data-eu-layer="dairy" aria-pressed="false">牛の生乳 · 国別統計</button></section>
          <section data-eu-farming-children="forest" hidden><h3>林業</h3><button type="button" data-eu-layer="treecover" aria-pressed="false">樹木被覆の分布 · 2021</button><button type="button" data-eu-layer="forest" aria-pressed="false">国別の森林面積比率 · 2023</button></section>
        </div>
        <div class="eu-map-candidates" data-eu-farm-candidates hidden aria-live="polite"></div>
        <div class="eu-city-choice" data-eu-city-list hidden={!initialClimateReader}><label>雨温図の都市<select data-eu-city-choice><option value="">都市を選ぶ</option>{cities.map(city=><option value={city.id}>{city.name}（{countryName(city.country)}）</option>)}</select></label></div>
        <div class="eu-item-list" data-eu-feature-list hidden aria-label="地図の地点を選ぶ"><h3>地図の名称から選ぶ</h3><div data-eu-feature-options></div></div>
        <EuropeLayoutControls position="items" {field} />
        <div class="eu-culture-controls-host" data-eu-culture-controls-host hidden></div>
        <section class="eu-origin-key" data-eu-origin-key hidden aria-label="比較元の図と凡例"><div data-eu-origin-caption></div><div data-eu-origin-legend></div><svg data-eu-origin-map hidden viewBox={`0 0 ${frame.width} ${frame.height}`} role="img" aria-label="元の分布図"></svg></section>

        <details class="eu-legend" data-eu-wheat-legend open hidden><summary>小麦の収穫面積 <span>2020年頃 · ha / 格子</span></summary><div class="eu-legend-grid">{wheatLegend.map(l => <div><span class="eu-swatch" style={`background:${l.color}`}></span><span>{l.label}</span></div>)}<div><span class="eu-swatch" style="background:repeating-linear-gradient(45deg,#fff,#fff 3px,#ccd3cc 3px,#ccd3cc 4px)"></span><span>データなし（下地が透けます）</span></div></div><details class="eu-legend-methods"><summary>対象範囲・出典</summary><p>IFPRI SPAM 2020 v2r2。全栽培方式の合計。0とデータなしを区別しています。重ね合わせでは小麦の色を半透明にするため、気候図と小麦図を切り替えて凡例を確認してください。</p></details></details>
        <div class="eu-farming-key" data-eu-farming-legend hidden={!agriculture}>
          <p><strong>主な栽培域・飼養地域 · 2020年頃</strong></p>
          <p>作物は実線、家畜は破線で示します。重なった色は新しい分類ではありません。品目を選ぶと、その分布の輪郭を濃くします。</p>
          <details class="eu-legend-methods"><summary>対象範囲・出典</summary><p>品目ごとの正値格子の上位10%が集中する場所から、条件を満たす集中域を件数で切らずに残した概略図です。全ての産地を塗った図ではありません。色のない場所や北欧でも生産がないとは限らず、色や面積で品目間の生産量を比較できません。初期表示は主要生産地域を拡大し、「欧州全域へ」で北部も確認できます。</p>
          <p>牛は肉用・乳用、鶏は肉用・採卵用を分けていません。オリーブ・ブドウ単独の分布は未収録です。</p>
          <a href={withBase('/assets/atlas/europe/farming-overview-v2/manifest.json')}>出典・分布面の加工方法</a>
          </details>
        </div>
        <div class="eu-culture-composition-key" data-eu-culture-composition-key hidden>
          <p data-eu-culture-key-intro>2021年の公表総計 · 円は同じ大きさです。角度は各対象の総人口に占める回答割合で、円の位置は対象を示す目印です。人口規模・個人の位置・細地域の分布を表しません。</p>
          <p data-eu-culture-key-coverage>イングランド・ウェールズ・クロアチアだけを掲載しています。最多・過半数の分類で土地を塗った地図ではありません。色は各表の分類を区別し、国をまたいだ同色の対応はありません。</p>
          <div class="eu-composition-tables" data-eu-composition-tables></div>
        </div>
        <p class="eu-map-caption">線は国境です。ロシアは欧州側の表示枠内を掲載しています。境界は概略で、係争地の帰属を示すものではありません。</p>
        <p class="eu-map-caption" data-eu-population-grid-note hidden={field!=='population'}>人口の格子色は2020年の約5 km格子ごとの推計密度です。国別指標は国全体の割合や変化率で、格子色と同じ単位ではありません。</p>
        <p class="eu-map-caption" data-eu-terrain-guide-note hidden>地形名の破線は山脈・平原のおおまかな軸です。正確な境界や標高値ではありません。標高の色はETOPO 2022、名称の参照は<a href="https://www.eea.europa.eu/en/analysis/maps-and-charts/mountain-massifs">EEAの山塊図</a>と<a href="https://www.nationalgeographic.org/encyclopedia/europe-physical-geography/">地理概説</a>です。</p>
        
        
        
      </section>
      <aside class="eu-read-panel" aria-labelledby={initialClimateReader?'eu-city-heading':'eu-subject-title'}>
        <div class="eu-drainage-choice" data-eu-drainage-controls hidden><label hidden>流域区画（HYBAS_ID）<select data-eu-drainage-choice tabindex="-1"><option value="">地図から区画を選ぶ</option></select></label><button type="button" data-eu-drainage-clear hidden tabindex="-1">選択を解除</button><p data-eu-basin-summary aria-live="polite">地図上の流域区画を選ぶと、その範囲と識別番号を表示します。色は区画の識別用で、量の大小ではありません。</p></div>
        <section class="eu-comparison-context" data-eu-comparison-context hidden aria-label="元の分布との比較">
          <h2 data-eu-comparison-heading></h2>
          <a data-eu-comparison-return href={withBase('/atlas/europe/agriculture/')}>元の分布へ戻る</a>
          <section class="eu-farming-comparison-focus" data-eu-farming-comparison-focus hidden aria-label="農林業と条件を比べる">
            <p data-eu-farming-focus-description></p>
            <p class="eu-farming-focus-value" data-eu-farming-focus-value hidden aria-live="polite"></p>
            <details><summary>事例の範囲・根拠</summary><p data-eu-farming-focus-scope></p><div data-eu-farming-focus-sources></div></details>
          </section>
          <details class="eu-comparison-origin"><summary>比較の問い・対象年・出典</summary><p data-eu-comparison-question></p><div data-eu-comparison-legend></div><p data-eu-comparison-scope></p><p data-eu-comparison-attribution hidden></p><a data-eu-comparison-licence hidden>元の図の利用条件（CC BY 4.0）</a><a data-eu-comparison-source>元の図の出典</a></details>
        </section>
        <div data-eu-culture-host hidden><EuropePopulationCases /></div>
        <p id="eu-industry-scope-note" class="eu-industry-scope-note" data-eu-industry-scope-note hidden={field!=='industry'}>各点は産業が集まる地域・施設の代表位置です。量・額や順位ではありません。分野を選んでも他の産業の位置を残します。国別の数値は国の概要で確認できます。</p>
        <EuropeSubjectReader layer={initialLayer} />
        <details class="eu-legend eu-climate-primary-key" data-eu-climate-legend hidden={field!=='nature'}><summary>気候分類 · 1991–2020 · 全17区分</summary><div class="eu-legend-grid">{legend.map(l => <div><span class="eu-swatch" style={`background:${l.color}`}></span><strong>{l.code}</strong><span>{l.name}</span></div>)}</div><details class="eu-legend-methods"><summary>対象範囲・出典</summary><p>区分はBeckほかのKöppen–Geiger分類。周辺の北アフリカ・西アジアも同じ色で表示します。掲載画像の元格子は0.05度で、細かな局地気候を表すものではありません。</p><p>カスピ海の水面には気候区分を表示しません。輪郭は<a href={climateWater.source.url}>Natural Earth 5.1.2（1:110m）</a>に基づきます。</p></details></details>
        <div data-eu-climate-reader hidden={!initialClimateReader}>
        <div class="eu-reader-heading"><h2 id="eu-city-heading">欧州の気候分布</h2></div>
        <section class="eu-climate-overview" data-eu-climate-overview aria-label="欧州の気候の概要">
          <p class="eu-reader-takeaway">{climateOverview.takeaway}</p>
          <p>{climateOverview.body}</p>
          <p class="eu-data-note">{climateOverview.note}</p>
          <p class="eu-data-note">地図は1991–2020年のKöppen–Geiger分類です。都市を選ぶと、1観測所の雨温図、区分の読み方、農畜産との関係を表示します。</p>
        </section>
        <div class="eu-city-readings">{cities.map(city=><EuropeClimateReading city={city} country={countryName(city.country)} />)}</div>
        <p data-eu-capital-missing hidden>対象国の首都の観測値は未収録です。地図下の都市一覧から、収録済みの観測地点を選べます。</p>
        <a class="eu-statistics-jump" href="#europe-climate-statistics" data-eu-climate-statistics-link hidden>月別の数値・年間の要約へ ↓</a>
        </div>
      </aside>
    </div>
    <noscript><p>JavaScriptが無効です。初期地図・解説一覧・出典を表示しています。主題や地点の変更にはJavaScriptが必要です。</p></noscript>
    <script type="application/json" data-eu-config set:html={JSON.stringify(config).replaceAll('<', '\\u003c')} />
    </div>
    <EuropeStatistics {field}>
        <div class="eu-grid-value" data-eu-subject-grid hidden={initialClimateReader||agriculture||!initialLayer.grid}><strong data-eu-grid-title>{initialLayer.title} · {initialLayer.unit}</strong><p data-eu-subject-result aria-live="polite">地図を押すと格子の数値を表示します。</p></div>
        <div class="eu-grid-value" data-eu-wheat-reading hidden><strong>小麦の面積を調べる</strong><p data-eu-grid-result aria-live="polite">地図を押すと、その格子に割り当てられた収穫面積（ha）を表示します。</p><p>5分角の格子ごとのモデル推計です。2020年頃の分布であり、現在の生産量や戦争の影響は表しません。面積の割合ではないため、緯度によって格子の実面積が異なる点にも注意してください。</p></div>
<details class="eu-country-reader" data-eu-country-reader hidden><summary data-eu-country-title></summary><p class="eu-data-note">2023年・国全体の統計です。格子や都市の値とは異なります。ロシアは全土の値です。</p><dl class="eu-national-values" data-eu-national-values></dl></details>
    </EuropeStatistics>
    <details class="eu-sources eu-consolidated-sources"><summary>地図・統計の出典と加工記録</summary>
      <ul>
        <li>作物：<a href="https://doi.org/10.7910/DVN/SWPENT">IFPRI SPAM 2020 v2r2・V6</a>、家畜：FAO GLW4 2020。<a href={withBase('/assets/atlas/europe/farming-overview-v2/manifest.json')}>農畜産の形状・加工記録</a>。統計：<a href="https://doi.org/10.4060/cd4313en">FAO Statistical Yearbook 2025</a>（2023年欧州・世界集計、CC BY 4.0）、<a href="https://comtradeapi.un.org/">UN Comtrade</a>（2021年の対象40報告国・地域、金額）。</li>
        <li>林業：<a href="https://ec.europa.eu/eurostat/databrowser/view/for_basic/default/table?lang=en">Eurostat for_basic</a>・<a href="https://ec.europa.eu/eurostat/databrowser/view/for_swpan/default/table?lang=en">for_swpan</a>（2024年、4か国）。樹木被覆：<a href="https://esa-worldcover.org/en/data-access">ESA WorldCover 2021</a>（CC BY 4.0、<a href={withBase('/assets/atlas/europe/tree-cover-v1/manifest.json')}>加工記録</a>）。</li>
        <li>地形・標高：NOAA NCEI ETOPO 2022、60秒角、EGM2008基準（<a href={withBase('/assets/atlas/europe/physical-v1/manifest.json')}>加工記録</a>）。河川・湖：Natural Earth 5.1.2、1:50m、パブリックドメイン。国境：Natural Earth 1:110mに微小国の1:50mを補完。</li>
        <li>気候：<a href="https://www.gloh2o.org/koppen/">Beck et al. (2023)</a>、1991–2020、CC BY 4.0（<a href={withBase('/assets/atlas/europe/climate-v1/manifest.json')}>加工記録</a>）。雨温図：<a href="https://www.data.jma.go.jp/tcc/tcc/products/climate/climatview/outline.html">気象庁 ClimatView</a>（<a href={withBase('/assets/atlas/europe/climate-v1/cities-manifest.json')}>取得記録</a>）。</li>
        <li>年降水量：<a href="https://doi.org/10.5676/DWD_GPCC/CLIMAT_V2025_025">GPCC/DWD、Rustemeier et al. (2025)</a>、1991–2020年、CC BY 4.0（<a href={layers.find(layer=>layer.id==='precipitation')!.manifest}>加工記録</a>）。流域区画：<a href="https://doi.org/10.6084/m9.figshare.9890531.v1">BasinATLAS v1.0 / HydroATLAS</a>、レベル4、CC BY 4.0（<a href={withBase('/assets/atlas/europe/drainage-v1/manifest.json')}>加工記録</a>）。</li>
        <li>人口密度：欧州委員会JRC・GHSL R2023A、2020年、CC BY 4.0（<a href={withBase('/assets/atlas/europe/population-v1/manifest.json')}>加工記録</a>）。国別統計：World Bank WDI。都市位置：Natural Earth 5.1.2（<a href={withBase('/assets/atlas/europe/context-v1/manifest.json')}>取得記録</a>）。</li>
      </ul>
      <p>FAOの世界生産シェアは2023年の公表Europe行÷World行（同品目・同単位）です。欧州はM49に基づき、ロシアは全国値を含みます。公表地域行には集計の充足条件があり、全小国の観測値を保証しません。供給熱量は同じ公表Europe行の9群・計3,490 kcal/人/日で、国別値の単純平均ではありません。</p>
      <p>UN Comtrade円の分母は、2021年の対象40報告国・地域について欧州内相手・World集計・地理帰属不明を除いた相手国別金額です。大豆輸入は9,881,386,718.92米ドル、小麦・メスリン輸出は18,924,714,476.237米ドル。小麦の製品World記録は35報告国で、関税領域とM49欧州は完全には一致しません。数量や自給率には換算しません。<a href="https://uncomtrade.org/docs/re-dissemination-of-data/">UN Comtrade再配布条件</a>。</p>
      <p>地図の格子・点と国・地域集計は別の資料です。欠測を0としていません。Insight Journalが表示範囲・配色・投影と図表を加工したもので、原機関の推薦・保証を示しません。</p>
    </details>
    </AtlasWorkspaceFrame>
