---
import {projectCanadaMap,canadaLegacyPath,canadaLegacyPoint} from '../../lib/atlas-canada-map-presentation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import NorthAmericaCountryFieldNavigation from './NorthAmericaCountryFieldNavigation.astro';
import CanadaClimateAgriculture from './CanadaClimateAgriculture.astro';
import AtlasClimatePlot from './AtlasClimatePlot.astro';
import CanadaLandformMap from './CanadaLandformMap.astro';
import CanadaNaturalLayerMap from './CanadaNaturalLayerMap.astro';
import CanadaWaterResources from './CanadaWaterResources.astro';
import {canadaClimateGroups} from '../../lib/atlas-canada-presentation';
import waterResources from '../../data/atlas/canada/water-resources.json';
import koppenGeometry from '../../../public/assets/atlas/canada-climate-elevation-v1/koppen.geojson?raw';
const elevationGeometry={type:'FeatureCollection' as const,features:[]};
import koppenManifest from '../../../public/assets/atlas/canada-climate-elevation-v1/koppen-manifest.json';
import elevationManifest from '../../../public/assets/atlas/canada-climate-elevation-v1/elevation-bands-manifest.json';
import CanadaCropNatureMap from './CanadaCropNatureMap.astro';
import climate from '../../data/atlas/canada/climate.json';
import rivers from '../../data/atlas/canada/rivers.json';
import lakes from '../../data/atlas/canada/lakes.json';
import forestry from '../../data/atlas/canada/forestry.json';
import physiography from '../../data/atlas/canada/physiography.json';
import industry from '../../data/atlas/canada/industry.json';
import industryGeometry from '../../data/atlas/canada/industry-geometry.json';
import population from '../../data/atlas/canada/population.json';
import populationGeometry from '../../data/atlas/canada/population-geometry.json';
import populationGeometryUrl from '../../data/atlas/canada/population-geometry.json?url';
import {features} from '../../data/atlas/regional-atlas';
import CanadaMapLand from './CanadaMapLand.astro';
import {climateCause,landReading,waterReading,geographySource,mechanismSource} from '../../data/atlas/canada/reading';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-canada-nature.css';
const width=900,height=580,fullFrame='0 0 900 580';
const project=projectCanadaMap;
const legacyProject=([lon,lat]:number[])=>[(lon+145)/95*width,(85-lat)/45*height];
function geometryPath(g:any):string{
 const line=(coords:number[][],closed:boolean)=>coords.map((p,i)=>{const [x,y]=project(p);return `${i?'L':'M'}${x.toFixed(2)},${y.toFixed(2)}`}).join('')+(closed?'Z':'');
 if(g.type==='LineString')return line(g.coordinates,false);
 if(g.type==='MultiLineString')return g.coordinates.map((r:number[][])=>line(r,false)).join('');
 if(g.type==='Polygon')return g.coordinates.map((r:number[][])=>line(r,true)).join('');
 if(g.type==='MultiPolygon')return g.coordinates.flat().map((r:number[][])=>line(r,true)).join('');
 return '';
}
const japaneseWater:Record<string,string>={'Mackenzie':'マッケンジー川','Fraser':'フレーザー川','Nelson':'ネルソン川','St. Lawrence':'セントローレンス川','Great Slave Lake':'グレートスレーブ湖','Great Bear Lake':'グレートベア湖','Lake Superior':'スペリオル湖','Lake Ontario':'オンタリオ湖','Lake Winnipeg':'ウィニペグ湖'};
const waterNames=Object.keys(japaneseWater).filter(name=>[...rivers.features,...lakes.features].some(f=>f.properties.name===name));
const featuredRivers=[{id:'Mackenzie',name:'マッケンジー川',point:[-120,62]},{id:'Fraser',name:'フレーザー川',point:[-123,53]},{id:'Nelson',name:'ネルソン川',point:[-96,55.2]},{id:'St. Lawrence',name:'セントローレンス川',point:[-74,47]}];
const fmt=(v:number|null)=>v===null?'未収録':v.toLocaleString('ja-JP',{minimumFractionDigits:1,maximumFractionDigits:1});
const climateGroups=canadaClimateGroups((koppenManifest as any).classes);
const elevationGroups=(elevationManifest as any).levels;
const config={cities:climate.stations.map(s=>({id:s.id,name:s.name,point:legacyProject(s.coordinates)})),waters:waterNames,width,height,layers:{climate:{groups:climateGroups,stations:(koppenManifest as any).stationSamples},elevation:{groups:elevationGroups}},industry:{...industry,geometry:industryGeometry.features},population:{...population,geometryUrl:populationGeometryUrl,geometry:populationGeometry.features.map(({id,point,bounds,provinceCodes})=>({id,point,bounds,provinceCodes}))}};
const waterConfig=JSON.parse(JSON.stringify(waterResources));
const rainDisplay=(waterConfig.datasets??waterConfig.layers).precipitation;
for(const image of rainDisplay.images??[])image.url=image.url.replace(/-mercator\.png$/, '-full-mercator.png');
rainDisplay.method=rainDisplay.method?.replace('米国と同じ7階級・配色。','米国と同じ7階級を保持し、画面の配色は多雨ほど濃い青で表示。保管画像の全域を最近傍法で投影。');
for(const layer of Object.values(waterConfig.datasets??waterConfig.layers) as any[]){
 if(layer.geometryUrl)layer.geometryUrl=withBase(layer.geometryUrl);
 if(layer.imageUrl)layer.imageUrl=withBase(layer.imageUrl);
 for(const image of [...(layer.images??[]),...(layer.classImages??[])])if(image.url)image.url=withBase(image.url);
}
import '../../styles/atlas-canada-country-parity.css';
---
<BaseLayout title="カナダの自然環境｜地形・気候・河川" description="首都オタワと沿岸・内陸・北部の気候を比べ、カナダの山地・平原・湖と河川のつながりを読む。" compactAtlas>
 <AtlasWorkspaceFrame region="north-america" mapActions={false}>
  <article class="canada-nature is-classified-climate" data-canada-nature>
   <div class="atlas-explorer atlas-workspace canada-country-primary" data-field="natural">
   <div class="atlas-compact-heading"><nav aria-label="パンくず"><a href={withBase('/atlas/')}>地図から見る</a> / <a href={withBase('/atlas/north-america/')}>北米地図</a></nav><span>カナダ</span></div>
   <AtlasRegionNavigation group="americas" current="north-america" country="canada" />
   <h1 class="visually-hidden">カナダの自然環境</h1>
   <NorthAmericaCountryFieldNavigation country="canada" field="nature" />
   <p><a href={withBase('/atlas/north-america/canada/agriculture/forestry/')} data-canada-forestry-return hidden>林業の森林図・州比較へ戻る</a></p>
   <p><a href={withBase('/atlas/north-america/canada/industry/')} data-canada-industry-return hidden>主要産業の州別構成・比較へ戻る</a></p>
   <p><a href={withBase('/atlas/north-america/canada/population/')} data-canada-population-return hidden>人口の都市圏分布・比較へ戻る</a></p>
   <p><a href={withBase('/atlas/north-america/canada/agriculture/')} data-canada-crop-return hidden>農畜産の分布・比較へ戻る</a></p>
   <nav class="canada-views country-topic-tabs" aria-label="自然環境の表示"><button data-canada-view="climate" aria-pressed="true">気候区分</button><button data-canada-view="water" aria-pressed="false">水資源</button><button data-canada-view="landform" aria-pressed="false">地形</button><button data-canada-view="elevation" aria-pressed="false">標高</button></nav>
   <nav class="country-water-topics" aria-label="水資源の内訳"><button data-canada-water-family="surface" aria-pressed="true">河川・地下水</button><button data-canada-water-family="precipitation" aria-pressed="false">降水量</button><button data-canada-water-family="drainage" aria-pressed="false">河川の流域</button></nav>
   <details class="country-water-subtopics" data-canada-water-subtopics hidden><summary>地下水の資料を見る</summary><div class="country-water-subtopic-actions"><button data-canada-water-topic="surface" aria-pressed="true">河川の地図へ戻る</button><button data-canada-water-topic="groundwater" aria-pressed="false">全国の地下水地域</button><button data-canada-water-topic="aquifers" aria-pressed="false">BCの帯水層事例</button></div></details>
   <div class="canada-workspace atlas-primary-grid">
    <CanadaWaterResources config={waterConfig} />
    <section class="canada-map-column atlas-map-column" data-canada-original-map-column aria-label="カナダの地図">
     <CanadaCropNatureMap />
     <CanadaNaturalLayerMap layer="climate" hidden={false} geometry={koppenGeometry} groups={climateGroups} geometryUrl={withBase('/assets/atlas/canada-climate-elevation-v1/koppen.geojson')} stations={climate.stations} source={(koppenManifest as any).source} />
     <CanadaNaturalLayerMap layer="elevation" lazyGeometry raster={{...elevationManifest.raster,imageUrl:withBase(`/assets/atlas/canada-climate-elevation-v1/${elevationManifest.raster.image.file}`),groups:elevationManifest.levels.map(g=>({id:g.id,bounds:g.bounds,outlineUrl:withBase(`/assets/atlas/canada-climate-elevation-v1/${g.outline.file}`),imageUrl:withBase(`/assets/atlas/canada-climate-elevation-v1/${g.isolated.file}`)}))}} geometry={elevationGeometry} groups={elevationGroups} geometryUrl={withBase('/assets/atlas/canada-climate-elevation-v1/elevation-native-classes.png')} source={(elevationManifest as any).source} />
     <section data-canada-locator hidden>
      <div class="canada-map-title"><h2>観測地点と水の位置</h2></div>
      <div class="atlas-map-frame canada-map-frame"><svg class="canada-map" data-canada-map viewBox={fullFrame} role="group" aria-labelledby="canada-map-title canada-map-desc">
       <title id="canada-map-title">カナダの観測地点、湖、河川</title><desc id="canada-map-desc">首都オタワと比較4地点を表示。都市は地図下の一覧からも選べます。湖と河川の表示では実際の概略形状を示します。</desc>
       <defs><clipPath id="canada-map-clip"><rect width={width} height={height}/></clipPath></defs>
       <g clip-path="url(#canada-map-clip)">
        <CanadaMapLand />
        <g data-canada-forest-context-map style="display:none">
         <image href={withBase('/assets/atlas/canada-forestry-v1/forest-needleleaf-2020-mercator.png')} x="0" y="0" width={width} height={height} preserveAspectRatio="none" />
        </g>
        <g data-canada-industry-context-map style="display:none" />
        <g data-canada-population-context-map style="display:none" />
        <g data-canada-water-layers hidden>
         {lakes.features.map(f=><path class="canada-lake" data-canada-water-shape={f.properties.name??''} d={geometryPath(f.geometry)} fill-rule="evenodd"><title>{japaneseWater[f.properties.name]??f.properties.name}</title></path>)}
         {rivers.features.map(f=><path class:list={['canada-river',{'is-featured':featuredRivers.some(r=>r.id===f.properties.name)}]} data-canada-water-shape={f.properties.name??''} d={geometryPath(f.geometry)}><title>{japaneseWater[f.properties.name]??f.properties.name}</title></path>)}
        </g>
        <g data-canada-river-labels hidden>{featuredRivers.map(r=>{const [x,y]=project(r.point);return <g data-canada-river-label={r.id} role="button" tabindex="0" aria-label={`${r.name}を選ぶ`} aria-pressed="false" transform={`translate(${x} ${y})`}><circle r="4"/><text x="9" y="-7">{r.name}</text></g>})}</g>
        <g data-canada-industry-water-labels style="display:none" text-anchor="middle"><text x={canadaLegacyPoint([537.9,480.5])[0]} y={canadaLegacyPoint([537.9,480.5])[1]}>スペリオル湖</text><text x={canadaLegacyPoint([557.2,530.2])[0]} y={canadaLegacyPoint([557.2,530.2])[1]}>ミシガン湖</text><text x={canadaLegacyPoint([594.8,516.0])[0]} y={canadaLegacyPoint([594.8,516.0])[1]}>ヒューロン湖</text><text x={canadaLegacyPoint([606.0,551.0])[0]} y={canadaLegacyPoint([606.0,551.0])[1]}>エリー湖</text><text x={canadaLegacyPoint([636.9,530.4])[0]} y={canadaLegacyPoint([636.9,530.4])[1]}>オンタリオ湖</text><text x={canadaLegacyPoint([682,499])[0]} y={canadaLegacyPoint([682,499])[1]}>St. Lawrence上流</text><text x={canadaLegacyPoint([806,490])[0]} y={canadaLegacyPoint([806,490])[1]} text-anchor="end">大西洋側</text></g>
        {climate.stations.map(s=>{const [x,y]=project(s.coordinates);return <g data-canada-map-city={s.id} role="button" tabindex="0" aria-label={`${s.name}の気候を読む`} aria-pressed={s.id==='ottawa'?'true':'false'}><circle cx={x} cy={y} r="6"/><text x={x+10} y={y-9}>{s.name}</text></g>;})}
        <text class="canada-ocean" x={canadaLegacyPoint([80,420])[0]} y={canadaLegacyPoint([80,420])[1]}>太平洋</text><text class="canada-ocean" x={canadaLegacyPoint([750,515])[0]} y={canadaLegacyPoint([750,515])[1]}>大西洋</text><text class="canada-ocean" x={canadaLegacyPoint([400,38])[0]} y={canadaLegacyPoint([400,38])[1]}>北極海</text><text class="canada-ocean" x={canadaLegacyPoint([550,265])[0]} y={canadaLegacyPoint([550,265])[1]}>ハドソン湾</text>
       </g>
      </svg>
       <div class="canada-map-actions canada-nature-map-tools"><button type="button" data-country-button="CAN" data-canada-reset aria-label="カナダ南部を表示">南部</button><button type="button" data-canada-whole aria-label="北極圏を含むカナダ全域を表示">全域</button><button data-canada-zoom="in" aria-label="地図を拡大">＋</button><button data-canada-zoom="out" aria-label="地図を縮小">−</button><button data-canada-focus aria-label="選んだ都市の位置へ">都市へ</button></div>
      </div>
      <p class="canada-caption" data-canada-forest-context-legend hidden><i style={`display:inline-block;width:18px;height:12px;background:rgb(${forestry.classes[0].color.join(',')})`} aria-hidden="true"/> 温帯・亜寒帯の針葉樹林（NRCan、2020年、元データ30m）。位置図と同じ範囲に重ねています。気候は点の位置の1991–2020年平年値です。<a href={withBase('/atlas/north-america/canada/agriculture/forestry/#canada-forestry-sources')}>森林分類・利用条件</a></p>
      <p class="canada-caption" data-canada-industry-context-legend hidden></p>
      <p class="canada-caption" data-canada-population-context-legend hidden></p>
      <p class="canada-caption" data-canada-position-caption>点は観測地点の位置、灰色は周辺の陸地。気候区分と同じメルカトル投影・表示範囲です。面積比較には使いません。都市を選んでも表示範囲を勝手に変えません。</p>
     </section>
     <section data-canada-physical hidden aria-label="地形地域の分布">
      <CanadaLandformMap />
      <details class="canada-landform-original"><summary>旧版の公式紙地図を資料として読む</summary><figure>
       <a href={withBase('/assets/atlas/canada-nature-v1/physiographic-regions-full.jpg')}><img src={withBase('/assets/atlas/canada-nature-v1/physiographic-regions.jpg')} alt="NRCanの2009年保存版の紙地図。主地図とは別版の出典資料。" width="1600" height="1433" loading="lazy" /></a><figcaption>NRCan『Atlas of Canada』第6版、2009年の保存版。地形分類の基礎資料は1967年。ランベルト正角円錐図法で、主地図とは投影が異なります。主地図の輪郭はこの画像をトレースせず、別の公式GISを使います。<a href={geographySource}>原典と利用条件</a></figcaption>
      </figure></details>
     </section>
     <div class="canada-city-list" aria-label="観測地点を選ぶ">{climate.stations.map(s=><button data-canada-city-button={s.id} aria-pressed={s.id==='ottawa'?'true':'false'}>{s.name}{s.id==='ottawa'?'（首都）':''}</button>)}</div>

    </section>
    <aside class="canada-reading atlas-national" data-canada-original-reading aria-label="地図と一緒に読む"><p data-population-geometry-status hidden></p>
   <header class="canada-national-header"><p class="atlas-eyebrow">Canada · Natural environment</p><h2>カナダの自然環境</h2><p class="canada-lead">西部山地からプレーリー、五大湖・セントローレンス低地へ。人が暮らし、農業や産業が集まる南部から、気候と水の違いを読む。</p></header>

     <section class="canada-comparison-context" data-canada-crop-context hidden><h2 data-canada-crop-context-title></h2><p data-canada-crop-context-text></p><p class="canada-caption" data-canada-crop-scope></p><div data-canada-crop-mini hidden></div><details><summary>元の図・比較年・利用条件</summary><p data-canada-crop-origin></p><p data-canada-crop-mechanism></p><p>地域地図は2021年農業センサスのCCS別申告値で固定し、州比較は元ページで選んだ別の年次統計です。農場本拠地に集計した面積・頭数で、輪郭は実際の畑・放牧地・牛の所在地ではありません。非公表Fと未収録をゼロに変えません。<a href="https://www.statcan.gc.ca/en/terms-conditions/open-licence">Statistics Canada Open Licence</a>。Adapted from Statistics Canada, 2021 Census of Agriculture, Tables 32-10-0309-01, 32-10-0370-01 and 32-10-0249-01, accessed October 2, 2026. This does not constitute an endorsement by Statistics Canada of this product. 境界の原典・利用条件、各指標の定義と品質は元の農畜産ページに保持しています。</p></details></section>
     <section class="canada-comparison-context" data-canada-forest-context hidden><h2>森林と沿岸気候を比べる</h2><p data-canada-forest-context-text></p><p class="canada-caption">Vancouverは沿岸1地点。BC全域平均ではありません。</p><details><summary>比較の年・範囲</summary><p class="canada-caption">Vancouverは沿岸1地点。BC全域平均ではありません。森林2020年／気候1991–2020年。</p></details></section>
     <section class="canada-comparison-context" data-canada-industry-context hidden><h2 data-canada-industry-context-heading></h2><p data-canada-industry-context-text></p><svg class="canada-map" data-canada-industry-context-mini-map viewBox="0 0 900 580" role="img" aria-label="元の州内GDP割合分布：別投影の地形図と左右で照合" style="display:none"></svg><p class="canada-caption" data-canada-industry-context-mini-legend hidden></p><details><summary>比較の年・分母と出典</summary><p>州内GDP割合は基本価格・当年価格。境界2021年、気候1991–2020年、水系Natural Earth概形。地図の位置だけから産業の原因や輸送経路を確定しません。<a href={withBase('/atlas/north-america/canada/industry/#canada-industry-sources')}>公式構成比・境界・交通の根拠</a></p></details></section>
     <section class="canada-comparison-context" data-canada-population-context hidden><h2>都市圏の集中と自然条件を比べる</h2><p data-canada-population-context-text></p><svg class="canada-map" data-canada-population-context-mini-map viewBox="0 0 900 580" role="img" aria-label="元の都市圏分布：別投影の地形図と左右で照合" style="display:none"></svg><p class="canada-caption" data-canada-population-context-mini-legend hidden></p><details><summary>都市圏・気候・水域の対象と出典</summary><p>CMAは自治体と通勤等で結びついた都市圏です。地図は2021年境界で固定し、人口は2016/2021年、密度は2021年です。気候は1991–2020年の観測地点で都市圏全体平均ではありません。<a href={withBase('/atlas/north-america/canada/population/#canada-population-sources')}>定義・公式数値・境界・交通の根拠</a></p></details></section>
      <section data-canada-reading="climate">
      <div class="canada-climate-cards">
       {climate.stations.map(s=><section class="canada-climate-card" data-canada-climate-card={s.id} hidden={s.id!=='ottawa'}>

        <AtlasClimatePlot name={s.name} period="1991–2020" temperatureC={s.temperatureC} precipitationMm={s.precipitationMm} />
        <p class="canada-plot-key">青棒：降水量mm ／ 赤線：平均気温℃ ／ ×：未収録</p>
        <div class="canada-forest-climate-bridge" data-canada-forest-climate-bridge hidden>
         <p class="canada-takeaway" data-canada-forest-climate-bridge-text></p>
         <p class="canada-caption">Vancouverは沿岸の1地点で、BC州全域の平均ではありません。森林分類は2020年、気候は1991–2020年の平年値です。</p>
         <div data-canada-forest-climate-return-slot></div>
        </div>

        <CanadaClimateAgriculture city={s.id} />
        <dl class="canada-climate-facts"><div><dt>年平均気温</dt><dd>{fmt(s.annualTemperatureC)} ℃</dd></div><div><dt>年降水量</dt><dd>{fmt(s.annualPrecipitationMm)} mm</dd></div><div><dt>1月／7月の平均気温</dt><dd>{fmt(s.temperatureC[0])} ／ {fmt(s.temperatureC[6])} ℃</dd></div></dl>
        <p class="canada-sources-inline"><a href={s.sourceUrl}>月別値・合成観測系列の原典</a> ／ <a href={mechanismSource}>気候の地域差を読む資料</a></p>
        <details><summary>12か月の数値・観測地点</summary><p>{s.composite} · 基準観測所 {s.station}（{s.climateId}）· {s.coordinates[1]}°N / {Math.abs(s.coordinates[0])}°W · 標高 {s.elevationM} m。観測所の構成と要素別の使用期間は原典のComposite Metadata / Threadsを参照。</p><table><caption>{s.name}の1991–2020年平年値</caption><thead><tr><th>月</th><th>平均気温 ℃</th><th>降水量 mm</th></tr></thead><tbody>{s.temperatureC.map((t,i)=><tr><th>{i+1}</th><td>{fmt(t)}</td><td>{fmt(s.precipitationMm[i])}</td></tr>)}</tbody></table></details>
       </section>)}
       </div>
       <section class="canada-climate-class-reading" data-canada-zone-reading><h2 data-canada-zone-title>南部の季節差と、北部の寒冷な気候を読む</h2><p class="canada-takeaway" data-canada-zone-text>色は1991–2020年のケッペン気候区分。都市の月別値と照合し、冬の寒さ・夏の長さ・雨の季節配分を区別します。</p><p class="canada-caption" data-canada-zone-city></p></section>
<details class="canada-climate-options"><summary>都市の選択・比較と観測期間</summary>      <div class="canada-city-controls"><label>読む都市<select data-canada-city>{climate.stations.map(s=><option value={s.id} selected={s.id==='ottawa'}>{s.name}</option>)}</select></label><label>比べる都市<select data-canada-compare><option value="">比較なし</option>{climate.stations.map(s=><option value={s.id}>{s.name}</option>)}</select></label></div>
      <p class="canada-period">ECCC 1991–2020年平年値 · 全地点を同じ尺度で比較</p>
</details>
       <details><summary>降水量と観測系列の読み方</summary><p>降水量は雨と雪などを水量に換算した合計です。今の天気や国全体の平均ではありません。複数観測所をつないだ合成系列を含みます。</p></details>
      </section>
      <section data-canada-reading="elevation" hidden><h2 data-canada-elevation-title>西の山地と東の低地を、500 mごとの色面で比べる</h2><p class="canada-takeaway" data-canada-elevation-text>西部では濃い色の山地が連なり、その東の内陸平原からハドソン湾沿岸・五大湖周辺へ高さが下がります。色の境界で500 mごとの高さの違いを読みます。境界が近い所ほど短い距離で高さが変わり、山越えの交通や川が高地から低地へ流れる向きを読む手掛かりになります。</p><p class="canada-caption">ETOPO2022の60秒格子から作図。単位m、EGM2008基準。元格子を500 m幅に分類し、色を混ぜずに地図投影へ写した全国的な概略図です。輪郭は表示格子の区分境界で、元の角度解像度は60秒です。細かな島の個数や区分の面積をこの図から読み取ることはできません。灰色の0 m未満には海岸線と格子の解像度差も含まれ、陸上の窪地や洪水域とは限りません。2022はモデルの版で、全地点の観測年ではありません。</p><details><summary>地形地域と標高の違い</summary><p>「地形」は山地・平原・楯状地などの地域分類、「標高」は高さです。同じ地域の中にも標高差があります。地形タブと切り替え、地域名と標高の色面を照合できます。</p><a href={(elevationManifest as any).source?.catalogueUrl}>ETOPO2022の原典</a></details></section>
     <section data-canada-reading="landform" hidden>
      <h2 data-canada-landform-reading-title>山地・平原・低地を、場所で見分ける</h2>
      <p class="canada-takeaway" data-canada-landform-reading-text>西部の山地、中央の平原、東部の盾状地を比較します。地図か凡例で地域を選ぶと、その範囲と説明が対応します。</p>
      <p class="canada-caption">選んだ地域だけを輪郭で強調します。背景の線は500・1,000・2,000 mの等高線、青は河川・湖です。NRCanの広域地形区分で、個別の山脈・低地とは尺度が異なります。</p>
      <p class="canada-sources-inline"><a href={physiography.source.descriptionUrl}>地形区分の定義</a> ／ <a href={physiography.source.catalogueUrl}>公式GISの出典</a></p>
      <details class="canada-general-reading" data-canada-general-reading><summary>全国の地形と気候・水の関係</summary>{landReading.map(r=><section class="canada-reading-section"><h3>{r.title}</h3><p>{r.body}</p></section>)}<p>都市の気候や湖・河川は、上の表示タブから場所を照合できます。地域区分だけから作物・産業の立地を断定しません。</p></details>
     </section>
     <section data-canada-reading="water" hidden>     <details class="canada-water-controls" data-canada-water-controls hidden><summary>ほかの川・湖を選ぶ</summary><label>水系・湖<select data-canada-water><option value="">全体を読む</option>{waterNames.map(name=><option value={name}>{japaneseWater[name]}</option>)}</select></label><label><input type="checkbox" data-canada-only /> <span data-canada-only-label>選んだ川・湖だけを表示</span></label><button data-canada-all-water>すべての水系へ戻す</button><p>川と湖はNatural Earth v5.1.2の1:50m概略形状。国境をまたぐ水系を含みます。</p></details><h2 data-canada-water-reading-title>四つの河川と海への出口</h2><p class="canada-takeaway" data-canada-water-reading-text>マッケンジー川は北極海、フレーザー川は太平洋、ネルソン川はハドソン湾、セントローレンス川は大西洋側へ向かいます。地図の川名から選ぶと、右にその川の説明が出ます。</p><p class="canada-caption" data-canada-water-reading-scope>線は川、面は湖の概略形状です。流量・水質・地下水・流域境界の地図ではありません。</p><details class="canada-general-reading" data-canada-general-reading><summary>全国の湖・河川と原典を読む</summary><h2>湖と川を、海までつなげて読む</h2>{waterReading.map(r=><section class="canada-reading-section"><h3>{r.title}</h3><p>{r.body}</p></section>)}<p><a href="https://www.naturalearthdata.com/downloads/50m-physical-vectors/">河川・湖の原典</a>。概略図のため小河川は省略されます。線の幅・湖の色は流量・水深・水質ではありません。</p></details></section>
    </aside>
   </div>
   <details class="canada-climate-context" data-canada-climate-context hidden>
    <summary>元の分布と気候の比較を詳しく読む</summary>
    <div class="canada-climate-context-grid">
     <div data-canada-climate-context-map-slot></div>
     <div data-canada-climate-context-reading-slot></div>
    </div>
   </details>
   </div>
   <details class="canada-source-footer" id="canada-water-sources"><summary>水資源の取得記録・配布データ・利用条件</summary><p>降水はECCC CanGridP mlyV2の1991–2020年360か月から算出した雨・雪の水当量の年平均です。流域はHydroBASINS v1cの地形由来の集水域を上下流関係に沿って結合したものです。国境をまたぐ水系も含めます。地下水は2008年の広域区分と、1993–2025年に地図化されたBC南西部の帯水層事例です。地下水量・取水量・利用可能量は示しません。</p><p><a href={withBase('/assets/atlas/canada-water-v1/manifest.json')}>原典・利用条件・形状検証・加工とハッシュの台帳</a> ／ <a href={withBase('/assets/atlas/canada-water-v1/annual-valid-grid-points.csv.gz')}>年降水量の有効格子CSV（gzip）</a></p><p>全国地下水の原資料で輪郭が交差する7区域は、座標を補正せず輪郭のみ表示します。BCの空白は帯水層がないことを意味しません。日本語名・色と降水量の計算は本サイトによる加工です。Contains information licensed under the Open Government Licence – Canada and the Open Government Licence – British Columbia. 提供機関による本サイトの承認を意味しません。</p></details>

   <footer class="canada-source-footer" id="canada-nature-sources"><h2>出典・対象期間・読み方</h2><ul><li>気候：Environment and Climate Change Canada、1991–2020年平年値。公式表の数値を抽出し、未収録値を補間しません。取得日2026年9月30日。<a href="https://climate.weather.gc.ca/climate_normals/index_e.html">計算方法と観測所一覧</a> ／ <a href="https://www.canada.ca/en/transparency/terms.html">政府サイト利用条件</a>。公式グラフの転載ではなく数値から作図しています。</li><li>主地図：Natural Resources Canadaの公式GIS「Physiographic Regions of Canada」。7地域の全頂点を保持し、EPSG:3978から公式サービスでEPSG:4326へ変換。カタログ公開2019年4月1日、対象期間開始2017年9月1日、確認2026年10月2日。<a href={physiography.source.catalogueUrl}>原典</a> ／ <a href={physiography.manifestUrl}>取得・座標系・ハッシュ台帳</a>。Contains information licensed under the Open Government Licence – Canada. 色と日本語ラベルは本サイトが付け、提供機関の承認を意味しません。</li><li>資料用の旧版紙地図：Natural Resources Canada、Atlas第6版の2009年保存版。地形分類の基礎資料は1967年。<a href={geographySource}>データカタログ</a> ／ <a href="https://open.canada.ca/en/open-government-licence-canada">Open Government Licence – Canada</a>。原図を縮小し、分類・配置を変更していません。提供機関による本サイトの承認を意味しません。</li><li>境界・河川・湖：Natural Earth v5.1.2、public domain。既存国境データは1:110m、河川・湖は1:50m。国土の周辺を含む表示範囲で抽出。詳細な境界・現在の実効支配・流域境界を示すものではありません。</li><li>本文の気候説明：<a href={mechanismSource}>Canada's Changing Climate Report（2019年）、第4章</a>と、各観測地点の平年値。地域の仕組みと一点の観測値を区別します。</li></ul><p><a href={withBase('/assets/atlas/canada-nature-v1/manifest.json')}>加工方法・固定版・ファイルハッシュの台帳</a></p></footer>
   <details class="canada-source-footer"><summary>気候区分・標高の原典と加工</summary><p>Beck et al.の1991–2020年ケッペン区分、元格子0.1°。格子の分類を同区分ごとに結合し、カナダ境界で切り出しています。ECCCの一点の月別平年値から国土の区分を推定したものではありません。<a href={withBase('/assets/atlas/canada-climate-elevation-v1/koppen-manifest.json')}>原典・CC BY 4.0・原データと加工のハッシュ</a></p><p>NOAA ETOPO2022、元格子60秒、標高m・EGM2008。元標高を500 m幅に分類し、メルカトル投影へ最近傍法で写しています。階級の色を混ぜず、カナダ陸域・湖の境界を表示格子に合わせて切り出しました。選択輪郭は同じ表示ピクセルの境界で、幾何的な簡略化を加えていません。値を0に丸めず、負標高と欠測を区別しています。<a href={withBase('/assets/atlas/canada-climate-elevation-v1/elevation-bands-manifest.json')}>原典・利用条件・解像度・加工のハッシュ</a></p><p>国境の切り出しにはStatistics Canada 2021年州準州のcartographic境界を利用します。元境界の出典と帰属は各台帳に保持しています。</p></details>
   <noscript><p>気候区分と首都オタワの雨温図、数値・本文・出典を読めます。地点・表示・比較の切替にはJavaScriptが必要です。</p></noscript>
