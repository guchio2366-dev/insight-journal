<section data-hydrology-panel hidden>
  <nav class="asia-water-kinds" data-water-kinds hidden aria-label="河川・地下水の資料"><button type="button" data-natural-topic="water" aria-pressed="true">河川・湖と流域</button><button type="button" data-natural-topic="groundwater" aria-pressed="false">地下水と涵養</button></nav>
 <p class="eyebrow">Water · Rain, catchments &amp; groundwater</p>
 <h2 data-hydrology-title></h2><p class="asia-takeaway" data-hydrology-lead></p>
 <nav data-basin-shortcuts aria-label="主な河川の集水域" hidden></nav>
 <div class="asia-rice-value" data-hydrology-value aria-live="polite"></div>
 <p data-hydrology-definition></p><p class="asia-small" data-hydrology-coverage></p>
 <p data-hydrology-status role="status"></p><button class="asia-reset" data-hydrology-retry type="button" hidden>水の資料を再読み込み</button>
 <label class="asia-detail-picker">着目する場所<select data-hydrology-scene aria-label="水の着目点"><option value="">地図上の地点を選ぶ</option></select></label>
 <div data-hydrology-scene-reading></div>
 <label class="asia-detail-picker" data-hydrology-detail-label>流域・地下水の区域<select data-hydrology-detail aria-label="流域・地下水の区域"><option value="">選択を解除する</option></select></label>
 <p class="asia-small" data-hydrology-picker-note></p>
 <div data-hydrology-content></div>
 <button class="asia-compare" data-hydrology-related="precipitation" type="button">同じ地点の年降水量へ<span>→</span></button>
 <button class="asia-compare" data-hydrology-related="basins" type="button">同じ地点の流域へ<span>→</span></button>
 <button class="asia-compare" data-hydrology-related="groundwater" type="button">同じ地点の地下水へ<span>→</span></button>
 <button class="asia-compare" data-hydrology-related="terrain" type="button">同じ地点の標高へ<span>→</span></button>
 <button class="asia-compare" data-hydrology-related="climate" type="button">同じ場所の気候と雨温図へ<span>→</span></button>
 <button class="asia-compare" data-compare="agriculture" type="button">同じ場所で農林業を比べる<span>→</span></button>
 <button class="asia-compare" data-compare="population" type="button">同じ場所で人口を比べる<span>→</span></button>
 <details class="asia-method"><summary>資料の定義・加工・出典</summary><div data-hydrology-method></div></details>
</section>
<style>
 section{min-width:0;max-width:100%;overflow-wrap:anywhere}[hidden]{display:none!important}
 h2{font-family:var(--serif);font-size:27px;line-height:1.5;margin:5px 0 14px}
 :global([data-hydrology-panel] h3){font-size:14px;margin:22px 0 8px}
 :global([data-hydrology-panel] p){font-size:13px;line-height:2}
 :global([data-hydrology-panel] .asia-small){font-size:11px;color:var(--ink-soft)}
 .asia-takeaway{font-size:14px;line-height:2}.asia-rice-value{padding:14px;background:#edf2e7;border-left:3px solid #477e6b;font-size:14px;line-height:1.8;margin:15px 0}
 label{display:flex;flex-direction:column;gap:6px;min-width:0;font-size:12px;margin:15px 0}
 select{min-height:44px;min-width:0;width:100%;max-width:100%;box-sizing:border-box;font:inherit;border:1px solid #afbcb6;background:white;padding:10px;color:#263c40}
 summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font-size:12px}
 .asia-compare,[data-hydrology-retry]{width:100%;min-height:48px;box-sizing:border-box;font-size:12px;border:1px solid #315b61;background:#edf3f1;color:#264c52;padding:12px;margin:12px 0;display:flex;align-items:center;justify-content:space-between;text-align:left}
 button:focus-visible,summary:focus-visible,select:focus-visible{outline:3px solid #a74830;outline-offset:2px}
</style>
