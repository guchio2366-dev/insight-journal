---
import AgroStatistics from './AgroStatistics.astro';
import AfricaForestryStatistics from './AfricaForestryStatistics.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegionalForestryMap from './RegionalForestryMap.astro';
import RegionalForestryReading from './RegionalForestryReading.astro';
import RegionalForestrySources from './RegionalForestrySources.astro';
import LatinAmericaWorkspace from './LatinAmericaWorkspace.astro';
import RegionalForestryFrame from './RegionalForestryFrame.astro';
import AfricaFieldNavigation from './AfricaFieldNavigation.astro';
import RussiaForestryStatistics from './RussiaForestryStatistics.astro';
import {withBase} from '../../lib/urls';
import {forestryReading,forestryFrame,type ForestryRegion} from '../../lib/atlas-regional-forestry';
import '../../styles/atlas-regional-forestry.css';
import '../../styles/atlas-africa.css';
import '../../styles/atlas-africa-forestry.css';
interface Props {region:ForestryRegion}
const {region}=Astro.props;
const reading=forestryReading(region),frame=forestryFrame(region);
const home=region==='africa'?'/atlas/africa/?field=agriculture&topic=farming':`/atlas/${region}/agriculture/`;
const overview=region==='russia'?'/atlas/russia/':`/atlas/${region}/overview/`;
const fieldLinks=[['agriculture','農林業'],['nature','自然環境'],['industry','主要産業'],['population','人口']];
const fieldURL=(field:string)=>region==='africa'?`/atlas/africa/?field=${field}`:`/atlas/${region}/${field}/`;
const config={region,reading,frame};
---
{region==='latin-america'?<LatinAmericaWorkspace field="agriculture" agricultureSection="forestry" title={`${reading.name}の林業`} lead={reading.overview}>
 <RegionalForestryMap slot="map" {region}/>
 <Fragment slot="items">
      <div class="forest-example-choices" aria-label="重要な林業の事例"><button type="button" data-forest-overview aria-pressed="true">全体の概説</button>{reading.examples.map((example,index)=><button type="button" data-forest-example={example.id} aria-pressed="false">{index+1} {example.label}</button>)}</div>
 </Fragment>
 <RegionalForestryReading slot="reading-heading" {region} part="heading"/>
 <RegionalForestryReading slot="reading" {region} part="body"/>
 <AgroStatistics slot="statistics" scope={reading.name} topic="forest" countries={[]} nationalOnly={false}/>
 <RegionalForestrySources slot="sources" {region}/>
 <script type="application/json" data-forest-config set:html={JSON.stringify(config).replaceAll('<','\\u003c')}/>
 <noscript><p>全体の概説と資料の範囲を表示しています。各地域の詳しい説明はJavaScriptを有効にして選べます。</p></noscript>
</LatinAmericaWorkspace>:<BaseLayout title={`${reading.name}の林業｜森林の場所と木材の利用`} description={reading.overview} compactAtlas>
 <div class:list={['regional-forestry-page',{'africa-atlas shell':region==='africa'}]} data-regional-forestry data-region={region} data-field={region==='africa'?'agriculture':undefined} data-topic={region==='africa'?'forestry':undefined}>
  <RegionalForestryFrame {region}>
   <article class:list={['regional-forestry-content',{'africa-main':region==='africa'}]}>
    {region==='africa'?<><header class="africa-heading"><div class="africa-compact-heading"><p class="africa-breadcrumb"><a href={withBase('/atlas/')}>地図から見る</a> / アフリカ</p><span>アフリカ地域</span></div><h1>アフリカ地図</h1><div class="africa-region-controls"><div class="africa-region-row"><nav class="africa-region-tabs" aria-label="地域の移動"><a href={withBase('/atlas/')}>世界の地域</a><a href={withBase('/atlas/africa/overview/')} aria-current="page">アフリカ</a></nav></div></div></header><AfricaFieldNavigation field="agriculture" interactive={false}/><nav class="africa-subfields forest-subfields" aria-label="分野内の項目"><a href={withBase(home)}>農畜産</a><a href={withBase('/atlas/africa/agriculture/forestry/')} aria-current="page">林業</a></nav></>:<>
    <div class="forest-breadcrumb"><a href={withBase('/atlas/')}>地図から見る</a><span> / {reading.name}</span></div>
    <h1>{reading.name}の林業</h1>
    <nav class="forest-fields" aria-label={`${reading.name}の分野`}><a href={withBase(overview)}>概要</a>{fieldLinks.map(([field,label])=><a href={withBase(fieldURL(field))} aria-current={field==='agriculture'?'page':undefined}>{label}</a>)}</nav>
    </>}
    <div class="forest-primary-grid">
     <section class="forest-map-column" aria-label="森林の資料と重要な地域の位置">
      <RegionalForestryMap {region}/>
      {region!=='africa'&&<><nav class="forest-subfields" aria-label="農林業の項目"><a href={withBase(home)}>農畜産</a><a href={withBase(`/atlas/${region}/agriculture/forestry/`)} aria-current="page">林業</a></nav><div class="forest-example-choices" aria-label="重要な林業の事例"><button type="button" data-forest-overview aria-pressed="true">全体の概説</button>{reading.examples.map((example,index)=><button type="button" data-forest-example={example.id} aria-pressed="false">{index+1} {example.label}</button>)}</div></>}
     </section>
     <aside class="forest-reading" aria-label="地図の概説と林業の解説">
      <RegionalForestryReading {region} part="heading"/>
      {region==='africa'&&<div class="forest-example-choices" aria-label="重要な林業の地域"><button type="button" data-forest-overview aria-pressed="true">全体の概説</button>{reading.examples.map(example=><button type="button" data-forest-example={example.id} aria-pressed="false">{example.label}</button>)}</div>}
      <RegionalForestryReading {region} part="body"/>
     </aside>
    </div>
    {region==='africa'?<AfricaForestryStatistics />:<AgroStatistics scope={reading.name} country={region==='russia'?'RUS':''} topic="forest" nationalOnly={region==='russia'} />}
    {region==='russia'&&<RussiaForestryStatistics />}
    <RegionalForestrySources {region}/>
   </article>
  </RegionalForestryFrame>
  <script type="application/json" data-forest-config set:html={JSON.stringify(config).replaceAll('<','\\u003c')}/>
  <noscript><p>全体の概説と資料の範囲を表示しています。各地域の詳しい説明はJavaScriptを有効にして選べます。</p></noscript>
 </div>
</BaseLayout>}

<script>import {initRegionalForestry} from '../../scripts/atlas-regional-forestry';initRegionalForestry();</script>
