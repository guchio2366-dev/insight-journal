---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import AsiaClimateDiagram from './AsiaClimateDiagram.astro';
import { features, japaneseNames, regionalMaps, regionFeatures, type CountryFeature } from '../../data/atlas/regional-atlas';
import { asiaClimateCities } from '../../data/atlas/asia-climate-cities';
import { asiaClimateClasses } from '../../data/atlas/asia-climate-definitions';
import { asiaRegionReading } from '../../data/atlas/asia-reading';
import climateManifest from '../../../public/assets/atlas/asia-climate-v2/manifest.json';
import physicalManifest from '../../../public/assets/atlas/asia-physical-v1/manifest.json';
import { asiaNaturalTopics, asiaPhysicalFocus, asiaPhysicalReading } from '../../data/atlas/asia-physical-reading';
import { asiaFieldPaths, type AsiaRegionId, type AsiaField } from '../../lib/atlas-asia-state';
import { withBase } from '../../lib/urls';
import 'maplibre-gl/dist/maplibre-gl.css';
interface Props { regionId: AsiaRegionId; initialField?: 'natural' | 'agriculture' }
const {regionId,initialField='natural'}=Astro.props;
const region=regionalMaps[regionId],reading=asiaRegionReading[regionId];
const cities=asiaClimateCities.filter(city=>city.regionId===regionId);
const targets=regionFeatures(regionId);
const countryCodes=new Set(targets.map(f=>f.properties.code));
const rings=(f:CountryFeature)=>f.geometry.type==='Polygon'?f.geometry.coordinates as number[][][]:(f.geometry.coordinates as number[][][][]).flat();
const countryBounds=(f:CountryFeature)=>{const p=rings(f).flat();return [Math.min(...p.map(p=>p[0])),Math.min(...p.map(p=>p[1])),Math.max(...p.map(p=>p[0])),Math.max(...p.map(p=>p[1]))];};
const countries=targets.map(f=>({code:f.properties.code,name:japaneseNames[f.properties.code]??f.properties.name,bounds:countryBounds(f)})).sort((a,b)=>a.name.localeCompare(b.name,'ja'));
const longitudeScale=Math.cos(region.latitude*Math.PI/180);
const project=([lon,lat]:number[])=>[lon*longitudeScale,-lat];
const bounds=reading.bounds;
const frame=[bounds[0]*longitudeScale,-bounds[3],(bounds[2]-bounds[0])*longitudeScale,bounds[3]-bounds[1]];
const path=(f:CountryFeature)=>rings(f).map(ring=>ring.map((p,i)=>{const [x,y]=project(p);return `${i?'L':'M'}${x.toFixed(3)},${y.toFixed(3)}`;}).join('')+'Z').join('');
const nearby=features.filter(f=>!countryCodes.has(f.properties.code)&&rings(f).some(r=>r.some(p=>p[0]>bounds[0]-10&&p[0]<bounds[2]+10&&p[1]>bounds[1]-10&&p[1]<bounds[3]+10)));
const precipitationMax=Math.max(400,Math.ceil(Math.max(...cities.flatMap(c=>c.precipitationMm.filter(v=>v!==null) as number[]))/200)*200);
const physical=physicalManifest.regions[regionId], physicalFocus=asiaPhysicalFocus.filter(f=>f.region===regionId);
const config={regionId,label:region.label,bounds,countries,cities,classes:asiaClimateClasses,climate:climateManifest.regions[regionId],physical,physicalFocus,geographyUrl:withBase('/assets/atlas/asia-geography-v1.json'),climateBase:withBase('/assets/atlas/asia-climate-v2/'),agricultureBase:withBase('/assets/atlas/asia-agriculture-v1/'),physicalBase:withBase('/assets/atlas/asia-physical-v1/')};
const familyNames=['熱帯','乾燥帯','温帯','冷帯','寒帯'];
const fieldTabs:{id:AsiaField;label:string}[]=[{id:'agriculture',label:'農林業'},{id:'natural',label:'自然環境'}];
---
<BaseLayout title={`${region.label}地図｜気候と農業`} description={reading.summary} compactAtlas canonicalPath={`/atlas/asia/${regionId}/${asiaFieldPaths[initialField]}/`}>
  <div class="asia-atlas-root" data-asia-atlas data-region={regionId}>
   <div class="shell asia-region-shell">
    <AtlasRegionNavigation group="asia" current={regionId} />
    <div class="asia-toolbar"><label>国・地域<select data-country-select aria-label="国・地域を選ぶ"><option value="">{region.label}全体</option>{countries.map(c=><option value={c.code}>{c.name}</option>)}</select></label><button class="asia-reset" type="button" data-reset>全体に戻す</button></div>
   </div>
   <AtlasWorkspaceFrame region={regionId}>
    <article class="atlas-explorer asia-atlas" data-asia-explorer data-field={initialField}>
     <section class="atlas-workspace" aria-label={`${region.label}の分野別地図`}>
      <div class="atlas-compact-heading"><nav aria-label="パンくずリスト"><a href={withBase('/atlas/')}>地図から見る</a><span> / </span><a href={withBase(`/atlas/asia/${regionId}/`)}>{region.label}</a></nav><span data-current-place>{region.label}全体</span></div>
      <h1 class="visually-hidden">{region.label}の地図から自然環境と農林業を読む</h1>
      <nav class="atlas-tabs asia-field-tabs" aria-label="地図の分野">{fieldTabs.map(f=><a href={withBase(`/atlas/asia/${regionId}/${asiaFieldPaths[f.id]}/`)} data-field={f.id} aria-current={initialField===f.id?'page':undefined}>{f.label}</a>)}</nav>
      <label class="asia-topic-picker" data-natural-topics hidden={initialField!=='natural'}>自然環境の主題<select data-natural-topic aria-label="自然環境の主題">{asiaNaturalTopics.map(t=><option value={t.id}>{t.label}</option>)}</select></label>
      <div class="atlas-primary-grid asia-layout">
      <section class="atlas-map-column asia-map-panel" aria-labelledby="asia-map-title">
        <div class="visually-hidden"><p data-map-eyebrow>{initialField==='natural'?'Climate · 1991–2020':'Agriculture · 2020'}</p><h2 id="asia-map-title" data-map-title>{initialField==='natural'?'気候区分と都市':'米の収穫面積'}</h2><span data-map-period>{initialField==='natural'?'ケッペン＝ガイガー':'モデルによる推計'}</span></div>
        <div class="atlas-map-frame asia-map-frame">
          <div class="atlas-map-surface asia-map-surface" data-map-surface role="region" tabindex="0" aria-label={`${region.label}の操作できる地図`}></div>
          <div class="asia-map-fallback" data-map-fallback>
            <svg viewBox={frame.join(' ')} data-default-frame={frame.join(' ')} role="img" aria-labelledby="asia-fallback-title"><title id="asia-fallback-title">{region.label}の国・地域の位置</title><g class="asia-context">{nearby.map(f=><path d={path(f)} fill-rule="evenodd" />)}</g><g>{targets.map(f=><path d={path(f)} fill-rule="evenodd" data-map-country={f.properties.code}><title>{japaneseNames[f.properties.code]}</title></path>)}</g></svg>
          </div>
          <div class="asia-map-state" data-map-state role="status">地図を読み込んでいます</div>
          <div class="asia-map-tools"><button type="button" data-zoom-in aria-label="地図を拡大">＋</button><button type="button" data-zoom-out aria-label="地図を縮小">−</button><button type="button" data-map-fit aria-label="選択範囲に地図を合わせる">全景</button></div>
          <button class="asia-map-retry" data-map-retry type="button" hidden>地図を再読み込み</button>
        </div>
        <div class="asia-map-selection" aria-live="polite"><span class="selection-dot"></span><span data-grid-reading>{initialField==='natural'?'地図上の陸地を選ぶと、気候区分を確認できます。':'地図上の対象地域を選ぶと、格子内の米の収穫面積を確認できます。'}</span></div>
        <p class="asia-gesture" data-map-gesture>都市の点を選ぶと雨温図が開きます。地図は2本指で移動・拡大できます。</p>
        <section class="asia-legend" data-climate-legend hidden={initialField!=='natural'} aria-label="気候区分の凡例"><div class="legend-title"><h3>気候区分</h3><span>区分を選ぶと意味を表示</span></div><div class="asia-family-legend">{familyNames.map(family=><details><summary><i style={`background:${asiaClimateClasses.find(c=>c.group.startsWith(family))?.color??'#aaa'}`}></i>{family}</summary><div class="asia-class-list">{asiaClimateClasses.filter(c=>c.group.startsWith(family)).map(c=><button type="button" data-climate-class={c.id} aria-pressed="false"><i style={`background:${c.color}`}></i><b>{c.code}</b><span>{c.name}</span></button>)}</div></details>)}</div></section>
        <section class="asia-legend" data-agriculture-legend hidden={initialField!=='agriculture'} aria-label="米の収穫面積の凡例"><h3>米の収穫面積</h3><div data-rice-scale></div><p>1格子内の年間収穫面積（ha）。二期作などは収穫の回数を含むため、土地の面積とは異なります。</p></section>
        <section class="asia-legend" data-physical-legend hidden aria-label="標高と水系の凡例"><h3>標高（m・EGM2008基準）</h3><div class="asia-physical-key">{['0未満','0–200','200–500','500–1,000','1,000–2,000','2,000–3,000','3,000–4,500','4,500以上'].map((label,i)=><span><i style={`background:#${physicalManifest.colors[i]}`}></i>{label}</span>)}</div><p>等高線：500m間隔。青い線：河川、青い面：湖。線の太さは川幅や流量を表しません。周辺国は灰色、対象内の透明な箇所はデータなし。</p></section>
        <details class="asia-country-list"><summary>{region.label}の国・地域を一覧から選ぶ</summary><div>{countries.map(c=><button type="button" data-country-button={c.code} aria-pressed="false">{c.name}</button>)}</div></details>
      </section>
      <aside class="atlas-field-national asia-reading-panel" data-field-national={initialField} aria-label="地図の解説">
       <div class="atlas-national asia-reading-scroll" tabindex="0" role="region" aria-label="選択した場所の解説">
        <label class="asia-city-picker" data-city-picker hidden={initialField!=='natural'}>都市の雨温図<select data-city-select aria-label="都市の雨温図を選ぶ"><option value="">都市を選ぶ</option>{cities.map(c=><option value={c.id} data-country={c.countryCode}>{c.name} · {japaneseNames[c.countryCode]}</option>)}</select></label>
        <div class="asia-comparison-return" data-comparison-return hidden><p>元の選択と地図の位置を保存しています。</p><button type="button" data-comparison-back>比較前の地図に戻る</button></div>
        <section class="asia-overview" data-overview hidden={initialField!=='natural'}><p class="eyebrow" data-reading-eyebrow>How to read this map</p><h2 data-reading-title>{reading.title}</h2><p class="asia-takeaway" data-reading-summary>{reading.summary}</p><div data-reading-questions><h3>地図で確かめること</h3><ol>{reading.questions.map(q=><li>{q}</li>)}</ol></div><div class="asia-next"><p>都市を選ぶと、雨温図と月別の数値を読めます。</p><div class="asia-city-links">{cities.slice(0,4).map(city=><button type="button" data-city-shortcut={city.id}>{city.name}<span>↗</span></button>)}</div></div></section>
        {cities.map(city=><article class="asia-city-card" data-city-panel={city.id} id={`city-${city.id}`} hidden><h2 class="visually-hidden">{city.name}の気候</h2><AsiaClimateDiagram {city} {precipitationMax} /><p class="asia-takeaway">{city.summary}</p><section class="asia-city-reading"><h3>季節の変化を読む</h3><p>{city.reading}</p></section><button class="asia-compare" type="button" data-compare="agriculture">同じ場所で米の分布を見る<span>→</span></button></article>)}
        <section class="asia-class-reading" data-class-reading hidden><p class="eyebrow">Climate classification</p><h3><b data-class-code></b><span data-class-name></span></h3><p data-class-description></p><p class="asia-small">広域の格子データによる分類です。観測所の位置や気候の期間・解像度によって、雨温図から読む特徴と一致しないことがあります。</p></section>
        <section class="asia-rice-reading" data-rice-reading hidden={initialField!=='agriculture'}><p class="eyebrow">Agriculture · Rice</p><h2>米が育つ場所と、気候の関係</h2><p class="asia-takeaway">米の収穫面積の分布を、都市の気温・降水量と見比べます。</p><div class="asia-rice-value" data-rice-value>地図上の対象地域を選ぶと、格子内の収穫面積を表示します。</div><p data-rice-summary></p><h3>「面積」の読み方</h3><p>収穫面積は、年間に収穫した作付面積です。同じ土地で複数回収穫すると、その回数分を含みます。表示は統計などを基にした空間配分モデルの推計で、個々の田畑の境界を示すものではありません。</p><p>気候と栽培の分布が重なることだけでは、因果関係は確定しません。灌漑、地形、土壌、品種、経済条件も関わります。</p><button class="asia-compare" type="button" data-compare="natural">同じ場所で気候を比べる<span>→</span></button><p class="asia-small" data-rice-source></p></section>
        <section data-physical-reading hidden><p class="eyebrow">Terrain &amp; Water · ETOPO 2022</p><h2 data-physical-title>地形を読む</h2><p class="asia-takeaway" data-physical-takeaway>{asiaPhysicalReading[regionId].terrain}</p><label class="asia-detail-picker">地形の着目点<select data-physical-focus aria-label="地形の着目点"><option value="">地図上の地点を選ぶ</option>{physicalFocus.map(f=><option value={f.id} data-country={f.country}>{f.name}</option>)}</select></label><label class="asia-detail-picker" data-water-picker hidden>河川・湖<select data-water-select aria-label="河川・湖を選ぶ"><option value="">一覧から選ぶ</option>{physical.waterFeatures.map(f=><option value={f.id}>{f.label}（{f.kind==='rivers'?'河川':'湖'}）</option>)}</select></label><div class="asia-rice-value" data-physical-value aria-live="polite">地点を選ぶと格子の標高を表示します。</div><h3 data-physical-detail-title>高低差と広がり</h3><p data-physical-detail></p><p data-physical-context></p><details class="asia-method"><summary>数値と地形の読み方</summary><p>元資料はNOAA ETOPO 2022の60秒角（赤道付近で約1.85km）です。Web Mercator上で約2.23kmの格子に平均化し、選択値と色を同じ値から生成しています。表示値は整数に丸めたもので、1m精度の測量値ではありません。</p><p>等高線は表示格子から計算した500m間隔です。海岸では陸地と海底が混じり、小島が欠ける場合があります。河川・湖はNatural Earth 1:50m v5.1.2の概略形状で、現在の湖面・流量・水質・水供給量を示しません。</p></details><button class="asia-compare" type="button" data-compare="agriculture">同じ場所で米の分布を見る<span>→</span></button><p class="asia-small">出典：<a href="https://doi.org/10.25921/fd45-gt74">NOAA ETOPO 2022</a> · <a href="https://www.naturalearthdata.com/downloads/50m-physical-vectors/">Natural Earth</a>。地域抽出・加工：Insight Journal。</p></section>
       </div>
      </aside>
     </div>
    </section>
    <footer class="asia-sources" id="asia-sources"><h2>地図の範囲と出典</h2><div class="asia-source-grid"><section><h3>気候区分・都市</h3><p>気候区分：<a href="https://www.nature.com/articles/s41597-023-02549-6">Beckほか（2023）</a>、<a href="https://www.gloh2o.org/koppen/">GloH2O</a>。1991–2020の分類データを広域表示向けに加工。元データと加工した表示の解像度を区別して使用しています。</p><p data-climate-method>気候データの版・解像度・利用条件を読み込んでいます。</p><p>雨温図：<a href="https://www.data.jma.go.jp/tcc/tcc/products/climate/climatview/frame.php">気象庁 ClimatView</a>ほか。観測所・平年期間と個別の出典は各都市の図表に記載。欠測値は補いません。</p></section><section><h3>米の分布・国境</h3><p data-agriculture-method>米の分布の出典・対象年・利用条件を読み込んでいます。</p><p>国境：<a href="https://www.naturalearthdata.com/downloads/110m-cultural-vectors/110m-admin-0-countries/">Natural Earth</a>。1:110m、一部の小国は1:50m。小島などの細部は省略されます。境界・名称は資料の表示上の区分に沿っています。</p><p>対象はアジア3地域の30か国・地域。中東（イランを含む）とロシアは選択対象に含みません。周辺国は灰色で表示します。地図は面積の比較には適しません。</p></section></div><p class="asia-source-status">掲載範囲：気候区分、都市の雨温図、標高・等高線・河川・湖、米の分布。その他の農林業、主要産業、人口は詳細化を進めています。水系の形状と、水資源の量・利用は別の情報です。</p></footer>
    <noscript><p>操作にはJavaScriptが必要です。国・地域の位置と、以下の都市の観測値を参照できます。</p><ul>{cities.map(c=><li><a href={c.sourceUrl}>{c.name}の平年値（{c.sourceName}）</a></li>)}</ul></noscript>
    </article>
   </AtlasWorkspaceFrame>
    <script type="application/json" data-asia-config set:html={JSON.stringify(config).replace(/</g,'\\u003c')} />
  </div>
</BaseLayout>
<script>import '../../scripts/atlas-asia-explorer';</script>
<style>
  :global(.asia-point-marker){background:#fffef6;color:#2a3f45;border:1px solid #8a4934;border-bottom:4px solid #a24a34;border-radius:3px;padding:5px 8px;font-size:11px;box-shadow:0 1px 5px #0002;pointer-events:none;white-space:nowrap}:global(.asia-point-marker[hidden]){display:none!important}
  .asia-topic-picker{display:flex;align-items:center;gap:12px;font-size:12px;padding:8px 0}.asia-topic-picker select,.asia-detail-picker select{min-height:44px;border:1px solid var(--rule);background:var(--white);font:inherit;padding:8px;max-width:100%}.asia-detail-picker{display:grid;gap:5px;font-size:12px;margin:12px 0}.asia-physical-key{display:flex;flex-wrap:wrap;gap:6px 12px}.asia-physical-key span{display:flex;gap:4px;font-size:10px;align-items:center}.asia-physical-key i{display:inline-block;width:16px;height:12px}.asia-method summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font-size:12px}.asia-method summary:before{content:"＋";margin-right:6px}.asia-method[open] summary:before{content:"−"}

  .asia-region-shell{padding-top:10px;display:flex;align-items:center;justify-content:space-between;gap:16px}.asia-region-shell :global(.regional-navigation){margin:0}.asia-region-shell .asia-toolbar{padding:0;align-items:center;gap:12px}.asia-region-shell .asia-toolbar label{flex-direction:row;align-items:center;gap:8px}.asia-field-tabs{grid-template-columns:repeat(2,minmax(0,1fr))}
  :global(.atlas-desktop-shell) .asia-atlas{padding:0;max-width:none;width:100%}
  :global(.atlas-desktop-shell) .asia-map-panel{position:static;top:auto;border:0;border-radius:0;background:transparent;overflow:visible}
  :global(.atlas-desktop-shell) .asia-map-frame{height:auto;min-height:190px;max-height:640px}
  :global(.atlas-desktop-shell) .asia-reading-panel{margin-top:0;min-width:0}
  .asia-city-picker{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;margin-bottom:12px}.asia-city-picker select{min-width:0;max-width:68%;min-height:36px;padding:4px;border:1px solid #bdcbbb;background:#fffef8;font:inherit}
  .asia-reading-panel .atlas-national h2{font-size:23px;line-height:1.4}.asia-reading-panel .atlas-national h3{font-size:16px}.asia-reading-panel .atlas-national p{font-size:13px;line-height:1.8}
  @media(min-width:1200px){.asia-reading-scroll{max-height:var(--asia-map-height,640px);overflow:auto;scrollbar-gutter:stable}}
  @media(max-width:1199px){:global(.atlas-desktop-shell) .asia-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}.asia-reading-scroll{overflow:visible;max-height:none}}
  @media(max-width:700px){.asia-region-shell{align-items:stretch;flex-direction:column;gap:10px}.asia-region-shell .asia-toolbar{display:flex;justify-content:space-between}.asia-region-shell :global(.regional-tabs){display:grid;grid-template-columns:1fr 1fr 1.25fr;gap:4px}.asia-region-shell :global(.regional-tabs a){justify-content:center;font-size:12px;padding:7px}}
