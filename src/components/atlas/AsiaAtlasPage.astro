---
import AsiaFieldNavigation from './AsiaFieldNavigation.astro';
import {asiaFocusViews,asiaFocusFieldReadings,asiaFocusCountries,asiaFocusIndustry,asiaFocusWaterRivers,asiaFocusWaterOverview,asiaFocusShareExample,asiaFocusFarmKindReading,type AsiaFocusId} from '../../data/atlas/asia-focus';
import {southCentralFieldReadings} from '../../data/atlas/asia-south-central-reading';
import eastContentGeography from '../../../public/assets/atlas/asia-population-v1/east-asia.geography.json';
import southeastContentGeography from '../../../public/assets/atlas/asia-population-v1/southeast-asia.geography.json';
import southContentGeography from '../../../public/assets/atlas/asia-population-v1/south-central-asia.geography.json';
import presentationManifest from '../../../public/assets/atlas/asia-presentation-v1/manifest.json';
import '../../styles/atlas-asia-fields.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import AsiaClimateDiagram from './AsiaClimateDiagram.astro';
import AsiaFarmingPanel from './AsiaFarmingPanel.astro';
import AsiaIndustryPanel from './AsiaIndustryPanel.astro';
import SoutheastAsiaFarmView from './asia/SoutheastAsiaFarmView.astro';
import EastAsiaFarmFoundations from './asia/EastAsiaFarmFoundations.astro';
import {southeastIndustryCountryScope} from '../../data/atlas/asia/southeast-asia-industry';
import {southeastAsiaInitialReadings} from '../../data/atlas/asia/southeast-asia-reading';
import AsiaWaterPanel from './AsiaWaterPanel.astro';
import AsiaSeasonalPrecipitationPanel from './AsiaSeasonalPrecipitationPanel.astro';
import AsiaSocialPanel from './AsiaSocialPanel.astro';
import AsiaSettlementPanel from './AsiaSettlementPanel.astro';
import settlementManifest from '../../../public/assets/atlas/asia-settlements-v1/manifest.json';
import AsiaTradePanel from './AsiaTradePanel.astro';
import AsiaPlaceReading from './AsiaPlaceReading.astro';
import tradeManifest from '../../../public/assets/atlas/asia-trade-v1/manifest.json';
import {tradeTopics} from '../../data/atlas/asia-trade';
import socialManifest from '../../../public/assets/atlas/asia-social-v1/manifest.json';
import {type SocialRegion} from '../../data/atlas/asia-social';
import {socialEntry,withSocialOverviews} from '../../data/atlas/asia-social-overview';
import {asiaFarmInsights} from '../../data/atlas/asia-map-insights';
import waterManifest from '../../../public/assets/atlas/asia-water-v1/manifest.json';
import industryManifest from '../../../public/assets/atlas/asia-industry-v1/manifest.json';
import {industryGroups,type IndustryRegion} from '../../data/atlas/asia-industry';
import {southCentralIndustryGroups} from '../../data/atlas/asia-south-central-industry';
import {southCentralLandformSources,southCentralFocusLandformSources,southCentralFocusPhysicalReading} from '../../data/atlas/asia-south-central-landform-reading';
import farmingManifest from '../../../public/assets/atlas/asia-farming-v1/manifest.json';
import type {AsiaFarmingRegion} from '../../data/atlas/asia-farming';
import AsiaPopulationPanel from './AsiaPopulationPanel.astro';
import populationManifest from '../../../public/assets/atlas/asia-population-v1/manifest.json';
import {asiaPopulationTopics,asiaPopulationColors,asiaPopulationLabels,type AsiaPopulationRegion} from '../../data/atlas/asia-population';
import { features, japaneseNames, regionalMaps, regionFeatures, type CountryFeature } from '../../data/atlas/regional-atlas';
import { asiaClimateCities } from '../../data/atlas/asia-climate-cities';
import { asiaClimateClasses } from '../../data/atlas/asia-climate-definitions';
import { asiaRegionReading } from '../../data/atlas/asia-reading';
import climateManifest from '../../../public/assets/atlas/asia-climate-v2/manifest.json';
import physicalManifest from '../../../public/assets/atlas/asia-physical-v1/manifest.json';
import { asiaNaturalTopics, asiaPhysicalFocus, asiaPhysicalReading } from '../../data/atlas/asia-physical-reading';
import { asiaFieldPaths, type AsiaRegionId, type AsiaField } from '../../lib/atlas-asia-state';
import { withBase } from '../../lib/urls';
import 'maplibre-gl/dist/maplibre-gl.css';
interface Props { regionId: AsiaRegionId; initialField?: AsiaField; focusId?: AsiaFocusId }
const {regionId,initialField='natural',focusId}=Astro.props;
const focus=focusId?asiaFocusViews[focusId]:null,pageId=focusId??regionId;
const region={...regionalMaps[regionId],...(focus?{label:focus.label}:{})},reading={...asiaRegionReading[regionId],...focus};
const cities=asiaClimateCities.filter(city=>city.regionId===regionId&&(!focusId||asiaFocusCountries[focusId].includes(city.countryCode)));
const targets=regionFeatures(regionId).filter(f=>!focusId||asiaFocusCountries[focusId].includes(f.properties.code));
const countryCodes=new Set(targets.map(f=>f.properties.code));
const rings=(f:CountryFeature)=>f.geometry.type==='Polygon'?f.geometry.coordinates as number[][][]:(f.geometry.coordinates as number[][][][]).flat();
const countryBounds=(f:CountryFeature)=>{const p=rings(f).flat();return [Math.min(...p.map(p=>p[0])),Math.min(...p.map(p=>p[1])),Math.max(...p.map(p=>p[0])),Math.max(...p.map(p=>p[1]))];};
const contentGeography={'east-asia':eastContentGeography,'southeast-asia':southeastContentGeography,'south-central-asia':southContentGeography}[regionId];
// Fit all rings in the existing detailed geography, including small islands.
// Raster rectangles and a country's largest polygon are not its content extent.
const contentBounds=(coordinates:unknown)=>{
 const extent=[Infinity,Infinity,-Infinity,-Infinity];
 const visit=(value:any)=>{if(typeof value?.[0]==='number'){extent[0]=Math.min(extent[0],value[0]);extent[1]=Math.min(extent[1],value[1]);extent[2]=Math.max(extent[2],value[0]);extent[3]=Math.max(extent[3],value[1]);}else if(Array.isArray(value))value.forEach(visit);};
 visit(coordinates);return extent;
};
const countries=targets.map(f=>({code:f.properties.code,name:japaneseNames[f.properties.code]??f.properties.name,bounds:contentBounds(contentGeography.features.filter(g=>g.properties.code===f.properties.code).map(g=>g.geometry.coordinates))})).map(c=>({...c,bounds:c.bounds.every(Number.isFinite)?c.bounds:countryBounds(targets.find(f=>f.properties.code===c.code)!)})).sort((a,b)=>a.name.localeCompare(b.name,'ja'));
const visibleCountries=new Set(focusId?asiaFocusCountries[focusId]:countries.map(c=>c.code));
const contentExtent=contentBounds(contentGeography.features.filter(f=>visibleCountries.has(f.properties.code)).map(f=>f.geometry.coordinates));
const longitudeScale=Math.cos(region.latitude*Math.PI/180);
const project=([lon,lat]:number[])=>[lon*longitudeScale,-lat];
const bounds=focusId?contentExtent:reading.bounds;
const frame=[bounds[0]*longitudeScale,-bounds[3],(bounds[2]-bounds[0])*longitudeScale,bounds[3]-bounds[1]];
const path=(f:CountryFeature)=>rings(f).map(ring=>ring.map((p,i)=>{const [x,y]=project(p);return `${i?'L':'M'}${x.toFixed(3)},${y.toFixed(3)}`;}).join('')+'Z').join('');
const nearby=features.filter(f=>!countryCodes.has(f.properties.code)&&rings(f).some(r=>r.some(p=>p[0]>bounds[0]-10&&p[0]<bounds[2]+10&&p[1]>bounds[1]-10&&p[1]<bounds[3]+10)));
const precipitationMax=Math.max(400,Math.ceil(Math.max(...cities.flatMap(c=>c.precipitationMm.filter(v=>v!==null) as number[]))/200)*200);
const physical={...physicalManifest.regions[regionId],waterFeatures:physicalManifest.regions[regionId].waterFeatures.filter(f=>!focusId||f.countries.some(code=>asiaFocusCountries[focusId].includes(code)))}, physicalFocus=asiaPhysicalFocus.filter(f=>f.region===regionId&&(!focusId||asiaFocusCountries[focusId].includes(f.country)));
const population={...populationManifest.regions[regionId],cities:populationManifest.regions[regionId].cities.filter(c=>!focusId||asiaFocusCountries[focusId].includes(c.country))} as unknown as AsiaPopulationRegion;
const config={regionId,focusId,label:region.label,bounds,contentExtent,dataBounds:focusId?bounds:asiaRegionReading[regionId].bounds,countries,cities,classes:asiaClimateClasses,climate:climateManifest.regions[regionId],physical,physicalFocus,geographyUrl:withBase('/assets/atlas/asia-geography-v1.json'),climateBase:withBase('/assets/atlas/asia-climate-v2/'),agricultureBase:withBase('/assets/atlas/asia-agriculture-v1/'),physicalBase:withBase('/assets/atlas/asia-physical-v1/')};
const farming=farmingManifest.regions[regionId] as unknown as AsiaFarmingRegion;
Object.assign(config,{farming,farmingBase:withBase('/assets/atlas/asia-farming-v1/')});
const pointInRing=([x,y]:number[],ring:number[][])=>{let inside=false;for(let i=0,j=ring.length-1;i<ring.length;j=i++)if((ring[i][1]>y)!==(ring[j][1]>y)&&x<(ring[j][0]-ring[i][0])*(y-ring[i][1])/(ring[j][1]-ring[i][1])+ring[i][0])inside=!inside;return inside;};
const focusShapes=contentGeography.features.filter(feature=>visibleCountries.has(feature.properties.code));
const inFocus=(point:number[])=>!focusId||focusShapes.some(feature=>{const polygons=feature.geometry.type==='Polygon'?[feature.geometry.coordinates]:feature.geometry.coordinates;return polygons.some((rings:number[][][])=>pointInRing(point,rings[0])&&!rings.slice(1).some(ring=>pointInRing(point,ring)));});
const originalPresentation=presentationManifest.regions[regionId];
const presentation={...originalPresentation,farming:{...originalPresentation.farming,labels:originalPresentation.farming.labels.filter(label=>inFocus(label.coordinate))},settlements:Object.fromEntries(Object.entries(settlementManifest.regions[regionId]).map(([key,value])=>[key,{...value,categories:value.categories.map(category=>({...category,anchors:category.anchors.filter(inFocus)})).filter(category=>category.anchors.length)}]))};
const visibleSettlementCategoryIds=Object.fromEntries(Object.entries(presentation.settlements).map(([topic,value])=>[topic,new Set(value.categories.map(category=>category.id))]));
Object.assign(config,{presentation,presentationBase:withBase('/assets/atlas/asia-presentation-v1/')});
const familyNames=['熱帯','乾燥帯','温帯','冷帯','寒帯'];
Object.assign(config,{population,populationBase:withBase('/assets/atlas/asia-population-v1/')});
const focusIndustry=focusId?asiaFocusIndustry(focusId):null;
const regionalIndustryGroups=focusIndustry?.groups??southCentralIndustryGroups;
const regionalIndustryTopics=regionId==='south-central-asia'?[{id:'sc-overview',title:`${region.label}の産業分布`,parent:'地域の特徴',kind:'regional',unit:'立地の事例',year:'地域概観',source:regionalIndustryGroups[0]?.source.url??'https://www.ilo.org/media/438656/download',note:'出典で確認した代表的な地域を点で示します。施設の全数や生産量ではありません。'},...regionalIndustryGroups.map(group=>({id:group.id,title:group.title,parent:'地域の特徴',kind:'regional',unit:'立地の事例',year:'地域概観',source:group.source.url,note:'出典で確認した代表的な地域を点で示します。施設の全数や生産量ではありません。'}))]:[];
const industry={...industryManifest.regions[regionId],...(focusId?{countries:asiaFocusCountries[focusId]}:{}),topics:[...regionalIndustryTopics,...industryManifest.regions[regionId].topics,...tradeTopics].filter(topic=>focusId!=='central-asia'||!('country' in topic)||topic.country!=='IND'),...(regionId==='southeast-asia'?{countryScope:southeastIndustryCountryScope}:{})} as unknown as IndustryRegion;
Object.assign(config,{industry,industryBase:withBase('/assets/atlas/asia-industry-v1/'),industrySites:focusIndustry?.sites,industryGroups:focusIndustry?.groups,industryOverview:focusIndustry?.overview,...(regionId==='south-central-asia'?{industryCountryCodes:focusId==='central-asia'?[]:['IND']}:{})});
Object.assign(config,{water:waterManifest.regions[regionId],waterBase:withBase('/assets/atlas/asia-water-v1/')});
Object.assign(config,{seasonalBase:withBase('/assets/atlas/asia-seasonal-precipitation-v1/')});
const socialBase=withSocialOverviews(socialManifest.regions[regionId] as SocialRegion);
const social=focusId?{...socialBase,countries:asiaFocusCountries[focusId],groups:socialBase.groups.filter(group=>!group.country||asiaFocusCountries[focusId].includes(group.country)),topics:socialBase.topics.filter(topic=>!socialBase.groups.some(group=>group.id===topic.group&&group.country&&!asiaFocusCountries[focusId].includes(group.country)))}:socialBase;
const farmInsight={...asiaFarmInsights[regionId],...(focusId?{title:asiaFocusFieldReadings[focusId]!.agriculture.title,lead:asiaFocusFieldReadings[focusId]!.agriculture.takeaway,body:asiaFocusFieldReadings[focusId]!.agriculture.reading,source:asiaFocusFieldReadings[focusId]!.agriculture.source.url,waterTitle:asiaFocusFieldReadings[focusId]!.natural.title,waterLead:asiaFocusFieldReadings[focusId]!.natural.takeaway,rivers:asiaFocusWaterRivers[focusId]}:{})};
Object.assign(config,{farmInsight,focusWaterRivers:focusId?asiaFocusWaterRivers[focusId]:null,focusWaterOverview:focusId?asiaFocusWaterOverview[focusId]:null,focusShareExample:focusId?asiaFocusShareExample[focusId]:null,focusFarmKindReading:focusId?asiaFocusFarmKindReading[focusId]:null,focusReadings:focusId?asiaFocusFieldReadings[focusId]??null:regionId==='southeast-asia'?southeastAsiaInitialReadings():regionId==='south-central-asia'?southCentralFieldReadings:null});
Object.assign(config,{social,socialBase:withBase('/assets/atlas/asia-social-v1/')});
Object.assign(config,{trade:{...tradeManifest.regions[regionId],...(focusId?{countries:asiaFocusCountries[focusId]}:{})},tradeBase:withBase('/assets/atlas/asia-trade-v1/'),tradeChapters:tradeManifest.chapters});
const fieldTabs:{id:AsiaField;label:string}[]=[{id:'agriculture',label:'農林業'},{id:'natural',label:'自然環境'},{id:'industry',label:'主要産業'},{id:'population',label:'人口'}];
---
<BaseLayout title={`${region.label}地図｜自然環境・農林業・主要産業・人口`} description={reading.summary} compactAtlas canonicalPath={`/atlas/asia/${pageId}/${asiaFieldPaths[initialField]}/`}>
  <div class="asia-atlas-root" data-asia-atlas data-region={regionId}>
   <AtlasWorkspaceFrame region={regionId}>
    <article class="atlas-explorer asia-atlas" data-asia-explorer data-field={initialField}>
     <section class="atlas-workspace" aria-label={`${region.label}の分野別地図`}>
      <div class="atlas-compact-heading"><nav aria-label="パンくずリスト"><a href={withBase('/atlas/')}>地図から見る</a><span> / </span><a href={withBase(`/atlas/asia/${pageId}/nature/`)}>{region.label}</a></nav><span data-current-place>{region.label}全体</span></div>
      <h1 class="visually-hidden">{region.label}の地図から自然環境・農林業・主要産業・人口を読む</h1>
      <div class="atlas-region-controls asia-region-shell">
       <AtlasRegionNavigation group="asia" current={pageId} />
       {regionId==='south-central-asia'&&<nav class="asia-focus-navigation" aria-label="南・中央アジアの地域">{Object.entries(asiaFocusViews).map(([id,v])=><a href={withBase(`/atlas/asia/${id}/${asiaFieldPaths[initialField]}/`)} data-focus-link={id} aria-current={pageId===id?'page':undefined}>{v.label}</a>)}</nav>}
       <div class="asia-toolbar"><label data-country-picker>国・地域<select data-country-select aria-label="国・地域を選ぶ"><option value="">{region.label}全体</option>{countries.map(c=><option value={c.code}>{c.name}</option>)}</select></label><button class="asia-reset" type="button" data-reset>全体に戻す</button></div>
      </div>
      <nav class="atlas-tabs atlas-tabs-with-overview asia-field-tabs" aria-label="地図の分野"><a data-atlas-overview-link href={withBase(`/atlas/asia/${pageId}/overview/`)}>概要</a>{fieldTabs.map(f=><a href={withBase(`/atlas/asia/${pageId}/${asiaFieldPaths[f.id]}/`)} data-field={f.id} aria-current={initialField===f.id?'page':undefined}>{f.label}</a>)}</nav>
      <AsiaFieldNavigation {initialField} {social} {regionId} {industry} forestTopic={farming.layers.find(t=>t.kind==='forest')?.id} />

      <div class="atlas-primary-grid asia-layout">
      <section class="atlas-map-column asia-map-panel" aria-labelledby="asia-map-title">
        <div class="visually-hidden"><p data-map-eyebrow>{initialField==='natural'?'Climate · 1991–2020':'Agriculture · 2020'}</p><h2 id="asia-map-title" data-map-title>{initialField==='natural'?'気候区分と都市':'米の収穫面積'}</h2><span data-map-period>{initialField==='natural'?'ケッペン＝ガイガー':'モデルによる推計'}</span></div>
        <div class="atlas-map-frame asia-map-frame">
          <div class="atlas-map-surface asia-map-surface" data-map-surface role="region" tabindex="0" aria-label={`${region.label}の操作できる地図`}></div>
          <div class="asia-map-fallback" data-map-fallback>
            <svg viewBox={frame.join(' ')} data-default-frame={frame.join(' ')} role="img" aria-labelledby="asia-fallback-title"><title id="asia-fallback-title">{region.label}の国・地域の位置</title><g class="asia-context">{nearby.map(f=><path d={path(f)} fill-rule="evenodd" />)}</g><g>{targets.map(f=><path d={path(f)} fill-rule="evenodd" data-map-country={f.properties.code}><title>{japaneseNames[f.properties.code]}</title></path>)}</g></svg>
          </div>
          <div class="asia-map-state" data-map-state role="status">地図を読み込んでいます</div>
          <div class="asia-map-annotations" data-map-annotations hidden></div>
          <div class="asia-farm-switches" data-farm-switches hidden={initialField!=='agriculture'} role="group" aria-label="農業地図の表示"><button type="button" data-farm-toggle="crop" aria-pressed="true">作物 <span>表示</span></button><button type="button" data-farm-toggle="livestock" aria-pressed="true">畜産 <span>表示</span></button></div>
          <div class="asia-map-tools"><button type="button" data-zoom-in aria-label="地図を拡大">＋</button><button type="button" data-zoom-out aria-label="地図を縮小">−</button><button type="button" data-map-fit aria-label="選択範囲に地図を合わせる">全景</button></div>
          <button class="asia-map-retry" data-map-retry type="button" hidden>地図を再読み込み</button>
        </div>
        <div class="asia-map-legend" data-asia-map-legend></div>
        <section class="asia-legend asia-farm-key" data-farm-overview-legend hidden={initialField!=='agriculture'} aria-label="農畜産物の品目一覧"><p class="asia-farm-period">2020年・概略分布</p><button class="asia-farm-return" type="button" data-farm-choice="overview" hidden>全品目の分布へ</button>{['crop','livestock'].map(kind=><div class="asia-farm-key-row"><strong>{kind==='crop'?'作物':'家畜'}</strong><div class="asia-farm-products">{presentation.farming.products.filter(p=>p.kind===kind).map(p=><button type="button" data-farm-choice={p.id} data-kind={p.kind} aria-pressed="false" style={`--product-color:${p.color}`} title={`${p.title}の詳しい分布を表示`}><i></i>{p.title}</button>)}</div></div>)}<p class="asia-farm-density-key" data-farm-density-key><span>2020年の概略分布</span><span><i class="core"></i>作物の集中域</span><span><i class="spread"></i>周辺の分布</span><span>● 畜産の代表点（数量を表しません）</span></p></section>
        <div class="asia-map-items" data-asia-map-items aria-label="地図に表示する項目">{regionId==='south-central-asia'&&<><label class="asia-topic-picker asia-south-central-product-picker" data-farming-selector hidden={initialField!=='agriculture'}>品目別の詳しい分布<select data-farming-topic aria-label="農林業の主題"><option value="overview">農畜産物の分布</option><option value="rice">米</option>{farming.layers.map(t=><option value={t.id}>{t.title}</option>)}</select></label><label class="asia-topic-picker" data-sc-industry-picker hidden={initialField!=='industry'}>地域の産業分布<select data-sc-industry-topic aria-label="南・中央アジアの産業を選ぶ"><option value="sc-overview">全体の産業分布</option>{regionalIndustryGroups.map(g=><option value={g.id}>{g.title}</option>)}{focusId!=='central-asia'&&<><option value="in-manufacturing">インドの州別製造業</option><option value="in-services">インドの州別サービス業</option></>}</select></label></>}</div>
        <div class="asia-map-selection" aria-live="polite"><span class="selection-dot"></span><span data-grid-reading>{initialField==='natural'?'地図上の陸地を選ぶと、気候区分を確認できます。':'地図上の対象地域を選ぶと、格子内の米の収穫面積を確認できます。'}</span></div>
        <p class="asia-gesture" data-map-gesture>都市の点を選ぶと雨温図が開きます。地図は2本指で移動・拡大できます。</p>
        {(regionId==='south-central-asia'||regionId==='southeast-asia')&&<section class="asia-farm-connections" data-south-central-farm-connections hidden={initialField!=='agriculture'} aria-label="農業の供給と世界での位置">
          <h2>農業の供給と世界での位置</h2>
          <div class="asia-farm-connections-grid">
            <section><h3 data-south-central-supply-title>供給元と行先</h3><div data-south-central-supply aria-live="polite"></div></section>
            <section><h3 data-south-central-destinations-title>主な輸出先</h3><div data-south-central-destinations aria-live="polite"></div></section>
            <section><h3>世界での位置</h3><div data-south-central-world-share aria-live="polite"></div></section>
          </div>
        </section>}
        <section class="asia-legend" data-climate-legend hidden={initialField!=='natural'} aria-label="気候区分の凡例"><div class="legend-title"><h3>気候区分</h3><span>区分を選ぶと意味を表示</span></div><div class="asia-family-legend">{familyNames.map(family=><details><summary><i style={`background:${asiaClimateClasses.find(c=>c.group.startsWith(family))?.color??'#aaa'}`}></i>{family}</summary><div class="asia-class-list">{asiaClimateClasses.filter(c=>c.group.startsWith(family)).map(c=><button type="button" data-climate-class={c.id} aria-pressed="false"><i style={`background:${c.color}`}></i><b>{c.code}</b><span>{c.name}</span></button>)}</div></details>)}</div></section>
        <section class="asia-legend" data-agriculture-legend hidden aria-label="米の収穫面積の凡例"><h3>米の収穫面積</h3><div data-rice-scale></div><p>1格子内の年間収穫面積（ha）。二期作などは収穫の回数を含むため、土地の面積とは異なります。</p></section>
        <section class="asia-legend" data-farming-legend hidden aria-label="農林業の凡例"><h3 data-farming-legend-title></h3><div class="asia-physical-key" data-farming-scale></div><p data-farming-legend-note></p></section>
        <section class="asia-legend" data-industry-legend hidden={initialField!=='industry'} aria-label="主要産業の凡例"><h3 data-industry-legend-title></h3><div class="asia-physical-key" data-industry-scale></div><p data-industry-legend-note></p></section>
        <section class="asia-legend" data-hydrology-legend hidden aria-label="降水量・流域・地下水の凡例"><h3 data-hydrology-legend-title></h3><div class="asia-physical-key" data-hydrology-scale></div><p data-hydrology-legend-note></p></section>
        {(['ethnicity','religion'] as const).map(topic=><section class="asia-legend" data-settlement-legend={topic} hidden><div class="asia-settlement-key">{settlementManifest.regions[regionId][topic].categories.filter(c=>!focusId||visibleSettlementCategoryIds[topic].has(c.id)).map(c=><button type="button" data-settlement-choice={c.id} data-settlement-topic={topic} aria-pressed="false"><i style={`background:${c.color}`}></i>{c.label}</button>)}</div><p>掲載した集団の居住域の概略です。色のない所は未分類で、人口がいないという意味ではありません。</p></section>)}
        <section class="asia-legend" data-social-legend hidden aria-label="年齢・社会統計の凡例"><h3 data-social-legend-title></h3><div class="asia-physical-key" data-social-scale></div><p data-social-legend-note></p></section>
        <section class="asia-legend" data-trade-legend hidden aria-label="商品貿易の凡例"><h3 data-trade-legend-title></h3><div class="asia-physical-key" data-trade-scale></div><p data-trade-legend-note></p></section>
        <section class="asia-legend" data-physical-legend hidden aria-label="標高と水系の凡例"><h3>標高（m・EGM2008基準）</h3><div class="asia-physical-key">{['0未満','0–200','200–500','500–1,000','1,000–2,000','2,000–3,000','3,000–4,500','4,500以上'].map((label,i)=><span><i style={`background:#${physicalManifest.colors[i]}`}></i>{label}</span>)}</div><p>等高線：500m間隔。青い線：河川、青い面：湖。線の太さは川幅や流量を表しません。周辺国は灰色、対象内の透明な箇所はデータなし。</p></section>
        <section class="asia-legend" data-population-legend hidden={initialField!=='population'} aria-label="人口密度の凡例"><h3>格子面積当たりの推計人口（人/km²・2020年）</h3><div class="asia-physical-key">{asiaPopulationLabels.map((label,i)=><span><i style={`background:${asiaPopulationColors[i]}`}></i>{label}</span>)}</div><p>都市名と丸は主要な掲載都市の位置を示し、大きさは人口を表しません。都市を選んでも表示範囲は変わりません。色のない箇所は、推計0人・海・データなしを含みます。地点を選ぶと数値を確認できます。</p><p data-population-resolution></p></section>
        {regionId!=='south-central-asia'&&<details class="asia-country-list"><summary>{region.label}の国・地域を一覧から選ぶ</summary><div>{countries.map(c=><button type="button" data-country-button={c.code} aria-pressed="false">{c.name}</button>)}</div></details>}
      </section>
      <aside class="atlas-field-national asia-reading-panel" data-field-national={initialField} aria-label="地図の解説">
       <div class="asia-city-reading-host" data-city-reading-host hidden>
        {cities.map(city=><article class="asia-city-card" data-city-panel={city.id} id={`city-${city.id}`} hidden><h2 class="visually-hidden">{city.name}の気候</h2><AsiaClimateDiagram {city} {precipitationMax} countryName={japaneseNames[city.countryCode]} /></article>)}
       </div>
       <section class="asia-reading-dock" data-reading-dock aria-label="この地図の要点と比較">
        <p class="eyebrow">この地図の要点</p><h2 data-reading-dock-title>{reading.title}</h2><p data-reading-dock-summary>{reading.summary}</p>
        <div class="asia-comparison-compact asia-main-legend" data-reading-map-legend aria-label="この地図の凡例・年・単位" hidden></div>
        <div class="asia-reading-dock-links" data-reading-dock-links>{fieldTabs.map(f=><button type="button" data-compare={f.id} data-dock-compare={f.id} hidden={f.id===initialField}>{f.label}と比べる <span>→</span></button>)}</div>
        <div class="asia-comparison-return" data-comparison-return hidden><button type="button" data-comparison-back>比較前の地図に戻る</button></div>
        <section class="asia-comparison-reading" data-comparison-reading hidden><h3 data-comparison-title></h3><p data-comparison-summary></p><div class="asia-comparison-compact" data-comparison-compact aria-label="比較元と比較先の凡例・年・単位"></div></section>
        <label class="asia-city-picker" data-city-picker hidden={initialField!=='natural'}>都市の雨温図<select data-city-select aria-label="都市の雨温図を選ぶ"><option value="">都市を選ぶ</option>{cities.map(c=><option value={c.id} data-country={c.countryCode}>{c.name} · {japaneseNames[c.countryCode]}</option>)}</select></label>
        {regionId==='east-asia'&&<label class="asia-topic-picker" data-farming-selector hidden={initialField!=='agriculture'}>品目別の詳しい分布<select data-farming-topic aria-label="農林業の主題"><option value="overview">農畜産物の分布</option><option value="rice">米</option>{farming.layers.map(t=><option value={t.id}>{t.title}</option>)}</select></label>}
       </section>
        <AsiaSeasonalPrecipitationPanel />
        <details class="asia-reading-details" data-reading-details open={!(regionId==='east-asia'&&initialField==='agriculture')}><summary>詳しい解説・出典を読む</summary>
       <div class="atlas-national asia-reading-scroll" tabindex="0" role="region" aria-label="選択した場所の詳しい解説">
        <details class="asia-comparison-method" data-comparison-method hidden><summary>比較区分の正式名称・説明・出典を読む</summary><p>元の選択と地図の位置を保存しています。</p><div data-comparison-legend></div></details>
        <section data-focus-reading hidden><h3 data-focus-reading-title></h3><p data-focus-reading-body></p><p class="asia-small">出典：<a data-focus-reading-source></a></p></section>
        <AsiaPopulationPanel {regionId} {population} active={initialField==='population'} />
        <AsiaIndustryPanel {regionId} active={initialField==='industry'} />
        {regionId==='southeast-asia'&&<SoutheastAsiaFarmView />}
        <AsiaWaterPanel />
        <AsiaSocialPanel />
        <AsiaSettlementPanel {regionId} {pageId} visibleSettlementCategoryIds={focusId?visibleSettlementCategoryIds:undefined} />
        <AsiaTradePanel />
        <section class="asia-overview" data-overview hidden={initialField!=='natural'}><p class="eyebrow" data-reading-eyebrow>How to read this map</p><h2 data-reading-title>{reading.title}</h2><p class="asia-takeaway" data-reading-summary>{reading.summary}</p><div data-reading-questions><h3>地図で確かめること</h3><ol>{reading.questions.map(q=><li>{q}</li>)}</ol></div><div class="asia-next"><p>都市を選ぶと、雨温図と月別の数値を読めます。</p><div class="asia-city-links">{cities.slice(0,4).map(city=><button type="button" data-city-shortcut={city.id}>{city.name}<span>↗</span></button>)}</div></div></section>
        <section class="asia-class-reading" data-class-reading hidden><p class="eyebrow">Climate classification</p><h3><b data-class-code></b><span data-class-name></span></h3><p data-class-description></p><p class="asia-small">広域の格子データによる分類です。観測所の位置や気候の期間・解像度によって、雨温図から読む特徴と一致しないことがあります。</p></section>
        <section class="asia-farm-overview-reading" data-farm-overview-reading hidden={initialField!=='agriculture'}><p class="eyebrow">Agriculture &amp; Livestock · 2020</p><h2 data-farm-insight-title>{farmInsight.title}</h2><p class="asia-takeaway" data-farm-insight-lead>{farmInsight.lead}</p><h3>水の確保と稲作の分布</h3><p>{farmInsight.body}</p><a class="asia-small" href={farmInsight.source}>水と稲作の説明の出典</a><p class="asia-small">色面で作物の栽培域を示し、名前付きの点で主な畜産地域を示します。点の大きさは頭数・羽数を表しません。同じ品目の濃い色は集中する地域、淡い色は周辺に続く分布です。作物が重なる場所では特徴的な一品目を代表として塗ります。畜産の点はその上に重ねるため、同じ地方で両方が営まれていることも読めます。</p><details class="asia-method"><summary>概略図の作り方と出典</summary><p>元の推計格子を共通の約12kmの投影格子にまとめ、周辺の分布をならしました。各品目の地域内での順位が上位55％に入る格子まで表示し、上位15％の集中域は濃くしています。作物同士が重なる場所は順位の高い一品目を代表とします。畜産は各品目の集中域の大きなまとまりから代表点を選びます。共通格子への平均化後の値が1ha/元格子未満の作物、1頭または1羽/km²未満の家畜は表示候補から除き、分布がない場所まで色を延ばしません。表示候補となった小さな区域も残します。地表での距離は緯度により異なります。色の濃淡は品目内での相対的な分布を示し、品目間の生産量や面積を比較する尺度ではありません。</p><p>地図直下の品目名を選ぶと、元の分布と地点の数値を確認できます。農畜産物は2020年の推計です。色を付けていない場所は、掲載品目の分布が薄いか、資料がない範囲です。農業がないという意味ではありません。色の付いた範囲も、すべてが農地や放牧地という意味ではなく、地方の特徴をつかむための概略です。</p><p>作物：IFPRI MapSPAM 2020 v2r2（米はCC BY-SA 4.0、他はCC BY 4.0）。家畜：FAO GLW4 2020（CC BY 4.0）。川：Natural Earth 1:50m。雨：CHELSA（CC0 1.0）。</p></details></section>
        <section class="asia-rice-reading" data-rice-reading hidden><p class="eyebrow">Agriculture · Rice</p><h2>米が育つ場所と、気候の関係</h2><p class="asia-takeaway">米の収穫面積の分布を、都市の気温・降水量と見比べます。</p><div class="asia-rice-value" data-rice-value>地図上の対象地域を選ぶと、格子内の収穫面積を表示します。</div><p data-rice-summary></p><h3>「面積」の読み方</h3><p>収穫面積は、年間に収穫した作付面積です。同じ土地で複数回収穫すると、その回数分を含みます。表示は統計などを基にした空間配分モデルの推計で、個々の田畑の境界を示すものではありません。</p><p>気候と栽培の分布が重なることだけでは、因果関係は確定しません。灌漑、地形、土壌、品種、経済条件も関わります。</p><button class="asia-compare" type="button" data-compare="natural">同じ場所で気候を比べる<span>→</span></button><p class="asia-small" data-rice-source></p></section>
        <AsiaFarmingPanel active={false} />
        <section data-physical-reading hidden><p class="eyebrow">Terrain &amp; Water · ETOPO 2022</p><h2 data-physical-title>地形を読む</h2><p class="asia-takeaway" data-physical-takeaway>{focusId?southCentralFocusPhysicalReading[focusId].terrain:asiaPhysicalReading[regionId].terrain}</p><label class="asia-detail-picker">地形の着目点<select data-physical-focus aria-label="地形の着目点"><option value="">地図上の地点を選ぶ</option>{physicalFocus.map(f=><option value={f.id} data-country={f.country}>{f.name}</option>)}</select></label><label class="asia-detail-picker" data-water-picker hidden>河川・湖<select data-water-select aria-label="河川・湖を選ぶ"><option value="">一覧から選ぶ</option>{physical.waterFeatures.map(f=><option value={f.id}>{f.label}（{f.kind==='rivers'?'河川':'湖'}）</option>)}</select></label><div class="asia-rice-value" data-physical-value aria-live="polite">地点を選ぶと格子の標高を表示します。</div><h3 data-physical-detail-title>高低差と広がり</h3><p data-physical-detail></p><p data-physical-context></p>{regionId==='south-central-asia'&&<p class="asia-small" data-sc-landform-sources hidden>成り立ちの資料：{(focusId?southCentralFocusLandformSources[focusId]:southCentralLandformSources).map((s,i)=><>{i>0?' · ':''}<a href={s.url}>{s.label}</a></>)}</p>}<details class="asia-method"><summary>数値と地形の読み方</summary><p>元資料はNOAA ETOPO 2022の60秒角（赤道付近で約1.85km）です。Web Mercator上で約2.23kmの格子に平均化し、選択値と色を同じ値から生成しています。表示値は整数に丸めたもので、1m精度の測量値ではありません。</p><p>等高線は表示格子を平滑化して計算した500m間隔です。短い線と細部を省き、広域の高低差を読みやすくしています。地点の標高は平滑化前の数値です。海岸では陸地と海底が混じり、小島が欠ける場合があります。河川・湖はNatural Earth 1:50m v5.1.2の概略形状で、現在の湖面・流量・水質・水供給量を示しません。</p></details><button class="asia-compare" type="button" data-compare="agriculture">同じ場所で米の分布を見る<span>→</span></button><p class="asia-small">出典：<a href="https://doi.org/10.25921/fd45-gt74">NOAA ETOPO 2022</a> · <a href="https://www.naturalearthdata.com/downloads/50m-physical-vectors/">Natural Earth</a>。地域抽出・加工：Insight Journal。</p></section>
      {regionId==='southeast-asia'&&<label class="asia-topic-picker" data-farming-selector hidden={initialField!=='agriculture'}>品目別の詳しい分布<select data-farming-topic aria-label="農林業の主題"><option value="overview">農畜産物の分布</option><option value="rice">米</option>{farming.layers.map(t=><option value={t.id}>{t.title}</option>)}</select></label>}
      <label class="asia-topic-picker" data-population-selector hidden={initialField!=='population'}>表示する人口統計<select data-population-topic aria-label="人口の主題">{asiaPopulationTopics.map(t=><option value={t.id}>{t.label}</option>)}{social.groups.map(g=><option value={socialEntry(g.id)}>{g.label}</option>)}</select></label>
      <details class="asia-industry-all" data-industry-all hidden={initialField!=='industry'}><summary>収録済みの統計をすべて見る</summary><label class="asia-topic-picker" data-industry-topics hidden={initialField!=='industry'}>表示する産業統計<select data-industry-topic aria-label="主要産業の主題">{industryGroups.map(group=><optgroup label={group}>{industry.topics.filter(t=>t.parent===group).map(t=><option value={t.id}>{t.title}</option>)}</optgroup>)}</select></label></details>

        <AsiaPlaceReading />
        <details class="asia-map-method" data-asia-map-method><summary>区分の正式名称・数値・地図の読み方</summary></details>
       </div>
       </details>
      </aside>
     </div>
     {regionId==='east-asia'&&<EastAsiaFarmFoundations />}
    </section>
    <details class="asia-source-fold"><summary>地図の範囲と全出典を確認する</summary><footer class="asia-sources" id="asia-sources"><h2>地図の範囲と出典</h2>{focus&&<p>このページで選べる国・都市と立地例は{focus.label}に絞っています。元の広域格子は南・中央アジア共通の資料を再利用しています。国別の数値は表示枠内だけの合計ではなく、各国全体の統計です。</p>}<div class="asia-source-grid"><section><h3>気候区分・都市</h3><p>気候区分：<a href="https://www.nature.com/articles/s41597-023-02549-6">Beckほか（2023）</a>、<a href="https://www.gloh2o.org/koppen/">GloH2O</a>。1991–2020の分類データを広域表示向けに加工。元データと加工した表示の解像度を区別して使用しています。</p><p data-climate-method>気候データの版・解像度・利用条件を読み込んでいます。</p><p>雨温図：<a href="https://www.data.jma.go.jp/tcc/tcc/products/climate/climatview/frame.php">気象庁 ClimatView</a>ほか。観測所・平年期間と個別の出典は各都市の図表に記載。欠測値は補いません。</p></section><section><h3>米の分布・国境</h3><p data-agriculture-method>米の分布の出典・対象年・利用条件を読み込んでいます。</p><p>国境：<a href="https://www.naturalearthdata.com/downloads/110m-cultural-vectors/110m-admin-0-countries/">Natural Earth</a>。気候・米・地形図の基図は1:110m（一部は1:50m）、人口・産業、追加した農林業・降水量・流域・地下水図の基図は1:10mです。ここでmは縮尺の百万倍を表し、10mの地上分解能という意味ではありません。小島などの細部は省略されます。境界・名称は資料の表示上の区分に沿っています。</p><p>対象はアジア4地域の30か国・地域。中東（イランを含む）とロシアは選択対象に含みません。周辺国は灰色で表示します。地図は面積の比較には適しません。</p></section></div><p class="asia-source-status">掲載範囲：気候区分、都市の雨温図、標高・等高線・河川・湖、米の分布、人口分布、52都市の範囲と推計人口、うち11都市の詳細人口図です。農林業では地域別の主要作物・家畜の分布、森林の参考図と国別統計も掲載しています。自然環境には1981–2010年の年降水量、地形から定めた流域、地下水を蓄える地層と涵養の広域区分も掲載しています。主要産業では国別11指標、日本・中国・マレーシア・インドの行政区域別統計、WRIの2021年公開版に収録された発電施設を掲載しています。人口では2020年の人口分布と、GeoEPR 2021に基づく一部の民族・宗教に結びついた居住域の概略を掲載しています。居住域は各地点の多数派や信者割合を示さず、全地域を網羅していません。水系の形状と、水資源の量・利用は別の情報です。</p></footer></details>
    <noscript><p>操作にはJavaScriptが必要です。国・地域の位置と、以下の都市の観測値を参照できます。</p><ul>{cities.map(c=><li><a href={c.sourceUrl}>{c.name}の平年値（{c.sourceName}）</a></li>)}</ul></noscript>
    </article>
    <section class="asia-statistics" data-asia-statistics hidden aria-label="この地図に関する統計"></section>
   </AtlasWorkspaceFrame>
    <script type="application/json" data-asia-config set:html={JSON.stringify(config).replace(/</g,'\\u003c')} />
  </div>
</BaseLayout>
<script>import '../../scripts/atlas-asia-explorer';</script>
<style>
  .asia-topic-picker select{min-width:0;flex:1}.asia-topic-picker{max-width:100%}
  :global([data-farming-scale] span){display:inline-flex;align-items:center;gap:5px;font-size:11px;line-height:1.8}
  :global([data-farming-scale] i){display:inline-block;width:13px;height:13px;flex:none;border:1px solid #50604f55}
  .asia-farm-connections{margin:18px 0 8px;padding:16px;background:#f7f7f1;border:1px solid #d6dcd1}.asia-farm-connections>h2{margin:0 0 12px;font:700 18px/1.5 var(--serif)}.asia-farm-connections-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;align-items:start}.asia-farm-connections-grid>section{min-width:0;align-self:start;padding:12px;background:#fffef9;border:1px solid #dbe0d4}.asia-farm-connections h3{margin:0 0 8px;font-size:13px}.asia-farm-connections p{margin:0;font-size:12px;line-height:1.7}
  :global(.sc-flow-lead){font-weight:700;color:#294c40}:global(.sc-flow-track){display:flex;height:22px;overflow:hidden;margin:12px 0 5px;border-radius:3px}:global(.sc-flow-basmati){background:#285c50}:global(.sc-flow-other){background:#a7a66c}:global(.sc-flow-legend){font-size:11px!important;color:#476054}:global(.sc-flow-legend i){display:inline-block;width:10px;height:10px;margin-right:4px}:global(.sc-flow-detail){margin-top:10px!important;font-size:11px!important;color:#526257}:global(.sc-flow-pie){width:118px;height:118px;border-radius:50%;margin:5px auto 12px}:global(.sc-flow-destinations){margin:0;padding:0;list-style:none;font-size:11px}:global(.sc-flow-destinations li){display:flex;align-items:center;gap:6px;margin:4px 0}:global(.sc-flow-destinations i){flex:none;width:10px;height:10px}:global(.sc-flow-destinations span){flex:1}:global([data-south-central-supply] a),:global([data-south-central-destinations] a){display:inline-block;margin-top:9px;color:#285b60;font-size:11px}
