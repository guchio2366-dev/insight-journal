<section data-place-reading hidden aria-label="地域の成り立ちを読む">
 <label>地域の事例<select data-place-story aria-label="地域の事例を選ぶ"><option value="">事例を選ぶ</option></select></label>
 <div data-place-story-body hidden>
  <h2 data-place-story-title></h2><p class="story-lead" data-place-story-lead></p><p data-place-story-text></p>
  <p class="story-scope" data-place-story-scope></p><p class="story-source">出典：<a data-place-story-source></a></p>
  <div class="story-bridges" data-place-story-bridges></div>
 </div>
</section>
<style>
 [hidden]{display:none!important}section{min-width:0;border-bottom:1px solid var(--rule);padding-bottom:14px;margin-bottom:18px}label{display:grid;gap:5px;font-size:12px}select{min-width:0;width:100%;max-width:100%;min-height:44px;border:1px solid var(--rule);background:#fff;font:inherit;padding:8px}h2{font-family:var(--serif);font-size:23px;line-height:1.5;margin:16px 0 8px}p{font-size:13px;line-height:1.9;overflow-wrap:anywhere}.story-lead{font-weight:600}.story-scope,.story-source{font-size:11px;color:var(--ink-soft)}.story-bridges{display:grid;gap:6px}.story-bridges :global(button){width:100%;min-height:44px;border:1px solid #315b61;background:#edf3f1;color:#264c52;padding:9px 12px;text-align:left;font-size:12px;line-height:1.7}.story-bridges :global(button:focus-visible),select:focus-visible{outline:3px solid #a74830;outline-offset:2px}
</style>
