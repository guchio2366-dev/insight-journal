---
import AgricultureProductReading from './AgricultureProductReading.astro';
import AgricultureDetailPanel from './AgricultureDetailPanel.astro';
import ProductionShareChart from './ProductionShareChart.astro';
import UsCropSupplyUse from './UsCropSupplyUse.astro';
import ConditionText from './ConditionText.astro';
import {agroMarketingYearFlow} from '../../data/atlas/agro-marketing-year-flow';
import {renderAgroMarketingProduction} from '../../lib/atlas-agro-statistics';
import '../../styles/atlas-agro-statistics.css';
import { cropExplanations } from '../../data/atlas/explorer';
import { atlasStatistics, statisticCropIds, statisticsSources, type StatisticCropId } from '../../data/atlas/statistics';
import { sources } from '../../data/atlas/north-america-agriculture';

const names: Record<StatisticCropId,string> = { corn:'とうもろこし', soybean:'大豆', wheat:'小麦', cotton:'綿花', rice:'米' };
const colors: Record<StatisticCropId,string> = { corn:'#d9a526', soybean:'#759b62', wheat:'#bd7b45', cotton:'#a46998', rice:'#3c91b2' };
const countries: Record<string,string> = {
  'United States':'米国', China:'中国', Brazil:'ブラジル', 'European Union':'EU', Argentina:'アルゼンチン', India:'インド', Russia:'ロシア', Australia:'豪州', Bangladesh:'バングラデシュ', Indonesia:'インドネシア', Vietnam:'ベトナム', Mexico:'メキシコ', Japan:'日本', 'South Korea':'韓国', Colombia:'コロンビア', 'European Union-27':'EU27', Egypt:'エジプト', Philippines:'フィリピン', Nigeria:'ナイジェリア', Pakistan:'パキスタン', Turkey:'トルコ', Haiti:'ハイチ', Iraq:'イラク', Canada:'カナダ', Other:'その他'
};
const sourceForExport = (id:StatisticCropId) => statisticsSources.find(entry=>entry.id===(id==='rice'?'source-usda-gats-rice':'source-usda-fatus-markets'))!;
const productionSource = statisticsSources.find(entry=>entry.id==='source-usda-psd')!;
const fmt = (value:number) => new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1}).format(value);
const fmtQuantity = (value:number) => value.toLocaleString('ja-JP',{maximumFractionDigits:20});
const pct = (value:number,total:number) => value/total*100;
const productionUnit = (id:StatisticCropId) => id==='cotton'?'千480ポンド俵':'千トン';
---
<section class="atlas-crop-details" id="crop-details" aria-labelledby="crop-details-title" data-detail-group="crops">
  <header class="atlas-crop-details-head">
    <p class="atlas-eyebrow">CROP DETAIL</p>
    <h2 id="crop-details-title">作物を詳しく読む</h2>
    <p>作物の性質、米国の地域条件、用途と世界の中での位置を一続きで確認できます。</p>
  </header>
  <div class="atlas-stat-tabs" role="tablist" aria-label="詳しく見る作物" data-stat-tabs>
    {statisticCropIds.map((id,index)=><button type="button" role="tab" aria-selected={index===0?'true':'false'} aria-controls={`crop-${id}`} id={`stat-tab-${id}`} data-stat-select={id} style={`--crop-color:${colors[id]}`}>{names[id]}</button>)}
  </div>

  {statisticCropIds.map((id,index)=>{
    const description=cropExplanations.find(entry=>entry.id===id)!;
    const exportData=atlasStatistics.exports[id];
    const production=atlasStatistics.production[id];
    const flow=agroMarketingYearFlow('USA',({corn:'maize-production',soybean:'soybean-production',wheat:'wheat-production',rice:'rice-milled-production',cotton:'cotton-lint-production'} as Record<string,string>)[id]??'');
    let offset=0;
    return <AgricultureDetailPanel id={id} group="crops" color={colors[id]}>
      <Fragment slot="copy">
        <h3>{names[id]}</h3>
        <AgricultureProductReading product={id} />
        {id!=='corn'&&<p class="atlas-crop-uses"><strong>主な用途</strong>{description.uses}</p>}
        <p class="atlas-inline-sources">地理・用途：{description.sources.map((sourceId,sourceIndex)=><Fragment>{sourceIndex>0?' ／ ':''}<a href={`#${sourceId}`}>{sources.find(source=>source.id===sourceId)?.publisher}</a></Fragment>)}</p>
      </Fragment>
      <UsCropSupplyUse slot="supply" id={id}/>
        <figure class="atlas-export-chart" id={`exports-${id}`} slot="exports">
          <figcaption class="atlas-comparison-caption"><strong>③ 輸出先の量と構成比</strong><span>別期間の参考：{exportData.year}暦年・数量（予備値）</span><span>{names[id]}{id==='rice'?'・精米換算':''} · トン</span></figcaption>
          <p class="atlas-chart-note">②の2024/25販売年度と期間が異なるため、②の輸出量の内訳には接続できません。{id==='wheat'?'未製粉小麦の輸出で、②の小麦粉等を含む小麦換算とは商品範囲も異なります。':id==='rice'?'②③とも精米換算ですが、独立した提供元の換算系列です。':''}</p>
          <p class="atlas-chart-note">この暦年の最大輸出先：<strong>{countries[exportData.destinations[0].country]??exportData.destinations[0].country} {pct(exportData.destinations[0].value,exportData.total).toFixed(1)}%</strong> · 上位3市場 <strong>{pct(exportData.destinations.slice(0,3).reduce((sum,r)=>sum+r.value,0),exportData.total).toFixed(1)}%</strong>（数量比）。</p>
          <div class="atlas-donut-layout">
            <svg class="atlas-donut" viewBox="0 0 144 144" role="img" aria-labelledby={`crop-export-title-${id}`}>
              <title id={`crop-export-title-${id}`}>{names[id]}の輸出数量構成。総量{fmtQuantity(exportData.total)}トン{ id==='rice'?'（精米換算）':''}。国・地域別の値は隣の一覧と数値表に表示。</title>
              <circle cx="72" cy="72" r="52" pathLength="100" class="atlas-donut-base"></circle>
              {exportData.destinations.map((entry,entryIndex)=>{
                const share=pct(entry.value,exportData.total); const start=offset; offset+=share;
                return <circle cx="72" cy="72" r="52" pathLength="100" class={`atlas-donut-slice atlas-donut-slice--${entryIndex}`} stroke-dasharray={`${share} ${100-share}`} stroke-dashoffset={-start} transform="rotate(-90 72 72)"><title>{countries[entry.country]??entry.country} {share.toFixed(1)}%</title></circle>;
              })}
              <text x="72" y="62" text-anchor="middle">総輸出量</text><text x="72" y="80" text-anchor="middle" class="atlas-donut-total">{fmt(exportData.total/1_000_000)}</text><text x="72" y="96" text-anchor="middle">百万トン</text>
            </svg>
            <ol class="atlas-donut-key">{exportData.destinations.map((entry,entryIndex)=><li><i class={`atlas-donut-color--${entryIndex}`} aria-hidden="true"></i><span class="atlas-donut-label"><span>{countries[entry.country]??entry.country}</span><strong>{pct(entry.value,exportData.total).toFixed(1)}%</strong><span>{fmt(entry.value)} t</span></span></li>)}</ol>
          </div>
          <p class="atlas-chart-note">{id==='rice'?'FAS換算可能な明細の精米換算（MTMEQ）。':'上位5市場とその他を表示。'}</p>
          <details class="atlas-chart-data"><summary>輸出量・対象範囲を確認</summary>
            <table><caption>{exportData.year}暦年・予備値 · {id==='rice'?'精米換算トン（MTMEQ）':'トン'}</caption><thead><tr><th>国・地域</th><th>輸出量</th><th>構成比</th></tr></thead><tbody>{exportData.destinations.map(entry=><tr><th scope="row">{countries[entry.country]??entry.country}</th><td>{fmtQuantity(entry.value)}</td><td>{pct(entry.value,exportData.total).toFixed(1)}%</td></tr>)}<tr><th scope="row">世界向け総量</th><td>{fmtQuantity(exportData.total)}</td><td>100%</td></tr></tbody></table>
            <p>総輸出量を母数に上位5市場とその他を表示。表示割合の合計は丸めで100%と異なる場合があります。</p>
          </details>
          <a href={sourceForExport(id).url} target="_blank" rel="noopener noreferrer">出典：{sourceForExport(id).publisher}</a>
        </figure>

      <Fragment slot="world">{flow&&<section class="atlas-world-chart agro-quantity-flow" data-us-flow-production={id}><div set:html={renderAgroMarketingProduction({...flow,countryName:'米国'})}/></section>}
      <details class="agro-other-reference" open={!flow}><summary>保存済みPSDの順位・推移（別資料）</summary><p class="atlas-chart-note">PSD抽出の国・地域行合計が分母です。上のWASDE公表Worldと別の版・集計で、②の数量へ置き換えません。</p><ProductionShareChart id={id} name={names[id]} period={`${production.marketYear}販売年度`} basis={id==='rice'?'米・精米換算':names[id]} unit={productionUnit(id)} totalUnit={id==='cotton'?'百万480lb俵':'百万トン'} totalDivisor={1000} worldTotal={production.worldTotal} countries={production.countries} trend={production.trend} sourceUrl={productionSource.url} sourceLabel="USDA FAS PSD" /></details></Fragment>
    </AgricultureDetailPanel>;
  })}
  <noscript><style>.atlas-stat-tabs{display:none}</style><p class="atlas-chart-note">各作物の本文と図を順に表示しています。</p></noscript>
</section>
