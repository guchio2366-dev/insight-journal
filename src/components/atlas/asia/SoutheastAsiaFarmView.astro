---
import {readFileSync} from 'node:fs';
import {gunzipSync} from 'node:zlib';
import {resolve} from 'node:path';
import {southeastCropPriority} from '../../../data/atlas/asia/southeast-asia-crop-priority.mjs';
import {southeastStudyCountries,southeastCountryNames,southeastExportExamples} from '../../../data/atlas/asia/southeast-asia-forestry-trade';
import shares from '../../../../public/assets/atlas/southeast-asia-v1/world-shares.json';
import foodBalances from '../../../../public/assets/atlas/southeast-asia-v1/food-balances-2023.json';

const statistics=JSON.parse(gunzipSync(readFileSync(resolve(process.cwd(),'public/assets/atlas/asia-farming-v1/statistics.json.gz'))).toString('utf8'));
const priority=southeastCropPriority(statistics);
const amount=(tonnes:number)=>tonnes>0&&tonnes<5000?'<1':Math.round(tonnes/10000).toLocaleString('ja-JP');
const mapLabels:Record<string,string>={arabica:'アラビカ分布',robusta:'ロブスタ分布'};
const studyCountries=southeastStudyCountries;
const allCountries=Object.entries(southeastCountryNames);
const shareText=(value:number|undefined)=>value===undefined?'欠測':value>0&&value<.01?'0.01%未満':`${value.toLocaleString('ja-JP',{maximumFractionDigits:2})}%`;
const worldRows=shares.series.filter(series=>['rice-production','maize-production','soybean-production'].includes(series.id)).flatMap(series=>studyCountries.map(([code,name])=>({
 item:series.label,country:name,initial:series.years.find(row=>row.year===2020)?.countries[code]?.share,
 latest:series.years.find(row=>row.year===2024)?.countries[code]?.share,
})));
const riceShare=(country:string)=>shareText(worldRows.find(row=>row.item==='米'&&row.country===country)?.initial);
const trade=JSON.parse(gunzipSync(readFileSync(resolve(process.cwd(),'public/assets/atlas/asia-trade-v1/southeast-asia.json.gz'))).toString('utf8'));
const faoValue=(code:string,item:string,element='Production')=>statistics.countries[code]?.observations.find((o:{domain:string;item:string;element:string;year:number;value:number})=>o.domain===(item==='6646'?'Inputs_LandUse':item==='27'?'Production_Crops_Livestock':'Forestry')&&o.item===item&&o.element===element&&o.year===2024)?.value as number|undefined;
const countryNames=southeastCountryNames;
const quantity=(value:number|undefined)=>value===undefined?'欠測':value>0&&value<1000?'0.1未満':(value/10000).toLocaleString('ja-JP',{maximumFractionDigits:1});
const dollars=(value:number|undefined)=>value===undefined?'欠測':value>0&&value<1e7?'0.1未満':(value/1e8).toLocaleString('ja-JP',{maximumFractionDigits:1});
const forestItems=[['1861','丸太材'],['1872','製材']] as const;
const forestRows=forestItems.flatMap(([item,label])=>allCountries.map(([code,name])=>({item:label,name,value:faoValue(code,item),flag:statistics.countries[code]?.observations.find((o:{domain:string;item:string;element:string;year:number;flag:string})=>o.domain==='Forestry'&&o.item===item&&o.element==='Production'&&o.year===2024)?.flag,share:shares.series.find(s=>s.id===(item==='1861'?'roundwood-production':'sawnwood-production'))?.years.find(y=>y.year===2024)?.countries[code]?.share})));
const tradeItems=southeastExportExamples;
const exportRows=tradeItems.map(([code,hs,label])=>({name:countryNames[code],hs,label,value:trade.countries[code].products[hs]?.X as number|undefined}));
const riceTradeRows=Object.entries(countryNames).map(([code,name])=>({code,name,imports:trade.countries[code]?.products['1006']?.M as number|undefined,exports:trade.countries[code]?.products['1006']?.X as number|undefined}));
const riceTradeAmount=(value:number|undefined)=>value===undefined?'欠測':value===0?'0':value<100000?'<0.1':(value/1e6).toLocaleString('ja-JP',{maximumFractionDigits:1});
const woodExportRows=allCountries.map(([code,name])=>({name,exports:trade.countries[code]?.products['44']?.X as number|undefined,imports:trade.countries[code]?.products['44']?.M as number|undefined}));
const riceTradeLeaders=(direction:'exports'|'imports')=>riceTradeRows.filter(row=>row[direction]!==undefined).sort((a,b)=>b[direction]!-a[direction]!).slice(0,3);
const balanceAmount=(value:number|null)=>value===null?'—':(value/10000).toLocaleString('ja-JP',{maximumFractionDigits:1,minimumFractionDigits:1});
const balanceGroups=[{name:'供給',total:'totalSupply',cells:[['beginningStock','期首在庫','#b4a474'],['production','生産','#397765'],['imports','輸入','#647da5']]},{name:'利用・繰越',total:'totalDemand',cells:[['domesticUtilization','国内利用','#397765'],['exports','輸出','#a65f46'],['endingStock','期末在庫','#b4a474']]}] as const;
const riceBalanceCountries=foodBalances.commodities.find(row=>row.id==='rice')?.countries??[];
const fatPartners=trade.countries.IDN.partners['15'];
const partnerLabels:Record<number,string>={156:'中国',699:'インド',586:'パキスタン',842:'米国',458:'マレーシア'};
const topPartners=(fatPartners.values as [number,number][]).slice(0,4).map(([code,value])=>({label:partnerLabels[code]??trade.partners[String(code)]?.name,value,share:value/fatPartners.world*100}));
const otherPartnerShare=Math.max(0,100-topPartners.reduce((sum,row)=>sum+row.share,0));
const pieColors=['#397765','#b1753d','#647da5','#9f6384','#d8d4bd'];
let pieEnd=0;
const pieStyle=`conic-gradient(${[...topPartners.map((row,index)=>({share:row.share,color:pieColors[index]})),{share:otherPartnerShare,color:pieColors[4]}].map(row=>{const start=pieEnd;pieEnd+=row.share;return `${row.color} ${start.toFixed(4)}% ${pieEnd.toFixed(4)}%`;}).join(',')})`;
---
<button type="button" data-southeast-farm-single hidden aria-pressed="false">この品目だけ表示</button>
<p class="southeast-industry-bridge southeast-rubber-bridge"><a href="../industry/?industryKind=rubber">天然ゴムの産地とタイヤ工場の立地を比べる →</a></p>
<details class="southeast-crop-priority" data-southeast-crop-priority>
 <summary>2020年の生産重量から主要作物の候補を確かめる</summary>
 <p>読めること：米の低地と、油ヤシ・ゴムなどの樹木作物は分布が異なります。収録14作物について、FAOSTATの2020年・生産重量（t）の有効値を11か国・地域で合計した候補順位です。重さは農業の価値や栄養、土地面積の順位ではありません。</p>
 <table><caption>生産重量の上位10候補。万tは四捨五入、「&lt;1」は1万t未満、有効国数は11か国・地域中</caption><thead><tr><th scope="col">品目・分布図</th><th scope="col">万t</th><th scope="col">有効国</th></tr></thead><tbody>{priority.selected.map(row=><tr><th scope="row"><strong>{row.label}</strong><span class="crop-map-links">{row.maps.length?row.maps.map(id=><button type="button" data-farm-group-topic={id}>{mapLabels[id]??'分布図を見る'}</button>):<span>分布図は未収録</span>}</span><small>資料区分 {row.flags.join('・')}</small></th><td>{amount(row.tonnes)}</td><td>{row.reportedCountries}/{priority.countryCount}</td></tr>)}</tbody></table>
 <p>次点：{priority.next.map(row=>`${row.label}（${amount(row.tonnes)}万t、${row.reportedCountries}/${priority.countryCount}か国）`).join('、')}。採用候補との差は、この収録集合で報告された重量の差です。茶・大豆・ひよこ豆は上位10候補でも地域の分布図がなく、地図へ追加していません。</p>
 <p>油ヤシは果実、コーヒーは生豆の種類合計、ゴムは一次形態です。コーヒーの国計をアラビカ・ロブスタ両方へ重複計上していません。国の欠測・未収録は0とせず、合計と有効国数を併記しました。資料区分はA＝公的報告、E＝推計、I＝受入機関の補完、X＝外部機関の値です。特に有効国の少ない品目を地域の確定順位とは扱えません。</p>
 <p class="source">出典：<a href="https://www.fao.org/faostat/en/#data/QCL">FAOSTAT 作物生産</a>（2020年、Production、t）。<a href="https://www.fao.org/contact-us/terms/db-terms-of-use/">利用条件・CC BY 4.0</a>に基づく収録値の再集計。地図は別資料のMapSPAM 2020推計収穫面積で、この表の重量を描いたものではありません。</p>
</details>
<details class="southeast-world-share" data-southeast-world-share>
 <summary>米・トウモロコシ・大豆の世界生産比を比べる</summary>
 <p>2020年の地図に合わせて3か国の同じ品目・生産重量の世界比を示します。2024年も同じ定義です。米はインドネシア{riceShare('インドネシア')}、ベトナム{riceShare('ベトナム')}、タイ{riceShare('タイ')}で、地図の収穫面積とは別の国別数量です。</p>
 <table><caption>国別生産重量 ÷ 当該年のWorld生産重量。％、欠測は0としない</caption><thead><tr><th scope="col">品目</th><th scope="col">国</th><th scope="col">2020</th><th scope="col">2024</th></tr></thead><tbody>{worldRows.map(row=><tr><th scope="row">{row.item}</th><td>{row.country}</td><td>{shareText(row.initial)}</td><td>{shareText(row.latest)}</td></tr>)}</tbody></table>
 <p>世界計は保存済みFAOSTATの同一原ZIPにあるWorld行です。候補10品目のうち、この組み合わせで世界分母を照合できるのは3品目だけです。油ヤシなど残る7品目の世界比は示しません。これは生産量の比率で、輸出先・輸出量・国内向けの割合ではありません。</p>
 <p class="source">出典：<a href="https://www.fao.org/faostat/en/#data/QCL">FAOSTAT 作物生産</a>（2015–2024年、Production、t）。<a href="https://www.fao.org/contact-us/terms/db-terms-of-use/">利用条件・CC BY 4.0</a>。<a href="/insight-journal/assets/atlas/southeast-asia-v1/world-shares.json">年別の値と資料区分</a>。</p>
</details>
<details class="southeast-forest-reading" data-southeast-forest-reading>
 <summary>森林面積・木材生産・木材製品の輸出を区別する</summary>
 <p>2024年の丸太材生産はインドネシアが{quantity(faoValue('IDN','1861'))}万m³、ベトナムが{quantity(faoValue('VNM','1861'))}万m³、タイが{quantity(faoValue('THA','1861'))}万m³です。製材ではベトナムとタイが近く、森林の広さだけでは加工段階を説明できません。森林地図は樹冠の参考画像で、この生産量を塗った図ではありません。</p>
 <table><caption>FAOSTAT Forestry、2024年。万m³。世界比は同年・同品目のWorld生産量を分母に計算</caption><thead><tr><th scope="col">品目</th><th scope="col">国</th><th scope="col">生産</th><th scope="col">世界比</th></tr></thead><tbody>{forestRows.map(row=><tr><th scope="row">{row.item}</th><td>{row.name}</td><td>{quantity(row.value)} <small>({row.flag})</small></td><td>{shareText(row.share)}</td></tr>)}</tbody></table>
 <p>同じ国でも、森林面積（千ha）、丸太材・製材（m³）、木材製品の輸出額（米ドル）は別の統計です。製材は丸太材を加工したものなので、両者を足して木材の総生産とはしません。国別の貿易額は次の表に掲載します。</p>
 <p class="source">出典：<a href="https://www.fao.org/faostat/en/#data/FO">FAOSTAT Forestry</a>（2024年、Production、m³、A＝公的報告・E＝推計）。<a href="https://www.fao.org/faostat/en/#data/RL">森林面積</a>は別系列。<a href="/insight-journal/assets/atlas/southeast-asia-v1/world-shares.json">世界比の原数値・資料区分</a>。</p>
</details>
<details class="southeast-forest-reading" data-southeast-trade-reading>
 <summary>3か国の主要な農林産品の輸出額を比べる</summary>
 <p>インドネシアのパーム油、ベトナムのコーヒーと木材製品、タイの米と天然ゴムについて、2023年の商品輸出額を同じ米ドル単位で比べます。収穫物と加工品、国際商品分類の4桁と2桁が混在するため、合計した順位ではありません。</p>
 <table><caption>UN Comtrade、2023年、輸出額（億米ドル）。HS44は木材・木材製品・木炭の2桁章</caption><thead><tr><th scope="col">国</th><th scope="col">商品</th><th scope="col">HS</th><th scope="col">億米ドル</th></tr></thead><tbody>{exportRows.map(row=><tr><th scope="row">{row.name}</th><td>{row.label}</td><td>{row.hs}</td><td>{dollars(row.value)}</td></tr>)}</tbody></table>
 <h3>米の国別輸出・輸入報告額</h3><p>同じ2023年のHS1006「米」。輸出と輸入は別の方向で、各国の対世界報告額です。国内で消費された量や、どの輸出国からどの輸入国へ届いたかは分かりません。</p>
 <p><a href="#southeast-rice-trade-comparison">地図下の輸出・輸入比較へ</a></p>
 <p>タイ・ベトナムは輸出報告額が大きく、インドネシア・フィリピンは輸入報告額が大きい一方、ベトナム自身にも輸入があります。11か国分を足すと域内の越境と再輸出を含むため、地域の純供給量にはなりません。東ティモールの輸出欄は欠測で、0ではありません。</p>
 <p>生産量から輸出額を差し引いて国内向け数量を求めることはできません。品目ごとの輸出相手は保持した原資料にないため、この表は輸出先の内訳を表しません。</p>
 <p class="source">出典：<a href="https://comtradeplus.un.org/">UN Comtrade</a>、2023年、各国報告の輸出額（current USD）。<a href="https://uncomtrade.org/docs/policy-on-use-and-re-dissemination/">利用・再配布方針</a>。FAOSTATの2024年生産量とは年・単位が異なります。</p>
</details>
<template data-southeast-supply-template>
 <h3 data-southeast-supply-title>食料5品目の供給と利用</h3>
 <div data-south-central-supply data-southeast-food-balances>
  <p>2023年・当時のASEAN10か国。米などを<strong>同じ品目の重量</strong>で比べます。東ティモールは含まず、地図の11か国とは範囲が異なります。</p>
  <p data-southeast-balance-context hidden></p>
  {foodBalances.commodities.map(row=><details class="southeast-food-balance" data-southeast-balance={row.id} open={row.id==='rice'}>
   <summary>{row.label}<span>生産 {balanceAmount(row.totals.production)}万t</span></summary>
   <p class="balance-takeaway">{row.id==='rice'?'米の地域生産は国内利用を上回りますが、輸入もあります。国ごとの不足と余剰は同じではありません。':row.id==='maize'?'トウモロコシは、生産だけでは国内利用を満たさず、輸入も供給を支えます。':row.id==='soybean'?'大豆は国内生産に対して輸入が大きい品目です。食用・飼料用などの用途内訳はこの表にありません。':row.id==='cassava'?'キャッサバは生産と輸出の両方が大きい品目です。生いも換算の重量を、でん粉の製品重量と混同しません。':'砂糖の需給です。地図のサトウキビの収穫面積や原料重量とは別の製品を扱います。'}</p>
   {balanceGroups.map(group=><div class="southeast-balance-group">
    <strong>{group.name}　{balanceAmount(row.totals[group.total])}万t</strong>
    <div class="southeast-balance-track" aria-hidden="true">{group.cells.map(([key,label,color])=><i style={`width:${row.totals[key]/row.totals[group.total]*100}%;background:${color}`} title={label}></i>)}</div>
    <dl class="southeast-balance-values">{group.cells.map(([key,label,color])=><div><dt><i style={`background:${color}`}></i>{label}</dt><dd>{balanceAmount(row.totals[key])}万t</dd></div>)}</dl>
   </div>)}
   {row.id!=='sugar'?<p>生産 ÷ 国内利用：<strong>{(row.totals.production/row.totals.domesticUtilization*100).toFixed(2)}%</strong>（この需給表から計算）。食料全体のカロリー自給率ではありません。</p>:<p>砂糖は原資料の需給表37と比率表40で生産値が異なるため、比率を表示していません。ここでは表37の値を保持しています。</p>}
   <details class="southeast-balance-exact"><summary>原表の値をt単位で確認</summary><table><caption>AFSIS ACO No.33、表{row.table}、本文{row.printedPage}頁。2023年、t</caption><thead><tr><th scope="col">項目</th><th scope="col">t</th></tr></thead><tbody>{balanceGroups.flatMap(group=>group.cells.map(([key,label])=><tr><th scope="row">{label}</th><td>{row.totals[key].toLocaleString('ja-JP')}</td></tr>))}<tr><th scope="row">公表合計（供給・利用とも）</th><td>{row.totals.totalSupply.toLocaleString('ja-JP')}</td></tr></tbody></table></details>
  </details>)}
  <p>国内利用は食用だけではありません。輸出入には域内の取引も含まれ、地域外への出入りではありません。生産は作物年、利用・在庫・貿易は暦年という原資料の区分を保持しています。</p>
  <details><summary>対象国・推計・原表の差を確認</summary><p>対象：ブルネイ、カンボジア、インドネシア、ラオス、マレーシア、ミャンマー、フィリピン、シンガポール、タイ、ベトナム。2024年12月版に掲載された2023年の値で、一部にAFSIS事務局の推計を含みます。2024年推計・2025年予測はここに混ぜていません。</p><p>米は利用側、トウモロコシは利用側、大豆は供給側で、公表合計と構成値に1tの差があります。修正せず、帯は各公表合計を分母にしています。国表の「—」は原資料の「-」を保持し、0と解釈しません。</p>
   <div class="southeast-table-scroll"><table><caption>米（精米）の国別生産と国内利用。2023年、万t。*＝AFSIS事務局推計</caption><thead><tr><th scope="col">国</th><th scope="col">生産</th><th scope="col">国内利用</th></tr></thead><tbody>{riceBalanceCountries.map(row=><tr><th scope="row">{countryNames[row.code]}</th><td>{balanceAmount(row.production)}{row.estimatedFields.includes('production')?'*':''}</td><td>{balanceAmount(row.domesticUtilization)}{row.estimatedFields.includes('domesticUtilization')?'*':''}</td></tr>)}</tbody></table></div>
  </details>
  <p class="source">出典：<a href={foodBalances.source.url}>AFSIS ACO No.33（2024年12月）</a>、表7・22・37・52・67。<a href="/insight-journal/assets/atlas/southeast-asia-v1/food-balances-2023.json">収録した原表値・注記</a>。籾米のFAOSTAT生産量・HS1006貿易額とは別の定義です。</p>
 </div>
</template>
<template data-southeast-partner-template>
 <h3 data-southeast-partner-title>各国の米の輸出・輸入</h3>
 <div data-south-central-destinations>
  <p>UN Comtrade、2023年、HS1006「米」。各国が世界へ輸出した額、世界から輸入した額を別々に比較します。</p>
  {(['exports','imports'] as const).map(direction=><div class="southeast-rice-trade-leaders"><h4>{direction==='exports'?'輸出額の大きい3か国':'輸入額の大きい3か国'}</h4><ol>{riceTradeLeaders(direction).map(row=><li><span>{row.name}</span><strong>{riceTradeAmount(row[direction])}百万米ドル</strong></li>)}</ol></div>)}
  <details><summary>11か国の報告額をすべて比較</summary><table id="southeast-rice-trade-comparison" data-southeast-rice-trade><caption>2023年、百万米ドル。輸出10/11か国・輸入11/11か国に値</caption><thead><tr><th scope="col">報告国</th><th scope="col">輸出</th><th scope="col">輸入</th></tr></thead><tbody>{riceTradeRows.map(row=><tr><th scope="row">{row.name}</th><td>{riceTradeAmount(row.exports)}</td><td>{riceTradeAmount(row.imports)}</td></tr>)}</tbody></table></details>
  <p>額は数量ではありません。HS1006には籾米・玄米・精米などが含まれ、左の精米需給表とは同じ製品ではありません。東ティモールの輸出は欠測で、0ではありません。</p>
  <details><summary>どこへ輸出したか・どこから輸入したか</summary><p>11か国の米の全相手国行列は未収録です。国別の対世界額から二国間の流れや地域外の数量を推定していません。域内取引を含む国計の合算も、地域外の輸出入にはなりません。</p></details>
  <details><summary>別品目の相手国例：インドネシアの油脂類</summary><p>HS15章（動植物性・微生物性の油脂等）、2023年・輸出額。<strong>パーム油HS1511だけの相手国ではありません。</strong></p>
   <div class="southeast-partner-pie" role="img" aria-label="インドネシアのHS15章輸出額の相手国割合。正確な値は直後の一覧を参照。" style={`background:${pieStyle}`}></div>
   <ul class="southeast-partner-list">{topPartners.map((row,index)=><li><i style={`background:${pieColors[index]}`}></i>{row.label} {shareText(row.share)}</li>)}<li><i style={`background:${pieColors[4]}`}></i>その他 {shareText(otherPartnerShare)}</li></ul>
   <p>分母は同国のHS15章の対世界輸出額、約{dollars(fatPartners.world)}億米ドル。その他には4相手国以外と統計上の差分を含みます。</p>
  </details>
  <p class="source">出典：<a href="https://comtradeplus.un.org/">UN Comtrade</a>、2023年、HS2017、current USD。米の需給量や食料全体の自給率を示す表ではありません。</p>
 </div>
</template>
<template data-southeast-forest-template>
 <div class="southeast-forest-connections">
  <h2>森林の広さ・木材の量・貿易額を11か国で比べる</h2>
  <div class="asia-farm-connections-grid">
   <section><h3>森林面積と衛星画像</h3><p>FAOSTAT、2024年の国計。森林面積は土地利用の区分で、地図の緑の画素や農園の面積を足した値ではありません。</p><table><caption>2024年、千ha。対象11か国</caption><thead><tr><th scope="col">国</th><th scope="col">森林面積</th></tr></thead><tbody>{allCountries.map(([code,name])=><tr><th scope="row">{name}</th><td>{faoValue(code,'6646','Area')===undefined?'欠測':faoValue(code,'6646','Area')!.toLocaleString('ja-JP',{maximumFractionDigits:1})}</td></tr>)}</tbody></table><p>地図はJRCの2020年森林分類。東カリマンタンでは樹木作物を一部誤分類します。油ヤシ・ゴム農園と森林を見分ける際は、作物図にも切り替えて確かめます。</p></section>
   <section><h3>丸太材・製材の生産と出入り</h3><p>FAOSTAT Forestry、2024年。生産・輸入・輸出を同じ品目・体積で比較します。国内利用や在庫変動は収録していません。</p>{forestItems.map(([item,label],index)=><details open={index===0}><summary>{label}の数量</summary><div class="southeast-table-scroll"><table><caption>{label}、2024年、万m³</caption><thead><tr><th scope="col">国</th><th scope="col">生産</th><th scope="col">輸入</th><th scope="col">輸出</th></tr></thead><tbody>{allCountries.map(([code,name])=><tr><th scope="row">{name}</th><td>{quantity(faoValue(code,item))}</td><td>{quantity(faoValue(code,item,'Import quantity'))}</td><td>{quantity(faoValue(code,item,'Export quantity'))}</td></tr>)}</tbody></table></div></details>)}<p>丸太材には燃料用も含み、製材は加工後の製品です。両者は足し合わせません。純輸出を生産から引いただけの値も、実際の国内利用とは呼びません。</p></section>
   <section><h3>木材製品の輸出・輸入額</h3><p>UN Comtrade、2023年、HS44章「木材・木材製品・木炭」。家具（HS94）はこの章に含みません。</p><table><caption>2023年、億米ドル。欠測は0ではありません</caption><thead><tr><th scope="col">国</th><th scope="col">輸出</th><th scope="col">輸入</th></tr></thead><tbody>{woodExportRows.map(row=><tr><th scope="row">{row.name}</th><td>{dollars(row.exports)}</td><td>{dollars(row.imports)}</td></tr>)}</tbody></table><p>貿易額と2024年の木材体積は年・単位・製品範囲が異なります。<a href="../industry/?industryKind=wood">木材・家具の加工拠点を地図で見る →</a></p></section>
  </div>
  <details><summary>原数値・推計区分と世界比</summary><p>林業の国別値には公的報告と推計が含まれます。小さい正の値を0にせず、原数値と各観測のフラグは<a href="/insight-journal/assets/atlas/asia-farming-v1/statistics.json">保存済みの林業統計</a>で確認できます。<a href="/insight-journal/assets/atlas/southeast-asia-v1/world-shares.json">同年・同品目の世界比</a>は別系列です。</p></details>
  <p class="source">出典：<a href="https://www.fao.org/faostat/en/#data/RL">FAOSTAT 土地利用</a>・<a href="https://www.fao.org/faostat/en/#data/FO">林業</a>、<a href="https://comtradeplus.un.org/">UN Comtrade</a>、<a href="https://forobs.jrc.ec.europa.eu/GFC/v3">JRC GFC2020</a>。東ティモールを含む地理的な東南アジア11か国です。</p>
 </div>
</template>
<script>
 import {renderSoutheastFarmConnections} from '../../../scripts/atlas-southeast-farm-connections';
 const mountRegionalStatistics=()=>{
 const root=document.querySelector<HTMLElement>('.asia-atlas-root[data-region="southeast-asia"]')??document;
 const section=root.querySelector<HTMLElement>('[data-south-central-farm-connections]');
 if(section){
  // Bound the sticky reading panel to the map row. The following statistics
  // remain a separate full-width row rather than part of its sticky range.
  const grid=root.querySelector<HTMLElement>('.asia-layout');
  if(grid&&!section.hidden){
   const map=grid.querySelector<HTMLElement>(':scope > .atlas-map-column');
   const reading=grid.querySelector<HTMLElement>(':scope > .asia-reading-panel');
   if(map&&reading){
    const workspace=document.createElement('div');
    workspace.className='southeast-map-and-reading';
    workspace.setAttribute('data-southeast-top-workspace','');
    map.before(workspace);
    workspace.append(map,reading);
   }
   if(section.parentElement!==grid)grid.append(section);
  }
  const headings=section.querySelectorAll<HTMLElement>('.asia-farm-connections-grid > section');
  const supply=root.querySelector<HTMLTemplateElement>('[data-southeast-supply-template]');
  const partners=root.querySelector<HTMLTemplateElement>('[data-southeast-partner-template]');
  if(headings[0]&&supply)headings[0].replaceChildren(supply.content.cloneNode(true));
  if(headings[1]&&partners)headings[1].replaceChildren(partners.content.cloneNode(true));
  const forest=root.querySelector<HTMLTemplateElement>('[data-southeast-forest-template]');
  if(forest&&!section.querySelector('.southeast-forest-connections'))section.append(forest.content.cloneNode(true));
  if(root instanceof HTMLElement)renderSoutheastFarmConnections(root,root.dataset.southeastFarmTopic??'overview');
 }
 };
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mountRegionalStatistics,{once:true});else mountRegionalStatistics();
</script>
