---
import data from '../../../../public/assets/atlas/east-asia-v1/farm-foundations.json';
const names:Record<string,string>={rice:'米',wheat:'小麦',maize:'トウモロコシ','sugar cane':'サトウキビ',soybean:'大豆',cotton:'綿花',tea:'茶',cassava:'キャッサバ',millet:'雑穀',rubber:'天然ゴム',oil:'油ヤシ',lentils:'レンズ豆',coffee:'コーヒー',chick:'ひよこ豆'};
const cropName=(s:string)=>s.startsWith('Maize')?names.maize:s==='Rice'?names.rice:s==='Wheat'?names.wheat:s==='Sugar cane'?names['sugar cane']:s.startsWith('Soya')?names.soybean:s.startsWith('Seed cotton')?names.cotton:s.startsWith('Tea')?names.tea:s.startsWith('Cassava')?names.cassava:s==='Millet'?names.millet:s.startsWith('Natural rubber')?names.rubber:s.startsWith('Oil palm')?names.oil:s.startsWith('Lentils')?names.lentils:s.startsWith('Coffee')?names.coffee:names.chick;
const amount=(n:number)=>n>=10000?`${(n/10000).toLocaleString('ja-JP',{maximumFractionDigits:1})}万t`:`${n.toLocaleString('ja-JP')}t`;
---
<section class="east-farm-foundations" data-east-farm-foundations hidden aria-label="東アジアの農林業と世界比">
 <h2>生産・貿易・世界での位置</h2>
 <p class="lead">森林面積、木材の生産・輸出入、商品輸出先は別の統計です。地図の森林色から数量や仕向け先を推定せず、国の公表値と並べて読みます。</p>
 <div class="columns">
  <section><h3>丸太・製材の供給と輸出入</h3><div data-east-forest-flows aria-live="polite"></div></section>
  <section><h3>全商品の輸出先</h3><div data-east-export-partners aria-live="polite"></div></section>
  <section><h3>世界比と推移</h3><div data-east-world-share aria-live="polite"></div></section>
 </div>
 <details class="priority"><summary>2020年の主要作物候補と次点を確認</summary><p>収録済み14品目の2020年 FAOSTAT 生産重量（t）を4対象で足した候補順位です。対象外品目を含む全作物順位でも、金額順位でもありません。欠測は0にせず、値のある国数を併記します。</p><table><caption>上位10候補 · 生産重量</caption><thead><tr><th scope="col">品目</th><th scope="col">4対象の報告値合計</th><th scope="col">有効数</th></tr></thead><tbody>{data.cropCandidates.selected.map(row=><tr><th scope="row">{cropName(row.label)}</th><td>{amount(row.tonnes)}</td><td>{row.reportedCountries}/4</td></tr>)}</tbody></table><p>次点：{data.cropCandidates.next.map(row=>`${cropName(row.label)}（${amount(row.tonnes)}、${row.reportedCountries}/4）`).join('、')}。地図で示せる作物は資料と対象品目が異なるため、この順位の重量を格子へ配分していません。</p></details>
 <p class="sources">出典：FAO. 2026. FAOSTAT <a href="https://www.fao.org/faostat/en/#data/FO">Forestry Production and Trade</a>・<a href="https://www.fao.org/faostat/en/#data/RL">Land Use</a>、FAO. 2025. FAOSTAT <a href="https://www.fao.org/faostat/en/#data/QCL">Crops and Livestock Products</a>。2026年10月8日参照。<a href="https://www.fao.org/contact-us/terms/db-terms-of-use/">License: CC BY 4.0</a>。輸出先は <a href="https://comtradeplus.un.org/">UN Comtrade</a> の小規模抽出（<a href="https://uncomtrade.org/docs/re-dissemination-of-data/">再配布条件</a>）。<a href="/insight-journal/assets/atlas/east-asia-v1/farm-foundations.json">値・資料区分・抽出元</a>。</p>
</section>
<style>
 [hidden]{display:none!important}.east-farm-foundations{border-top:1px solid var(--rule);padding:14px 0 18px}.east-farm-foundations h2{font-family:var(--serif);font-size:22px;margin:4px 0 7px}.lead{font-size:13px;line-height:1.8;margin:0 0 13px}.columns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.columns>section{min-width:0;border:1px solid var(--rule);padding:12px;background:#fff}.columns h3{font-size:14px;margin:0 0 9px}.columns :global(p){font-size:12px;line-height:1.65;margin:7px 0}.columns :global(.east-bar){display:grid;grid-template-columns:74px 1fr 73px;align-items:center;gap:6px;margin:8px 0;font-size:11px}.columns :global(.east-bar i){height:10px;min-width:2px;background:#4b8169}.columns :global(.east-bar b){font-weight:500;text-align:right;font-variant-numeric:tabular-nums}.columns :global(.east-pie){width:108px;height:108px;border-radius:50%;margin:7px auto}.columns :global(.east-pie-key){display:grid;grid-template-columns:12px 1fr auto;gap:5px;align-items:center;font-size:11px;margin:5px 0}.columns :global(.east-pie-key i){width:10px;height:10px}.columns :global(.east-share-chart){width:100%;height:auto}.columns :global(.east-share-chart .axis){stroke:#9aaba4}.columns :global(.east-share-chart .trend){fill:none;stroke:#376d59;stroke-width:2}.columns :global(.east-share-chart .dot){fill:#376d59}.columns :global(.east-share-chart text){font-size:10px;fill:#31453d}.priority{margin:12px 0}.priority summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font-size:13px;font-weight:700}.priority p,.sources{font-size:11px;line-height:1.8}.priority table{width:100%;border-collapse:collapse;font-size:11px}.priority th,.priority td{padding:6px;border-bottom:1px solid var(--rule);text-align:right}.priority th:first-child{text-align:left}@media(max-width:860px){.columns{grid-template-columns:1fr}.columns>section{padding:12px}.columns :global(.east-bar){grid-template-columns:86px 1fr 86px}}
</style>
