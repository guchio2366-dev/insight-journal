---
import {southeastIndustryKinds,southeastIndustrySectors,southeastIndustrySites} from '../../../data/atlas/asia/southeast-asia-industry-sites';
import {southeastIndustryProfiles,southeastIndustrySources,southeastFigureValue,southeastIndustryEvidenceDate,southeastPalmProcessing} from '../../../data/atlas/asia/southeast-asia-industry-catalog';
import '../../../styles/atlas-southeast-industry.css';
const columns=[['scale','産業の規模'],['position','世界の供給・調達での位置'],['market','域内・域外の市場と用途']] as const;
---
<div data-southeast-industry-controls class="sea-industry-controls" hidden>
 <nav class="southeast-industry-sectors" aria-label="産業の三分類">{southeastIndustrySectors.map(sector=><button type="button" data-southeast-industry-sector={sector.id} aria-pressed={String(sector.id==='all')}>{sector.label}</button>)}</nav>
 <nav class="southeast-industry-choices" aria-label="主要産業を選ぶ">{southeastIndustryKinds.map(kind=><button type="button" data-southeast-industry-kind={kind.id} aria-pressed={String(kind.id==='all')}>{kind.label}</button>)}</nav>
</div>
<section data-industry-region-reading class="sea-industry-story" hidden aria-label="東南アジアの産業分布の解説">
 <p class="sea-industry-eyebrow">東南アジアの主要産業</p>
 <h2 data-southeast-industry-story-title>資源・工業地区・サービス都市</h2>
 <p class="southeast-industry-summary" data-southeast-industry-summary>{southeastIndustrySectors[0].reading}</p>
 <h3>集積を支える条件</h3><p data-southeast-industry-why>原料、人材、交通、市場への接続は工程ごとに異なります。</p>
 <p class="sea-industry-scope" data-southeast-industry-caveat></p>
 <button type="button" data-southeast-industry-clear>産業の選択を解除</button>
 <section data-southeast-industry-selected hidden><h3 data-southeast-industry-selected-title></h3><p data-southeast-industry-selected-reading></p><p class="southeast-industry-source">立地資料：<span data-southeast-industry-selected-year></span> · <a data-southeast-industry-selected-source></a></p></section>
 <details class="southeast-industry-site-directory"><summary>出典付きの立地案内 {southeastIndustrySites.length}例</summary><div class="southeast-industry-sites">{southeastIndustrySites.map(site=><button type="button" data-southeast-industry-site={site.id}>{site.industryName} · {site.placeName}</button>)}</div></details>
 <details class="sea-industry-source-method"><summary>位置と数量の意味・出典範囲</summary><p>既存資料で確認した地区・都市・拠点の案内位置です。個別工場の敷地座標、施設の全数、産業の実測集積範囲を表しません。丸の大きさと地点数は数量を表しません。細線は札と案内位置を対応させる線で、取引経路ではありません。</p><p>精米と太陽電池の青い国境は国単位の加工品貿易資料の確認範囲です。国内全域が加工産地という意味ではありません。原料生産の世界シェアは加工業の優位性に転用しません。統計未取得はゼロにしません。</p><p>統計資料確認日：{southeastIndustryEvidenceDate}。出典年と対象を各数値に表示します。国別GDP・既存商品貿易は別資料として保持しています。</p></details>
</section>
<section data-southeast-industry-statistics class="sea-industry-statistics" hidden aria-label="主要産業の規模と市場の統計">
 <div data-southeast-palm-map-key hidden class="sea-palm-key"><strong>州の精製所による粗油処理量 · 2025年</strong><span><i style="background:#edf2e0"></i>100万t未満</span><span><i style="background:#9bbdae"></i>100～300万t未満</span><span><i style="background:#397a67"></i>300万t以上</span><p>州合計の投入量。工場の実生産量・面積当たり密度ではありません。表に値がない州を0として塗っていません。</p><p data-southeast-palm-map-status role="status"></p></div>
 <section data-southeast-industry-overview-statistics>
  <h2>産業ごとに異なる規模の指標</h2><p>各行の国・製品・工程・年は異なります。地域全体の合計や共通の順位を示す表ではありません。</p>
  <div class="sea-industry-table-wrap"><table><thead><tr><th scope="col">産業</th><th scope="col">確認した規模</th><th scope="col">国・製品・年と定義</th></tr></thead><tbody>{southeastIndustryProfiles.map(p=><tr data-sea-overview-row={p.id}><th scope="row"><button type="button" data-southeast-overview-kind={p.id}>{p.label}</button></th><td>{southeastFigureValue(p.scale[0])}</td><td>{p.scale[0].label} · {p.scale[0].scope} · {p.scale[0].year}<small>{p.scale[0].definition}</small><a href={southeastIndustrySources[p.scale[0].source].url}>{southeastIndustrySources[p.scale[0].source].label}</a></td></tr>)}</tbody></table></div>
 </section>
 {southeastIndustryProfiles.map(profile=><article data-southeast-industry-facts={profile.id} hidden>
  <h2>{profile.label}の規模・供給・市場</h2>
  {profile.id==='palm'&&<div class="sea-industry-table-wrap"><table data-southeast-palm-state-table><caption>マレーシア精製所の州別粗油処理量（2025年・t）</caption><thead><tr><th scope="col">州</th><th scope="col">粗パーム油</th><th scope="col">粗パーム核油</th><th scope="col">投入量合計</th></tr></thead><tbody>{southeastPalmProcessing.map(s=><tr><th scope="row">{s.name}</th><td>{s.cpo.toLocaleString('ja-JP')}</td><td>{s.cpko.toLocaleString('ja-JP')}</td><td>{s.inputTonnes.toLocaleString('ja-JP')}</td></tr>)}</tbody></table><p><a href={southeastIndustrySources.palmProcessing.url}>MPOB・州別処理量の原表</a>。国合計17,266,555t、ジョホール・セランゴール8,975,912t（52.0%）。同じ州の全土が精製所の敷地という意味ではありません。</p></div>}
  <div class="sea-industry-fact-columns">{columns.map(([key,title])=><section><h3>{title}</h3>{profile[key].map(figure=><div class="sea-industry-figure"><h4>{figure.label}</h4><p class="sea-industry-value">{southeastFigureValue(figure)}</p><p class="sea-industry-definition">{figure.year} · {figure.scope}</p><p>{figure.definition}</p>{figure.evidence&&<p class="sea-industry-evidence">{figure.evidence==='indexed'?'公式検索収録文で確認・原表本文未取得':'基準年・算定方法の記載を確認できない説明値'}</p>}<a href={southeastIndustrySources[figure.source].url}>{southeastIndustrySources[figure.source].label}</a></div>)}</section>)}</div>
  <p class="sea-industry-scope">{profile.caveat}</p>
 </article>)}
</section>
