---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import NorthAmericaCountryFieldNavigation from './NorthAmericaCountryFieldNavigation.astro';
import CanadaTerrainContext from './CanadaTerrainContext.astro';
import data from '../../data/atlas/canada/industry-parity.json';
import geometry from '../../data/atlas/canada/industry-geometry.json';
import geography from '../../data/atlas/regional-countries.json';
import {canadaLandformPath,projectCanadaLandform} from '../../lib/atlas-canada-landform-map';
const provincePath=(path:string)=>path.replace(/([ML])(-?[\d.]+),(-?[\d.]+)/g,(_,cmd,x,y)=>{const [mx,my]=projectCanadaLandform([Number(x)/900*95-145,85-Number(y)/580*45]);return `${cmd}${mx.toFixed(2)},${my.toFixed(2)}`;});
import {industrySectors} from '../../data/atlas/industry-catalog';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-explorer.css';
import '../../styles/atlas-industry.css';
import '../../styles/atlas-desktop.css';
import '../../styles/atlas-us-responsive.css';
import '../../styles/atlas-canada-industry-parity.css';
const colors=Object.fromEntries(industrySectors.map(s=>[s.id,s.color]));
const total=data.metrics[0];
const rows=[...data.nationalChart].sort((a,b)=>a.gdp-b.gdp);
---
<BaseLayout title="カナダの主要産業｜地図から読む立地と全国構成" description="産業の分布を地図で選び、付加価値・雇用の全国構成と合わせて読む。" compactAtlas>
<AtlasWorkspaceFrame region="north-america" mapActions={false}>
<article class="atlas-explorer atlas-workspace canada-industry-parity" data-canada-industry data-ca-industry-parity data-atlas-explorer data-field="industry" data-industry-subsector="all">
 <div class="atlas-compact-heading"><nav aria-label="パンくず"><a href={withBase('/atlas/')}>地図から見る</a> / <a href={withBase('/atlas/north-america/')}>北米地図</a></nav><span>カナダ</span></div>
 <div class="atlas-region-controls"><AtlasRegionNavigation group="americas" current="north-america" country="canada" /></div>
 <h1 class="visually-hidden">カナダの主要産業</h1>
 <NorthAmericaCountryFieldNavigation country="canada" field="industry" />
 <div class="industry-controls">
  <div class="industry-tab-row" role="tablist" aria-label="産業の業態">{industrySectors.map(s=><button type="button" role="tab" id={`ca-sector-${s.id}`} aria-selected={String(s.id==='all')} tabindex={s.id==='all'?0:-1} aria-controls="ca-industry-panel" data-ca-sector={s.id}>{s.label}</button>)}</div>
  {industrySectors.filter(s=>s.id!=='all').map(s=><div class="industry-tab-row industry-subtabs" role="tablist" aria-label={`${s.label}の分野`} data-ca-subtabs={s.id} hidden>{[{id:'all',label:'全分野'},...data.metrics.filter(m=>m.sector===s.id&&m.id!==s.id)].map(m=><button type="button" role="tab" aria-selected={String(m.id==='all')} tabindex={m.id==='all'?0:-1} data-ca-subsector={m.id} data-owner-sector={s.id} aria-controls="ca-industry-panel">{m.label}</button>)}</div>)}
  <p class="industry-guide"><span data-ca-breadcrumb>全産業</span><a href="#canada-industry-statistics">この分野の統計へ</a><a href="#canada-industry-sources">出典・定義</a></p>
 </div>
 <div class="atlas-primary-grid" id="ca-industry-panel" role="tabpanel" aria-labelledby="ca-sector-all">
  <div class="atlas-map-column">
   <div class="atlas-map-frame" data-ca-map-frame>
    <svg class="ca-industry-map" data-ca-map viewBox="0 0 900 580" role="group" tabindex="0" aria-label="カナダの産業地図。州名を選ぶと右に説明。矢印キーで移動できます。">
     <rect x="-1000" y="-1000" width="3000" height="3000" fill="#e4eff0"/>
     {geography.features.filter(f=>['CAN','USA','GRL'].includes(f.properties.code)).map(f=><path d={canadaLandformPath(f.geometry as any)} fill="#edecdf" stroke="#abbab3" stroke-width=".7" vector-effect="non-scaling-stroke"/>)}
     <CanadaTerrainContext/>
     {geometry.features.map(g=><path class="ca-province" data-ca-province-shape={g.id} d={provincePath(g.path)} fill="transparent" stroke="#839c96" stroke-width=".6" vector-effect="non-scaling-stroke" fill-rule="evenodd"/>)}
    </svg>
    <div class="ca-industry-labels" data-ca-labels></div>
    <div class="atlas-map-tools" aria-label="地図操作"><button type="button" data-ca-camera="reset">南部</button><button type="button" data-ca-camera="whole">全域</button><button type="button" data-ca-camera="in" aria-label="地図を拡大">＋</button><button type="button" data-ca-camera="out" aria-label="地図を縮小">−</button></div>
    <p class="atlas-layer-caption" data-ca-map-caption>州名から産業の立地を読む · 地形・水系</p>
   </div>
   <div class="industry-key"><p data-ca-key>州名の丸は位置の目印。州を選ぶと、主要分野と付加価値を右側で確認できます。</p><details><summary>州・準州を一覧から選ぶ</summary><div class="industry-region-list">{total.provinces.map(p=><button type="button" data-ca-place={p.id}>{p.name}</button>)}</div></details></div>
  </div>
  <div class="industry-map-reading" data-field-national="industry">
   <aside class="atlas-national industry-selected-reading" aria-label="選んだ産業・地域の説明"><article><header><h2 data-ca-title>産業の立地と全国構成</h2></header><div class="industry-selected-reading-body">
    <p class="industry-key-sentence"><strong data-ca-lead>中央部の加工・サービスと、西部の資源を地図で比較する。</strong></p>
    <button type="button" class="ca-industry-clear" data-ca-clear hidden>全国の解説へ</button><section><h3 data-ca-heading>地域を選んで読む</h3><p data-ca-reading>地図の州名から、その地域で大きい産業を確認できます。業態と分野は米国と同じ順序で選べます。</p></section>
    <div class="ca-industry-national-patterns" data-ca-national-patterns></div>
    <p class="industry-economic-value" data-ca-value hidden aria-live="polite"></p>
    <p><a data-ca-nature href={withBase('/atlas/north-america/canada/nature/?view=landform')}>地形・水系と照らし合わせる</a></p>
    <details class="industry-reading-definitions"><summary>地域と統計の範囲・操作方法</summary><p data-ca-operation-reading>業態を選び、さらに分野を絞ると、州別GDPの大きさを比較できます。地形や水路・市場の位置と合わせて、産業の立地を読んでいきます。</p><p>州・準州単位の産業GDPです。国際供給量・輸出額・世界シェアはこの国内構成比に含みません。丸の位置は地域の案内で、工場・鉱山の所在地ではありません。分野を絞るとGDP上位5州の金額を丸の面積で比較します。</p><p>GDPと雇用を同一年で比較できる抽出値は2021年。現在の工場数や生産量を示すものではありません。</p></details>
   </div></article></aside>

  </div>
 </div>
 <details class="canada-industry-statistics"><summary>補助統計：国内の付加価値・雇用構成（2021年）</summary>   <aside class="atlas-national industry-national" id="canada-industry-statistics" aria-label="カナダ全国の産業統計"><section>
    <header><h3 data-ca-chart-title>全産業の全国構成</h3><p>2021年 · 付加価値と年平均雇用</p></header>
    <figure class="industry-chart industry-paired-chart"><figcaption><h3>付加価値・雇用の構成比</h3><span data-ca-chart-scope>全国を100%</span></figcaption>
     <div class="industry-paired-heading" aria-hidden="true"><span>付加価値の昇順</span><span>付加価値</span><span>雇用</span></div>
     <ol class="industry-bars industry-paired-bars" data-ca-bars>{rows.map(r=><li><div class="industry-paired-row"><span class="industry-paired-name">{r.label}</span>{[['gdp',r.gdp/total.gdp*100],['employment',r.employment/total.employment*100]].map(([key,value])=><span class="industry-paired-cell" data-industry-metric={key}><strong>{Number(value).toFixed(1)}<small>%</small></strong><i class="industry-paired-track"><b style={`width:${value}%;--industry-color:${colors[r.sector]??'#64815d'}`}/></i></span>)}</div></li>)}</ol>
    </figure><details class="industry-number-table"><summary>金額・雇用数と定義</summary><div data-ca-numbers></div><p>GDP：13州・準州合計、基本価格・当年価格、百万カナダドル。雇用：準州を除く全国、15歳以上、自営業を含む年平均就業者、千人。米国の雇用統計とは対象が異なります。</p></details>
    <p class="industry-stat-source"><a href="#canada-industry-sources">Statistics Canada 原表・分類</a></p>
   </section></aside></details>
 <p class="industry-return" data-ca-population-return-wrap hidden><a data-canada-population-industry-return href={withBase('/atlas/north-america/canada/population/')}>元の人口比較へ戻る</a></p>
 <details class="industry-method" id="canada-industry-sources"><summary>出典・年・分類・利用条件</summary>
  <p>GDP：<a href="https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=3610040201">Statistics Canada 36-10-0402-01</a>。雇用：<a href="https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410002301">14-10-0023-01</a>。2021年の公表値を使用し、分類の対応がない細分類の雇用は欠損として表示します。業態別の集計では不動産をサービスから外し、建設・不動産へ一度だけ含めています。</p>
  <p>「半導体・電子機器」はNAICS 334の電子機器全体。「娯楽・宿泊・飲食」は住民の利用も含みます。製造業の分野タブは代表的な分野で、全製造業を分割したものではありません。</p>
  <p>州境：Statistics Canada 2021 Census Cartographic Boundary Files。地形の線：NOAA ETOPO 2022、500・1,000・2,000 m。河川・湖・周辺国土：Natural Earth、public domain。地図は面積測定用ではありません。</p>
  <p>立地の解説：<a href="https://www.cer-rec.gc.ca/en/data-analysis/energy-markets/province-territory-energy-profiles/alberta.html">CER アルバータの資源と輸送</a>、<a href="https://tc.canada.ca/en/corporate-services/transparency/corporate-management-reporting/transportation-canada-annual-reports/transportation-canada-2024">Transport Canada 2024</a>。統計順位と、立地を支える条件は区別して記述しています。</p>
  <p lang="en">Adapted from Statistics Canada, Tables 36-10-0402-01 and 14-10-0023-01, reference year 2021. This does not constitute an endorsement by Statistics Canada of this product. Contains information licensed under the Open Government Licence – Canada.</p>
  <p><a href={withBase('/assets/atlas/canada-industry-parity-v1/gdp-2021.csv.gz')}>GDP抽出CSV（gzip）</a> ／ <a href={withBase('/assets/atlas/canada-industry-parity-v1/employment-2021.csv.gz')}>雇用抽出CSV（gzip）</a> ／ <a href={withBase('/assets/atlas/canada-industry-parity-v1/provenance.json')}>分類・原表ハッシュ</a></p>
  <p><a href="https://www.statcan.gc.ca/en/terms-conditions/open-licence">Statistics Canada Open Licence</a></p>
 </details>
 <noscript><p>全国の付加価値・雇用構成と地形を表示しています。分野・州の選択にはJavaScriptが必要です。</p></noscript>
 <script type="application/json" data-ca-industry-config set:html={JSON.stringify({...data,geometry:geometry.features,colors}).replace(/</g,'\\u003c')}/>
</article>
</AtlasWorkspaceFrame>
</BaseLayout>
<script>import {initCanadaIndustry} from '../../scripts/atlas-canada-industry';const root=document.querySelector<HTMLElement>('[data-canada-industry]');if(root)initCanadaIndustry(root);</script>
