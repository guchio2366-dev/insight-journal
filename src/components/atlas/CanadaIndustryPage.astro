---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import NorthAmericaCountryFieldNavigation from './NorthAmericaCountryFieldNavigation.astro';
import CanadaTerrainContext from './CanadaTerrainContext.astro';
import data from '../../data/atlas/canada/industry-parity.json';
import extraMetrics from '../../data/atlas/canada/industry-pilot-statistics.json';
import {canadaIndustryPilot as pilot,pilotIndustryLabel} from '../../lib/atlas-canada-industry-pilot';
import {canadaIndustryInternational as international,formatCanadaIndustryInternationalIndicator} from '../../data/atlas/canada/industry-international';
import geometry from '../../data/atlas/canada/industry-geometry.json';
import geography from '../../data/atlas/regional-countries.json';
import {canadaLandformPath} from '../../lib/atlas-canada-landform-map';
import {canadaLegacyPath} from '../../lib/atlas-canada-map-presentation';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-explorer.css';
import '../../styles/atlas-industry.css';
import '../../styles/atlas-desktop.css';
import '../../styles/atlas-us-responsive.css';
import '../../styles/atlas-canada-industry-parity.css';
import '../../styles/atlas-canada-industry-pilot.css';
const total=data.metrics[0];
---
<BaseLayout title="カナダの主要産業｜資源・製造・サービスの集積" description="カナダの主要産業を資源・エネルギー、製造業、サービス業に分け、産地と加工、人と情報の集積を読む。" compactAtlas>
<AtlasWorkspaceFrame region="north-america" mapActions={false}>
<article class="atlas-explorer atlas-workspace canada-industry-parity canada-industry-pilot" data-canada-industry data-ca-industry-parity data-ca-industry-pilot data-atlas-explorer data-field="industry">
 <div class="atlas-compact-heading"><nav aria-label="パンくず"><a href={withBase('/atlas/')}>地図から見る</a> / <a href={withBase('/atlas/north-america/')}>北米地図</a></nav><span>カナダ</span></div>
 <div class="atlas-region-controls"><AtlasRegionNavigation group="americas" current="north-america" country="canada" /></div>
 <h1 class="visually-hidden">カナダの主要産業</h1>
 <NorthAmericaCountryFieldNavigation country="canada" field="industry" />
 <div class="industry-controls">
  <div class="industry-tab-row" role="tablist" aria-label="主要産業の表示分類">{pilot.sectors.map(s=><button type="button" role="tab" id={`ca-sector-${s.id}`} aria-selected={String(s.id==='resources')} tabindex={s.id==='resources'?0:-1} aria-controls="ca-industry-panel" data-ca-sector={s.id}>{s.label}</button>)}</div>
  <p class="industry-guide"><span data-ca-breadcrumb>どこで採れ、どこで使える原料・エネルギーになるか</span><a href="#canada-industry-statistics">統計へ</a><a href="#canada-industry-sources">出典・範囲</a></p>
 </div>
 <div class="atlas-primary-grid" id="ca-industry-panel" role="tabpanel" aria-labelledby="ca-sector-resources">
  <div class="atlas-map-column">
   <div class="atlas-map-frame" data-ca-map-frame>
    <svg class="ca-industry-map" data-ca-map viewBox="50 220 940 440" role="group" tabindex="0" aria-label="カナダの産業集積図。産業名から選択。矢印キーで地図を移動できます。">
     <rect x="-4000" y="-4000" width="9000" height="9000" fill="#e4eff0"/>
     {geography.features.filter(f=>['CAN','USA','GRL'].includes(f.properties.code)).map(f=><path d={canadaLandformPath(f.geometry as any)} fill="#f0efe3" stroke="#abbab3" stroke-width=".7" vector-effect="non-scaling-stroke"/>)}
     <CanadaTerrainContext/>
     {geometry.features.map(g=><path class="ca-province" data-ca-province-shape={g.id} d={canadaLegacyPath(g.path)} fill="transparent" stroke="#9baea5" stroke-width=".6" vector-effect="non-scaling-stroke" fill-rule="evenodd"/>)}
    </svg>
    <div class="ca-industry-labels" data-ca-labels></div>
    <nav class="ca-pilot-map-key" aria-label="地図の産業と色">{pilot.sectors.map(s=><div data-ca-subtabs={s.id} hidden={s.id!=='resources'}>{pilot.industries.filter(i=>i.sectors.includes(s.id)).map(i=><button type="button" data-ca-subsector={i.id} data-owner-sector={s.id} aria-pressed="false" style={`--pilot-color:${i.color}`}><i aria-hidden="true"/>{pilotIndustryLabel(i.id,s.id)}</button>)}</div>)}</nav>
    <div class="atlas-map-tools" aria-label="地図操作"><button type="button" data-ca-camera="reset">集積全体</button><button type="button" data-ca-camera="whole">国土全域</button><button type="button" data-ca-camera="in" aria-label="地図を拡大">＋</button><button type="button" data-ca-camera="out" aria-label="地図を縮小">−</button></div>
    <p class="atlas-layer-caption" data-ca-map-caption>産業の色＋工程の記号 · 位置を示し、数量は表しません</p>
   </div>
   <p class="ca-pilot-map-note"><span>● 採取・発電・サービス　■ 加工・精製・精錬</span><span>点と引出線は集積地域の案内位置。正確な境界や密度ではありません。</span></p>
  </div>
  <aside class="ca-pilot-reading" aria-label="産業分布の概説と理由">
   <h2 data-ca-title>資源・エネルギー</h2>
   <p class="ca-pilot-insight" data-ca-lead>どこで採れ、どこで使える原料・エネルギーになるか</p>
   <h3 data-ca-heading>西部の資源と各地の加工・電力</h3><p data-ca-reading>{pilot.sectors[0].overview}</p>
   <h3>なぜここに集まるのか</h3><p data-ca-why>{pilot.sectors[0].why}</p>
   <section class="ca-pilot-selected" data-ca-site-reading hidden><h3 data-ca-site-title></h3><p data-ca-site-copy></p><div data-ca-site-sources></div></section>
   <div class="ca-pilot-selection-actions"><button type="button" data-ca-clear hidden>選択を解除</button><label data-ca-only-wrap hidden><input type="checkbox" data-ca-only/> この産業だけ表示</label><button type="button" data-ca-overlap hidden></button></div>
   <details><summary>この分類の集積を一覧から選ぶ</summary><div class="ca-pilot-site-list" data-ca-site-list></div></details>
   <p class="ca-pilot-boundary">学習のための3分類。精錬・精製は資源と製造の両方に表示します。表示地点や分類の統計を合算しません。</p>
  </aside>
 </div>
 <section class="ca-pilot-statistics" id="canada-industry-statistics" aria-label="地図の下の3列の統計">
  <section class="ca-pilot-stat-card"><h2 data-ca-stat-title>採掘・電気等の供給</h2><p data-ca-stat-scope></p><dl class="ca-pilot-kpis"><div><dt>全国GDP</dt><dd data-ca-stat-gdp></dd><small>百万CAD・当年価格・基本価格</small></div><div><dt>年平均の就業者</dt><dd data-ca-stat-employment></dd><small>千人・15歳以上・自営業を含む</small></div></dl><p data-ca-stat-note></p><p class="industry-economic-value" data-ca-value hidden></p><p><a href="#canada-industry-sources">Statistics Canada · 2021年</a></p></section>
  <section class="ca-pilot-stat-card"><h2>州別GDPの大きさ</h2><p data-ca-ranking-scope></p><ol class="ca-pilot-ranking" data-ca-ranking></ol><details><summary>13州・準州の金額を確かめる</summary><div data-ca-numbers></div><div class="industry-region-list">{total.provinces.map(p=><button type="button" data-ca-place={p.id}>{p.name}</button>)}</div></details></section>
  <section class="ca-pilot-stat-card">
   <section class="ca-industry-international" data-ca-international aria-labelledby="ca-industry-international-title"><h2 id="ca-industry-international-title">{international.title}</h2><p>{international.source.referenceYear}年 · {international.geography}</p><dl class="ca-industry-international-values">{international.indicators.map(metric=>{const display=formatCanadaIndustryInternationalIndicator(metric);return <div data-ca-international-indicator={metric.id}><dt>{metric.label}</dt><dd><strong>{display.value}</strong><span>{display.unit}</span></dd></div>;})}</dl><p>割合の分母：カナダの原油輸出量。米国向けはCER公表値。</p><p>{international.reading}</p><button type="button" data-ca-international-place>採取と精製の場所を地図で見る</button><p><a href={international.source.url}>CER · {international.source.edition}</a></p></section>
   <section data-ca-port-statistics hidden><h2>太平洋の港が扱う貨物</h2><p>2024年 · 港湾貨物量（百万t）</p><dl class="ca-pilot-kpis"><div><dt>バンクーバー港</dt><dd>158</dd></div><div><dt>プリンスルパート港</dt><dd>23.5</dd></div></dl><p>全貨物の重量。都市の雇用・GDP・コンテナ個数と別の指標です。</p><a href={pilot.sources.transport.url}>Transport Canada · 2024</a></section>
   <section data-ca-process hidden><h2>原料から製品へ</h2><p data-ca-process-copy></p><p class="ca-pilot-boundary">工程の説明と個別の取引は区別します。品目別生産量・地域別雇用は未収録です。</p></section>
  </section>
 </section>
 <details class="canada-industry-statistics"><summary>既存の全国付加価値・雇用構成（2021年）</summary><p>全国を100%。原NAICS区分に基づく既存の内訳で、地図の学習分類の合計ではありません。GDPは13州・準州計、雇用は準州を除く全国。</p><div class="industry-paired-heading"><span>区分</span><span>GDP</span><span>雇用</span></div><ol class="industry-bars industry-paired-bars" data-ca-bars>{data.nationalChart.map(r=><li><div class="industry-paired-row"><span class="industry-paired-name">{r.label}</span><span>{(r.gdp/total.gdp*100).toFixed(1)}%</span><span>{(r.employment/total.employment*100).toFixed(1)}%</span></div></li>)}</ol></details>
 <p class="industry-return" data-ca-population-return-wrap hidden><a data-canada-population-industry-return href={withBase('/atlas/north-america/canada/population/')}>元の人口比較へ戻る</a></p>
 <details class="industry-method"><summary>地図に採用した地域・工程・一次資料</summary><p>{pilot.positionMethod}</p><p>実流通が確認できる線は、ヴォイジーズ・ベイからロングハーバーへの精鉱輸送のみ。線の経路は模式です。他の引出線はラベルの位置案内です。</p><ul>{Object.values(pilot.sources).map(s=><li><a href={s.url}>{s.title}</a>（確認 {s.accessed}） — {s.scope}</li>)}</ul><p>初版の未収録範囲：{pilot.omissions.join('／')}。表示がない場所を産業の不在とは判断しません。</p></details>
 <details class="industry-method" id="canada-industry-sources"><summary>出典・年・分類・利用条件</summary>
  <section class="ca-industry-international-definitions" data-ca-international-definitions>
   <h3>原油輸出：2024年</h3>
   <p><a href={international.source.url}>{international.source.publisher} — {international.source.title}</a>。公表日：{international.source.publishedAt}。確認日：{international.source.accessedAt}。{international.source.method}</p>
   <dl>{international.indicators.map(metric=><><dt>{metric.label}</dt><dd>{metric.definition}</dd></>)}</dl>
   <p>{international.roundingNote}</p>
   <p>輸送の解説：<a href={international.readingSource.url}>{international.readingSource.publisher} — {international.readingSource.title}</a>。確認日：{international.readingSource.accessedAt}。{international.readingSource.scope}</p>
  </section>
  <p>GDP：<a href="https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=3610040201">Statistics Canada 36-10-0402-01</a>。雇用：<a href="https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410002301">14-10-0023-01</a>。2021年の公表値を使用し、分類の対応がない細分類の雇用は欠損として表示します。業態別の集計では不動産をサービスから外し、建設・不動産へ一度だけ含めています。</p>
  <p>「半導体・電子機器」はNAICS 334の電子機器全体。「娯楽・宿泊・飲食」は住民の利用も含みます。地図は資料を確認できた集積例です。下段の統計分類を地図の3分類へ足し合わせません。</p>
  <p>追加のNAICS 324（石油・石炭製品製造）と48–49（運輸・倉庫）は、保持済みの同じ2021年原CSVから抽出。精製の細分類雇用は未取得です。</p>
  <p>州境：Statistics Canada 2021 Census Cartographic Boundary Files。地形の線：NOAA ETOPO 2022、500・1,000・2,000 m。河川・湖・周辺国土：Natural Earth、public domain。地図は面積測定用ではありません。</p>
  <p>立地の解説：<a href="https://www.cer-rec.gc.ca/en/data-analysis/energy-markets/province-territory-energy-profiles/alberta.html">CER アルバータの資源と輸送</a>、<a href="https://tc.canada.ca/en/corporate-services/transparency/corporate-management-reporting/transportation-canada-annual-reports/transportation-canada-2024">Transport Canada 2024</a>。統計順位と、立地を支える条件は区別して記述しています。</p>
  <p lang="en">Adapted from Statistics Canada, Tables 36-10-0402-01 and 14-10-0023-01, reference year 2021. This does not constitute an endorsement by Statistics Canada of this product. Contains information licensed under the Open Government Licence – Canada.</p>
  <p><a href={withBase('/assets/atlas/canada-industry-parity-v1/gdp-2021.csv.gz')}>GDP抽出CSV（gzip）</a> ／ <a href={withBase('/assets/atlas/canada-industry-parity-v1/employment-2021.csv.gz')}>雇用抽出CSV（gzip）</a> ／ <a href={withBase('/assets/atlas/canada-industry-parity-v1/provenance.json')}>分類・原表ハッシュ</a></p>
  <p><a href="https://www.statcan.gc.ca/en/terms-conditions/open-licence">Statistics Canada Open Licence</a></p>
 </details>
 <noscript><p>産業集積の選択・地図操作にはJavaScriptが必要です。下部の統計と出典は閲覧できます。</p></noscript>
 <script type="application/json" data-ca-industry-config set:html={JSON.stringify({...data,metrics:[...data.metrics,...extraMetrics],geometry:geometry.features,pilot}).replace(/</g,'\\u003c')}/>
</article>
</AtlasWorkspaceFrame>
</BaseLayout>
<script>import {initCanadaIndustry} from '../../scripts/atlas-canada-industry';const root=document.querySelector<HTMLElement>('[data-canada-industry]');if(root)initCanadaIndustry(root);</script>
