---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import NorthAmericaCountryFieldNavigation from './NorthAmericaCountryFieldNavigation.astro';
import data from '../../data/atlas/canada/industry.json';
import geometry from '../../data/atlas/canada/industry-geometry.json';
import climate from '../../data/atlas/canada/climate.json';
import population from '../../data/atlas/canada/population.json';
import populationGeometry from '../../data/atlas/canada/population-geometry.json';
import populationGeometryUrl from '../../data/atlas/canada/population-geometry.json?url';
import {features} from '../../data/atlas/regional-atlas';
import {forestrySources} from '../../data/atlas/canada/forestry-reading';
import {formatCanadaIndustryValue as fmt} from '../../lib/atlas-canada-industry';
import {canadaIndustrySectors,canadaIndustryRegions,canadaIndustryOverview} from '../../data/atlas/canada/industry-reading';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-canada-nature.css';
import '../../styles/atlas-canada-agriculture.css';
import '../../styles/atlas-industry.css';

const assetRoot='/assets/atlas/canada-industry-v1';
const nature=(query:string)=>withBase(`/atlas/north-america/canada/nature/${query}`);
const sources={table:'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=3610040001',zip:'https://www150.statcan.gc.ca/n1/tbl/csv/36100400-eng.zip',boundary:'https://open.canada.ca/data/en/dataset/ef70dc3b-1069-4037-9bce-61f47e628a1d',boundaryLayer:'https://geo.statcan.gc.ca/geo_wa/rest/services/2021/Cartographic_boundary_files/MapServer/0',boundaryGuide:'https://www150.statcan.gc.ca/n1/pub/92-160-g/92-160-g2021001-eng.htm',energy:'https://www.cer-rec.gc.ca/en/data-analysis/energy-markets/province-territory-energy-profiles/alberta.html'};
const targets={water:nature('?city=ottawa&view=water&water=St.%20Lawrence&only=1&frame=480,440,335,140'),coast:nature('?city=vancouver&view=water&water=Fraser&only=1'),landform:nature('?city=ottawa&view=landform')};
const year=2025,metric='mining',initialRows=data.data.filter(r=>r.year===year),initial=initialRows.find(r=>r.id==='Alberta')!;
const mapMetrics=data.metrics.filter(m=>m.id!=='all');
const project=([lon,lat]:readonly number[])=>[(lon+145)/95*900,(85-lat)/45*580];
function geometryPath(g:any):string{const line=(coords:number[][],closed:boolean)=>coords.map((p,i)=>{const [x,y]=project(p);return `${i?'L':'M'}${x.toFixed(2)},${y.toFixed(2)}`}).join('')+(closed?'Z':'');if(g.type==='Polygon')return g.coordinates.map((r:number[][])=>line(r,true)).join('');if(g.type==='MultiPolygon')return g.coordinates.flat().map((r:number[][])=>line(r,true)).join('');return '';}
const labelOffsets:Record<string,[number,number]>={'Prince Edward Island':[17,-6],'Nova Scotia':[17,14],'New Brunswick':[-8,-7]};
const industryMarkerLabels:Record<string,string>={'alberta-energy':'アルバータ｜資源・エネルギー','ontario-manufacturing':'オンタリオ｜製造業','quebec-manufacturing':'ケベック｜製造業','bc-transport-services':'BC｜サービス業'};
const places=climate.stations.filter(s=>['ottawa','vancouver'].includes(s.id));
const valueText=(v:{value:number|null;status:string;symbol:string})=>`${fmt(v.value)}${v.value===null?'':'%'}${[v.status,v.symbol].filter(Boolean).length?`（${[v.status,v.symbol].filter(Boolean).join(' ')}）`:''}`;
import '../../styles/atlas-canada-country-parity.css';
import '../../styles/atlas-canada-industry.css';
---
<BaseLayout title="カナダの主要産業｜資源・加工・輸送・市場をつなぐ" description="2023–2025年の州内GDP割合と公式州境で、鉱業・製造業・サービス生産産業の地域差を比較する。" compactAtlas>
 <AtlasWorkspaceFrame region="north-america" mapActions={false}>
  <article class="canada-nature canada-industry" data-canada-industry>
   <div class="atlas-explorer atlas-workspace canada-country-primary" data-field="industry">
   <div class="atlas-compact-heading"><nav aria-label="パンくず"><a href={withBase('/atlas/')}>地図から見る</a> / <a href={withBase('/atlas/north-america/')}>北米地図</a></nav><span>カナダ</span></div>
   <AtlasRegionNavigation group="americas" current="north-america" country="canada" />
   <h1 class="visually-hidden">州ごとの構成から読む、カナダの産業</h1>
   <NorthAmericaCountryFieldNavigation country="canada" field="industry" />
   <p><a href={withBase('/atlas/north-america/canada/population/')} data-canada-population-industry-return hidden>元の都市圏人口・比較へ戻る</a></p>
   <div class="industry-controls country-industry-us-navigation" data-industry-controls>
    <div class="industry-tab-row" role="tablist" aria-label="産業の業態">
     {canadaIndustrySectors.map(sector=><button type="button" role="tab" id={`canada-industry-sector-${sector.id}`} data-industry-sector={sector.id} aria-controls="canada-industry-map-panel" aria-selected={sector.id==='all'?'true':'false'} tabindex={sector.id==='all'?0:-1}>{sector.label}</button>)}
    </div>
    <p class="industry-guide"><span data-industry-breadcrumb>全産業</span><a href="#canada-industry-statistics">この分野の統計へ</a></p>
   </div>
   <div class="canada-workspace atlas-primary-grid" id="canada-industry-map-panel" role="tabpanel" aria-labelledby="canada-industry-sector-all">
    <section class="canada-map-column atlas-map-column" aria-label="州内GDP割合の地図と比較">
     <div class="canada-map-title visually-hidden"><h2 data-canada-industry-map-title>カナダの産業の代表地域</h2></div>

     <div class="atlas-map-frame canada-map-frame">
     <svg class="canada-map industry-map" data-industry-map viewBox="0 0 900 580" role="group" aria-labelledby="canada-industry-title canada-industry-desc">
      <title id="canada-industry-title">カナダの産業の代表地域と13州・準州</title>
      <desc id="canada-industry-desc">2021年の公式境界を位置の参照として表示します。産業の代表地域は本文と対応する事例で、点の大きさは数量を表しません。州内GDP割合は右の関連統計で読みます。ABはアルバータ、ONはオンタリオ、QCはケベック、BCはブリティッシュコロンビア。周辺の米国とグリーンランドは位置の参考です。</desc>
      <defs><clipPath id="industry-map-clip"><rect width="900" height="580" /></clipPath><pattern id="industry-missing" width="8" height="8" patternUnits="userSpaceOnUse"><rect width="8" height="8" fill="#f7f4e9"/><path d="M-2,2L2,-2M0,8L8,0M6,10L10,6" stroke="#929a8e" stroke-width="2"/></pattern></defs>
      <g clip-path="url(#industry-map-clip)">
       {features.filter(f=>['USA','GRL'].includes(f.properties.code)).map(f=><path class="canada-land is-context" d={geometryPath(f.geometry)} fill-rule="evenodd" />)}
       {geometry.features.map(g=>{const row=initialRows.find(r=>r.id===g.id)!;return <path data-industry-province-shape={g.id} d={g.path} fill="#edf1df" fill-rule="evenodd" role="button" tabindex="0" aria-pressed="false" aria-label={`${row.name}を選ぶ`}><title>{row.name}（州の位置案内）</title></path>;})}
       {geometry.features.map(g=>{const p=data.provinces.find(p=>p.id===g.id)!,[dx,dy]=labelOffsets[g.id]??[0,0];return <g data-industry-province-label={g.id}><circle cx={g.point[0]} cy={g.point[1]} r="2" fill="#32534b"/><text x={g.point[0]+dx} y={g.point[1]+dy-5} text-anchor="middle">{p.short}<title>{p.name}（州の位置案内）</title></text></g>;})}
       {places.map(s=>{const [x,y]=project(s.coordinates);return <g class="industry-place"><circle cx={x} cy={y} r="3"/><text x={x+7} y={y+18}>{s.id==='ottawa'?'Ottawa':'Vancouver'}</text><title>{s.name}の気候観測点（都市の位置案内）</title></g>;})}
       <g data-industry-region-markers>
        {canadaIndustryRegions.map(region=>{const [x,y]=project(region.coordinates),sector=canadaIndustrySectors.find(s=>s.id===region.sector)!,left=region.id==='ontario-manufacturing';return <g class="industry-region-marker" data-industry-region={region.id} role="button" tabindex="0" aria-pressed="false" aria-label={`${region.name}：${sector.label}の地域事例を読む`} transform={`translate(${x},${y})`}><title>{region.name}（{region.scope}）</title><rect class="industry-region-hit" x="-32" y="-32" width="64" height="64" fill="transparent"/><circle r="6" fill={sector.color}/><text x={left?-10:10} y={left?20:-10} text-anchor={left?'end':'start'}>{industryMarkerLabels[region.id]}</text></g>;})}
       </g>
       <text class="canada-ocean" x="45" y="440">太平洋</text><text class="canada-ocean" x="800" y="550">大西洋</text><text class="canada-ocean" x="400" y="35">北極海</text><text class="canada-ocean" x="555" y="292">ハドソン湾</text><text class="canada-ocean" x="440" y="555">米国</text>
      </g>
     </svg></div>
     <div class="industry-key" data-industry-key><div class="industry-sector-legend" aria-label="産業の業態の色">{canadaIndustrySectors.filter(s=>s.id!=='all').map(sector=><span><i style={`background:${sector.color}`} aria-hidden="true"/>{sector.label}</span>)}</div><p data-industry-map-status aria-live="polite">点は産業を読み解く地域の案内位置。同じ大きさで、数量・順位や施設の位置を表しません。</p></div>
     <p class="canada-caption">州境は2021年の位置案内です。本文の地域名や地図の点を押して、その産業のつながりを読みます。</p>
     <details><summary>地域一覧から選ぶ</summary><div class="industry-region-list">{canadaIndustryRegions.map(region=><button type="button" data-industry-region={region.id}>{region.name}<small>{canadaIndustrySectors.find(s=>s.id===region.sector)!.label}</small></button>)}</div></details>
    </section>
    <aside class="canada-reading atlas-national industry-reading industry-map-reading" aria-label="資源・加工・輸送・市場をつなぐ読み方"><p data-population-geometry-status hidden></p>

     <section class="canada-comparison-context" data-canada-population-industry-context hidden>
      <h2>都市圏人口と州の産業構成を照合する</h2>
      <p data-canada-population-industry-text></p>
      <p class="canada-caption" data-canada-population-industry-scope hidden></p>
      <svg class="canada-map population-industry-source-map" data-canada-population-industry-map viewBox="140 340 760 240" role="img" aria-label="元の都市圏人口分布と数量または密度の凡例"></svg>
      <p class="canada-caption" data-canada-population-industry-legend></p>
      <details><summary>人口と産業の対象・出典を分けて読む</summary><p>CMAは自治体と通勤によって結びつく都市圏です。元の人口は2016・2021年、密度と境界は2021年。産業は選択年の州・準州全体のGDP構成比で、都市雇用数や都市のGDPではありません。地図の重なりだけから人口集中の原因を決めません。</p><p><a href={withBase('/atlas/north-america/canada/population/#canada-population-sources')}>元の人口・境界・定義・出典</a> / <a href="#canada-industry-sources">州別産業構成の出典</a></p><p lang="en">Adapted from Statistics Canada, Tables 98-10-0003-01 and 98-10-0001-01, Census of Population 2021, and 2021 Census Cartographic Boundary Files, reference years 2016 and 2021 (accessed September 30, 2026). This does not constitute an endorsement by Statistics Canada of this product. Contains information licensed under the Open Government Licence – Canada.</p></details>
     </section>
     <details class="industry-context-general" data-industry-general-reading open><summary>産業の立地・比較を読む</summary>
     <article class="industry-selected-reading-body" data-industry-reading="all" data-industry-sector-reading="all">
      <header class="industry-selected-header"><h2>全産業</h2></header>
      <p class="canada-takeaway">{canadaIndustryOverview.lead}</p>
      <h3>資源から加工・輸送・市場へつなぐ</h3>
      <p>{canadaIndustryOverview.explanation}</p>
      <div class="industry-reading-places" aria-label="産業の業態を読む"><button type="button" data-industry-sector="resources">資源・エネルギーを読む</button><button type="button" data-industry-sector="manufacturing">製造業を読む</button><button type="button" data-industry-sector="services">サービス業を読む</button></div>
      <details><summary>掲載範囲と統計の読み方</summary><p>掲載した地域は立地のつながりを読む事例です。全産業や全施設の分布を網羅したものではありません。下の統計は州・準州全体のGDP割合で、地図の点にある施設や都市の金額ではありません。</p><a href="#canada-industry-sources">地域の根拠と州別統計の出典</a></details>
     </article>
     <article class="industry-selected-reading-body" data-industry-reading="mining" data-industry-sector-reading="resources" hidden>
      <header class="industry-selected-header"><h2>資源・エネルギー</h2></header>
      <h3>資源の場所から、加工・輸送・市場へ</h3>
      <p class="canada-takeaway">アルバータ北部の石油資源 → Edmonton・Hardistyの集荷拠点 → 精製・パイプライン → 国内外の市場。</p>
      <p class="canada-sources-inline"><a href={targets.landform} data-industry-nature-link={targets.landform}>西部山地と内陸の位置は、資源を運ぶ条件にどう関わる？</a></p>
      <details><summary>採取の後に、技術と輸送が必要になる</summary><p>CERによると、2023年のアルバータ原油生産の4分の3超は北部オイルサンドから。加工や希釈を経た原油は集荷拠点に集まり、パイプラインが米国や他州の精製・販売市場につなぎます。</p><p>2023年にオイルサンドから生産したビチューメンの一部は合成原油へ加工され、精製原料や輸送のための希釈にも使われます。Enbridge MainlineはEdmontonからプレーリー・米国中西部・オンタリオの市場へ、Trans MountainはBC・Washington州の精製所・港湾ターミナルへつながります。州内の精製品配送には道路・鉄道・製品パイプラインも使われます。</p><p>この地図のNAICS 21は石油・ガスだけの割合ではありません。鉱物資源の採掘を含む準州と、オイルサンドの事例を区別して読みます。</p><p><a href={sources.energy}>CER：Albertaの生産・加工・輸送（生産年2023）</a></p></details>
     </article>
     <article class="industry-selected-reading-body" data-industry-reading="manufacturing" data-industry-sector-reading="manufacturing" hidden>
      <header class="industry-selected-header"><h2>製造業</h2></header>
      <h3>加工を支える、交通と市場</h3>
      <p class="canada-takeaway">オンタリオとケベックを比較し、五大湖・セントローレンス沿いの輸送と市場につなぐ。</p>
      <p class="canada-sources-inline"><a href={targets.water} data-industry-nature-link={targets.water}>五大湖からセントローレンス川へ、両州と市場を結ぶ位置を追う</a><br/><a href={forestrySources.transport}>中央輸送回廊の根拠：Transport Canada 2024</a></p>
      <p>Transport Canadaの2024年報告は、両州を含む中央輸送回廊と、道路・鉄道・五大湖／セントローレンス水路の役割を説明しています。加工業の立地は原料だけでなく、人・製品を運ぶ交通や、買い手につながる条件と合わせて読みます。</p>
      <details><summary>割合と、加工する活動の大きさを分ける</summary><p>州内割合が高いことから、その州が全国最大の製造業金額だとは言えません。製造業は木材・紙・食品・輸送機器など多くの加工を含みます。原料の自然条件から加工の段階を追う例は林業ページで比べられます。</p><p><a href={withBase('/atlas/north-america/canada/agriculture/forestry/')}>森林の分布 → 木材・紙製品の加工へ</a></p></details>
     </article>
     <article class="industry-selected-reading-body" data-industry-reading="services" data-industry-sector-reading="services" hidden>
      <header class="industry-selected-header"><h2>サービス業</h2></header>
      <h3>人口と仕事を支える、多様な活動</h3>
      <p class="canada-takeaway">サービスは商業だけでなく、運輸・教育・医療・公的活動も含む。都市の人口と仕事へつなげて読む。</p>
      <p class="canada-sources-inline"><a href={withBase('/atlas/north-america/canada/population/')}>都市圏の人口分布と、仕事の集まる場所を読む</a><br/><a href={targets.coast} data-industry-nature-link={targets.coast}>BCの沿岸・Vancouver・Fraser川は、太平洋側の市場とどうつながる？</a></p>
      <p>オンタリオとBCの州内割合を比べ、次に人口ページで都市圏の集まり方を確かめます。州全体の産業割合と都市圏の人口は、対象と分母が異なる統計です。</p>
      <details><summary>港・道路と、州全体のサービスを分ける</summary><p>Transport Canadaの2024年報告は、BCの港・鉄道・道路・米国との陸上国境を結ぶ交通を説明しています。Vancouverの位置は沿岸事例です。この交通の説明だけで、BCのサービス割合全体の原因を確定することはできません。</p><p><a href={forestrySources.transport}>BCの輸送ネットワークの根拠</a> / <a href={sources.table}>サービス生産産業の元表・定義</a></p></details>
     </article>
     </details>
     <div class="industry-selected-region-reading" data-industry-region-readings>
      {canadaIndustryRegions.map(region=><article class="industry-selected-reading-body" data-industry-region-reading={region.id} hidden><header class="industry-selected-header"><h2>{region.name}</h2><button type="button" data-industry-overview>全分野へ</button></header><p class="canada-takeaway">{region.lead}</p><p>{region.explanation}</p><button type="button" class="industry-reading-place" data-industry-region={region.id}>{region.name}を地図で見る</button><details><summary>地域事例の対象・年・出典</summary><p>{region.scope}</p><p>本文の対象年：{region.sourceYear}年。地図の点は2021年の都市圏境界にある既存の案内位置です。</p><a href={region.sourceURL}>地域事例の根拠資料</a></details></article>)}
     </div>
     <details class="industry-related-statistics" id="canada-industry-statistics"><summary>この分野の統計：州内GDP割合</summary>
      <p class="canada-caption">州の全産業GDPを100%とした割合です。代表地域の規模・都市のGDP・雇用人数とは対象が異なります。</p>
     <div class="industry-statistics-controls">
       <label>統計年<select data-industry-year>{data.years.map(y=><option value={y} selected={y===year}>{y}年</option>)}</select></label>
       <label>統計の分類<select data-industry-metric>{mapMetrics.map(m=><option value={m.id} selected={m.id===metric}>{m.name}</option>)}</select></label>
       <label>読む州・準州<select data-industry-province>{data.provinces.map(p=><option value={p.id} selected={p.id==='Alberta'}>{p.name}</option>)}</select></label>
       <label>比べる州・準州<select data-industry-compare><option value="">比較なし</option>{data.provinces.map(p=><option value={p.id} disabled={p.id==='Alberta'}>{p.name}</option>)}</select></label>
      </div>
      <p class="industry-comparison" data-industry-comparison aria-live="polite">2025年 鉱業・採石・石油ガス採取の州内GDP割合 — アルバータ: {valueText(initial.values.mining)}</p>
      <div class="industry-comparison-cards">
       {[0,1].map(i=><div data-industry-card hidden={i===1}><span data-industry-card-name>{i===0?initial.name:''}</span><strong data-industry-card-value>{i===0?valueText(initial.values.mining):''}</strong><span class:list={['canola-bar-track',{'is-missing':i===0&&initial.values.mining.value===null}]}><span data-industry-card-bar style={`width:${i===0?(initial.values.mining.value??0):0}%`} /></span></div>)}
      </div>
     <details class="industry-definitions"><summary>州名の略号と、数字の意味</summary>
      <p>{data.provinces.map((p,i)=><Fragment>{i?' ／ ':''}{p.short}＝{p.name}</Fragment>)}</p>
      <dl><dt>GDP割合</dt><dd>基本価格・当年価格で、その州の全産業GDPを100%とした割合。</dd><dt>鉱業・採石・採取</dt><dd>NAICS 21。石油・ガス採取に加えて鉱業・採石と支援活動を含みます。すべての天然資源産業を含む分類ではありません。</dd><dt>製造業</dt><dd>NAICS 31–33。原料などを製品に加工する産業。</dd><dt>サービス生産産業</dt><dd>T003。商業・運輸・専門サービスに加え、教育・医療・公的な活動なども含みます。</dd><dt>全産業</dt><dd>T001、各州100%。表の分母を確かめる参照列です。</dd></dl>
      <p>地図の3分類以外にも農林漁業・電気等の供給・建設などがあるため、3分類を足して100%とする円グラフにはしません。同じ割合でも州の経済規模は異なります。</p>
      <p>位置図は等緯度経度表示。小さな島や細部を表示用に一般化し、面積の測定には使いません。州名の丸は位置案内で、資源・工場の地点ではありません。</p>
     </details>
   <details class="industry-table-details"><summary>選択年の13州・準州を、4指標の表で確かめる</summary>
