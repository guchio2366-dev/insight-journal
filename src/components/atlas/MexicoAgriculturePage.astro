---
import {readFile} from 'node:fs/promises';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AgricultureMapControls from './AgricultureMapControls.astro';
import AgricultureCommodityKey from './AgricultureCommodityKey.astro';
import AgricultureValueComposition from './AgricultureValueComposition.astro';
import {withBase} from '../../lib/urls';
import {geometryPath,stateFeatures,stateLabelPoint,projectLonLat,projectNative,mapViewBox} from '../../lib/atlas-mexico-geometry';
import {agricultureProductStatistics,formatMexicoProduction,formatMexicoValue,type MexicoAgricultureAtlasData} from '../../lib/atlas-mexico-agriculture-atlas';
import {mexicoCrops,mexicoLivestockKinds,mexicoAgricultureLabel} from '../../data/atlas/mexico/agriculture-catalog';
import {agricultureReading,agricultureSources} from '../../data/atlas/mexico/agriculture-reading';
import {mexicoAgricultureProductReading} from '../../data/atlas/mexico/agriculture-product-reading';
import displayStates from '../../../public/assets/atlas/mexico-agriculture-v2/display-states.json';
import census from '../../data/atlas/mexico/agriculture.json';
import labels from '../../../public/assets/atlas/mexico-nature-parity-v1/labels.json';
import '../../styles/atlas-us-responsive.css';
import '../../styles/atlas-agriculture-insights.css';
import '../../styles/atlas-mexico-agriculture-atlas.css';
const data=JSON.parse(await readFile('public/assets/atlas/mexico-agriculture-v2/agriculture-atlas.json','utf8')) as MexicoAgricultureAtlasData;
const assetBase=withBase('/assets/atlas/mexico-agriculture-v2/');
const crops=mexicoCrops.filter(crop=>data.cropZones.features.some(feature=>feature.properties.cropId===crop.id));
const readings={...mexicoAgricultureProductReading,
 corn:{...agricultureReading.maize,title:'とうもろこし：主食と飼料を支える',steps:agricultureReading.maize.steps.map((step,index)=>index===2?{...step,body:'灌漑によって雨の季節だけに頼らず耕作するには、用水の確保が条件になります。2020年推計の主要栽培域と地形を見て、2022年センサスの白粒生産・灌漑率、加工や市場への輸送を別々に確かめます。'}:step)},
 pine:agricultureReading.pine,irrigation:agricultureReading.irrigation,
 cattle:{...agricultureReading.cattle,steps:agricultureReading.cattle.steps.map((step,index)=>index===0?{...step,body:'2022年9月の牛の飼養頭数です。農業生産単位と住宅で飼養する牛を合わせ、下の州別統計で確認します。地図の牛の記号は2025年の牛肉生産から選んだ自治体であり、この頭数を表すものではありません。'}:step)},
};
const ids=[...crops.map(c=>c.id),...mexicoLivestockKinds.map(k=>k.id),'pine','irrigation','cattle'];
const stats=Object.fromEntries(ids.map(id=>[id,agricultureProductStatistics(data,id)]));
const physicalLabels=labels.labels.filter(label=>label.view==='relief'&&['西シエラマドレ','東シエラマドレ','中央高原','ユカタン半島','南シエラマドレ'].includes(label.labelJa));
const config={crops,livestockKinds:mexicoLivestockKinds,markers:data.livestockMarkers.map(marker=>({...marker,point:projectLonLat(marker.anchor)})),
 states:census.states.map(state=>({code:state.code,name:state.nameJa,point:stateLabelPoint(state.code)})),statistics:stats,
 naturePath:withBase('/atlas/north-america/mexico/nature/'),agriculturePath:withBase('/atlas/north-america/mexico/agriculture/')};
const composition=data.composition.map(group=>({id:group.id,label:group.id==='crops'?'作物':'畜産',total:group.totalValueMxN,items:group.items.map(item=>({label:item.label,value:item.valueMxN}))}));
const total=composition.reduce((sum,group)=>sum+group.total,0);
const cropShare=composition.find(group=>group.id==='crops')!.total/total*100;
const displayCropLabels=crops.filter(crop=>crop.id!=='other').map(crop=>data.cropLabels.find(label=>label.cropId===crop.id)).filter(Boolean);
const cropPaths=crops.map(crop=>({...crop,path:data.cropZones.features.filter(feature=>feature.properties.cropId===crop.id).map(feature=>geometryPath(feature.geometry)).join('')}));
---
<BaseLayout title="メキシコの農林業｜北米地理" description="メキシコの主要栽培域と畜産の産地を、地形・水・生産・利用のつながりから読みます。" compactAtlas>
 <AtlasWorkspaceFrame region="north-america" mapActions={false}>
  <article class="atlas-explorer mexico-agriculture-atlas" data-mexico-agriculture-atlas data-mexico-workspace data-mexico-field="agriculture" data-field="agriculture" data-mexico-reading-selected="false" data-agri-reading-ready>
   <section class="atlas-workspace mexico-learning-workspace" aria-label="メキシコの農林業地図">
    <div class="atlas-compact-heading"><nav aria-label="パンくずリスト"><a href={withBase('/atlas/')}>地図から見る</a><span aria-hidden="true"> / </span><a href={withBase('/atlas/north-america/')}>北米地理</a></nav><span>メキシコ</span></div>
    <h1 class="visually-hidden">メキシコの農林業</h1>
    <div class="atlas-region-controls"><AtlasRegionNavigation group="americas" current="north-america" country="mexico" /></div>
    <nav class="atlas-tabs atlas-tabs-with-overview mexico-fields" aria-label="地図の分野">{([['overview','概要'],['agriculture','農林業'],['nature','自然環境'],['industry','主要産業'],['population','人口']] as const).map(([id,label])=><a href={withBase(`/atlas/north-america/mexico/${id}/${id==='overview'?'?country=MEX':''}`)} aria-current={id==='agriculture'?'page':undefined}>{label}</a>)}</nav>
    <div class="atlas-primary-grid">
     <div class="atlas-map-column">
      <div class="atlas-map-frame" data-map-frame>
       <svg class="mexico-agriculture-map" data-mexico-map data-agriculture-map viewBox={mapViewBox} tabindex="0" role="group" aria-labelledby="mexico-agriculture-map-title mexico-agriculture-map-description">
        <title id="mexico-agriculture-map-title">メキシコの主要栽培域と畜産の産地</title>
        <desc id="mexico-agriculture-map-description">作物面はMapSPAM 2020の推計を5分格子で概略化。畜産記号は2025年の生産統計から選んだ市町村の代表位置。州合計の数量円ではありません。</desc>
        <rect width="900" height="580" fill="#c1e1ed" />
        <image href={withBase('/assets/atlas/mexico-nature-parity-v1/relief.webp')} x="0" y="0" width="900" height="580" />
        <g data-mexico-crop-zones>{cropPaths.map(crop=><path class="mexico-crop-zone" data-crop-zone={crop.id} fill={crop.color} fill-rule="evenodd" d={crop.path} role="button" tabindex="0" aria-label={`${crop.name}の主要栽培域を読む`}><title>{crop.name}：2020年の推計主要栽培域</title></path>)}</g>
        <image href={`${assetBase}tree-cover-2021.png`} data-mexico-tree-cover width="900" height="580" hidden class="mexico-agriculture-tree-cover" />
        <image href={`${assetBase}rivers.png`} width="900" height="580" class="mexico-agriculture-rivers" />
        <g class="mexico-agriculture-state-lines">{displayStates.states.map(state=><path d={state.path} data-agriculture-state-code={state.code}><title>{state.nameJa}</title></path>)}</g>
        <g class="mexico-agriculture-geography" aria-hidden="true"><text class="is-country" x="550" y="64">アメリカ合衆国</text><text class="is-water" x="135" y="440">太平洋</text><text class="is-water" x="729" y="302">メキシコ湾</text>{physicalLabels.map(label=>{const [x,y]=projectNative(label.pointNative);return <text x={x} y={y}>{label.labelJa}</text>;})}</g>
        <g class="mexico-agriculture-crop-labels" data-mexico-crop-labels>{displayCropLabels.map(label=>{const [x,y]=projectLonLat(label.anchor);return <text x={x} y={y} data-crop-label={label.cropId} data-crop-zone={label.cropId} role="button" tabindex="0">{mexicoAgricultureLabel(label.cropId)}</text>;})}</g>
        <g class="mexico-agriculture-state-selection" data-mexico-state-selection hidden>{displayStates.states.map(state=><path d={state.path} data-mexico-state-outline={state.code} hidden />)}</g>
        <g class="mexico-agriculture-forest-states" data-mexico-forest-states hidden>{displayStates.states.filter(state=>['08','10'].includes(state.code)).map(state=><path d={state.path} />)}{census.states.filter(state=>['08','10'].includes(state.code)).map(state=>{const [x,y]=stateLabelPoint(state.code);return <text x={x} y={y}>{state.nameJa}</text>;})}</g>
       </svg>
       <div class="atlas-livestock-markers" data-livestock-markers></div>
       <AgricultureMapControls countryLabel="メキシコ" />
       <p class="atlas-layer-caption" data-layer-caption>作物 2020推計・畜産産地 2025（概略）</p>
      </div>
      <AgricultureCommodityKey {crops} livestock={[...mexicoLivestockKinds]} overlap={false} />
      <p class="mexico-agriculture-map-note"><span data-mexico-map-note>作物は推計主要栽培域、畜産は生産の多い市町村の代表位置。記号の大きさは数量を表しません。</span><a href="#mexico-agriculture-sources">出典・表示方法</a></p>
      <section class="agriculture-relations mexico-agriculture-relations" aria-label="自然条件と産地のつながり"><h2>自然条件と産地をつなぐ</h2><div><button type="button" data-mexico-agriculture-item="irrigation"><strong>北西部の乾燥と灌漑</strong><span>水の確保が秋冬作を支える</span></button><button type="button" data-mexico-agriculture-item="pine"><strong>山地の森林と木材</strong><span>西シエラマドレと松材供給</span></button></div></section>
      <p class="visually-hidden" data-atlas-live aria-live="polite" aria-atomic="true"></p>
     </div>
     <div data-field-national="agriculture">
      <aside class="atlas-national" data-agri-overview aria-labelledby="national-agriculture-title">
       <header><p class="atlas-eyebrow">NATIONAL OVERVIEW</p><h2 id="national-agriculture-title">メキシコの農林業</h2><p>作物・畜産・林業を、自然条件と生産・利用のつながりから読みます。地図下の項目から詳説を選べます。</p><h3>農畜産の概況</h3><p>生産額は作物が{cropShare.toFixed(0)}%、畜産が{(100-cropShare).toFixed(0)}%。北西部の灌漑農業、中央高原の穀物、南部の熱帯作物を、飼料・加工・市場へのつながりと合わせて読みます。</p></header>
       <AgricultureValueComposition title="農畜産物の生産額" period={`${data.years.statistics}年`} groups={composition} {total} divisor={1e9} unit="十億ペソ" idPrefix="mexico-receipt"
        definition="当年価格による生産額。作物と畜産は同じ2025年・メキシコペソで集計。生体と枝肉の二重計上を避け、生体の金額は含めません。販売収入・利益・GDPではありません。林業はこの構成比の対象外です。"
        sourceUrl="https://nube.agricultura.gob.mx/datosAbiertos/Agricola.php" sourceLabel="DGSIAP 農業・畜産年次統計" />
       <details class="mexico-agriculture-census-overview"><summary>農地と森林資源も確かめる</summary><p>2022年農業センサスでは、農業用地の{census.national.irrigationSharePct.toFixed(1)}%が灌漑農地。松材取得量は{(census.national.pineObtainedM3/1e6).toFixed(2)}百万m³です。</p><button type="button" data-mexico-agriculture-item="irrigation">灌漑と農地を読む</button><button type="button" data-mexico-agriculture-item="pine">森林資源と木材生産を読む</button></details>
      </aside>
      <section class="agri-reading-panel" data-agri-reading-panel hidden aria-labelledby="agri-reading-heading">
       <header><button type="button" data-agri-overview-button>← メキシコの農林業</button><h2 id="agri-reading-heading" tabindex="-1"></h2></header>
       <div class="agri-reading-body" data-agri-reading-body tabindex="0" role="region" aria-label="選択した項目の解説本文">
        <div data-agri-reading-content>{Object.entries(readings).map(([id,reading])=><section data-agriculture-reading={id} hidden><p class="mexico-agriculture-takeaway">{id==='corn'&&<small>白粒とうもろこし・2022年センサスの事例</small>}{reading.takeaway}</p>{id==='pine'&&<p class="mexico-agriculture-forest-note">地図の緑は2021年の樹木被覆です。樹木が地表を覆う場所を粗い解像度で示し、松林・伐採区域・法的な森林区分を示すものではありません。輪郭は松材取得量の多い2州の位置です。</p>}{reading.steps.map(step=><section class="mexico-agriculture-causal"><h3>{step.title}</h3><p>{step.body}</p><p class="atlas-inline-sources"><a href={step.source} target="_blank" rel="noopener">この説明の原典</a></p></section>)}{['corn','irrigation','pine','cattle'].includes(id)&&<p><a class="mexico-agriculture-comparison-link" data-agriculture-nature-comparison={id} href={withBase(`/atlas/north-america/mexico/nature/?compare=irrigation&from=agriculture&sourceMetric=${id==='corn'?'maize':id}&state=${id==='pine'?'10':id==='cattle'?'30':'25'}&reading=item`)}>{id==='pine'?'松材の生産州と山地を比べる':id==='cattle'?'牛の頭数と気候を比べる':'白粒の生産と乾燥・灌漑を比べる'}</a></p>}<p><a href="#mexico-agriculture-statistics" data-mexico-statistics-link={id}>全国・州別の統計を確かめる</a></p></section>)}</div>
        <section data-mexico-region-reading hidden><h3 data-mexico-region-heading>選択した産地</h3><p data-mexico-region-name></p><p data-mexico-region-production></p><p class="atlas-inline-sources" data-mexico-region-scope></p></section>
        <div data-agri-candidates hidden></div>
        <div class="atlas-relation-warning" data-agri-layer-warning hidden><p>この項目の地図表示はオフです。</p><button type="button" data-agri-enable-layers>選んだ項目の層を表示</button></div>
       </div>
      </section>
     </div>
    </div>
   </section>
   <section class="agri-statistics mexico-statistics" id="mexico-agriculture-statistics" data-mexico-agriculture-statistics hidden aria-labelledby="mexico-statistics-heading">
    <h2 id="mexico-statistics-heading" data-mexico-statistics-heading>全国と州の統計</h2>
    <div class="mexico-agriculture-stat-tools"><label>読む州 <select data-agriculture-state><option value="">全国</option>{census.states.map(state=><option value={state.code}>{state.nameJa}</option>)}</select></label><label><input type="checkbox" data-mexico-only-item /> 選んだ品目だけを地図に表示</label></div>
    {ids.map(id=>{const value=stats[id];return value&&<section data-mexico-stat-panel={id} hidden><p>{value.definition}</p><div class="mexico-agriculture-stat-totals"><p>{id==='irrigation'?'全国の灌漑農地率':id==='cattle'?'全国の牛頭数':id==='pine'?'全国の松材取得量':'全国の生産量'} <strong>{formatMexicoProduction(value.national,value.unit)}</strong><small>{value.year}</small></p>{value.valueMxN!==null&&<p>全国の生産額 <strong>{formatMexicoValue(value.valueMxN)}</strong><small>当年価格</small></p>}</div><figure class="atlas-mini-chart"><figcaption><strong>{value.valueMxN!==null?'生産額の大きい州':'公表値の大きい州'}</strong><span>{value.year}</span></figcaption><div class="atlas-bars">{value.rows.slice(0,8).map(row=><button class="atlas-bar-row mexico-agriculture-state-bar" type="button" data-agriculture-pick={row.code}><span>{row.name}</span><i><b style={`width:${(value.valueMxN!==null?(row.valueMxN??0)/(value.rows[0].valueMxN??1):(row.production??0)/(value.rows[0].production??1))*100}%`}></b></i><strong>{value.valueMxN!==null?formatMexicoValue(row.valueMxN):formatMexicoProduction(row.production,value.unit)}</strong></button>)}</div></figure><details><summary>32州の値と単位を確認する</summary><div class="mexico-agriculture-table-scroll"><table><caption>{value.label} / {value.year}</caption><thead><tr><th>州</th><th>生産量・公表値 {value.unit}</th>{value.valueMxN!==null&&<th>生産額 十億ペソ</th>}</tr></thead><tbody>{value.rows.map(row=><tr data-agriculture-stat-row={row.code}><th><button type="button" data-agriculture-pick={row.code}>{row.name}</button></th><td>{formatMexicoProduction(row.production,value.unit)}</td>{value.valueMxN!==null&&<td>{formatMexicoValue(row.valueMxN)}</td>}</tr>)}</tbody></table></div></details></section>;})}
   </section>
   <footer class="mexico-sources" id="mexico-agriculture-sources"><details><summary>原典・表示方法・年・単位</summary><p>作物面はMapSPAM 2020 v2r2の物理的栽培面積を使った推計主要栽培域です。格子面積の10%以上が耕作面積と推計された5分格子の支配的な作物群を示し、実際の圃場境界や2025年の作付状況を示すものではありません。</p><p>畜産はDGSIAPの2025年市町村別生産統計から品目ごとに選んだ産地です。初期画面は掲載自治体の中から各品目1点を、互いの間隔を確保して表示し、品目を選ぶとその品目の掲載3自治体を表示します。生産量を飼養頭数に読み替えず、記号の面積で数量を表しません。牛肉と乳、豚肉、鶏肉、卵を別々に集計しています。</p><p>全国構成と州の生産額は同じ2025年のペソ建てで集計。生体と枝肉を合算せず、農業と畜産の単位を確認して換算しています。地図の作物群とDGSIAPの商品分類は同一ではないため、推計面積と2025年の金額を対応付けた順位としては扱いません。</p><p>松材取得量・灌漑農地率・旧白粒統計はINEGIの2022年農業センサス。参照期間は2021年10月～2022年9月、牛頭数は2022年9月です。州境はMarco Geoestadístico 2025年12月版。地形・主要河川は既存のINEGI/地形背景を同じLambert投影で再利用しています。河川は小流域内次数7以上の選択です。</p><ul><li>IFPRI, MapSPAM 2020 v2r2 / CGIAR Climate Action Data Hub。作物図は本サイトで集約・加工。<a href="https://www.mapspam.info/">データと方法</a> ／ <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></li><li><a href="https://nube.agricultura.gob.mx/datosAbiertos/Agricola.php">DGSIAP 農業年次統計</a> ／ <a href="https://nube.agricultura.gob.mx/datosAbiertos/Pecuario.php">畜産年次統計</a></li><li>© ESA WorldCover project 2021 / Contains modified Copernicus Sentinel data (2021) processed by ESA WorldCover consortium。class10を元の10m図ではなく約0.00534度格子の概略画像から採取し、メキシコの投影・国境で加工。<a href="https://creativecommons.org/licenses/by/4.0/">CC BY4.0</a> ／ <a href={`${assetBase}tree-cover-manifest.json`}>樹木被覆の原典・解像度・欠測・加工記録</a></li><li><a href={agricultureSources.census}>INEGI 2022年農業センサス</a> ／ <a href={agricultureSources.licence}>INEGI Términos de Libre Uso</a></li><li><a href={`${assetBase}manifest.json`}>加工方法・原典・ハッシュ・全国照合</a> ／ <a href={`${assetBase}LICENSE.txt`}>作物派生データの帰属・変更点・利用条件</a></li><li><a href={withBase('/assets/atlas/mexico-agriculture-v1/selected-states.csv')}>2022年センサスの32州公表値</a></li></ul></details></footer>
   <script type="application/json" data-mexico-agriculture-config set:html={JSON.stringify(config).replace(/</g,'\\u003c')} />
   <noscript><style is:global>.mexico-agriculture-atlas [data-agriculture-reading][hidden],.mexico-agriculture-atlas [data-agri-reading-panel][hidden],.mexico-agriculture-atlas [data-mexico-agriculture-statistics][hidden],.mexico-agriculture-atlas [data-mexico-stat-panel][hidden]{display:block!important}.mexico-agriculture-atlas .agri-reading-panel{height:auto!important}.mexico-agriculture-atlas .agri-reading-body{overflow:visible!important}</style><p>地図の切替・拡大・産地記号はJavaScriptで動作します。解説、統計表、作物図と原典はこのまま読めます。</p></noscript>
  </article>
 </AtlasWorkspaceFrame>
</BaseLayout>
<script>import {initMexicoAgricultureAtlas} from '../../scripts/atlas-mexico-agriculture-atlas';for(const root of document.querySelectorAll<HTMLElement>('[data-mexico-agriculture-atlas]'))initMexicoAgricultureAtlas(root);</script>
