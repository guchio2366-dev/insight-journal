---
import { northAmericaFields } from "../../data/atlas/regions";
import { withBase } from "../../lib/urls";

interface Props {
  active?: string;
}

const { active = "" } = Astro.props;
---

<nav class="atlas-field-nav" aria-label="北米地図の分野">
  <div class="atlas-field-nav-head">
    <p class="eyebrow">North America map</p>
    <p>同じ地図の土台から、読みたい分野を選ぶ</p>
  </div>
  <div class="atlas-field-nav-items">
    {northAmericaFields.map((field, index) => (
      field.status === "ready" ? (
        <a class:list={["atlas-field-link", { "atlas-field-link--active": active === field.id }]} href={withBase(field.href)} aria-current={active === field.id ? "page" : undefined}>
          <span class="atlas-field-number">0{index + 1}</span>
          <span class="atlas-field-copy"><strong>{field.label}</strong><small>{field.description}</small></span>
          <b aria-hidden="true">→</b>
        </a>
      ) : (
        <div class="atlas-field-link atlas-field-link--disabled" aria-disabled="true">
          <span class="atlas-field-number">0{index + 1}</span>
          <span class="atlas-field-copy"><strong>{field.label}</strong><small>{field.description}</small></span>
          <span class="atlas-field-status">準備中</span>
        </div>
      )
    ))}
  </div>
</nav>
