---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import AsiaClimateDiagram from './AsiaClimateDiagram.astro';
import {withBase} from '../../lib/urls';
import data from '../../data/atlas/west-asia.json';
import {westFields,westTopics,observation} from '../../data/atlas/west-asia-topics.mjs';
import '../../styles/atlas-west-asia.css';
interface Props { initialField?: 'natural'|'agriculture'|'industry'|'population' }
const {initialField='natural'}=Astro.props;
const field=westFields.find(f=>f.id===initialField)!;
const topics=westTopics.filter(t=>t.field===initialField);
const initial=topics.find(t=>t.id===field.first)!;
const groups=[...new Set(topics.map(t=>t.group))];
const rainMax=Math.ceil(Math.max(...data.cities.flatMap(c=>c.precipitationMm).filter(v=>v!==null))/100)*100;
const assetBase=withBase('/assets/atlas/west-asia-v1/');
const climateSource='https://www.data.jma.go.jp/tcc/tcc/products/climate/climatview/frame.php';
---
<BaseLayout title={`西アジア・中東の${field.label}`} description="20か国・地域の自然環境、農林業、産業、人口を、資料の対象年とともに読む地図。" compactAtlas>
 <AtlasWorkspaceFrame region="west-asia">
  <article class="atlas-explorer west-atlas" data-west-atlas data-field={initialField} data-assets={assetBase}>
   <div class="atlas-compact-heading"><a href={withBase('/atlas/')}>← 世界の地域を選ぶ</a><span>20か国・地域</span></div>
   <header class="west-heading"><p class="eyebrow">REGIONAL ATLAS</p><h1>西アジア・中東</h1><p>場所を選び、水・土地・産業・暮らしのつながりを読む。</p></header>
   <div class="west-region-row">
    <label>国・地域<select data-west-country aria-label="国・地域を選択"><option value="">地域全体</option>{data.countries.map(c=><option value={c.code}>{c.name}</option>)}</select></label>
    <a data-west-other="north-america" href={withBase(`/atlas/north-america/${field.route}/`)}>北米を見る</a>
    <a href={withBase('/atlas/europe/')}>欧州を見る</a>
   </div>
   <nav class="atlas-tabs" aria-label="地図の分野">{westFields.map(f=><a data-west-field={f.id} href={withBase(`/atlas/west-asia/${f.route}/`)} aria-current={f.id===initialField?'page':undefined}>{f.label}</a>)}</nav>
   <div class="atlas-nature-controls west-controls">
    <div class="atlas-nature-tabs" role="group" aria-label={`${field.label}の主題群`}>{groups.map((g,i)=><button type="button" data-west-group={g} aria-pressed={i===0} aria-selected={i===0}>{g}</button>)}</div>
    <label class="west-topic-label"><span>表示する地図</span><select data-west-topic aria-label="表示する地図">{groups.map(g=><optgroup label={g}>{topics.filter(t=>t.group===g).map(t=><option value={t.id}>{t.label}</option>)}</optgroup>)}</select></label>
   </div>
   <div class="atlas-primary-grid">
    <section class="atlas-map-column" aria-labelledby="west-map-title">
     <div class="west-map-heading"><h2 id="west-map-title">{initial.label}</h2><span data-west-period></span></div>
     <div class="atlas-map-frame">
      <svg data-west-map data-map-surface viewBox={`0 0 ${data.width} ${data.height}`} tabindex="0" role="group" aria-label="西アジア・中東の主題図。矢印キーで移動、プラスとマイナスで拡大・縮小。国・都市は一覧からも選択できます。"><title>西アジア・中東の地図</title><g data-west-scene></g></svg>
      <div class="atlas-map-tools" aria-label="地図の表示範囲"><button data-west-reset aria-label="地域全体へ戻る">全体</button><button data-west-zoom="0.65" aria-label="地図を拡大">＋</button><button data-west-zoom="1.54" aria-label="地図を縮小">−</button></div>
      <div class="west-map-loading" data-west-loading role="status">地図資料を読み込んでいます。</div>
     </div>
     <p class="west-map-help">地図の場所、または上の国の一覧を選んでください。ドラッグ・矢印キーで移動できます。スマートフォンでは上下の余白からページをスクロールできます。</p>
     <p class="west-point" data-west-point aria-live="polite">場所を選ぶと、ここに地図の値を表示します。</p>
     <div class="west-legend" data-west-legend aria-label="地図の凡例"></div>
     <p class="west-method" data-west-method></p>
     <p class="west-source" data-west-source></p>
     <button class="west-retry" data-west-retry hidden>資料を再読み込みする</button>
    </section>
    <aside class="west-reading" aria-labelledby="west-detail-title">
     <div class="west-detail-controls">
      <label data-west-year-label>国別統計の年<select data-west-year aria-label="国別統計の年">{[2024,2023,2022,2021,2020].map(y=><option value={y}>{y}年</option>)}</select></label>
      <label data-west-city-label>観測所の雨温図<select data-west-city aria-label="雨温図の観測所"><option value="">観測所を選択</option>{data.cities.map(c=><option value={c.id}>{c.name}</option>)}</select></label>
      <label data-west-urban-label hidden>都市中心部<select data-west-urban aria-label="人口を読む都市"><option value="">都市を選択</option>{data.urban.cities.map(c=><option value={c.id}>{c.name}</option>)}</select></label>
      <label data-west-basin-label hidden>流域全体へ移動<select data-west-basin aria-label="流域を選択"><option value="">流域を選択</option></select></label>
     </div>
     <div data-west-detail><p class="eyebrow">読み方</p><h2 id="west-detail-title">{initial.label}</h2><p>{initial.description}</p><p>国や都市を選ぶと、統計と説明を表示します。</p></div>
     <div class="west-related"><h3>同じ場所の別の分野へ</h3>{westFields.filter(f=>f.id!==initialField).map(f=><a data-west-field={f.id} href={withBase(`/atlas/west-asia/${f.route}/`)}>{f.label} →</a>)}</div>
     <a class="west-back-map" href="#west-map-title">地図へ戻る ↑</a>
    </aside>
   </div>
   <section class="west-sources" id="west-sources"><h2>資料の範囲と読み方</h2>
    <p>このページは、国連M49の西アジア18か国・地域にイランとエジプトを加えた編集上の範囲です。国連が「中東」をこの20と定めたものではありません。<a href="https://unstats.un.org/unsd/methodology/m49/overview">国連M49</a></p>
    <p>境界はNatural Earth v5.1.2の表示区分を採用しています。パレスチナは資料のPSXをPSEに対応させ、キプロスの2つの境界ポリゴンは選択項目をまとめています。境界・名称は現在の実効支配や領有権の確定を示しません。国別統計は各提供元の対象範囲に従い、境界図と厳密には一致しない場合があります。</p>
    <div class="west-source-grid"><section><h3>自然環境</h3><p><a href="https://www.nature.com/articles/s41597-023-02549-6">Beckほか（2023）</a>の1991–2020年の気候区分を使い、色は北米の定義を参照します。雨温図は<a href={climateSource}>気象庁ClimatView</a>の観測所平年値です。分類格子と観測所は別の資料です。</p><p><a href="https://www.ncei.noaa.gov/products/etopo-global-relief-model">NOAA ETOPO 2022</a>の標高、<a href="https://www.naturalearthdata.com/">Natural Earth</a>の河川・湖、<a href="https://www.hydrosheds.org/hydroatlas">HydroATLAS v1.0</a>の流域、BGR・UNESCOのWHYMAPを使います。水系・帯水層の図から、現在の水不足や使える水量は判断できません。</p></section>
    <section><h3>農林業・産業・人口</h3><p><a href="https://doi.org/10.7910/DVN/SWPENT">MapSPAM 2020</a>の収穫面積、<a href="https://www.fao.org/livestock-systems/global-distributions/en/">FAO GLW4</a>の家畜密度、<a href="https://www.fao.org/faostat/en/">FAOSTAT</a>の国別統計を区別して使います。空間分布は観測点の実数ではなく、統計を地理情報で配分した推計です。</p><p>国別比較は<a href="https://data.worldbank.org/">World Bank WDI</a>、人口分布は<a href="https://human-settlement.emergency.copernicus.eu/ghs_pop2023.php">GHSL R2023A</a>、都市は<a href="https://human-settlement.emergency.copernicus.eu/ucdb2024.php">GHSL UCDB R2024A</a>を使います。欠測は0に置き換えず、同じ年の値を比較します。2020〜2024年の収録状況は指標ごとに異なります。</p></section></div>
    <p>Webメルカトル図法を使っています。面積の直接比較には適しません。格子の値は元の解像度を超えて細かくなりません。海岸や小国では原資料の未収録があります。地図に点がない国でも、国の一覧と統計表から確認できます。</p>
    <p><a href={assetBase+'manifest.json'}>資料・加工方法・利用条件の台帳</a> · <a href={assetBase+'coverage.json'}>20か国・地域×4分野の収録状況</a></p>
    <details class="west-static-data"><summary>国別の基本人口と出典を読む（操作できない場合も利用できます）</summary><table><caption>2024年の人口／World Bank WDI。欠測は未収録と表示します。</caption><thead><tr><th>国・地域</th><th>人口</th></tr></thead><tbody>{data.countries.map(c=>{const r=observation(data,{indicator:'SP.POP.TOTL',unit:'人'},c.code,2024);return <tr><th>{c.name}</th><td>{r.value===null?'未収録':`${r.value.toLocaleString('ja-JP')}人`}</td></tr>})}</tbody></table></details>
   </section>
   <noscript><p>地図の切替にはJavaScriptが必要です。上の国別人口表と出典はそのまま読めます。</p></noscript>
   {data.cities.map(c=><template data-west-chart={c.id}><AsiaClimateDiagram city={c} precipitationMax={rainMax}/></template>)}
  </article>
 </AtlasWorkspaceFrame>
</BaseLayout>
<script>import '../../scripts/atlas-west-asia';</script>
