---
import { climateCities, natureModes, type NatureMode } from '../../data/atlas/natural-environment';
import ClimateDiagram from './ClimateDiagram.astro';
import NatureFeatureDetail from './NatureFeatureDetail.astro';
interface Props { initialMode?:NatureMode }
const { initialMode='climate' } = Astro.props;
---
<aside class="atlas-national atlas-nature-summary" data-natural-summary>
  <div class="atlas-nature-overview-tabs">
    {natureModes.map(mode=><section data-nature-summary-panel={mode.id} hidden={mode.id!==initialMode}>
      {mode.id==='climate'&&<>
        <section class="atlas-city-climate" data-city-climate aria-labelledby="city-climate-heading">
          <h3 id="city-climate-heading" tabindex="-1">都市の雨温図</h3>
          <div class="atlas-climate-diagrams" id="city-climate-chart" data-climate-chart>{climateCities.map(city=><ClimateDiagram {city} />)}</div>
        </section>
        </>}
      {mode.id==='water'&&<div data-nature-empty><h3>水資源の解説</h3><p>地図の川・湖・帯水層の名前から選んでください。</p></div>}
      {mode.id==='landform'&&<div data-nature-empty><h3>地形の解説</h3><p>地図の山脈・高原・平原の名前から選んでください。</p></div>}
      {mode.id==='contour'&&<div data-nature-empty><h3>標高（等高線）</h3><p>全国比較用の500m間隔を、拡大しても同じ線のまま表示します。ロッキーでは2,000〜3,000m級の線が広く連なり、アパラチアでは主に500〜1,000m級に収まる違いが見えます。</p><p>高さは線に付いた数値で、斜面の急緩は同じ間隔の線の密度で読みます。山頂付近の小さな起伏は省略されています。</p></div>}
    </section>)}
  </div>
  <NatureFeatureDetail />
</aside>
