---
import MexicoWorkspace from './MexicoWorkspace.astro';
import MexicoLocalityPopulation from './MexicoLocalityPopulation.astro';
import population from '../../data/atlas/mexico/population.json';
import composition from '../../data/atlas/mexico/population-composition.json';
import {mexicoPopulationReading, mexicoPopulationRegionReading, mexicoPopulationReadingSources} from '../../data/atlas/mexico/population-reading';
import {geometryPath, stateFeatures, stateLabelPoint, mapViewBox} from '../../lib/atlas-mexico-geometry';
import {mexicoDensityColor, mexicoDensityBins, mexicoPopulationRadius, mexicoPopulationLegendValues, formatMexicoPopulation, formatMexicoDensity} from '../../lib/atlas-mexico-population';
import {mexicoCompositionOverviewMetrics, mexicoCompositionHighlights, mexicoCompositionNationalRecord, mexicoCompositionShare, formatMexicoCompositionShare, type MexicoCompositionData} from '../../lib/atlas-mexico-population-composition';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-mexico-population.css';

const initialReading = {text:Object.values(mexicoPopulationReading.regions).map(item=>item.text).join(' '),cause:Object.values(mexicoPopulationReading.regions).map(item=>item.cause).join(' ')};
const assetRoot = withBase('/assets/atlas/mexico-population-v1');
const compositionAssetRoot = withBase('/assets/atlas/mexico-population-composition-v1');
const routes = {
 population: withBase('/atlas/north-america/mexico/population/'),
 industry: withBase('/atlas/north-america/mexico/industry/'),
 nature: withBase('/atlas/north-america/mexico/nature/'),
 agriculture: withBase('/atlas/north-america/mexico/agriculture/'),
 assets: assetRoot,
 labelPoints: Object.fromEntries(population.states.map(row => [row.stateCode, stateLabelPoint(row.stateCode)])),
};
const mapLabels = [
 {stateCode:'08',label:'チワワ州',point:stateLabelPoint('08'),anchor:'middle',leader:false},
 {stateCode:'09',label:'メキシコシティ',point:[560,520],anchor:'start',leader:true},
 {stateCode:'31',label:'ユカタン州',point:stateLabelPoint('31'),anchor:'middle',leader:false},
];
const shapes = stateFeatures.map(feature => {
 const row = population.states.find(row => row.stateCode === feature.properties.code)!;
 return {row, path: geometryPath(feature.geometry), point: stateLabelPoint(row.stateCode)};
});
const symbolShapes = [...shapes].sort((a,b) => b.row.population-a.row.population);
const [selectedX, selectedY] = stateLabelPoint('09');
const compositionData=composition as MexicoCompositionData;
const overviewGroups=['ethnicity','religion'] as const;
const overviewColors=['#af4e25','#167c83','#7754a5'];
const religionOverviewMetrics=mexicoCompositionOverviewMetrics(composition as MexicoCompositionData,'religion');
const metropolitanAreas2020=[
 {name:'メキシコシティ都市圏',population:21_436_911},
 {name:'モンテレイ都市圏',population:5_322_117},
 {name:'グアダラハラ都市圏',population:5_110_617},
];
---
<MexicoWorkspace field="population" title="人口分布から読むメキシコ" lead="集落ごとの人数から、都市への人口集中と全国に広がる集落を読みます。" description="INEGIの2020年国勢調査による189,432集落の人口を表示。集落代表位置の人数円と、既存の州人口・公表人口密度を切り替えて確認できます。">
 <Fragment slot="controls">
 <nav class="atlas-nature-controls mexico-topic-controls" aria-label="人口の項目"><div class="atlas-nature-tabs mexico-topic-tabs mexico-population-topic-tabs">
   <button type="button" data-population-category="distribution" aria-pressed="true">人口分布</button>
   <button type="button" data-population-category="ethnicity" aria-pressed="false">民族・自己認識</button>
   <button type="button" data-population-category="religion" aria-pressed="false">宗教</button>
 </div></nav>
 <p class="population-scope-caption" data-population-scope>2020年・全国32州のデータ。州境は2025年。</p>
 </Fragment>
 <Fragment slot="map">
  <svg class="population-shape-definitions" width="0" height="0" aria-hidden="true" focusable="false"><defs>{shapes.map(({row,path})=><path id={`mexico-population-outline-${row.stateCode}`} d={path} fill-rule="evenodd"/>)}</defs></svg>
  <section class="population-overview-maps" data-population-overview-maps hidden aria-label="全国の分布を一覧で比較">
   {overviewGroups.map(category=><div data-population-overview-category={category} hidden>
    <h2>{category==='religion'?'宗教の特徴的な分布':'民族・自己認識の特徴的な分布'}</h2>
    <p>{category==='religion'?'淡い緑の地は、全32州で州内人口の過半数を占めるカトリックを示します。州内割合に比例する緑と紫の小円で、プロテスタント・福音系と無宗教も全州に示します。色付きの輪郭は各指標で割合が高い8州、番号は上位2州です。多数派と相対的な集中は区別して読みます。':'各指標で公表された州内割合が高い8州を色付きの輪郭で同時に示し、そのうち上位2州に番号を置きます。色と番号は指標の区別で、多数派や人口の大きさを表しません。指標を選ぶとその輪郭を強調します。全32州の割合を面色で見る操作は右欄にあります。先住民言語と先住民自己認識の上位8州は同じ集合ですが、別の指標です。重なる州では橙の外縁と紫の内線で両方を示します。'}</p>
    <figure class="population-overview-combined"><svg viewBox={mapViewBox} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`${category==='religion'?'宗教':'民族・自己認識'}の3指標それぞれで州内割合が高い8州を輪郭で同時に示す地図`}>
     <g class="population-overview-land">{shapes.map(({row})=><use href={`#mexico-population-outline-${row.stateCode}`} data-overview-state={row.stateCode} class={category==='religion'?'is-catholic-majority':undefined}><title>{row.nameJa}{category==='religion'?`：カトリック州内${formatMexicoCompositionShare(religionOverviewMetrics[0].states[row.stateCode],religionOverviewMetrics[0])}`:''}</title></use>)}</g>
     {category==='religion'&&<g class="population-overview-religion-dots" aria-label="全32州のプロテスタント・福音系と無宗教の州内割合">{shapes.map(({row,point})=><g data-overview-religion-state={row.stateCode}>{religionOverviewMetrics.slice(1).map((metric,index)=>{const share=mexicoCompositionShare(metric.states[row.stateCode]);return share===null?null:<circle cx={point[0]+(index===0?-11:11)} cy={point[1]+12} r={11*Math.sqrt(share/25)} fill={overviewColors[index+1]} data-overview-religion-metric={metric.id}><title>{row.nameJa}：{metric.label}、州内{formatMexicoCompositionShare(metric.states[row.stateCode],metric)}。円面積は州内割合に比例</title></circle>;})}</g>)}</g>}
     {mexicoCompositionOverviewMetrics(compositionData,category).map((metric,index)=><g class="population-overview-regions" data-overview-region-metric={metric.id} style={`--region-color:${overviewColors[index]}`}>{mexicoCompositionHighlights(metric,8).map(({code})=>{const row=population.states.find(item=>item.stateCode===code)!;return <use href={`#mexico-population-outline-${code}`} data-overview-region-state={code}><title>{metric.label}：{row.nameJa}、州内{formatMexicoCompositionShare(metric.states[code],metric)}。公表割合の高い8州の一つ</title></use>;})}</g>)}
     {mexicoCompositionOverviewMetrics(compositionData,category).map((metric,index)=><g class="population-overview-highlights" data-overview-highlight-metric={metric.id}>{mexicoCompositionHighlights(metric).map(({code})=>{const point=stateLabelPoint(code),row=population.states.find(item=>item.stateCode===code)!;return <g data-overview-highlight-state={code} transform={`translate(${point[0]+(index-1)*24} ${point[1]-13})`}><circle r="10" fill={overviewColors[index]}/><text text-anchor="middle" dominant-baseline="central">{index+1}</text><title>{metric.label}：{row.nameJa}、州内{formatMexicoCompositionShare(metric.states[code],metric)}。この指標で割合が高い州の一つ</title></g>;})}</g>)}
    </svg><figcaption>2020年・INEGI。{category==='religion'?'淡緑はカトリックが過半数の州。緑と紫の円は各州内割合を共通の面積尺度で示し、半径11の円が25%です。輪郭は各指標の上位8州、番号は上位2州。円の重なりは人口の重複を意味しません。':'各色の輪郭はその指標の公表割合が高い8州、番号は上位2州です。8州以外にも該当者はいます。複数の輪郭が重なる州もあります。'}</figcaption></figure>
    <p class="population-overview-extra" data-population-overview-extra hidden></p>
    <ol class="population-overview-indicators">{mexicoCompositionOverviewMetrics(compositionData,category).map((metric,index)=><li style={`--overview-color:${overviewColors[index]}`}><strong>{index+1}　{metric.label}</strong><span>上位州：{mexicoCompositionHighlights(metric).map(({code})=>{const row=population.states.find(item=>item.stateCode===code)!;return `${row.nameJa} ${formatMexicoCompositionShare(metric.states[code],metric)}`;}).join('／')}</span><small>分母：{metric.countDenominatorLabel}</small></li>)}</ol>
    <details class="population-overview-all-states"><summary>3指標の全32州の割合を確認する</summary><div class="population-overview-all-states-scroll"><table><caption>2020年・INEGI。輪郭は各指標の上位8州、番号は上位2州の位置案内、表は全32州の公表値です。</caption><thead><tr><th scope="col">州</th>{mexicoCompositionOverviewMetrics(compositionData,category).map(metric=><th scope="col">{metric.label}</th>)}</tr></thead><tbody>{population.states.map(row=><tr><th scope="row">{row.nameJa}</th>{mexicoCompositionOverviewMetrics(compositionData,category).map(metric=><td>{formatMexicoCompositionShare(metric.states[row.stateCode],metric)}</td>)}</tr>)}</tbody></table></div></details>
    {category==='religion'&&<p class="population-overview-denominator" data-population-overview-denominator="religion">3指標の分母は全年齢の通常居住人口（不詳を含む）。全国割合の分母は全国人口{formatMexicoPopulation(population.nationalPopulation)}人です。州内割合を指標間で足し合わせません。右欄には8区分の全国値と個別詳細も残しています。</p>}
   </div>)}
  </section>
   <MexicoLocalityPopulation />
   <div class="atlas-map-frame mexico-map-frame" id="mexico-population-distribution" data-population-legacy-frame>
   <div class="population-map-actions" aria-label="人口地図の表示範囲"><button type="button" data-population-map-action="fit">全体</button><button type="button" data-population-map-action="in" aria-label="人口地図を拡大">＋</button><button type="button" data-population-map-action="out" aria-label="人口地図を縮小">−</button></div>
   <p class="mexico-caption population-reference" data-population-reference hidden>参考：人口分布</p>
  <figure class="population-map-figure" data-population-normal>
   <svg class="mexico-map population-map" data-mexico-map data-population-map viewBox={mapViewBox} preserveAspectRatio="xMidYMid meet" role="group" aria-labelledby="mexico-population-map-title mexico-population-map-desc">
    <title id="mexico-population-map-title">2020年の州別人口密度</title>
    <desc id="mexico-population-map-desc">INEGIの32州の人口密度を色で表示。単位は人/km²、州全域の平均です。人口規模を選ぶと円の面積で州人口を表示します。選ぶ州のメニューと全州の表でも値を読めます。表示州境は2025年、統計は2020年です。</desc>
    <defs><pattern id="mexico-population-missing" width="9" height="9" patternUnits="userSpaceOnUse"><rect width="9" height="9" fill="#eef0e7"/><path d="M-2,2L2,-2M0,9L9,0M7,11L11,7" stroke="#798c83" stroke-width="2"/></pattern></defs>
    <g aria-hidden="true">{shapes.map(({row}) => <use href={`#mexico-population-outline-${row.stateCode}`} class="mexico-context population-context" />)}</g>
    <g>{shapes.map(({row,path}) => <path d={path} class="population-state" data-population-state-shape={row.stateCode} fill={mexicoDensityColor(row.density)} fill-rule="evenodd" role="button" tabindex="0" aria-pressed="false" aria-label={`${row.nameJa}、2020年人口密度 ${formatMexicoDensity(row.density)}人/km²、人口 ${formatMexicoPopulation(row.population)}人`}><title>{row.nameJa}：{formatMexicoDensity(row.density)}人/km²、{formatMexicoPopulation(row.population)}人（2020年）</title></path>)}</g>
    <g data-population-symbols hidden>{symbolShapes.map(({row,point}) => <g class="population-symbol" data-population-state-symbol={row.stateCode} role="button" tabindex="0" aria-pressed="false" aria-label={`${row.nameJa}、2020年人口 ${formatMexicoPopulation(row.population)}人`}><circle cx={point[0]} cy={point[1]} r={mexicoPopulationRadius(row.population)} /><title>{row.nameJa}：{formatMexicoPopulation(row.population)}人（円の面積、2020年）</title></g>)}</g>
    <g aria-hidden="true" class="population-labels">{mapLabels.map(({stateCode,label,point,anchor,leader}) => <g data-population-state-label={stateCode}>{leader&&<path d={`M${stateLabelPoint(stateCode).join(',')}L${point[0]-12},${point[1]-12}h8`} />}<text x={point[0]} y={point[1]-6} text-anchor={anchor}>{label}</text></g>)}</g>
    <g class="population-selected-label" data-population-selected-label aria-hidden="true" hidden><path d={`M${selectedX},${selectedY}l20,-24`} /><text x={selectedX+25} y={selectedY-25} data-population-selected-label-text></text></g>
    <g class="population-map-context" aria-hidden="true"><text x="450" y="45">米国</text><text x="95" y="415">太平洋</text><text x="720" y="250">メキシコ湾</text><text x="870" y="540" text-anchor="end">グアテマラ</text></g>
    <g class="population-map-symbol-key" data-population-map-symbol-key hidden role="img" aria-label="円の面積の凡例。人口100万人、500万人、1000万人。地図の人口円と同じ座標縮尺。"><text x="45" y="476" class="population-map-key-heading">円の面積＝州人口</text>{mexicoPopulationLegendValues.map((value,index) => <g><circle cx={70+index*135} cy="524" r={mexicoPopulationRadius(value)} /><text x={70+index*135} y="572" text-anchor="middle">{value===1_000_000?'100万':value===5_000_000?'500万':'1,000万'}人</text></g>)}</g>
   </svg>
  </figure>
  <figure class="population-map-fallback" data-population-fallback hidden>
   <img class="population-fallback-image" data-population-fallback-image src={`${assetRoot}/density.svg`} width="900" height="580" alt="2020年の32州の人口密度。全州の値は下の表でも確認できます。" />
   <figcaption data-population-fallback-caption>地図の代替表示：全32州の分布。選んだ州の値は右側で確認できます。</figcaption>
  </figure>
  </div>
  </Fragment>
 <Fragment slot="legend">
  <section class="population-overview-reading" data-population-overview-reading hidden>
   {overviewGroups.map(category=><div data-population-overview-reading-category={category} hidden>
    <h2>{category==='religion'?'申告した宗教を、州内割合で読む':'言語と自己認識を分けて読む'}</h2>
    <p>{category==='religion'?'地図上の3色はカトリック、プロテスタント・福音系、無宗教それぞれの割合が高い州の位置を示します。色の濃さや面積で割合を表していません。':'先住民言語を話す人、アフロ系と自己認識する人、先住民と自己認識する人を別々に示します。同じ人が複数の指標に含まれるため、3つの人数や割合は足し合わせません。'}</p>
    {category==='religion'&&<p>8区分の個別詳細では、実割合と宗教別の階級を確認できます。相対的に割合が高い州と、人口の多数派であることは区別します。</p>}
    <h3>{category==='religion'?'8区分の全国値・個別詳細':'3指標の全国値・個別詳細'}</h3>
    <ul class="population-overview-values">{compositionData.metrics.filter(metric=>metric.category===category).map(metric=><li><button type="button" data-population-overview-metric={metric.id}>{metric.label}<span>{formatMexicoCompositionShare(mexicoCompositionNationalRecord(metric),metric)} · {formatMexicoPopulation(metric.nationalCount,metric.nationalStatus)}人</span></button></li>)}</ul>
    <p class="mexico-caption">統計：2020年。州境：2025年。公式定義・対象人口・推計の精度・出典は個別詳細で保持しています。</p>
   </div>)}
  </section>
  <section class="population-composition-hero" data-population-composition-hero hidden aria-live="polite">
   <p class="mexico-takeaway" data-population-composition-takeaway></p>
   <a class="mexico-comparison-link" data-population-composition-compare href={routes.population}>人数と割合を比べる</a>
   <a class="mexico-return" data-population-composition-return href={routes.population} hidden>元の指標に戻る</a>
   <div class="population-composition-selected">
    <h2 data-population-composition-selected-name></h2>
    <dl><div><dt data-population-composition-count-label>選択指標の人数</dt><dd><strong data-population-composition-count></strong> 人</dd></div><div><dt data-population-composition-share-label>州内の割合</dt><dd><strong data-population-composition-share></strong></dd></div><div><dt>割合の分母</dt><dd><span data-population-composition-denominator></span> 人</dd></div></dl>
    <p data-population-composition-confidence hidden></p>
   </div>
  </section>
  <div class="population-composition-key" data-population-composition-key hidden>
   <p class="population-key-title" data-population-composition-key-title></p>
   <div data-population-composition-share-key><p class="mexico-caption">色＝州内の割合（%）</p><ul class="mexico-legend" data-population-composition-color-key aria-label="選択指標の割合の凡例"></ul></div>
   <div data-population-composition-count-key><p class="mexico-caption" data-population-composition-count-note></p></div>
   <p class="mexico-caption" data-population-composition-key-universe></p>
  </div>
   <h2 data-population-map-heading>2020年、人口はどこに集まる？</h2>
  <div class="population-density-key" data-population-density-key>
   <p class="population-key-title">色＝人口密度（2020年、人/km²）</p>
   <ul class="mexico-legend" aria-label="人口密度の色の凡例">{mexicoDensityBins.map(bin => <li><i style={`background:${bin.color}`} aria-hidden="true"/>{bin.label}</li>)}</ul>
  </div>
  <div class="population-symbol-key" data-population-symbol-key hidden>
   <p class="population-key-title">円の面積＝人口（2020年）</p>
  </div>
   <details class="population-key-notes"><summary>表示州・統計と州境</summary><p class="mexico-caption" data-population-map-status aria-live="polite">2020年・全32州の平均密度。全国表示。</p><p class="mexico-caption population-source-caption">統計：2020年3月15日 ／ 州境：2025年。密度は公表値。</p></details>
 </Fragment>
 <Fragment slot="items">
  <details class="population-display-settings" data-population-display-settings>
   <summary>表示指標・州の詳細</summary>
   <div class="mexico-controls population-controls">
    <label>地図の指標<select data-population-view disabled><option value="locality">集落の人口分布（点・人数円）</option><option value="density" selected>州の人口密度（色）</option><option value="population">州の人口規模（円）</option></select></label>
    <label>州を詳しく見る<select data-population-state disabled><option value="" selected>全国・州を選ばない</option>{population.states.map(row => <option value={row.stateCode}>{row.nameJa}</option>)}</select></label>
   </div>
  </details>
  <button type="button" data-population-national>全国一覧へ</button>
  <label class="population-composition-selector" data-population-composition-selector hidden>統計の項目 <select data-population-composition-metric aria-label="民族・宗教の統計指標"></select></label>
  <label><input type="checkbox" data-population-only disabled /> <span data-population-only-label>選んだ州のデータだけ</span></label>
  <button type="button" data-population-reset disabled>州の選択を解除</button>
  <a class="population-scale-entry" data-population-scale-link href={`${routes.population}?view=density&compare=scale&sourceView=density`}>人口規模と密度を比べる</a>
 </Fragment>
 <Fragment slot="reading">
   <section class="locality-population-reading" data-locality-reading hidden>
    <div data-locality-geography>
     <h2>中央部の高地と都市・国境への集中</h2>
     <p>中央部の高地・メキシコシティ周辺に人口が集中し、グアダラハラやモンテレイにも大きな集積が見えます。</p>
     <p>北部は集落が広く点在し、ティフアナやシウダーフアレスなど、国境の拠点に人口が集まります。</p>
    </div>
    <figure class="mexico-metropolitan-comparison"><figcaption>主要3都市圏の人口規模（2020年・同一定義）</figcaption><div>{metropolitanAreas2020.map(area=><div class="mexico-metropolitan-row"><span>{area.name}</span><i aria-hidden="true"><b style={`width:${area.population/metropolitanAreas2020[0].population*100}%`}></b></i><strong>{area.population.toLocaleString('ja-JP')}人</strong></div>)}</div><p>棒の長さは都市圏人口に比例。地図の集落点や州人口の円とは集計範囲が異なります。<a href="https://www.gob.mx/cms/uploads/attachment/file/866951/Parte5.pdf">都市圏の公式資料</a></p></figure>
    <div data-locality-totals>
    <h2 data-locality-total-label>メキシコ全国の人口</h2>
    <p class="locality-population-total"><strong data-locality-total>126,014,024</strong> 人</p>
    <p>2020年3月15日。<span data-locality-total-localities>189,432</span>集落。<span data-locality-scope-note>州を選ばず全国で表示します。</span></p>
    </div>
    <section class="locality-population-key" data-locality-legend hidden>
     <h3>点と人数円の読み方</h3>
     <p><strong>橙色の円の面積＝人数</strong>。灰点は位置の目印です。1点が1人を表す図ではありません。</p>
     <svg data-locality-count-key viewBox="0 0 300 62" width="300" height="62" role="img" aria-label="人数円の凡例。地図と同じ面積尺度。"></svg>
     <p class="mexico-caption" data-locality-mode>近接集落を集約した人数円</p>
     <p class="mexico-caption">日本語の都市名と十字は位置の目印です。人数円の集計名や都市圏全体の人口を表すラベルではありません。</p>
     <details><summary>集約点と円の尺度</summary><p>縮小時は近接点の人口を合算し、人口で重み付けした平均位置に表示。拡大すると元の集落代表位置に分かれます。人数の合計は保持し、拡大率に合わせて円と凡例を同じ尺度で更新します。</p></details>
    </section>
    <p>都市周辺の大きい人数円と、その間に広がる集落を拡大して読みます。人口総数にはINEGIの公式補完推計も含みます。</p>
    <p class="mexico-caption">表示中の点に含まれる集落・人口：<span data-locality-visible-count>全国</span></p>
    <section class="locality-population-selection" data-locality-selection hidden aria-live="polite">
     <h3 data-locality-selected-name></h3><p><strong data-locality-selected-population></strong> 人</p>
     <p data-locality-selected-description></p><button type="button" data-locality-selection-zoom>この集約を拡大して集落を見る</button>
    </section>
    <details data-locality-ranked><summary>表示範囲の大きい点と値</summary><ul class="locality-population-list" data-locality-list></ul></details>
    <details><summary>点の位置・集計・原典</summary><p>元の点はINEGIが公表する集落代表座標です。住宅位置、集落の区域、連続した人口密度面を示していません。2020年の集落コードで集計し、背景の州境は2025年です。</p><p>日本語都市名は方位確認用です。6都市はINEGI ITERの都市代表点、メキシコシティはSMNのタクバヤ観測所の公表位置を目印にしています。集約セルの原名称と人数は点の選択詳細に残しており、市区やセルの人数を都市圏人口へ改名・再集計していません。</p><p>表示中の合計は、画面内に代表位置がある点・集約点に含まれる人数です。範囲境界の集約点には画面外の集落も含まれるため、画面の区域内人口ではありません。</p><p>全国・各市町村・各州の人口総計と照合済み。集計行と小集落まとめ行を、集落人口へ二重に加えていません。</p><p><a href={`${withBase('/assets/atlas/mexico-population-localities-v1/') }manifest.json`}>集落点の原典・集約・照合記録</a></p></details>
   </section>
   <p class="population-national-intro" data-population-national-intro><strong>全国 {formatMexicoPopulation(population.nationalPopulation)}人</strong>・公表密度 {formatMexicoDensity(population.nationalDensity)}人/km²（2020年）。{mexicoPopulationReading.takeaway}</p>
   <section class="population-composition-reading" data-population-composition-reading hidden aria-live="polite">
    <button type="button" class="population-composition-map-mode" data-population-composition-map-mode aria-pressed="false">この指標だけを州別の面で見る</button>
    <p class="population-composition-comparison-note" data-population-composition-comparison-note></p>
    <p data-population-composition-definition></p>
    <p class="mexico-caption">対象：<span data-population-composition-universe></span></p>
    <p data-population-composition-national></p>
    <details class="population-composition-source"><summary>定義・推計の精度・原典と加工</summary>
     <p data-population-composition-period></p><p data-population-composition-method></p><p data-population-composition-confidence-detail></p>
     <p>人数の円は同じ指標の全32州で共通の尺度です。指標が変わると人数の基準も変わるため、別の指標の円の大きさを直接比べません。0人・0%は有効な値です。欠測・秘匿・未取得は斜線で区別します。</p>
     <p><a data-population-composition-source href={compositionAssetRoot}>公式原典</a></p>
     <p><a href={`${compositionAssetRoot}/composition-2020.csv`}>全指標の配信値CSV</a> ／ <a href={`${compositionAssetRoot}/composition-2020.json`}>配信JSON（公式区間を含む）</a> ／ <a href={`${compositionAssetRoot}/manifest.json`}>原典・加工・照合記録</a></p>
    </details>
   </section>
   <h2 data-population-reading-heading>{mexicoPopulationReading.title}</h2>
   <section class="population-unavailable-reading" data-population-unavailable hidden aria-live="polite">
    <p class="mexico-takeaway" data-population-unavailable-heading>人種・民族の分布は未整備です。</p>
    <p data-population-unavailable-text>現在の地図は、2020年の州別人口を示す参考図です。人種・民族の構成や分布を示していません。</p>
   </section>
   <div class="population-state-summary" aria-live="polite">
    <p class="mexico-caption" data-population-reference-values hidden>参考：選択州の人口（2020年）</p>
   <p class="population-selected-name" data-population-selected-name>メキシコ全国</p>
   <dl><div><dt>人口・2020年</dt><dd><strong data-population-selected-population>{formatMexicoPopulation(population.nationalPopulation)}</strong> 人</dd></div><div><dt>全域の密度</dt><dd><strong data-population-selected-density>{formatMexicoDensity(population.nationalDensity)}</strong> 人/km²</dd></div></dl>
   </div>
   <div class="population-scale-reading" data-population-scale-reading hidden>
    <h3 data-population-scale-heading>人口規模 × 人口密度</h3>
   <p>{mexicoPopulationReading.scaleExplanation}</p>
   <a class="mexico-return" data-population-return href={`${routes.population}?view=density`}>メキシコ全国の人口密度に戻る</a>
  </div>
   <div data-population-distribution-reading>
   <p class="mexico-takeaway" data-population-region-heading>{mexicoPopulationReading.takeaway}</p>
  <p data-population-short-reading>メキシコ州は人口が最多、メキシコシティは密度が最高。人口規模と密度を重ねて読みます。</p>
  <a class="mexico-comparison-link" data-population-nature-link href={`${routes.nature}?view=relief&compare=population&sourceState=&sourceOnly=0&from=population&sourceView=density`}><strong data-population-nature-link-label>地形区分 × 人口密度</strong><br/><span data-population-nature-link-hint>中央部の高地・盆地と、人口が集まる州の位置を比べる</span></a>
  <a class="mexico-comparison-link" data-population-industry-link href={`${routes.industry}?compare=population&sourceState=&sourceOnly=0&from=population&sourceView=density`}><strong data-population-industry-link-label>州人口密度2020 × 州輸出額2025</strong><br/><span>人口の集積と、輸送機器・電子の輸出拠点が重なるかを比べる</span></a>
  <details class="population-reading-detail"><summary>地形 → 仕事・交通 → 人口の集積を読む</summary><p class="mexico-takeaway">{mexicoPopulationReading.mechanism}</p><p data-population-region-text>{initialReading.text}</p><p data-population-region-cause>{initialReading.cause}</p><p><a href={mexicoPopulationReadingSources.manufacturing}>米国商務省ITA：製造業の地域的な集積（2026年2月）</a><br/><a href={mexicoPopulationReadingSources.transport}>ITA：工業中心地・港・米国国境を結ぶ貨物鉄道（2026年2月）</a></p><p><a href={routes.agriculture}>農林業の生産分布と、暮らしを支える生産地へ</a></p></details>
  <details><summary>州平均・人口円・年をどう読む？</summary><p>{mexicoPopulationReading.densityMeaning}</p><p>{mexicoPopulationReading.populationMeaning}</p><p>人口と密度は2020年3月15日0時の州全域の値。密度は公表値を保持し、2025年表示州境の面積で再計算していません。</p><p>32州の人口・密度には欠測・秘匿値はありません。0、欠測、秘匿、未取得は別の状態として管理しています。</p></details>
   <noscript><p class="population-no-script">全32州の値を下の表で確認できます。地図と表は2020年の統計です。</p></noscript>
   </div>
