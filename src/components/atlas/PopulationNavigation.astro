---
import {populationViews} from '../../data/atlas/population';
import {populationVoteStates} from '../../data/atlas/population-focus';
const {active=false}=Astro.props;
---
<div class="population-controls" data-population-controls hidden={!active}>
 <nav aria-label="人口の表示" class="population-tabs">{populationViews.map(([id,label])=><button type="button" data-pop-view={id} aria-pressed={id==='distribution'}>{label}</button>)}</nav>
 <div class="population-filters" data-pop-filter="vote" hidden><label>注目州<select data-pop-vote-state><option value="">全国</option>{populationVoteStates.map(state=><option value={state.id}>{state.name}</option>)}</select></label></div>
 <p data-pop-status role="status">人口統計を読み込みます。</p><button type="button" data-pop-retry hidden>データの読み込みを再試行</button>
 <noscript><p>地図の切替と都市選択にはJavaScriptが必要です。人口密度の代替図と分類方法はこのまま読めます。</p></noscript>
</div>
