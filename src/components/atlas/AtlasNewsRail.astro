---
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/urls';
import { topics } from '../../data/taxonomy';
import { atlasNewsRegions, articleMatchesNewsRegion, type AtlasNewsRegion } from '../../scripts/atlas-news';

interface Props { region?: AtlasNewsRegion }
const {region='north-america'}=Astro.props;
const config=atlasNewsRegions[region];

// Only approved, public articles for this region belong in this rail.
const articles = (await getCollection('articles'))
  .filter(({data}) => articleMatchesNewsRegion(data,region))
  .sort((a,b) => Date.parse(b.data.publishedAt)-Date.parse(a.data.publishedAt) || a.data.slug.localeCompare(b.data.slug));
const rendered = await Promise.all(articles.map(async entry => ({entry, ...await render(entry)})));
---
<aside class="atlas-news" aria-labelledby="atlas-news-heading" data-news-rail data-news-region={region==='latin-america'?region:undefined} data-news-bounds={region==='latin-america'?config.bounds.join(','):undefined} data-pagefind-ignore="all">
  <header class="atlas-news-header">
    <p>NEWS & CONTEXT</p>
    <h2 id="atlas-news-heading">{config.label}のニュース</h2>
    <span>記事と地図を、並べて読む</span>
  </header>
  <div class="atlas-news-list" data-news-list tabindex="0" aria-label={`${config.label}のニュース一覧`}>
    <div class="atlas-news-count">新着順 <span>{articles.length} 件</span></div>
    {articles.length === 0 && <div class="atlas-news-empty">
      <span aria-hidden="true">＋</span>
      <h3>記事の追加を待っています</h3>
      <p>{config.label}に関連する公開記事を、ここに新着順で表示します。</p>
      <p>地図や各分野の解説は、右側で引き続き利用できます。</p>
    </div>}
    {articles.map(({data}) => <article class="atlas-news-card">
      <div class="atlas-news-meta"><time datetime={data.publishedAt}>{data.publishedAt.slice(0,10).replaceAll('-','.')}</time><span>{data.topics.map(topic=>topics[topic]).join('・')}</span></div>
      <h3><a href={withBase(`/articles/${data.slug}/`)} data-news-open={data.slug}>{data.title}</a></h3>
      <p>{data.summary}</p>
      <a class="atlas-news-read" href={withBase(`/articles/${data.slug}/`)} data-news-open={data.slug}>記事を読む <span aria-hidden="true">↗</span></a>
    </article>)}
  </div>
  <section class="atlas-news-reader" data-news-reader hidden aria-label="選んだニュース記事">
    <button type="button" data-news-close>← ニュース一覧へ</button>
    <div data-news-body></div>
  </section>
  <footer class="atlas-news-footer">ニュース欄は独立してスクロールできます</footer>
  {rendered.map(({entry:{data}, Content}) => {
    const [west,south,east,north]=config.bounds;
    const point = data.geography.mode==='map' ? data.geography.points.find(p=>p.longitude>=west&&p.longitude<=east&&p.latitude>=south&&p.latitude<=north) : undefined;
    return <template data-news-template={data.slug}>
      <time datetime={data.publishedAt}>{data.publishedAt.slice(0,10)}</time>
      <h2 tabindex="-1">{data.title}</h2>
      <p class="atlas-news-deck">{data.summary}</p>
      {point && <button type="button" data-news-location data-lng={point.longitude} data-lat={point.latitude}>関連地域を地図で見る：{point.label}</button>}
      <div class="atlas-news-prose"><Content /></div>
      <h3>出典</h3>
      <ul>{data.sources.map(source=><li id={`source-${source.id}`}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a> — {source.publisher}</li>)}</ul>
      <a href={withBase(`/articles/${data.slug}/`)}>記事のページを開く（地図・年表を含む）</a>
    </template>;
  })}
</aside>
<script>
  import { initAtlasNews } from '../../scripts/atlas-news';
  document.querySelectorAll<HTMLElement>('[data-news-rail]').forEach(initAtlasNews);
</script>
