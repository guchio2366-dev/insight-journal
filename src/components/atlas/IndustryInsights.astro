---
import {withBase} from '../../lib/urls';
import {industryInsights} from '../../data/atlas/industry-content';
import {industrySources} from '../../data/atlas/industry-regions';
import {subsectorLabel,type IndustrySector} from '../../data/atlas/industry-catalog';
const {active=false}=Astro.props;
const labels:Record<string,string>={knowledge:'技術人材を共有する産業','supply-chain':'車の生産を支える供給網','energy-chemistry':'採掘地と加工拠点は違う','food-agriculture':'農畜産から加工・設備へ','tourism-logistics':'同じ州でも都市の役割は違う','housing-jobs':'仕事の集積が住宅需要を生む'};
---
<section class="industry-map-insights" id="industry-insights" data-industry-insights hidden={!active} aria-labelledby="industry-insights-title">
 <h2 id="industry-insights-title">地域と産業のつながり</h2>
 <div class="industry-map-insight-list">
 {industryInsights.map(item=><details id={`industry-insight-${item.id}`} data-industry-insight-card={item.id}>
  <summary>{labels[item.id]}</summary>
  <div class="industry-map-insight-body"><p class="industry-insight-region">{item.region}</p><h3>{item.title}</h3><p>{item.text}</p>
   <nav class="industry-insight-links" aria-label={`${labels[item.id]}の関連分野`}>{item.links.map(([sector,subsector])=><a href={withBase(`/atlas/north-america/${sector==='agriculture'?'agriculture/':`industry/?sector=${sector}&subsector=${subsector}`}`)} data-industry-jump-sector={sector} data-industry-jump-subsector={subsector} data-industry-insight={item.id}>{sector==='agriculture'?'農畜産':subsectorLabel(sector as IndustrySector,subsector)}を見る</a>)}</nav>
   <a class="industry-source" href={industrySources[item.source].url}>根拠となる地域資料</a>
  </div>
 </details>)}
 </div>
</section>
