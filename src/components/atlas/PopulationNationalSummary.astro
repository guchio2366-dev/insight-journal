---
import {populationOverviews} from '../../data/atlas/population-reading';
import PopulationInsights from './PopulationInsights.astro';
---
<aside class="atlas-national population-national" aria-label="人口の分布と選択した場所の解説">
 <div class="population-reading-heading"><p class="atlas-eyebrow">UNITED STATES · 人口</p><button type="button" data-pop-reading-reset hidden>全国の解説へ</button></div>
 <PopulationInsights />
 <section id="population-city-reading" data-pop-reading tabindex="-1" aria-label="選択した項目の解説">
  <h2 data-pop-overview-title>{populationOverviews.distribution.title}</h2>
  <p class="population-key"><strong data-pop-key>{populationOverviews.distribution.text}</strong></p>
  <p data-pop-overview hidden>{populationOverviews.distribution.text}</p>
  <div data-pop-reading-body><h3>地図のどこを見る？</h3><p>{populationOverviews.distribution.reading}</p></div>
 </section>
 <a class="population-map-return" href="#nature-map-panel">↑ 地図と見比べる</a>
</aside>
