---
import { features, belongsToRegion, type CountryFeature, type RegionalId } from '../../data/atlas/regional-atlas';
import europe from '../../data/atlas/europe-countries.json';
import { europeRings } from '../../lib/atlas-europe-geometry';
import { withBase } from '../../lib/urls';

interface Props { availableRegions?: string[] }
const { availableRegions = [] } = Astro.props;
const regions = [
  { id:'north-america', label:'北米', href:'/atlas/north-america/', x:21, y:29, color:'#91b5c1' },
  { id:'latin-america', label:'中南米', href:'/atlas/latin-america/', x:31, y:69, color:'#aabe93' },
  { id:'europe', label:'欧州', href:'/atlas/europe/', x:53, y:24, color:'#b6aed1' },
  { id:'east-asia', label:'東アジア', href:'/atlas/asia/east-asia/', x:84, y:31, color:'#8ebfba' },
  { id:'south-central-asia', label:'南・中央アジア', href:'/atlas/asia/south-central-asia/', x:68, y:48, color:'#d7b57b' },
  { id:'southeast-asia', label:'東南アジア', href:'/atlas/asia/southeast-asia/', x:83, y:61, color:'#a8bd83' },
  { id:'africa', label:'アフリカ', href:'/atlas/africa/', x:53, y:60, color:'#d6a38d', optional:true },
  { id:'oceania', label:'オセアニア', href:'/atlas/oceania/', x:87, y:85, color:'#96bacd', optional:true },
].map((region, index) => ({ ...region, number:index + 1, available: !region.optional || availableRegions.includes(region.id) }));
const width = 960;
const height = 400;
// Equidistant cylindrical overview, 85°N to 65°S. Navigation only, not area comparison.
const project = ([longitude, latitude]: number[]) => [(longitude + 180) / 360 * width, (85 - latitude) / 150 * height];
const rings = (feature: CountryFeature) => feature.geometry.type === 'Polygon'
  ? feature.geometry.coordinates as number[][][]
  : (feature.geometry.coordinates as number[][][][]).flat();
const path = (coordinates: number[][][]) => coordinates.map(ring => ring.map((point, index) => {
  const [x, y] = project(point);
  return `${index ? 'L' : 'M'}${x.toFixed(2)},${y.toFixed(2)}`;
}).join('') + 'Z').join('');
const background = features.filter(feature => feature.properties.code !== 'ATA').map(feature => path(rings(feature)));
const europeCountries = europe.features.filter(feature => feature.properties.kind === 'europe');
function regionCountries(id: string) {
  if (id === 'europe') return europeCountries.map(feature => ({ code:feature.properties.code, d:path(europeRings(feature.geometry)) }));
  return features.filter(feature => {
    if (id === 'north-america') return ['CAN','USA','MEX'].includes(feature.properties.code);
    if (id === 'africa') return feature.properties.region === 'Africa';
    if (id === 'oceania') return feature.properties.region === 'Oceania';
    return belongsToRegion(feature, id as RegionalId);
  }).map(feature => ({ code:feature.properties.code, d:path(rings(feature)) }));
}
---
<section class="world-navigation" aria-label="世界地図から地域を選ぶ">
  <div class="world-frame">
    <svg data-atlas-world-map viewBox={`0 0 ${width} ${height}`} role="group" aria-labelledby="world-map-title world-map-description">
      <title id="world-map-title">地域を選んで開く世界地図</title>
      <desc id="world-map-description">色のついた地域を選ぶと、その地域の地図が開きます。地域名の一覧からも同じ地図へ移動できます。灰色の陸地は現在の掲載対象外です。</desc>
      <g class="world-context" aria-hidden="true">{background.map(d => <path d={d} fill-rule="evenodd" />)}</g>
      <g class="world-graticule" aria-hidden="true">
        {[-30,0,30,60].map(latitude => <line x1="0" x2={width} y1={project([0,latitude])[1]} y2={project([0,latitude])[1]} />)}
      </g>
      {regions.map(region => region.available ?
        <a href={withBase(region.href)} data-world-region={region.id} aria-label={`${region.label}の地図を開く`} style={`--region-color:${region.color}`}>
          <title>{region.label}の地図を開く</title>
          {regionCountries(region.id).map(country => <path data-world-country={country.code} d={country.d} fill-rule="evenodd" />)}
        </a> :
        <g class="world-pending" data-world-region={region.id} aria-label={`${region.label}・準備中`}>
          {regionCountries(region.id).map(country => <path data-world-country={country.code} d={country.d} fill-rule="evenodd" />)}
        </g>
      )}
    </svg>
    <div class="world-labels">
      {regions.map(region => region.available ?
        <a class="world-label" href={withBase(region.href)} style={`left:${region.x}%;top:${region.y}%;--region-color:${region.color}`} aria-label={`${region.label}の地図を開く`}>
          <span class="map-number">{region.number}</span><span class="map-name">{region.label}</span>
        </a> :
        <span class="world-label pending" style={`left:${region.x}%;top:${region.y}%`}>
          <span class="map-number">{region.number}</span><span class="map-name">{region.label}<small>準備中</small></span>
        </span>
      )}
    </div>
  </div>
  <nav class="world-region-list" aria-label="地域名から選ぶ">
    {regions.map(region => region.available ?
      <a class="atlas-region-link" href={withBase(region.href)} style={`--region-color:${region.color}`}>
        <span class="region-number">{region.number}</span><span>{region.label}</span><span class="open-arrow" aria-hidden="true">↗</span>
      </a> :
      <span class="atlas-region-pending"><span class="region-number">{region.number}</span><span>{region.label}</span><small>準備中</small></span>
    )}
  </nav>
  <details class="world-notes">
    <summary>地域の区分・地図の出典</summary>
    <p>北米はカナダ・米国・メキシコ。アジアは東アジア、東南アジア、南・中央アジアに分けています。ロシア西部は欧州の地図に含み、中東とロシアのその他の地域は掲載対象外です。</p>
    <p>境界：<a href="https://www.naturalearthdata.com/about/terms-of-use/">Natural Earth（パブリックドメイン）</a>。位置を選ぶための概略図で、小島などは省略しています。等距円筒図法を使用し、面積の比較には適しません。境界・名称は資料の表示上の区分に沿っています。</p>
  </details>
</section>
<style>
  .world-frame { position: relative; width: min(100%, 1120px); margin: 0 auto; border: 1px solid #d8e1df; background: #edf2f1; overflow: hidden; border-radius: 3px; }
  svg { display: block; width: 100%; height: auto; }
  path { stroke: #fbfaf6; stroke-width: .7; vector-effect: non-scaling-stroke; }
  .world-context path { fill: #d9ddd8; }
  .world-graticule { stroke: #c7d6d5; stroke-width: .6; stroke-dasharray: 3 5; pointer-events: none; }
  svg a path { fill: var(--region-color); cursor: pointer; }
  svg a:hover path, svg a:focus path { fill: #466c79; stroke: #183447; stroke-width: 1.3; }
  svg a:focus-visible { outline: none; }
  .world-pending path { fill: #d9ddd8; }
  .world-labels { position: absolute; inset: 0; pointer-events: none; }
  .world-label { position: absolute; display: flex; align-items: center; gap: 5px; transform: translate(-50%,-50%); min-height: 36px; padding: 4px 10px; border: 1px solid #8a9695; border-radius: 3px; background: #fffdf6; color: #192c39; font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap; box-shadow: 0 1px 3px #19253612; pointer-events: auto; }
  a.world-label:hover, a.world-label:focus-visible { background: #192c39; color: white; outline: 3px solid #b35335; outline-offset: 2px; }
  .map-number { display: none; }
  .pending { color: #687370; background: #f1f2ed; border-style: dashed; pointer-events: none; }
  .map-name small { margin-left: 5px; font-size: 10px; font-weight: 400; }
  .world-region-list { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 7px; margin-top: 12px; }
  .atlas-region-link, .atlas-region-pending { display: flex; align-items: center; gap: 9px; min-height: 44px; padding: 7px 11px; border: 1px solid var(--rule); background: var(--white); color: var(--ink); font-size: 13px; text-decoration: none; }
  .region-number { display: grid; place-items: center; flex: 0 0 22px; height: 22px; background: var(--region-color, #e3e6e2); color: #18303e; font-size: 11px; font-weight: 700; border-radius: 50%; }
  .open-arrow { margin-left: auto; color: var(--ink-soft); }
  .atlas-region-link:hover { border-color: #466c79; background: #f0f4f2; }
  .atlas-region-link:focus-visible { outline: 3px solid #b35335; outline-offset: 2px; }
  .atlas-region-pending { color: var(--ink-soft); background: transparent; border-style: dashed; }
  .atlas-region-pending small { margin-left: auto; font-size: 10px; }
  .world-notes { margin-top: 12px; color: var(--ink-soft); font-size: 11px; }
  .world-notes summary { cursor: pointer; min-height: 32px; padding-top: 6px; }
  .world-notes p { max-width: 85ch; margin: 8px 0; line-height: 1.8; }
  @media (max-width: 600px), (max-height: 600px) {
    .world-region-list { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 6px; margin-top: 10px; }
    .world-label { width: 28px; height: 28px; min-height: 28px; justify-content: center; padding: 0; border-radius: 50%; font-size: 12px; }
    .map-name { display: none; }
    .map-number { display: block; }
    .atlas-region-link, .atlas-region-pending { gap: 7px; padding: 6px 9px; font-size: 12px; }
  }
  @media (max-height: 600px) and (min-width: 601px) {
    .world-navigation { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(0,1fr); gap: 10px 14px; align-items: start; }
    .world-frame { width: 100%; min-width: 0; }
    .world-region-list { margin-top: 0; }
    .world-notes { grid-column: 1 / -1; margin-top: 0; }
  }
</style>
