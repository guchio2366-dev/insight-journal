---
import {projectCanadaMap,canadaLegacyPoint} from '../../lib/atlas-canada-map-presentation';
import CanadaMapLand from './CanadaMapLand.astro';
import {densityColor} from '../../scripts/atlas-canada-population-overview';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtlasRegionNavigation from './AtlasRegionNavigation.astro';
import AtlasWorkspaceFrame from './AtlasWorkspaceFrame.astro';
import NorthAmericaCountryFieldNavigation from './NorthAmericaCountryFieldNavigation.astro';
import CanadaDemographicReading from './CanadaDemographicReading.astro';
import CanadaDemographicSources from './CanadaDemographicSources.astro';
import data from '../../data/atlas/canada/population.json';
import ethnicity from '../../data/atlas/canada/profile-ethnicity.json';
import religion from '../../data/atlas/canada/profile-religion.json';
import geometry from '../../data/atlas/canada/population-geometry.json';
import industry from '../../data/atlas/canada/industry.json';
import rivers from '../../data/atlas/canada/rivers.json';
import lakes from '../../data/atlas/canada/lakes.json';
import {features} from '../../data/atlas/regional-atlas';
import {formatCanadaPopulationValue as fmt,populationDensityColors} from '../../lib/atlas-canada-population';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-canada-nature.css';
import '../../styles/atlas-canada-agriculture.css';
import '../../styles/atlas-canada-population.css';
const path='/atlas/north-america/canada/',asset='/assets/atlas/canada-population-v1/',nature=(query='')=>withBase(`${path}nature/${query}`);
const project=projectCanadaMap;
const line=(points:number[][],closed=true)=>points.map((p,i)=>{const [x,y]=project(p);return `${i?'L':'M'}${x.toFixed(3)},${y.toFixed(3)}`;}).join('')+(closed?'Z':'');
function geometryPath(g:any):string {if(g.type==='Polygon')return g.coordinates.map((r:number[][])=>line(r)).join('');if(g.type==='MultiPolygon')return g.coordinates.flat().map((r:number[][])=>line(r)).join('');if(g.type==='LineString')return line(g.coordinates,false);if(g.type==='MultiLineString')return g.coordinates.map((r:number[][])=>line(r,false)).join('');return '';}
const max=Math.max(...data.cmas.map(r=>r.population[2021].value??0)),canada=data.national.find(r=>r.id==='Canada')!;
const geo=data.cmas.map(r=>({...geometry.features.find(g=>g.id===r.id)!,name:r.name,population:r.population[2021],density:r.density2021.value}));
const statisticCell=(v:{value:number|null;symbol:string},density=false,area=false)=>v.value===null?'未公表':density?fmt(v.value,'density'):v.value.toLocaleString('ja-JP',{minimumFractionDigits:area?2:0,maximumFractionDigits:area?2:1});
const sources={cma:'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=9810000301',national:'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=9810000101',boundary:'https://www12.statcan.gc.ca/census-recensement/2021/geo/sip-pis/boundary-limites/files-fichiers/lcma000b21a_e.zip',definition:'https://www12.statcan.gc.ca/census-recensement/2021/ref/dict/az/Definition-eng.cfm?ID=geo009',urban:'https://www150.statcan.gc.ca/n1/daily-quotidien/220209/dq220209b-eng.htm',transport:'https://tc.canada.ca/en/corporate-services/transparency/corporate-management-reporting/transportation-canada-annual-reports/transportation-canada-2024/role-canada-s-transportation-network'};
const natureTargets={climate:nature('?city=ottawa&compare=vancouver'),water:nature('?city=ottawa&view=water&water=Lake%20Ontario&only=1&frame=140,340,760,240'),landform:nature('?city=ottawa&view=landform')};
import '../../styles/atlas-canada-country-parity.css';
---
<BaseLayout title="カナダの人口｜都市圏・人口集団・宗教" description="41 CMAの人口・密度と、2021年の人口集団・宗教の割合と人数を比較し、都市圏への集中と構成の違いを読む。" compactAtlas>
 <AtlasWorkspaceFrame region="north-america" mapActions={false}>
  <article class="canada-nature canada-population" data-canada-population data-population-selection="national">
   <div class="atlas-explorer atlas-workspace canada-country-primary" data-field="population">
   <div class="atlas-compact-heading"><nav aria-label="パンくず"><a href={withBase('/atlas/')}>地図から見る</a> / <a href={withBase('/atlas/north-america/')}>北米地図</a></nav><span>カナダ</span></div>
   <AtlasRegionNavigation group="americas" current="north-america" country="canada" />
   <h1 class="visually-hidden">カナダの都市圏人口・人口集団・宗教</h1>
   <NorthAmericaCountryFieldNavigation country="canada" field="population" />
   <nav class="country-topic-tabs" aria-label="人口の分野"><button type="button" data-population-topic="distribution" aria-pressed="true">人口分布</button><button type="button" data-population-topic="ethnicity" aria-pressed="false">人種・民族</button><button type="button" data-population-topic="religion" aria-pressed="false">宗教</button></nav>
   <p class="population-coverage-brief" data-population-coverage-brief>2021年・293統計地域と41都市圏。地域未選択、南部を初期表示。</p>

   <div class="canada-workspace atlas-primary-grid population-workspace">
    <section class="canada-map-column atlas-map-column" aria-label="都市圏の地図と選択">

     <div class="atlas-map-frame canada-map-frame population-map-frame"><svg class="canada-map population-map" data-population-map tabindex="0" viewBox="0 0 900 580" role="group" aria-labelledby="canada-population-title canada-population-desc">
      <title id="canada-population-title">カナダの41都市圏、2021年境界</title><desc id="canada-population-desc">南部を初期表示。色は都市圏の人口密度、輪郭は2021年CMA境界。自治体境界ではありません。都市圏を選ぶと隣の比較が更新されます。図にない場所の人口をゼロとする地図ではありません。</desc>
      <CanadaMapLand />
      {lakes.features.map(f=><g class="population-lake"><path class="canada-lake" d={geometryPath(f.geometry)} fill-rule="evenodd"><title>Ontario湖（オンタリオ湖）</title></path></g>)}
      {rivers.features.filter(f=>f.properties.name==='St. Lawrence').map(f=><path class="canada-river" d={geometryPath(f.geometry)}><title>セントローレンス川</title></path>)}
      <defs data-population-concentration-patterns></defs>
      <g data-population-regions></g>
      <g data-religion-region-symbols aria-hidden="true"></g>
      {geo.map(g=><g data-population-map-cma={g.id} role="button" tabindex="0" aria-label={`${g.name}都市圏を選ぶ`} aria-pressed="false"><title>{g.name}都市圏、2021年 {fmt(g.population.value)}人{g.population.symbol?' '+g.population.symbol:''}</title><path data-population-boundary style={`fill:${densityColor(g.density)}`} d={g.rings.map(r=>line(r)).join('')} fill-rule="evenodd" /><circle class="population-anchor" cx={canadaLegacyPoint(g.point)[0]} cy={canadaLegacyPoint(g.point)[1]} r="1.8"/><circle data-population-symbol cx={canadaLegacyPoint(g.point)[0]} cy={canadaLegacyPoint(g.point)[1]} r={g.population.value===null?0:Math.sqrt(g.population.value/max)*22} style="display:none"/><text data-population-label x={canadaLegacyPoint(g.point)[0]+7} y={canadaLegacyPoint(g.point)[1]-7} style={['535','462','933'].includes(g.id)?undefined:'display:none'}>{g.name.match(/（(.+)）/)?.[1]??g.name}</text></g>)}
      <g data-religion-map-callouts aria-hidden="true"></g>

     </svg><div class="population-map-tools"><button data-population-reset>南部</button><button data-population-whole>全域</button><button data-population-scale="in" aria-label="地図を拡大">＋</button><button data-population-scale="out" aria-label="地図を縮小">−</button></div></div>
     <div class="population-category-key" data-population-category-key></div>
     <div class="population-legend" data-population-population-legend hidden><svg viewBox="0 0 280 56" role="img" aria-label="人口総数の円、100万人と500万人。2016年と2021年で同じ尺度"><circle cx="25" cy="25" r={Math.sqrt(1000000/max)*22}/><circle cx="160" cy="25" r={Math.sqrt(5000000/max)*22}/><text x="45" y="31">100万人</text><text x="190" y="31">500万人</text></svg><span>円の面積が人口総数。両年は共通尺度。輪郭の広さは人口の多さではありません。</span></div>
     <ul class="population-density-legend" data-population-density-legend hidden aria-label="2021年人口密度の凡例">{['50未満','50–150未満','150–300未満','300–600未満','600以上'].map((label,i)=><li><i style={`background:${populationDensityColors[i]}`} aria-hidden="true"/>{label}</li>)}<li>人/km²・都市圏全体</li></ul>
     <div data-demographic-share-legend hidden><p class="canada-caption" data-demographic-origin-legend hidden></p><ul class="population-density-legend" data-demographic-share-classes aria-label="選んだ集団の割合の色と区間"></ul><p class="canada-caption">%・各都市圏の私的世帯人口が分母。集団ごとに色の目盛が変わります。灰色は欠測・秘匿。</p></div>
     <div class="population-legend" data-demographic-count-legend hidden><svg viewBox="0 0 280 56" role="img" aria-label="選んだ集団の人数、10万人と100万人。集団間は共通尺度"><circle cx="25" cy="25" data-demographic-legend-count="100000"/><circle cx="160" cy="25" data-demographic-legend-count="1000000"/><text x="45" y="31">10万人</text><text x="190" y="31">100万人</text></svg><span>円の面積が集団の人数。両分野・全集団で共通尺度。公表0と欠測を区別します。</span></div>
          <p class="canada-caption population-coverage" data-population-coverage>2021年の41都市圏を収録。都市圏外の細かな地域データは本サイトでは未収録です。空白は人口ゼロではありません。</p>
     <p class="canada-caption" data-population-filter-key hidden></p>


     <p class="canada-caption" data-population-map-status aria-live="polite"></p>
     <details><summary>都市から解説を選ぶ</summary><div class="population-place-buttons">{data.cmas.map(r=><button data-population-locate={r.id}>{r.name.match(/（(.+)）/)?.[1]??r.name}</button>)}</div></details>
    </section>
    <aside class="canada-reading atlas-national population-reading" aria-label="人口比較と集中の理由">
   <div data-population-distribution-reading>
   <header class="canada-national-header"><p class="atlas-eyebrow">Canada · Population</p><h2>都市圏に集まる、カナダの人口</h2><p class="canada-lead" data-population-distribution-lead>人口は南部の都市圏に集中し、交通・仕事・住まいのつながりが、その集中と広がりを支えている。</p></header>

     <h2 data-population-distribution-heading>全国の人口分布</h2>
     <div class="population-main-reading" data-demographic-return-container hidden><p data-demographic-origin-comparison></p><p><a data-demographic-return href={withBase(`${path}population/`)}>元の集団比較へ戻る</a> / <a data-demographic-context-clear href={withBase(`${path}population/`)}>照合を閉じる</a></p><p>色は集団の割合、円は全住民の人口。分母が異なる2つの値を、同じ都市圏で比べます。</p></div>
     <p class="population-comparison" data-population-comparison aria-live="polite">2021年の全国人口 {fmt(canada.population[2021].value)}人。41都市圏に{data.cmaShare2021.toFixed(1)}%が住んでいます。</p>
     <p class="population-change" data-population-change hidden></p>
     <p class="population-main-reading population-reading-links" data-population-comparison-links hidden><a href={withBase(`${path}industry/?year=2025&province=Ontario&metric=services`)} data-population-industry-link={withBase(`${path}industry/`)}>都市圏人口と、対応する州の産業構成を照合する</a><br/><a href={natureTargets.water} data-population-nature-link={natureTargets.water}>自然環境：Ontario湖を分離し、南部の水域位置を確かめる</a></p>
     <p class="population-summary">人口密度は人口を陸地面積で割った値です。広い郊外を含む都市圏平均と、州より細かい統計地域（CD）の平均を区別して読みます。CDと都市圏は重なり、人口を足し合わせません。</p>
     <details class="population-background"><summary>場所 → 交通と仕事 → 人口集中</summary><p>地図のTorontoとMontréalは五大湖・セントローレンス側、Vancouverは太平洋側にあります。オンタリオ・ケベックの交通回廊や西岸の港は、産業と市場をつなぐ場所です。人の集中は気候だけでなく、仕事への移動や住宅にも関わります。</p><div class="population-place-buttons"><button data-population-locate="535">Torontoを拡大</button><button data-population-locate="462">Montréalを拡大</button><button data-population-locate="933">Vancouverを拡大</button></div></details>
     <details class="population-more"><summary>都市の広がり・移動と、自然や農畜林業との関係</summary><p>2016–2019年に移住してきた人の9割超はCMAに居住しました。2016→2021年には中心部と郊外の両方で人口が増え、住宅供給・価格や通勤時間も居住場所に関わっています。人口が増えると交通・住宅・サービスの整備が必要になり、都市の拡大は農地などの利用へも影響します。これは当時の分析で、2026年現在の人口・移民動向を示す数値ではありません。</p><p><a href={sources.urban}>Statistics Canadaの2016→2021年分析</a> / <a href={sources.transport}>Transport Canada 2024年交通報告</a></p><p><button data-population-locate="505">Ottawa–Gatineauを拡大</button>は州をまたぐ1都市圏です。首都Ottawaの自治体だけの人口とは区別します。</p><p><a href={natureTargets.climate} data-population-nature-link={natureTargets.climate}>首都OttawaとVancouver：2地点の気温と雨の季節を比較</a>。観測所の気候と、都市圏全体の人口を同じ対象としません。<a href={natureTargets.landform} data-population-nature-link={natureTargets.landform}>地形：南部の低地・西部の山地の位置を確認</a>。</p><p><button data-population-locate="602">Winnipegの都市圏</button>と<button data-population-locate="705">Reginaの都市圏</button>を図で確かめ、<a href={withBase(`${path}agriculture/wheat/`)}>小麦の産地・輸送・需要</a>、<a href={withBase(`${path}agriculture/`)}>カノーラの生産と加工</a>へ。<a href={withBase(`${path}agriculture/beef/`)}>肉牛の草地・飼料・管理</a>、<a href={withBase(`${path}agriculture/forestry/`)}>森林と木材加工</a>も、自然条件と人の活動を分けて読みます。</p></details>
   </div>
   <CanadaDemographicReading /><details data-population-composition hidden><summary data-population-composition-title></summary><p data-population-composition-note></p><table><thead><tr><th>区分</th><th>割合</th><th>人数</th></tr></thead><tbody data-population-composition-rows></tbody></table><details data-religion-source-detail hidden><summary>原表の23末端区分と人数</summary><table><thead><tr><th>原表の区分</th><th>割合</th><th>人数</th></tr></thead><tbody data-religion-source-rows></tbody></table></details></details>
    </aside>
   </div>
   </div>

   <details class="population-tables" data-population-distribution-table id="canada-population-comparisons"><summary>41都市圏・全国と13州準州の数値、年・記号を確認</summary>
    <p>人口は人、密度は2021年の人/km²、陸地面積は2021年km²。2016年人口は原表の改定値を保持し、2021年境界で比較します。rは改定、空欄の記号は記号なし。未公表値は0で補いません。2016年人口を選んでも境界は2021年のままです。センサス人口と年次の人口推計は異なります。</p>
    <div class="canola-table-scroll"><table class="canola-stats population-stats"><caption>41 CMA・Statistics Canada 98-10-0003-01</caption><thead><tr><th>都市圏</th><th>2016年人口<br/>人</th><th>2021年人口<br/>人</th><th>2016→2021<br/>増減%</th><th>2021年密度<br/>人/km²</th><th>2021年陸地<br/>km²</th></tr></thead><tbody>{data.cmas.map(r=><tr data-population-row={r.id}><th>{r.name}{r.notes.includes(2)&&<small> ※</small>}<span class:list={['canola-bar-track',{'is-missing':r.population[2021].value===null}]} aria-label={`${r.name}: ${fmt(r.population[2021].value)}人`}><span data-population-bar style={`width:${(r.population[2021].value??0)/max*100}%`} /></span></th>{[2016,2021].map(y=><td data-population-cell={y} class:list={{'is-current-metric':y===2021}}>{fmt(r.population[y as 2016|2021].value)}{r.population[y as 2016|2021].symbol&&<small> {r.population[y as 2016|2021].symbol}</small>}</td>)}<td>{statisticCell(r.changePercent)}{r.changePercent.symbol&&<small> {r.changePercent.symbol}</small>}</td><td data-population-cell="density">{statisticCell(r.density2021,true)}{r.density2021.symbol&&<small> {r.density2021.symbol}</small>}</td><td>{statisticCell(r.landAreaKm2,false,true)}{r.landAreaKm2.symbol&&<small> {r.landAreaKm2.symbol}</small>}</td></tr>)}</tbody></table></div>
    <div class="canola-table-scroll"><table class="canola-stats"><caption>全国・13州準州・Statistics Canada 98-10-0001-01（都市圏表と重複する人口を加算しません）</caption><thead><tr><th>地域</th><th>2016年人口<br/>人</th><th>2021年人口<br/>人</th><th>2016→2021<br/>増減%</th><th>2021年密度<br/>人/km²</th><th>2021年陸地<br/>km²</th></tr></thead><tbody>{data.national.map(r=><tr data-population-national={r.id}><th>{r.name}{r.notes.includes(2)&&<small> ※</small>}</th>{[2016,2021].map(y=><td>{fmt(r.population[y as 2016|2021].value)}{r.population[y as 2016|2021].symbol&&<small> {r.population[y as 2016|2021].symbol}</small>}</td>)}<td>{statisticCell(r.changePercent)}{r.changePercent.symbol&&<small> {r.changePercent.symbol}</small>}</td><td>{statisticCell(r.density2021,true)}{r.density2021.symbol&&<small> {r.density2021.symbol}</small>}</td><td>{statisticCell(r.landAreaKm2,false,true)}{r.landAreaKm2.symbol&&<small> {r.landAreaKm2.symbol}</small>}</td></tr>)}</tbody></table></div>
    <p>※ 原表の地理注記2：不完全に調査された保留地・集落のデータを含みません。この影響により、対象地域の2016→2021年変化は厳密な比較にならないことがあります。注記と原表の記号をCSVにも保持しています。都市圏の白い外側にも人は住んでおり、この図は全居住地の分布図ではありません。</p>
    <p><a href={sources.cma}>都市圏原表と注記</a> / <a href={sources.national}>全国・州準州原表と注記</a> / <a href={withBase(`${asset}population-selected.csv`)}>抽出CSV</a></p>
   </details>
   <details class="canada-source-footer population-source-footer" id="canada-population-sources"><summary>出典・利用条件・境界の加工と検証</summary>
    <p lang="en">Adapted from Statistics Canada, Table 98-10-0003-01, Population and dwelling counts: Census metropolitan areas, census agglomerations and census subdivisions (municipalities), and Table 98-10-0001-01, Population and dwelling counts: Canada, provinces and territories, 2021 Census of Population, reference years 2016 and 2021 (accessed September 30, 2026). This does not constitute an endorsement by Statistics Canada of this product.</p>
    <p>人口・密度・陸地面積：<a href={sources.cma}>98-10-0003-01</a>、<a href={sources.national}>98-10-0001-01</a>、2022年2月9日公表。<a href="https://www.statcan.gc.ca/en/terms-conditions/open-licence">Statistics Canada Open Licence</a>に基づく抽出・日本語化・表示。55地域×5指標の原値と直後のSymbols列、地理注記を保持。2026年9月30日取得。全国の2021年人口36,991,981人と41都市圏合計27,281,119人から73.7%を計算しています。</p>
    <p lang="en">Contains information licensed under the Open Government Licence – Canada.</p>
    <p>都市圏輪郭：<a href={sources.boundary}>Statistics Canada 2021 Census cartographic boundary file, lcma000b21a_e.zip</a>。地理基準日2021年1月1日、<a href="https://open.canada.ca/en/open-government-licence-canada">OGL–Canada</a>（原ZIP内XMLで確認）。EPSG:3347 / GRS 1980のLambert座標を経緯度へ変換し、元座標で最大250mの表示簡略化を行いました。元の2,519輪郭を保持、Ottawa–Gatineauの2州分割を1都市圏にまとめています。面積・密度を輪郭から推計せず原表値を使用。表示は気候区分と共通のメルカトル投影です。地図上の面積は人口の多さを表しません。</p>
    <p>位置整合：ECCCのOttawa・Vancouver・Winnipeg・Reginaの公開観測所位置が対応する原都市圏内に入ること、EPSG:3347往復変換、元輪郭と穴の維持を検証しています。観測所を都市圏代表気候とする検証ではありません。<a href={withBase(`${asset}population-boundaries.geojson`)}>簡略化都市圏境界</a> / <a href={withBase(`${asset}manifest.json`)}>出典・方法・ハッシュ・検証台帳</a>。</p>
    <p>下地は気候区分の国土輪郭と共通です（気候区分の出典台帳参照）。周辺国・河川・湖：Natural Earth v5.1.2、public domain、河川と湖1:50mの概形。<a href="https://www.naturalearthdata.com/about/terms-of-use/">利用条件</a>。国の外形は都市圏原図と精度が異なり、行政境界や河川の詳細を読む図ではありません。</p>
    <p>説明：<a href={sources.definition}>2021 Census DictionaryのCMA定義</a>、<a href={sources.urban}>Statistics Canada 2022年2月9日分析（2016→2021年）</a>、<a href={sources.transport}>Transport Canada 2024年交通報告（2025年公表）</a>を要約。本文・地図・統計の対象年を区別し、人口の原因を地図の位置だけから推計していません。</p>
   </details>
   <CanadaDemographicSources />
   <noscript><p>南部41都市圏の2021年人口密度図、全国の分布概要、本文・全55地域の数値表・出典を読めます。人口集団と宗教は末尾の全国原人数と定義を確認できます。選択・分野の切替、拡大、履歴やURLからの復帰にはJavaScriptが必要です。</p></noscript>
