---
import type { AtlasInsight, AtlasPlace } from "../../data/atlas/north-america-agriculture";
import {
  agricultureField,
  contextLand,
  cropOverlapPath,
  geometry,
  insights as defaultInsights,
  mapLabels,
  physicalFeatures,
  places as defaultPlaces,
  zones as defaultZones
} from "../../data/atlas/north-america-agriculture";
import { withBase } from "../../lib/urls";

interface Props {
  places?: AtlasPlace[];
  insights?: AtlasInsight[];
  mapHref: string;
  reportHref: string;
}

const { places = defaultPlaces, insights = defaultInsights, mapHref: _mapHref, reportHref } = Astro.props;
const zones = defaultZones;
const mapLabelInsights = insights.filter((insight) => insight.placement === "map-label" && insight.mapLabel);
const states = geometry.states;
const overlapPath = cropOverlapPath;
const payload = JSON.stringify({ field: agricultureField, places, zones, insights }).replace(/</g, "\\u003c");
const cropName = (cropId: keyof typeof agricultureField.cropLabels) => agricultureField.cropLabels[cropId];
---

<section
  class="atlas-workspace"
  data-atlas-root
  data-base={withBase("/").replace(/\/$/, "")}
  data-report-base={withBase(reportHref)}
  aria-labelledby="atlas-map-title"
>
  <div class="atlas-workspace-head">
    <div>
      <p class="eyebrow">Map view · North America · Agriculture</p>
      <h1 id="atlas-map-title">北米の農業</h1>
      <p class="atlas-lede">州を塗り分けるのではなく、地形・水・気候に沿った作物域として読む。</p>
    </div>
    <div class="atlas-head-meta">
      <span class="atlas-status-chip">{agricultureField.dataStatus}</span>
      <span>更新 {agricultureField.updatedAt.replace(/-/g, ".")}</span>
    </div>
  </div>

  <div class="atlas-map-layout">
    <div class="atlas-map-column">
      <div class="atlas-map-card">
        <div class="atlas-map-card-head">
          <div>
            <p class="eyebrow">Regional crop zones</p>
            <h2>主要栽培域（概略）</h2>
          </div>
          <p class="atlas-coverage">収録範囲：{agricultureField.coverage}</p>
        </div>
        <div class="atlas-map-frame">
          <svg
            class="atlas-map-svg"
            viewBox={geometry.viewBox}
            role="img"
            aria-labelledby="atlas-svg-title atlas-svg-desc"
            data-atlas-svg
          >
            <title id="atlas-svg-title">北米の主要栽培域と物理地理</title>
            <desc id="atlas-svg-desc">山地・河川・湖沼を薄く示した地図に、州境をまたぐ六種類の主要栽培域を重ねている。色の面を選ぶと、その地域のインサイトが開く。</desc>
            <defs>
              <pattern id="atlas-zone-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
                <line x1="0" y1="0" x2="0" y2="8" stroke="#334455" stroke-width="1" opacity="0.22" />
              </pattern>
              <filter id="atlas-zone-shadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="1" stdDeviation="1.5" flood-color="#243746" flood-opacity="0.16" />
              </filter>
            </defs>
            <rect class="atlas-map-ocean" x="0" y="0" width="1200" height="620" rx="12" />
            <g class="atlas-context-layer" aria-hidden="true">
              {contextLand.map((land) => <path class="atlas-context-land" d={land.path}><title>{land.label}</title></path>)}
            </g>
            <g class="atlas-terrain-layer" aria-hidden="true">
              {physicalFeatures.filter((feature) => feature.kind === "terrain").map((feature) => <path class="atlas-terrain-band" d={feature.path}><title>{feature.label}</title></path>)}
            </g>
            <g class="atlas-state-reference" aria-hidden="true">
              {states.map((state) => <path class="atlas-state-reference-path" d={state.path} />)}
              {states.map((state) => <text class="atlas-state-reference-label" x={state.labelX} y={state.labelY}>{state.nameJa}</text>)}
            </g>
            <g class="atlas-zone-layer">
              {zones.map((zone) => (
                <path
                  class={`atlas-zone atlas-zone--${zone.cropIds[0]}`}
                  d={zone.path}
                  style={`--zone-color: ${agricultureField.cropColors[zone.cropIds[0]]}`}
                  data-zone-id={zone.id}
                  tabindex="0"
                  role="button"
                  aria-pressed="false"
                  aria-label={`${zone.nameJa}。${zone.cropIds.map(cropName).join("・")}`}
                >
                  <title>{zone.nameJa}：{zone.cropIds.map(cropName).join("・")}</title>
                </path>
              ))}
              <path class="atlas-zone-overlap" d={overlapPath} aria-hidden="true" />
            </g>
            <g class="atlas-hydro-layer" aria-hidden="true">
              {physicalFeatures.filter((feature) => feature.kind === "lake").map((feature) => <path class="atlas-lake" d={feature.path}><title>{feature.label}</title></path>)}
              {physicalFeatures.filter((feature) => feature.kind === "river").map((feature) => <path class="atlas-river" d={feature.path}><title>{feature.label}</title></path>)}
            </g>
            <g class="atlas-zone-label-layer" aria-hidden="true">
              {zones.map((zone) => <text class={`atlas-zone-label atlas-zone-label--${zone.cropIds[0]}`} x={zone.labelX} y={zone.labelY}>{zone.label}</text>)}
            </g>
            <g class="atlas-map-label-layer" aria-hidden="true">
              {mapLabels.map((label) => <text class={`atlas-map-label atlas-map-label--${label.kind}`} x={label.x} y={label.y}>{label.text}</text>)}
            </g>
          </svg>
          <div class="atlas-map-key" aria-label="地図の操作案内">
            <span><b class="atlas-key-swatch atlas-key-swatch--zone"></b>色の面をタップ・クリック</span>
            <span><b class="atlas-key-swatch atlas-key-swatch--border"></b>州境・州名は位置確認用</span>
            <span><b class="atlas-key-swatch atlas-key-swatch--overlap"></b>重なりは輪作・複合域の入口</span>
          </div>
        </div>

        <div class="atlas-legend" aria-label="作物域の凡例">
          {agricultureField.cropOrder.map((cropId) => (
            <span class="atlas-legend-item">
              <b
                class={`atlas-legend-swatch atlas-legend-swatch--${cropId}`}
                style={`--legend-color: ${agricultureField.cropColors[cropId]}`}
                aria-hidden="true"
              ></b>
              {agricultureField.cropLabels[cropId]}
            </span>
          ))}
        </div>

        <p class="atlas-map-note">{agricultureField.dataNote}</p>
      </div>

      {mapLabelInsights.length > 0 && (
        <section class="atlas-reading-points" aria-labelledby="atlas-reading-points-title">
          <div class="atlas-subheading">
            <p class="eyebrow">Reading points</p>
            <h2 id="atlas-reading-points-title">地図の読みどころ</h2>
          </div>
          <div class="atlas-reading-point-list">
            {mapLabelInsights.map((insight) => (
              <button type="button" class="atlas-reading-point" data-insight-id={insight.id}>
                <span>{insight.title}</span><b aria-hidden="true">↗</b>
              </button>
            ))}
          </div>
        </section>
      )}

      <section class="atlas-zone-directory" aria-labelledby="atlas-zone-directory-title">
        <div class="atlas-subheading">
          <p class="eyebrow">Regional index</p>
          <h2 id="atlas-zone-directory-title">地域から選ぶ</h2>
        </div>
        <div class="atlas-zone-list">
          {zones.map((zone) => (
            <button type="button" data-zone-id={zone.id}>
              <span>{zone.nameJa}</span>
              <small>{zone.cropIds.map(cropName).join("・")}</small>
            </button>
          ))}
        </div>
        <details class="atlas-state-reference-list">
          <summary>州名は位置確認用に見る</summary>
          <p>州境は作物域の境界ではありません。地図上の位置を逆算するための補助情報です。</p>
          <div>{states.map((state) => <span>{state.nameJa}</span>)}</div>
        </details>
      </section>
    </div>

    <aside class="atlas-insight-panel" data-atlas-panel aria-live="polite">
      <div class="atlas-panel-empty" data-atlas-empty>
        <p class="eyebrow">Select a regional zone</p>
        <h2>色の面を選ぶと、<br />その土地の事情が開く。</h2>
        <p>地形・河川・州境を手がかりに、作物域を一つ選んでください。解説は選択後も画面に残ります。</p>
      </div>
      <div class="atlas-panel-content" data-atlas-content hidden></div>
      <p class="atlas-selection-status" data-atlas-status role="status">地域を選択していません</p>
    </aside>
  </div>

  <p class="atlas-source-note">州境：Natural Earth 1:110m。山地・河川・湖沼：Natural Earthの物理地理資料を参照。作物域：USDA資料を読み合わせた編集概略。出典と更新方針は<a href={withBase(reportHref)}>詳述ページ</a>に記載。</p>
  <script type="application/json" data-atlas-payload set:html={payload}></script>
</section>

<script is:inline src={withBase("/scripts/atlas.js")} defer></script>
