---
import rawCensus from '../../data/atlas/canada/census-agriculture.json';
import readings from '../../data/atlas/canada/agriculture-major-reading.json';
import supplement from '../../data/atlas/canada/agriculture-provincial-supplement.json';
import {combineCanadaAgricultureSources} from '../../lib/atlas-canada-agriculture-supplement';
import {canadaAgricultureProducts as products,canadaAgricultureSymbolOffset,canadaAgricultureMarkerPath} from '../../lib/atlas-canada-agriculture-products';
const census=combineCanadaAgricultureSources(rawCensus,supplement);
import geography from '../../data/atlas/regional-countries.json';
import rawGeometry from '../../../public/assets/atlas/canada-census-agriculture-v1/ccs.geojson?raw';
import {buildCanadaAgricultureOverviewModel,canadaAgricultureOverviewColors as colors,canadaAgricultureOverviewNames as names} from '../../lib/atlas-canada-agriculture-overview';
import {canadaMapPath,projectCanadaMap} from '../../lib/atlas-canada-map-presentation';
import type {CanadaCensusCollection} from '../../lib/atlas-canada-census-map';
import {withBase} from '../../lib/urls';
import '../../styles/atlas-canada-agriculture-overview.css';
const context={type:'FeatureCollection',features:geography.features.filter(feature=>['CAN','USA','GRL'].includes(feature.properties.code))} as CanadaCensusCollection;
const model=buildCanadaAgricultureOverviewModel(census,JSON.parse(rawGeometry),context),ids=model.ids;
const config={...model,readings,legacyUrls:{canola:withBase('/atlas/north-america/canada/agriculture/?item=canola'),wheat:withBase('/atlas/north-america/canada/agriculture/wheat/'),beef:withBase('/atlas/north-america/canada/agriculture/beef/')},dataUrl:withBase('/assets/atlas/canada-census-agriculture-v1/census-agriculture.json'),geometryUrl:withBase(census.geometry.url),supplementUrl:withBase('/assets/atlas/canada-agriculture-major-v1/provincial-supplement.json')};
const percent=(group:string,id:string)=>model.summaries.find(item=>item.id===group)!.values[id].nationalShare.toFixed(1);
const maxima=Object.fromEntries(ids.map(id=>[id,Math.max(...census.provinces.map(p=>p.cells[id].value??0))]));

const abbreviations:Record<string,string>={'10':'NL','11':'PE','12':'NS','13':'NB','24':'QC','35':'ON','46':'MB','47':'SK','48':'AB','59':'BC','60':'YT','61':'NT','62':'NU'};
// AAFC's published 2019–2023 average cash-receipt series. Potatoes and lentils are outside this comparable top-ten chart.
const farmReceipts=[{id:'canola',name:'カノーラ',billions:11.7},{id:'beef',name:'肉牛・子牛',billions:11.2},{id:'wheat',name:'小麦',billions:9.6},{id:'dairy',name:'生乳',billions:7.7},{id:'pork',name:'豚',billions:5.6},{id:'soybeans',name:'大豆',billions:3.5},{id:'chicken',name:'鶏肉',billions:3.4},{id:'corn',name:'とうもろこし',billions:3.0}];
---
<div class="canada-agri-overview" data-canada-agri-overview data-canola-country-map>
  <div class="canada-workspace atlas-primary-grid">
   <section class="map-column canada-map-column atlas-map-column" aria-label="主要10品目と飼料・土地利用の同時分布">
    <div class="map-frame atlas-map-frame canada-map-frame" id="canada-agri-map-frame">
<svg class="overview-fallback" data-overview-fallback viewBox="0 0 900 580" role="img" aria-label="主要10品目と飼料・土地利用の州別公表値。指標・年・数値は凡例と表に記載。">
<rect width="900" height="580" fill="#e4eff0"/>
{context.features.map(feature => <path d={canadaMapPath(feature.geometry)} fill="#efeee5" stroke="#94aaaa" stroke-width=".6"/>)}
{model.labels.map(label => { const [x,y]=projectCanadaMap(label.labelAnchor); const province=census.provinces.find(p=>p.code===label.id)!; return <g transform={`translate(${x} ${y})`}><title>{label.name}</title>{ids.map((id,index)=>{const cell=province.cells[id];const [dx,dy]=canadaAgricultureSymbolOffset(index,ids.length);return <g transform={`translate(${dx} ${8+dy})`}><title>{names[id]}：{cell.status==='not-covered'?'対象外・未収録':cell.status==='quality-f'?'非公表 F':cell.value!.toLocaleString('ja-JP')+' '+census.products[id].unit}</title>{cell.status==='published'?<path d={canadaAgricultureMarkerPath(products[id].shape)} fill={cell.value!>0?colors[id]:'#fff'} opacity={cell.value!>0?.25+.75*cell.value!/maxima[id]:1} stroke={colors[id]}/>:<path d={cell.status==='quality-f'?'M-3,-3L3,3M-3,3L3,-3':'M-3,0H3'} stroke="#718389" stroke-width="1"/>}</g>;})}<text y="-6" text-anchor="middle" fill="#36535b" font-size="14">{abbreviations[label.id]}</text></g>;})}
</svg>
<canvas id="canada-agri-map" role="group" tabindex="0" aria-label="主要10品目と飼料・土地利用の州別概観・CCS地図" aria-describedby="canada-agri-map-note canada-agri-map-status">地図と同じ地域別数値を、下の一覧と地域選択から読めます。</canvas>
<div class="labels" id="canada-agri-labels" aria-hidden="true">
</div>
    <div class="map-stories" id="canada-agri-map-stories" aria-label="州公表値で確認できる分布の特徴"></div>
    <div class="map-crop-labels" id="canada-agri-crop-labels" aria-hidden="true"></div>
<div class="map-focus" id="canada-agri-map-focus" hidden>地図操作中：矢印で移動、＋−で拡大縮小</div>
<div class="map-tools" aria-label="地図の操作">
<button id="canada-agri-zoom-in" aria-label="地図を拡大">＋</button>
<button id="canada-agri-zoom-out" aria-label="地図を縮小">−</button>
<button id="canada-agri-focus-region" disabled>地域へ</button>
<button id="canada-agri-reset">全国へ</button>
<button id="canada-agri-south">南部へ</button>
</div>
<span class="map-year">色面：2021年CCS別申告値／豚：2025年版</span>
</div>
    <div class="key" role="group" aria-label="指標の凡例と強調">
<button data-metric="" aria-pressed="true">全分布</button>
<span class="key-family">作物・飼料の面積</span>{ids.filter(id=>products[id].kind==='crop'||products[id].kind==='land').map(id=><button data-metric={id} aria-pressed="false" title={`${census.products[id].label}：${census.products[id].unitLabel}`}><i class={`shape ${products[id].shape}`} style={`--color:${colors[id]}`} aria-hidden="true"/>{names[id]}</button>)}
<span class="key-family">畜産</span>{ids.filter(id=>products[id].kind==='livestock').map(id=><button data-metric={id} aria-pressed="false" title={`${census.products[id].label}：${census.products[id].unitLabel}`}><i class={`shape ${products[id].shape}`} style={`--color:${colors[id]}`} aria-hidden="true"/>{id==='beef'?'肉牛':id==='dairy'?'乳牛':names[id]}</button>)}
<span class="meaning" id="canada-agri-display-meaning">色面は2021年CCSで申告面積が最も大きい主要作物。実際の畑の輪郭ではありません。公表0・非公表・未収録は下の一覧で区別します。</span>
</div>
    <div id="canada-agri-story-dock"></div>
    <p class="source-note" data-agri-resolution-note>作物・牛と飼料・土地利用は2021年センサス。鶏は2021年の州別生産者数、豚はAAFC 2025年版の3州の全国頭数比です。豚・鶏のCCS値を配分・推計しません。</p>
    <p id="canada-agri-map-note" class="note">
<strong>色面は農場の本拠地があるCCSの2021年申告面積です。</strong>色の境界は耕地・農場の輪郭ではありません。個別品目を選ぶと公表値の大小を示し、豚・鶏は州単位のまま表示します。</p>
    <div class="region-controls">
<label for="canada-agri-region">地域を読む</label>
<select id="canada-agri-region" aria-label="統計地域CCSを選ぶ">
<option value="">全国・地域未選択</option>
</select>
<button id="canada-agri-clear-region">解除</button>
</div>
    <p id="canada-agri-map-status" class="status" aria-live="polite">主要10品目と飼料・土地利用の州別公式値を概観しています。地域未選択。</p>
<nav class="canada-crop-tabs" aria-label="品目別の原図と解説"><a data-canola-select-item="canola" href={withBase('/atlas/north-america/canada/agriculture/?item=canola')}>カノーラの解説</a><a href={withBase('/atlas/north-america/canada/agriculture/wheat/')}>小麦の解説</a><a href={withBase('/atlas/north-america/canada/agriculture/beef/')}>肉牛・放牧と飼料</a></nav>
   </section>
   <aside class="reading canada-reading atlas-national" data-canola-overview-reading aria-label="分布と数値の読み方">
<section class="canada-agri-receipts" aria-label="主要品目の農場現金収入"><h2>農業を支える販売収入</h2><p>カノーラ、肉牛、小麦が大きな柱です。下の棒は各品目の農場現金収入で、畑の面積や飼養頭数ではありません。</p><div class="canada-agri-receipt-bars">{farmReceipts.map(item=><button type="button" data-agri-reading-product={item.id} aria-label={`${item.name}、年平均${item.billions}十億カナダドルの説明を見る`}><span>{item.name}</span><i style={`--receipt-color:${colors[item.id]};--receipt-size:${(item.billions/11.7*100).toFixed(1)}%`} aria-hidden="true"/><strong>{item.billions.toFixed(1)}</strong></button>)}</div><p class="source-note">2019〜2023年の年平均、十億CAD。<a href="https://agriculture.canada.ca/en/department/transparency/briefing-documents/aafc-transition-books/overview-agriculture-and-agri-food-sector-deputy-minister-transition-book-2024-aafc">AAFC／Statistics Canada</a>。同じ資料に比較値のないレンズ豆・ばれいしょは棒に含めず、地図と解説には残します。</p></section>
<p class="eyebrow" id="canada-agri-reading-eyebrow">主要品目の産地と用途</p>
<h2 id="canada-agri-reading-title">穀物・飼料と畜産を重ねて読む</h2>
<div id="canada-agri-distribution-overview">
<p class="key-sentence"><strong>西部の穀物・豆類、東部の飼料と畜産、東西の加工向けばれいしょを比べると、産地と市場のつながりが見えます。</strong></p>
<section class="distribution-section"><h3>プレーリー：穀物・豆と肉牛</h3><p>プレーリー3州はカノーラ面積の{percent('prairie','canola')}％、小麦面積の{percent('prairie','wheat')}％を占めます。冷涼な季節に育つ作物でも、成熟までの期間、水分・排水、輪作を合わせる管理が必要です。内陸の収穫物は加工と鉄道・港を通じて市場につながります。</p><button data-agri-reading-product="canola">カノーラを読む</button> <button data-agri-reading-product="lentils">レンズ豆を読む</button></section>
<section class="distribution-section"><h3>東部：とうもろこし・大豆と酪農</h3><p>オンタリオ・ケベックには、とうもろこし面積の{percent('east','corn')}％、乳牛頭数の{percent('east','dairy')}％があります。茎葉も利用するサイレージは牛の飼料になり、作物と畜産の分布を重ねると農業の組合せを読めます。</p><button data-agri-reading-product="corn">とうもろこしを読む</button> <button data-agri-reading-product="dairy">酪農を読む</button></section>
<section class="distribution-section"><h3>ばれいしょ：産地と加工工場</h3><p>プリンスエドワード島などの大西洋岸と、マニトバ・アルバータに産地が分かれます。作付け前の契約、貯蔵、産地近くの加工工場が、フライドポテトなどの海外供給を支えます。</p><button data-agri-reading-product="potatoes">ばれいしょを読む</button></section>
<details><summary>穀物・草地と肉牛の分布</summary>
<section class="distribution-section"><h3>プレーリーの穀物・カノーラ</h3><p>アルバータ・サスカチュワン・マニトバに、カノーラ面積の<strong>{percent('prairie','canola')}％</strong>、小麦面積の<strong>{percent('prairie','wheat')}％</strong>が集まります。</p></section>
<section class="distribution-section"><h3>西部の母牛・放牧地</h3><p>アルバータ・サスカチュワンで、肉用母牛頭数の<strong>{percent('west','beef')}％</strong>、放牧地面積の<strong>{percent('west','pasture')}％</strong>を占めます。</p></section>
<section class="distribution-section"><h3>東部にも干草が広がる</h3><p>オンタリオ・ケベックには、干草・栽培牧草面積の<strong>{percent('east','hay')}％</strong>、小麦面積の<strong>{percent('east','wheat')}％</strong>があります。干草は東部だけの指標ではなく、西部にも広く分布します。</p></section></details>
</div>
<p id="canada-agri-reading-intro" class="source-note">割合は同じ指標の全国公表値に対する比です。面積と頭数の量を相互比較しません。</p>
<p id="canada-agri-selection-reading" class="source-note" hidden></p>
<details><summary>地図の色面と統計地域</summary><p class="source-note">初期の色面は、同じ2021年・面積haの主要作物6品目から、各CCSで申告面積が最大の品目を示します。1,000 ha未満、0、非公表、未収録は初期の色面にしません。レンズ豆・ばれいしょの小点は、それぞれ公表値が1万ha・1,000ha以上のCCSの表示用基点です。各CCSを実際の耕地の輪郭として描いていません。</p><p class="source-note">選んだ品目は個別の公表値で濃淡表示します。牛の印は2021年に頭数の大きいCCSの表示用基点です。豚・鶏は州公表値のまま印で示し、CCSに配分しません。元の1,757 CCSの値・品質・成分を保持し、公表0・非公表F・未収録は地域選択と下の表で区別します。</p></details>
<details class="overview-original-reading"><summary>農畜産・林業の解説へ</summary><p>プレーリーの作物・草地と森林の広がりを、栽培・家畜・加工へつなげて読む。</p><p>農畜産は作物の生育、放牧と冬の飼料を、林業は森林被覆と木材の加工活動を分けて比べます。自然条件に加え、管理・輸送・用途を確かめます。</p><p><a data-canola-select-item="canola" href={withBase('/atlas/north-america/canada/agriculture/?item=canola')}>カノーラ：プレーリーの面積と油の加工</a><br/><a href={withBase('/atlas/north-america/canada/agriculture/wheat/')}>小麦：生育期間・用途と輸送</a><br/><a href={withBase('/atlas/north-america/canada/agriculture/beef/')}>肉牛：放牧地と冬の飼料</a><br/><a href={withBase('/atlas/north-america/canada/agriculture/forestry/')}>林業：森林被覆と木材・紙製品の加工</a></p><p class="canada-caption">各項目の資料年・単位は異なります。未収集の品目をゼロとして表示しません。</p></details></aside>
  </div>
<section class="statistics" id="canada-agri-statistics" aria-label="補助統計">
<details id="canada-agri-statistics-detail"><summary>補助統計：全国・選択CCSの主要10品目・補助指標と品質</summary>
<table>
<caption id="canada-agri-table-caption">全国の公表値（各指標の年・対象範囲は定義欄）</caption>
<thead>
<tr>
<th scope="col">指標</th>
<th scope="col">公表値</th>
</tr>
</thead>
<tbody id="canada-agri-values">{ids.map(id=><tr data-value={id}><th scope="row">{id==='beef'?'肉用母牛':id==='dairy'?'乳牛':id==='chicken'?'鶏肉生産者':names[id]}</th><td>{census.products[id].national.value.toLocaleString('ja-JP')} {census.products[id].national.unit??census.products[id].unit}</td></tr>)}</tbody>
</table>
<p class="source-note" id="canada-agri-quality-note">全国値は原表の公表値です。地域値を足して全国値に置き換えません。</p>
<details>
<summary>品質・収録範囲</summary>
<div id="canada-agri-scales">
</div>
<p class="source-note">ゼロは白抜き、Fは×、対象外・未収録は−の小記号です。Fは品質上の理由による非公表です。選択や拡大をしても他の指標を残します。</p>
</details>
<details>
<summary>主要10品目と飼料・土地利用の定義・原表・成分の品質</summary>
<div id="canada-agri-definitions">
</div>
<div id="canada-agri-components">
</div>
</details>
<details>
<summary>地図の出典・地域集計・利用条件</summary>
<div id="canada-agri-sources">
</div>
</details>
</details>
</section>
  <details class="list" aria-label="CCS別公表値一覧"><summary>地域一覧：全1,757 CCSの公表値・品質</summary>
<div class="list-title">
<h2>地域一覧：CCS指標を並べる</h2>
<label>
<input id="canada-agri-search" type="search" placeholder="地域名・CCSコード・州名" aria-label="地域名・CCSコード・州名で探す">
</label>
</div>
<div class="agri-table-scroll" tabindex="0" aria-label="全指標の地域表を横スクロール"><table>
<thead>
<tr>
<th scope="col">地域名・州</th>
{ids.filter(id=>census.products[id].resolution==='ccs').map(id=><th scope="col">{id==='beef'?'肉用母牛':id==='dairy'?'乳牛':names[id]}<small>{census.products[id].unit}</small></th>)}
</tr>
</thead>
<tbody id="canada-agri-rows">
</tbody>
</table></div>
<div class="pager">
<button id="canada-agri-previous">前へ</button>
<span id="canada-agri-page-status">
</span>
<button id="canada-agri-next">次へ</button>
</div>
</details>
  <div class="page-source" id="canada-agri-page-source">出典：<a href={census.source.url}>Statistics Canada, Census of Agriculture, 2021</a>。作物・牛は2021年センサス。豚と鶏は<a href={supplement.products.pork.sourceTableUrl}>AAFCの豚在庫比率</a>・<a href={supplement.products.chicken.sourceTableUrl}>2021年の鶏肉生産者数</a>。</div>

<details class="overview-scope"><summary>主要10品目の採用根拠と次点</summary><p>販売規模、国際供給、産地の特徴を合わせた主要な食料・飼料品目の選定です。面積・頭数・輸出額を混ぜた数量順位ではありません。放牧地は品目に数えず、干草とともに補助表示に残します。</p><p>カノーラ・小麦・肉牛・酪農・豚・鶏肉・大豆・とうもろこしは、AAFCの2019–2023年平均現金収入の上位群。ばれいしょは2024年の収入と加工品を含む輸出、レンズ豆は国際供給とサスカチュワンへの集中を重視しました。</p><p>次点はえんどう、続いて大麦・干草・えん麦・亜麻。えんどうの2024/25年度輸出量はレンズ豆より多く、レンズ豆を輸出量順位で選んだわけではありません。野菜全体など複数品目の合計や大麻を含む公式収入順位とは範囲が異なります。</p><p><a href="https://agriculture.canada.ca/en/department/transparency/briefing-documents/aafc-transition-books/overview-agriculture-and-agri-food-sector-deputy-minister-transition-book-2024-aafc">AAFCの収入構成</a> ／ <a href="https://agriculture.canada.ca/en/sector/horticulture/reports/potato-market-information-review-2024-2025">ばれいしょの市場統計</a> ／ <a href="https://agriculture.canada.ca/en/sector/crops/reports-statistics/canada-outlook-principal-field-crops-2026-09-25">豆類の供給・輸出</a></p></details>
<noscript><p>拡大・地域選択・地域一覧の操作にはJavaScriptが必要です。州別概観と全国値、品目別の原図・解説はこのまま読めます。<a href={config.dataUrl}>全地域の元データ</a>から値・品質・成分を確認できます。</p></noscript>
<script type="application/json" data-canada-agri-overview-config set:html={JSON.stringify(config).replace(/</g,'\\u003c')} />
</div>
<script>import {initCanadaAgricultureDistribution} from '../../scripts/atlas-canada-agriculture-distribution';const root=document.querySelector<HTMLElement>('[data-canada-agri-overview]');if(root)initCanadaAgricultureDistribution(root);</script>
