---
import { withBase } from "../../lib/urls";

interface Props {
  active: "map" | "report";
  mapHref: string;
  reportHref: string;
  label?: string;
}

const { active, mapHref, reportHref, label = "北米農業" } = Astro.props;
const items = [
  { key: "map", label: "地図", href: mapHref },
  { key: "report", label: "詳述", href: reportHref }
] as const;
---

<nav class="atlas-tabs" aria-label={`${label}の表示切替`}>
  {items.map((item) => (
    <a
      class:list={["atlas-tab", { "atlas-tab--active": item.key === active }]}
      href={withBase(item.href)}
      aria-current={item.key === active ? "page" : undefined}
    >
      <span>{item.key === "map" ? "01" : "02"}</span>
      <strong>{item.label}</strong>
    </a>
  ))}
</nav>
