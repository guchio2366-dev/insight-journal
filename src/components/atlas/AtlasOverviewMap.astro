---
import { contextLand, geometry, mapLabels, physicalFeatures } from "../../data/atlas/north-america-agriculture";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["atlas-overview-card", { "atlas-overview-card--compact": compact }]}>
  <div class="atlas-map-card-head">
    <div>
      <p class="eyebrow">Shared geographic base</p>
      <h2>北米の地理的な土台</h2>
    </div>
    <p class="atlas-coverage">州境・山地・河川・湖沼</p>
  </div>
  <div class="atlas-overview-frame">
    <svg class="atlas-map-svg atlas-overview-svg" viewBox={geometry.viewBox} role="img" aria-labelledby="atlas-overview-title atlas-overview-desc">
      <title id="atlas-overview-title">北米の物理地理と州境</title>
      <desc id="atlas-overview-desc">カナダ・メキシコを含む地理的文脈に、米国本土の州境、山地、河川、湖沼を薄く示した共通土台。</desc>
      <rect class="atlas-map-ocean" x="0" y="0" width="1200" height="620" rx="12" />
      <g class="atlas-context-layer" aria-hidden="true">
        {contextLand.map((land) => <path class="atlas-context-land" d={land.path}><title>{land.label}</title></path>)}
      </g>
      <g class="atlas-terrain-layer" aria-hidden="true">
        {physicalFeatures.filter((feature) => feature.kind === "terrain").map((feature) => <path class="atlas-terrain-band" d={feature.path}><title>{feature.label}</title></path>)}
      </g>
      <g class="atlas-state-reference" aria-hidden="true">
        {geometry.states.map((state) => <path class="atlas-state-reference-path" d={state.path} />)}
        {geometry.states.map((state) => <text class="atlas-state-reference-label" x={state.labelX} y={state.labelY}>{state.nameJa}</text>)}
      </g>
      <g class="atlas-hydro-layer" aria-hidden="true">
        {physicalFeatures.filter((feature) => feature.kind === "lake").map((feature) => <path class="atlas-lake" d={feature.path}><title>{feature.label}</title></path>)}
        {physicalFeatures.filter((feature) => feature.kind === "river").map((feature) => <path class="atlas-river" d={feature.path}><title>{feature.label}</title></path>)}
      </g>
      <g class="atlas-map-label-layer" aria-hidden="true">
        {mapLabels.map((label) => <text class={`atlas-map-label atlas-map-label--${label.kind}`} x={label.x} y={label.y}>{label.text}</text>)}
      </g>
    </svg>
  </div>
  <p class="atlas-overview-caption">分野を切り替えても、この地理的な土台の上に情報を重ねます。</p>
</div>
