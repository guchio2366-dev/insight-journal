---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PopulationCulture from './PopulationCulture.astro';
import {russiaCulture} from '../../data/atlas/russia-culture';
import russiaGeography from '../../data/atlas/russia-countries.json';
import russiaDisputed from '../../data/atlas/russia-disputed-areas.json';
import {russiaPath,projectRussia,russiaWidth,russiaHeight} from '../../lib/atlas-russia-geometry';
import RussiaNewsRail from './RussiaNewsRail.astro';
import '../../styles/atlas-explorer.css';
import '../../styles/atlas-desktop.css';
import {withBase} from '../../lib/urls';
import {
 russiaFields,russiaRegions,russiaLayers,russiaThemes,russiaOverviewReadings,
 createRussiaState,getRussiaLayer,getRussiaTheme,
 renderRussiaScene,renderRussiaLegend,russiaCoverage,getRussiaComparisonReading,russiaBoundarySources,getRussiaFarmingGeography,
} from '../../data/atlas/russia-learning';
import '../../styles/atlas-russia-learning.css';
import {renderRussiaWorkspaceLegend} from '../../scripts/atlas-russia-learning';
import {russiaWheatWorldShare} from '../../data/atlas/russia-wheat-world-share';
import {russiaFarmingProductCandidates} from '../../data/atlas/russia-farming-products';
type RussiaField=keyof typeof russiaFields;
interface Props {field?:RussiaField;overview?:boolean}
const {field='nature',overview=false}=Astro.props;
const state={...createRussiaState('',overview?'population':field),scope:'all' as const};
if(overview){state.layer='cities';state.compareLayer='density';}
const mainFields=[{id:'overview',label:'概要'},{id:'agriculture',label:'農林業'},{id:'nature',label:'自然環境'},{id:'industry',label:'主要産業'},{id:'population',label:'人口'}];
const hierarchy=overview?[]:field==='agriculture'?[{label:'農畜産',ready:true},{label:'林業',ready:false}]:field==='nature'?[{label:'気候区分',ready:true},{label:'水資源',ready:false},{label:'地形',ready:false},{label:'標高',ready:false}]:field==='industry'?[]:[{label:'人口分布',ready:true},{label:'人種・民族',ready:false},{label:'宗教',ready:false}];
const theme=getRussiaTheme(state);
const fieldOverview=russiaOverviewReadings[field];
const layer=getRussiaLayer(state.layer,state);
const comparison=getRussiaLayer(state.compareLayer,state);
const fieldThemes=russiaThemes.filter(t=>t.field===field);
const industryEntryLabels:Record<string,string>={'northern-resources':'鉱業・加工','markets-and-port':'都市・港湾'};
const fieldLayers=overview?russiaLayers.filter(l=>l.id==='cities'):russiaLayers.filter(l=>l.field===field);
const scopeOptions=[{id:'all',label:'全体'},{id:'theme',label:'テーマ'},{id:'region',label:'選択地域'}];
const wheatShareAxis=[0,5,10,15];
const wheatShareX=(index:number)=>44+index*105;
const wheatShareY=(share:number)=>111-share/15*78;
const wheatSharePath=russiaWheatWorldShare.map((point,index)=>`${index?'L':'M'} ${wheatShareX(index)} ${wheatShareY(point.share)}`).join(' ');
const wheatNumber=new Intl.NumberFormat('ja-JP',{maximumFractionDigits:1});
const wheatUseRows=[{label:'輸出',millionTonnes:39.5},{label:'食用・種子・工業用',millionTonnes:23.5},{label:'飼料・残差',millionTonnes:18.0}];
const cultureMap=`<defs><pattern id="culture-russia-disputed" width="9" height="9" patternUnits="userSpaceOnUse"><path d="M0 9L9 0" style="fill:none;stroke:#455d65;stroke-width:1"/></pattern></defs>`+russiaGeography.features.map(f=>`<path d="${russiaPath(f.geometry)}" fill-rule="evenodd"/>`).join('')+russiaDisputed.features.map(f=>`<path class="culture-dispute" d="${russiaPath(f.geometry)}" fill-rule="evenodd"><title>Natural Earthの係争区分</title></path>`).join('');
const usdaWheatUrl='https://apps.fas.usda.gov/newgainapi/api/Report/DownloadReportByFileName?fileName=Grain+and+Feed+Annual_Moscow_Russian+Federation_04-15-2021';
---
<BaseLayout title={overview?'ロシア｜概要':`ロシア｜${russiaFields[field].label}`} description={overview?'ロシアの都市と地域を確かめ、4分野の分布を読む':russiaFields[field].title} compactAtlas>
 <div class="russia-workspace" data-russia-learning data-field={overview?'population':field} data-russia-overview={overview?'true':undefined}><div class="russia-desktop-shell" data-atlas-shell><RussiaNewsRail /><article class="russia-learning atlas-explorer" data-field={overview?'regional-overview':field}>
  <header class="russia-learning-heading"><div class="russia-learning-title"><p class="russia-learning-breadcrumb"><a href={withBase('/atlas/')}>地図から見る</a> / <a href={withBase('/atlas/russia/')}>ロシア</a></p><h1 class="visually-hidden">{overview?'ロシアの概要と都市・地域':russiaFields[field].title}</h1></div><span class="russia-header-scope">ロシア全域</span>   <button type="button" class="russia-learning-return" data-return>← {layer.title}へ戻る：ロシア全域</button>   <label class="russia-learning-compare-layer">並べる分布<select data-compare-layer>{russiaLayers.map(item=><option value={item.id} selected={item.id===comparison.id}>{item.title}</option>)}</select></label></header>
  <div class="russia-region-controls" class:list={{'russia-overview-region-controls':overview}}><div class="russia-regional-navigation"><nav class="russia-region-tabs" aria-label="地図の地域"><a href={withBase('/atlas/')}>世界の地域</a><a href={withBase('/atlas/russia/')} aria-current="page">ロシア</a></nav><nav class="russia-region-countries" aria-label="ロシアの学習地域">{!overview&&field!=='agriculture'&&russiaRegions.map(region=><button type="button" data-map-place={region.code} data-region-option={region.code}>{region.name}</button>)}   <label class="russia-learning-place">学習地域<select data-place><option value="all" selected={state.place==='all'}>ロシア全域</option>{russiaRegions.map(region=><option value={region.code} selected={region.code===state.place}>{region.name}</option>)}</select></label></nav></div></div>
  <nav class="russia-learning-fields atlas-tabs atlas-tabs-with-overview" aria-label="ロシアの分野">{mainFields.map(item=><a href={withBase(item.id==='overview'?'/atlas/russia/':`/atlas/russia/${item.id}/`)} data-russia-overview-link={item.id==='overview'?'':undefined} data-field-link={item.id==='overview'?undefined:item.id} aria-current={(overview?item.id==='overview':item.id===field)?'page':undefined}>{item.label}</a>)}</nav>
  {!overview&&field!=='agriculture'&&<div class="russia-subcontrols" hidden={field==='population'}>{field==='industry'?<nav class="russia-subtabs russia-industry-categories" aria-label="主要産業の代表例">{fieldThemes.map(item=><button type="button" data-theme={item.id} title={item.title} aria-pressed="false">{industryEntryLabels[item.id]??item.title}</button>)}</nav>:<nav class="russia-subtabs" style={`--sub-count:${hierarchy.length}`} aria-label="分野の項目">{hierarchy.map(item=>item.ready?<button type="button" aria-pressed="true">{item.label}</button>:<button type="button" disabled>{item.label}<small>未整備</small></button>)}</nav>}{field==='industry'&&<p class="russia-control-note">一次資料で確認した代表位置 <a href="#russia-statistics">資料・統計へ</a></p>}{field==='population'&&<div class="russia-population-meta"><p class="russia-control-note">人種・民族・宗教：未整備。2020年人口・2025年都市範囲。市の行政人口とは異なります。</p><label class="russia-population-layer">人口分布<select data-distribution-layer>{fieldLayers.map(item=><option value={item.id} selected={item.id===layer.id}>{item.title}</option>)}</select></label></div>}</div>}
  {!overview&&field==='population'&&<><nav class="culture-topic-controls" aria-label="人口・社会の項目"><button type="button" data-population-topic="distribution" aria-pressed="true">人口分布</button><button type="button" data-population-topic="ethnicity" aria-pressed="false">民族・収録状況</button><button type="button" data-population-topic="religion" aria-pressed="false">宗教</button></nav><PopulationCulture data={russiaCulture} map={cultureMap} width={russiaWidth} height={russiaHeight} project={projectRussia} names={['ロシア']} boundaryNote="境界背景は既存のNatural Earth 1:50mのde facto形状。斜線は同資料の係争区分で、現在の主権・支配を判断しません。全国推計の対象領域をこの形状から再計算していません。" /></>}
  <div class="russia-learning-normal" data-normal-view>
   <section class="russia-learning-map-panel" aria-labelledby="russia-primary-title">
    <div class="russia-learning-map-heading"><div class:list={{'visually-hidden':field==='agriculture'&&!overview}}><h2 id="russia-primary-title" data-primary-title>{layer.title}</h2><p><span data-primary-period>{layer.period}</span><span data-primary-unit>{layer.unit}</span></p></div><label class="russia-learning-layer"><span class:list={{'visually-hidden':field!=='agriculture'||overview}}>{field==='agriculture'&&!overview?'分布':'地図の分布を選ぶ'}</span><select data-layer>{fieldLayers.map(item=><option value={item.id} selected={item.id===layer.id}>{item.title}</option>)}</select></label>
     {field==='agriculture'&&!overview&&<details class="russia-farming-view-options"><summary>範囲・テーマ</summary><div class="russia-farming-advanced-controls"><div class="russia-learning-themes" aria-label="学ぶテーマ">{fieldThemes.map(item=><button type="button" data-theme={item.id} aria-pressed="false">{item.title}</button>)}</div><div class="russia-learning-scope" aria-label="地図の範囲">{scopeOptions.map(item=><button type="button" data-scope={item.id} aria-pressed={item.id===state.scope?'true':'false'} disabled={item.id==='region'&&state.place==='all'}>{item.label}</button>)}</div></div></details>}
    </div>
    <div class="russia-learning-scene" data-primary-map set:html={renderRussiaScene(layer,state,'primary')}></div>
    {field==='agriculture'&&!overview&&<div class="russia-key-legend russia-farming-map-legend" data-key-legend data-climate-legend="false"><div class="russia-learning-legend" data-primary-legend aria-label="品目と色の凡例" set:html={renderRussiaWorkspaceLegend(layer)}></div><details class="russia-climate-dictionary russia-farming-legend-details" data-climate-dictionary><summary>数量階級・単位・欠測の詳しい凡例</summary><p data-current-legend-unit>{layer.period}・{layer.unit}</p><div class="russia-learning-legend" data-primary-legend-definitions set:html={renderRussiaLegend(layer)}></div></details></div>}
    {overview?<div class="russia-learning-legend" data-primary-legend aria-label="地図の全凡例" set:html={renderRussiaLegend(layer)}></div>:<div class="russia-learning-legend russia-legend-spacer" data-primary-legend-spacer aria-hidden="true" inert set:html={renderRussiaLegend(layer)}></div>}
    {field==='agriculture'&&!overview&&<nav class="russia-subtabs russia-agriculture-subtabs" style="--sub-count:2" aria-label="農林業の項目">{hierarchy.map(item=>item.ready?<button type="button" aria-pressed="true">{item.label}</button>:<button type="button" disabled>{item.label}<small>未整備</small></button>)}</nav>}
    {field!=='agriculture'&&<div class="russia-learning-toolbar"><div class="russia-learning-themes" hidden={overview} aria-label="学ぶテーマ">{fieldThemes.map(item=><button type="button" data-theme={item.id} title={item.title} aria-pressed="false">{item.title}</button>)}</div><div class="russia-learning-scope" aria-label="地図の範囲">{scopeOptions.map(item=><button type="button" data-scope={item.id} aria-pressed={item.id===state.scope?'true':'false'} disabled={item.id==='region'&&state.place==='all'}>{item.label}</button>)}</div></div>}
    {field==='nature'&&!overview&&<details class="russia-water-unavailable"><summary>水資源の項目（未整備）</summary><nav aria-label="水資源の項目"><button disabled>河川・地下水 <small>未整備</small></button><button disabled>降水量 <small>未整備</small></button><button disabled>河川の流域 <small>未整備</small></button></nav></details>}
    {overview&&<section class="russia-overview-entries"><h2>分野ごとに分布を読む</h2>{mainFields.filter(item=>item.id!=='overview').map(item=><a href={withBase(`/atlas/russia/${item.id}/`)} data-field-link={item.id}>{item.label}<span>地図と場所の理由を読む →</span></a>)}</section>}
   </section>
   <aside class="russia-learning-reading" aria-label="地図から読み取ること">
    <div class="russia-learning-message"><p class="russia-learning-kicker" data-reading-status>ロシアの概要</p><h2 data-theme-title>{overview?'広い国土を、都市と分野の分布から読む':fieldOverview.title}</h2><p class="russia-learning-takeaway" data-takeaway>{overview?'欧州側・シベリア・極東を同じ表示枠で確かめ、自然条件に設備・交通・市場・社会を重ねて読む。都市中心の円は行政人口ではなく、固定された都市範囲の人口です。':fieldOverview.takeaway}</p><button type="button" class="russia-learning-comparison-button" data-comparison>{comparison.title}と並べる →</button></div>
    {!overview&&field!=='agriculture'&&<div class="russia-key-legend" data-key-legend data-climate-legend={layer.id==='climate'?'true':'false'}><p data-current-legend-unit>{layer.period}・{layer.unit}</p><div class="russia-learning-legend" data-primary-legend aria-label="地図の全凡例" set:html={renderRussiaWorkspaceLegend(layer)}></div></div>}
    {overview&&<div class="russia-learning-coverage"><h3>この地図で読める範囲</h3><p data-coverage>{russiaCoverage(layer,state)}</p></div>}
    {field==='agriculture'&&!overview?<div class="russia-reading-scroll" tabindex="0" aria-label="地理の読み取りと詳しい資料"><p class="russia-farming-geography" data-geography-reading>{getRussiaFarmingGeography(layer.id,state.place)}</p><div class="russia-learning-detailed-readings"><details class="russia-learning-explanation"><summary>資料・表示方法の詳細</summary><p data-explanation>{fieldOverview.explanation}</p><p class="russia-legend-resolution" data-legend-resolution hidden={!layer.resolution}>{layer.resolution}</p><div class="russia-learning-coverage"><h3>この地図で読める範囲</h3><p data-coverage>{russiaCoverage(layer,state)}</p></div></details><details class="russia-learning-social"><summary>社会・制度とのつながりを読む</summary><p data-social-context>{theme.social}</p></details></div></div>:(<div class="russia-reading-scroll" tabindex="0" aria-label="選んだ場所の詳しい説明">{!overview&&<><p class="russia-legend-resolution" data-legend-resolution hidden={!layer.resolution}>{layer.resolution}</p><div class="russia-learning-coverage"><h3>この地図で読める範囲</h3><p data-coverage>{russiaCoverage(layer,state)}</p></div><details class="russia-climate-dictionary" data-climate-dictionary hidden={layer.id!=='climate'}><summary>気候区分のコードと名前</summary><div class="russia-learning-legend" data-primary-legend-definitions set:html={renderRussiaLegend(layer)}></div></details></>}  <div class="russia-learning-detailed-readings"><details class="russia-learning-explanation"><summary>選んだ場所と分布を詳しく読む</summary><p data-explanation>{fieldOverview.explanation}</p></details><details class="russia-learning-social"><summary>社会・制度とのつながりを読む</summary><p data-social-context>{theme.social}</p></details></div>
</div>)}
   </aside>
   {field==='agriculture'&&!overview&&<section class="russia-farming-trade-grid" aria-label="小麦の供給・輸出先・世界生産量比">
    <div class="russia-farming-trade-brief"><h2>小麦の用途・行先</h2><p>2020/21年度の全国需給表。食用・飼料・輸出への利用を示します。各項目は独立した量で、2020年の収穫量を分割した割合ではありません。</p><div class="russia-wheat-use-bars">{wheatUseRows.map(item=><div><span>{item.label}</span><strong>{wheatNumber.format(item.millionTonnes)}百万t</strong><i style={`--use-width:${item.millionTonnes/39.5*100}%`}></i></div>)}</div><p class="russia-trade-source"><a href={usdaWheatUrl}>USDA FAS・小麦需給表</a>（2021年報告）。産地別の経路は示しません。</p></div>
    <div class="russia-farming-trade-brief"><h2>小麦の輸出先</h2><p><a href={usdaWheatUrl}>USDAの2021年報告</a>は、2020年7月〜2021年2月にエジプトとトルコを主な輸出先として挙げています。</p><p>同じ期間の全相手国別総量が未収録のため、構成比の円グラフは示せません。現在の仕向け先とも異なります。</p></div>
    <section class="russia-wheat-share" aria-labelledby="russia-wheat-share-title">
    <p class="russia-wheat-share-kicker">世界生産量比・2020〜2022年</p><h2 id="russia-wheat-share-title">ロシアの小麦：2022年 {wheatNumber.format(russiaWheatWorldShare[2].share)}%</h2>
    <p class="russia-wheat-share-reading">同年のロシア／世界の生産量（t）で計算。地図の2020年収穫面積とは別指標です。</p>
    <div class="russia-wheat-share-chart"><svg viewBox="0 0 300 145" role="img" aria-labelledby="russia-wheat-chart-title russia-wheat-chart-desc"><title id="russia-wheat-chart-title">ロシアの小麦生産量の世界比、2020〜2022年</title><desc id="russia-wheat-chart-desc">{russiaWheatWorldShare.map(point=>`${point.year}年 ${wheatNumber.format(point.share)}%`).join('、')}。同年のロシアと世界の公表生産量から算出。</desc>
     {wheatShareAxis.map(tick=><g><line x1="37" x2="263" y1={wheatShareY(tick)} y2={wheatShareY(tick)} class="russia-wheat-grid"/><text x="32" y={wheatShareY(tick)+4} text-anchor="end" class="russia-wheat-axis-label">{tick}%</text></g>)}
     <path d={wheatSharePath} class="russia-wheat-line"/>
     {russiaWheatWorldShare.map((point,index)=><g><circle cx={wheatShareX(index)} cy={wheatShareY(point.share)} r="5" class="russia-wheat-dot"/><text x={wheatShareX(index)} y={wheatShareY(point.share)-11} text-anchor="middle" class="russia-wheat-value">{wheatNumber.format(point.share)}%</text><text x={wheatShareX(index)} y="135" text-anchor="middle" class="russia-wheat-year">{point.year}</text></g>)}
    </svg></div>
    <p class="russia-wheat-share-caveat">2023・24年のロシア値は非公式値（X）のため除外。</p>
    <details class="russia-wheat-share-details"><summary>数値・出典・欠測の詳細</summary><div class="russia-wheat-share-data"><table><thead><tr><th scope="col">年</th><th scope="col">ロシア（万t）</th><th scope="col">世界（万t）</th><th scope="col">世界比</th></tr></thead><tbody>{russiaWheatWorldShare.map(point=><tr><th scope="row">{point.year}</th><td>{wheatNumber.format(point.russianTonnes/10000)}</td><td>{wheatNumber.format(point.worldTonnes/10000)}</td><td>{wheatNumber.format(point.share)}%</td></tr>)}</tbody></table></div><p class="russia-wheat-share-source">出典：<a href="https://www.fao.org/faostat/en/#data/QCL">FAOSTAT, Crops and livestock products, Wheat, Production Quantity（ロシア・World）</a>。2025年12月31日公開の保存済み系列、<a href="https://www.fao.org/contact-us/terms/db-terms-of-use/">CC BY 4.0</a>。2022年は確認できる最新年という意味ではありません。</p></details>
    </section>
   </section>}
   {field==='agriculture'&&!overview&&<section class="russia-farming-candidates" aria-labelledby="russia-farming-candidates-title"><h2 id="russia-farming-candidates-title">小麦・牛以外の主要品目も確かめる</h2><p>大麦・テンサイ・ヒマワリ種子、豚・羊・鶏などの全国統計を収録しました。ライムギは別の公表資料で全国値を確認できます。地図で全域分布を示せるのは、現在は小麦と牛です。</p><p><strong>ライムギ：</strong><a href="https://apps.fas.usda.gov/psdonline/circulars/2025/07/Grain.pdf">USDA FAS の2025年7月公表表</a>では、ロシアの2022/23年度生産量は200万t、同じ表の世界総量は1,214.9万t。EUに次ぐ規模です。年度の区切りと出典が異なるため、下のFAOSTAT暦年値とは同列に順位付けしません。ライムギ単独の全国分布格子は未収録で、地図上の場所は示しません。</p><details><summary>2022年の作物・家畜の全国値</summary><p>作物は生産重量、家畜は飼養頭羽数です。単位が違うため合算・順位付けはできません。</p><div class="russia-farming-candidate-columns"><div><h3>作物生産量</h3><ul>{russiaFarmingProductCandidates.filter(item=>item.group==='crop').map(item=><li><span>{item.label}</span><strong>{wheatNumber.format(item.value/1e6)}百万t</strong></li>)}</ul></div><div><h3>家畜飼養数</h3><ul>{russiaFarmingProductCandidates.filter(item=>item.group==='livestock').map(item=><li><span>{item.label}</span><strong>{wheatNumber.format(item.unit==='1000 An'?item.value/1000:item.value/1e6)}百万{item.id==='chicken-stocks'?'羽':'頭'}</strong></li>)}</ul></div></div><p>出典：<a href="https://www.fao.org/faostat/en/#data/QCL">FAOSTAT QCL</a>、2022年の公表値（A）、<a href="https://www.fao.org/contact-us/terms/db-terms-of-use/">CC BY 4.0</a>。ライムギの全国行はこの保存済み系列に未収録です。上記のUSDA値は異なる年度区分です。</p></details></section>}
  </div>
  <section class="russia-learning-comparison" data-comparison-view hidden aria-label="元の分布と比較する">
   <div class="russia-learning-comparison-grid">
    <section class="russia-learning-map-panel" aria-labelledby="russia-original-title"><div class="russia-learning-map-heading"><div><h2 id="russia-original-title" data-original-title>元の分布：{layer.title}</h2><p><span data-original-period>{layer.period}</span><span data-original-unit>{layer.unit}</span></p></div></div><div class="russia-learning-scene" data-original-map set:html={renderRussiaScene(layer,state,'original')}></div><div class="russia-learning-legend" data-original-legend aria-label="元の分布の全凡例" set:html={renderRussiaLegend(layer)}></div></section>
    <section class="russia-learning-map-panel" aria-labelledby="russia-comparison-title"><div class="russia-learning-map-heading"><div><h2 id="russia-comparison-title" data-comparison-title>{comparison.title}</h2><p><span data-comparison-period>{comparison.period}</span><span data-comparison-unit>{comparison.unit}</span></p></div></div><div class="russia-learning-scene" data-comparison-map set:html={renderRussiaScene(comparison,state,'comparison')}></div><div class="russia-learning-legend" data-comparison-legend aria-label="比較する分布の全凡例" set:html={renderRussiaLegend(comparison)}></div><p class="russia-learning-comparison-explanation" data-comparison-explanation>{getRussiaComparisonReading(state).message}</p></section>
   </div>
  </section>
  <noscript><p class="russia-learning-noscript">最初の地図、全凡例、説明と出典を表示しています。地域・テーマ・分布の選択と比較には JavaScript が必要です。上の分野リンクから各分野の最初の地図を読めます。</p></noscript>
 </article>
</div><section id="russia-statistics" class="russia-statistics" aria-label="分布の資料と統計の読み方"><h2>資料・統計と分布の読み方</h2><p>地図の数値・年・単位と、資料の対象範囲を確認できます。代表地点の地図は全国の生産量を示しません。</p>  <details class="russia-learning-sources"><summary>地図・分布の出典、帰属表示、資料の範囲</summary><p>地図では同じ学習地域と範囲を保ったまま分布を読み比べます。異なる資料の対象年・定義・解像度は各地図と次の出典に示しています。</p><section class="russia-learning-current-sources"><h2>表示中の地図・説明の出典</h2><div data-source-list>{[...russiaBoundarySources,...layer.sources,...theme.sources].map(source=><div class="russia-learning-citation"><a href={source.url}>{source.title}</a>{source.note&&<p>{source.note}</p>}</div>)}</div></section><section class="russia-learning-source-entry"><h2>基礎地図の境界・係争区分と資料の範囲</h2>{russiaBoundarySources.map(source=><div class="russia-learning-citation"><a href={source.url}>{source.title}</a>{source.note&&<p>{source.note}</p>}</div>)}</section>{russiaLayers.map(item=><section class="russia-learning-source-entry"><h2>{item.title}</h2><p>{item.period} · {item.unit}{item.resolution?` · ${item.resolution}`:''}</p>{item.sources.map(source=><div class="russia-learning-citation"><a href={source.url}>{source.title}</a>{source.note&&<p>{source.note}</p>}</div>)}<p>{item.coverage}</p></section>)}<section class="russia-learning-source-entry"><h2>場所と背景の説明</h2>{russiaThemes.map(item=><div class="russia-learning-citation"><h3>{item.title}</h3>{item.sources.map(source=><div><a href={source.url}>{source.title}</a>{source.note&&<p>{source.note}</p>}</div>)}</div>)}</section><p>西部・シベリア・極東の3区分は分布を読み比べるための学習地域です。行政区分とは異なります。境界や表示範囲の出典・扱いは各地図の説明で確認できます。</p></details>
</section></div>
</BaseLayout>
